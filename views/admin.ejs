<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DPP Admin Panel</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .tab-button { transition: all 0.3s ease; }
    .tab-button.active { border-bottom: 3px solid #2563eb; color: #2563eb; }
    .tab-content { display: none; }
    .tab-content.active { display: block; }
  </style>
</head>
<body class="bg-gray-100">
  <div class="max-w-7xl mx-auto py-12 px-4">
    <h1 class="text-4xl font-bold text-gray-900 mb-8">📦 DPP Admin Panel</h1>

    <!-- Tabs Navigation -->
    <div class="flex gap-2 mb-8 border-b border-gray-300 bg-white rounded-t-lg shadow overflow-x-auto">
      <button class="tab-button active px-6 py-4 font-semibold text-gray-700 whitespace-nowrap" data-tab="batch">1. Batch & Serials</button>
      <button class="tab-button px-6 py-4 font-semibold text-gray-700 whitespace-nowrap" data-tab="product-info">2. Product Info</button>
      <button class="tab-button px-6 py-4 font-semibold text-gray-700 whitespace-nowrap" data-tab="transparency">3. Transparency</button>
      <button class="tab-button px-6 py-4 font-semibold text-gray-700 whitespace-nowrap" data-tab="nudie-values">4. Nudie Values</button>
      <button class="tab-button px-6 py-4 font-semibold text-gray-700 whitespace-nowrap" data-tab="storytelling">5. Storytelling</button>
      <button class="tab-button px-6 py-4 font-semibold text-gray-700 whitespace-nowrap" data-tab="supplier-import">6. Supplier Data</button>
      <button class="tab-button px-6 py-4 font-semibold text-gray-700 whitespace-nowrap" data-tab="serial-data">7. Serial Data</button>
      <button class="tab-button px-6 py-4 font-semibold text-gray-700 whitespace-nowrap" data-tab="events">8. Events</button>
    </div>

    <!-- TAB 1: BATCH & SERIALS -->
    <div id="tab-batch" class="tab-content active bg-white rounded-lg shadow-md p-8 mb-6">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">📦 Import Batch + Serials</h2>
      <form id="importForm" class="space-y-4 max-w-2xl">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Batch ID</label>
            <input type="text" name="batch_id" placeholder="114539-BATCH01" class="w-full border border-gray-300 rounded px-3 py-2" required>
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Style Number</label>
            <input type="text" name="style_number" placeholder="114539" class="w-full border border-gray-300 rounded px-3 py-2" required>
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Total Units</label>
            <input type="number" name="total_units" placeholder="500" class="w-full border border-gray-300 rounded px-3 py-2" required>
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Partner Name</label>
            <input type="text" name="partner_name" placeholder="Trimco" class="w-full border border-gray-300 rounded px-3 py-2">
          </div>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Serial Numbers (comma-separated)</label>
          <textarea name="serials" placeholder="114539-001-AA,114539-001-AB,114539-001-AC" rows="4" class="w-full border border-gray-300 rounded px-3 py-2" required></textarea>
        </div>
        <button type="submit" class="bg-blue-600 text-white px-4 py-3 rounded font-semibold hover:bg-blue-700">
          ✓ Import Batch
        </button>
        <div id="importResult" class="mt-4 hidden p-4 rounded"></div>
      </form>
    </div>

    <!-- TAB 2: PRODUCT INFORMATION -->
    <div id="tab-product-info" class="tab-content bg-white rounded-lg shadow-md p-8 mb-6">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">🛍️ Product Information (Style-level)</h2>
      <form id="productInfoForm" class="space-y-4 max-w-2xl">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Style Number</label>
          <input type="text" name="style_number" placeholder="114539" class="w-full border border-gray-300 rounded px-3 py-2" required>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Product Name</label>
          <input type="text" name="product_name" placeholder="Tight Terry Zip Hood" class="w-full border border-gray-300 rounded px-3 py-2" required>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Description</label>
          <textarea name="description" placeholder="A comfortable hoodie..." rows="3" class="w-full border border-gray-300 rounded px-3 py-2" required></textarea>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Care Instructions</label>
          <textarea name="care_instructions" placeholder="Wash 40°C..." rows="2" class="w-full border border-gray-300 rounded px-3 py-2"></textarea>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Delivery & Returns</label>
          <textarea name="delivery_returns" placeholder="Ships within 5 days..." rows="2" class="w-full border border-gray-300 rounded px-3 py-2"></textarea>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Size, Material & Composition</label>
          <textarea name="size_material_composition" placeholder="95% cotton, 5% elastane..." rows="2" class="w-full border border-gray-300 rounded px-3 py-2"></textarea>
        </div>
        <button type="submit" class="bg-green-600 text-white px-4 py-3 rounded font-semibold hover:bg-green-700">
          ✓ Save Product Info
        </button>
        <div id="productInfoResult" class="mt-4 hidden p-4 rounded"></div>
      </form>
    </div>

    <!-- TAB 3: TRANSPARENCY DATA -->
    <div id="tab-transparency" class="tab-content bg-white rounded-lg shadow-md p-8 mb-6">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">🌍 Transparency Data (DPP Core)</h2>
      <form id="transparencyForm" class="space-y-4 max-w-4xl">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Style Number</label>
          <input type="text" name="style_number" placeholder="114539" class="w-full border border-gray-300 rounded px-3 py-2" required>
        </div>

        <div class="border-t pt-4">
          <h3 class="font-bold text-gray-700 mb-2">Suppliers & Production Chain (JSON)</h3>
          <textarea name="suppliers_chain" placeholder='{"spinning": "Factory A", "weaving": "Factory B", "dyeing": "Factory C"}' rows="3" class="w-full border border-gray-300 rounded px-3 py-2 font-mono text-sm"></textarea>
        </div>

        <div class="border-t pt-4">
          <h3 class="font-bold text-gray-700 mb-2">Certifications (JSON)</h3>
          <textarea name="certifications" placeholder='{"GOTS": true, "OCS": true, "Fairwear": "Audit 2024"}' rows="3" class="w-full border border-gray-300 rounded px-3 py-2 font-mono text-sm"></textarea>
        </div>

        <div class="border-t pt-4">
          <h3 class="font-bold text-gray-700 mb-2">Environmental Data (JSON)</h3>
          <textarea name="environmental_data" placeholder='{"PEF": "2.5 kg CO2e", "renewable_energy": "80%", "chemicals": "ZDHC Level 2"}' rows="3" class="w-full border border-gray-300 rounded px-3 py-2 font-mono text-sm"></textarea>
        </div>

        <div class="border-t pt-4">
          <h3 class="font-bold text-gray-700 mb-2">Social Data (JSON)</h3>
          <textarea name="social_data" placeholder='{"living_wages": true, "audit_score": "85", "audit_date": "2024-01-15"}' rows="3" class="w-full border border-gray-300 rounded px-3 py-2 font-mono text-sm"></textarea>
        </div>

        <button type="submit" class="bg-purple-600 text-white px-4 py-3 rounded font-semibold hover:bg-purple-700">
          ✓ Save Transparency Data
        </button>
        <div id="transparencyResult" class="mt-4 hidden p-4 rounded"></div>
      </form>
    </div>

    <!-- TAB 4: NUDIE VALUES -->
    <div id="tab-nudie-values" class="tab-content bg-white rounded-lg shadow-md p-8 mb-6">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">💚 Nudie-Specific Values</h2>
      <form id="nudieValuesForm" class="space-y-4 max-w-2xl">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Style Number</label>
          <input type="text" name="style_number" placeholder="114539" class="w-full border border-gray-300 rounded px-3 py-2" required>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Repair Program Info</label>
          <textarea name="repair_info" placeholder="We offer free repairs for 1 year..." rows="3" class="w-full border border-gray-300 rounded px-3 py-2"></textarea>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Trade-in Program Info</label>
          <textarea name="trade_in_info" placeholder="Trade in your old jeans for 20% off..." rows="3" class="w-full border border-gray-300 rounded px-3 py-2"></textarea>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Partner Links (JSON)</label>
          <textarea name="partner_links" placeholder='[{"name": "Stockholm Store", "url": "..."}, {"name": "Repair Partner", "url": "..."}]' rows="3" class="w-full border border-gray-300 rounded px-3 py-2 font-mono text-sm"></textarea>
        </div>
        <button type="submit" class="bg-pink-600 text-white px-4 py-3 rounded font-semibold hover:bg-pink-700">
          ✓ Save Nudie Values
        </button>
        <div id="nudieValuesResult" class="mt-4 hidden p-4 rounded"></div>
      </form>
    </div>

    <!-- TAB 5: STORYTELLING -->
    <div id="tab-storytelling" class="tab-content bg-white rounded-lg shadow-md p-8 mb-6">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">📖 Storytelling</h2>
      <form id="storytellingForm" class="space-y-4 max-w-2xl">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Style Number</label>
          <input type="text" name="style_number" placeholder="114539" class="w-full border border-gray-300 rounded px-3 py-2" required>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Summary (short)</label>
          <textarea name="summary" placeholder="A timeless classic made with care..." rows="2" class="w-full border border-gray-300 rounded px-3 py-2" required></textarea>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Full Content</label>
          <textarea name="content" placeholder="This collection tells the story of..." rows="4" class="w-full border border-gray-300 rounded px-3 py-2"></textarea>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Related Links (JSON)</label>
          <textarea name="links" placeholder='[{"title": "Read more", "url": "..."}]' rows="3" class="w-full border border-gray-300 rounded px-3 py-2 font-mono text-sm"></textarea>
        </div>
        <button type="submit" class="bg-yellow-600 text-white px-4 py-3 rounded font-semibold hover:bg-yellow-700">
          ✓ Save Storytelling
        </button>
        <div id="storytellingResult" class="mt-4 hidden p-4 rounded"></div>
      </form>
    </div>

    <!-- TAB 6: SUPPLIER DATA IMPORT -->
    <div id="tab-supplier-import" class="tab-content bg-white rounded-lg shadow-md p-8 mb-6">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">📨 Import Supplier Data (SGTIN + RFID)</h2>
      <form id="supplierImportForm" class="space-y-4 max-w-3xl">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Batch ID</label>
          <input type="text" name="batch_id" placeholder="114539-BATCH01" class="w-full border border-gray-300 rounded px-3 py-2" required>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Paste Data (Format: serial_number,sgtin_numeric,sgtin_uri,rfid)</label>
          <textarea name="data" placeholder="114539-001-AA,301414170001200ABC,https://nudiejeans.dpp.com/01/.../21/001AA,12AB34CD56EF&#10;114539-001-AB,301414170001200ABD,https://nudiejeans.dpp.com/01/.../21/001AB,12AB34CD56F0" rows="8" class="w-full border border-gray-300 rounded px-3 py-2 font-mono text-sm" required></textarea>
          <p class="text-xs text-gray-500 mt-1">Each line: serial_number, sgtin_numeric, sgtin_uri, rfid (RFID can be empty)</p>
        </div>
        <button type="submit" class="bg-indigo-600 text-white px-4 py-3 rounded font-semibold hover:bg-indigo-700">
          ✓ Import Supplier Data
        </button>
        <div id="supplierImportResult" class="mt-4 hidden p-4 rounded"></div>
      </form>
    </div>

    <!-- TAB 7: SERIAL DATA -->
    <div id="tab-serial-data" class="tab-content bg-white rounded-lg shadow-md p-8 mb-6">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">🏷️ Serial Data (Per-item metadata)</h2>
      <p class="text-sm text-gray-600 mb-6">Add metadata to a specific serial (size, location, owner, condition, notes, etc.)</p>
      <form id="serialDataForm" class="space-y-4 max-w-2xl">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Serial Number</label>
          <input type="text" name="serial_number" placeholder="114519-001-AA" class="w-full border border-gray-300 rounded px-3 py-2" required>
        </div>

        <div class="bg-gray-50 p-6 rounded-lg space-y-4">
          <h3 class="font-bold text-gray-900">Common Fields</h3>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Size</label>
              <select name="size" class="w-full border border-gray-300 rounded px-3 py-2">
                <option value="">-- Not specified --</option>
                <option value="XS">XS</option>
                <option value="S">S</option>
                <option value="M">M</option>
                <option value="L">L</option>
                <option value="XL">XL</option>
                <option value="XXL">XXL</option>
                <option value="One size">One size</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Condition</label>
              <select name="condition" class="w-full border border-gray-300 rounded px-3 py-2">
                <option value="">-- Not specified --</option>
                <option value="new">New</option>
                <option value="like_new">Like New</option>
                <option value="good">Good</option>
                <option value="fair">Fair</option>
                <option value="worn">Worn</option>
                <option value="damaged">Damaged</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Location</label>
              <input type="text" name="location" placeholder="e.g., Stockholm warehouse, Customer ID" class="w-full border border-gray-300 rounded px-3 py-2">
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Owner/Customer ID</label>
              <input type="text" name="owner_id" placeholder="e.g., CUST-12345" class="w-full border border-gray-300 rounded px-3 py-2">
            </div>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Notes</label>
            <textarea name="notes" placeholder="Quality notes, defects, observations, etc." rows="3" class="w-full border border-gray-300 rounded px-3 py-2"></textarea>
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Added By (staff/system)</label>
          <input type="text" name="added_by" placeholder="stockholm-repair-hub" class="w-full border border-gray-300 rounded px-3 py-2">
        </div>

        <button type="submit" class="bg-teal-600 text-white px-4 py-3 rounded font-semibold hover:bg-teal-700">
          ✓ Save Serial Data
        </button>
        <div id="serialDataResult" class="mt-4 hidden p-4 rounded"></div>
      </form>
    </div>

    <!-- TAB 8: EVENTS -->
    <div id="tab-events" class="tab-content bg-white rounded-lg shadow-md p-8 mb-6">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">⚙️ Log Event (Service, Repair, Recycling)</h2>
      <form id="eventForm" class="space-y-4 max-w-2xl">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Serial Number</label>
          <input type="text" name="serial_number" placeholder="114539-001-AA" class="w-full border border-gray-300 rounded px-3 py-2" required>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Event Type</label>
          <select name="event_type" class="w-full border border-gray-300 rounded px-3 py-2" required>
            <option value="">-- Select --</option>
            <option value="service">Service</option>
            <option value="repair">Repair</option>
            <option value="reuse">Reuse (Trade-in)</option>
            <option value="recycling">Recycling</option>
            <option value="scanned">Scanned</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Event Details (JSON)</label>
          <textarea name="event_data" placeholder='{"issue": "broken_zipper", "cost": 450, "location": "Stockholm"}' rows="4" class="w-full border border-gray-300 rounded px-3 py-2 font-mono text-sm"></textarea>
        </div>
        <button type="submit" class="bg-orange-600 text-white px-4 py-3 rounded font-semibold hover:bg-orange-700">
          ✓ Log Event
        </button>
        <div id="eventResult" class="mt-4 hidden p-4 rounded"></div>
      </form>
    </div>

  </div>

  <script>
    // Tab switching
    document.querySelectorAll('.tab-button').forEach(btn => {
      btn.addEventListener('click', () => {
        const tabName = btn.dataset.tab;

        document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.tab-button').forEach(b => b.classList.remove('active'));

        document.getElementById(`tab-${tabName}`).classList.add('active');
        btn.classList.add('active');
      });
    });

    // Auto-open tab from search if needed
    window.addEventListener('load', async () => {
      const adminTab = sessionStorage.getItem('adminTab');
      const adminStyle = sessionStorage.getItem('adminStyle');
      const adminSerial = sessionStorage.getItem('adminSerial');

      if (adminTab) {
        // Open the right tab
        const btn = document.querySelector(`[data-tab="${adminTab}"]`);
        if (btn) btn.click();

        // Pre-fill style number if applicable
        if (adminStyle) {
          const styleInputs = document.querySelectorAll('input[name="style_number"]');
          styleInputs.forEach(input => input.value = adminStyle);

          // Fetch and populate style data
          if (adminTab === 'product-info') {
            await populateProductInfo(adminStyle);
          } else if (adminTab === 'transparency') {
            await populateTransparency(adminStyle);
          } else if (adminTab === 'nudie-values') {
            await populateNudieValues(adminStyle);
          } else if (adminTab === 'storytelling') {
            await populateStorytelling(adminStyle);
          }
        }

        // Pre-fill serial number if applicable
        if (adminSerial) {
          const serialInputs = document.querySelectorAll('input[name="serial_number"]');
          serialInputs.forEach(input => input.value = adminSerial);

          if (adminTab === 'serial-data') {
            await populateSerialData(adminSerial);
          }
        }

        // Clear session storage
        sessionStorage.removeItem('adminTab');
        sessionStorage.removeItem('adminStyle');
        sessionStorage.removeItem('adminSerial');
      }
    });

    async function populateProductInfo(styleNumber) {
      try {
        const res = await fetch(`/api/styles/${styleNumber}/full-data`);
        const data = await res.json();
        if (data.style) {
          document.querySelector('input[name="product_name"]').value = data.style.product_name || '';
          document.querySelector('textarea[name="description"]').value = data.style.description || '';
          document.querySelector('textarea[name="care_instructions"]').value = data.style.care_instructions || '';
          document.querySelector('textarea[name="delivery_returns"]').value = data.style.delivery_returns || '';
          document.querySelector('textarea[name="size_material_composition"]').value = data.style.size_material_composition || '';
        }
      } catch (err) {
        console.log('Could not load product info:', err);
      }
    }

    async function populateTransparency(styleNumber) {
      try {
        const res = await fetch(`/api/styles/${styleNumber}/full-data`);
        const data = await res.json();
        if (data.transparency_data) {
          document.querySelector('textarea[name="suppliers_chain"]').value = JSON.stringify(data.transparency_data.suppliers_chain || {}, null, 2);
          document.querySelector('textarea[name="certifications"]').value = JSON.stringify(data.transparency_data.certifications || {}, null, 2);
          document.querySelector('textarea[name="environmental_data"]').value = JSON.stringify(data.transparency_data.environmental_data || {}, null, 2);
          document.querySelector('textarea[name="social_data"]').value = JSON.stringify(data.transparency_data.social_data || {}, null, 2);
        }
      } catch (err) {
        console.log('Could not load transparency data:', err);
      }
    }

    async function populateNudieValues(styleNumber) {
      try {
        const res = await fetch(`/api/styles/${styleNumber}/full-data`);
        const data = await res.json();
        if (data.nudie_values) {
          document.querySelector('textarea[name="repair_info"]').value = data.nudie_values.repair_info || '';
          document.querySelector('textarea[name="trade_in_info"]').value = data.nudie_values.trade_in_info || '';
          document.querySelector('textarea[name="partner_links"]').value = JSON.stringify(data.nudie_values.partner_links || [], null, 2);
        }
      } catch (err) {
        console.log('Could not load nudie values:', err);
      }
    }

    async function populateStorytelling(styleNumber) {
      try {
        const res = await fetch(`/api/styles/${styleNumber}/full-data`);
        const data = await res.json();
        if (data.storytelling) {
          document.querySelector('textarea[name="summary"]').value = data.storytelling.summary || '';
          document.querySelector('textarea[name="content"]').value = data.storytelling.content || '';
          document.querySelector('textarea[name="links"]').value = JSON.stringify(data.storytelling.links || [], null, 2);
        }
      } catch (err) {
        console.log('Could not load storytelling:', err);
      }
    }

    async function populateSerialData(serialNumber) {
      try {
        const res = await fetch(`/api/serials/${serialNumber}/full-data`);
        const data = await res.json();
        if (data.serial_data && data.serial_data.length > 0) {
          const sizeData = data.serial_data.find(d => d.key === 'size');
          const conditionData = data.serial_data.find(d => d.key === 'condition');
          const locationData = data.serial_data.find(d => d.key === 'location');
          const ownerData = data.serial_data.find(d => d.key === 'owner_id');
          const notesData = data.serial_data.find(d => d.key === 'notes');

          if (sizeData) document.querySelector('select[name="size"]').value = sizeData.value || '';
          if (conditionData) document.querySelector('select[name="condition"]').value = conditionData.value || '';
          if (locationData) document.querySelector('input[name="location"]').value = locationData.value || '';
          if (ownerData) document.querySelector('input[name="owner_id"]').value = ownerData.value || '';
          if (notesData) document.querySelector('textarea[name="notes"]').value = notesData.value || '';
        }
      } catch (err) {
        console.log('Could not load serial data:', err);
      }
    }

    // Utility function for showing results
    const showResult = (elementId, success, message) => {
      const resultDiv = document.getElementById(elementId);
      resultDiv.className = success
        ? 'mt-4 p-4 rounded bg-green-50 border border-green-200 text-green-900'
        : 'mt-4 p-4 rounded bg-red-50 border border-red-200 text-red-900';
      resultDiv.innerHTML = `<p>${success ? '✓ ' : '✗ '} ${message}</p>`;
      resultDiv.classList.remove('hidden');
    };

    // Import batch
    document.getElementById('importForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(e.target);
      const serials = data.get('serials').split(',').map(s => s.trim());

      try {
        const res = await fetch('/api/batch/import', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            batch_id: data.get('batch_id'),
            style_number: data.get('style_number'),
            total_units: parseInt(data.get('total_units')),
            partner_name: data.get('partner_name'),
            serials
          })
        });
        const result = await res.json();
        showResult('importResult', res.ok, res.ok ? `${result.serials_imported} serials imported` : result.error);
      } catch (err) {
        showResult('importResult', false, err.message);
      }
    });

    // Product info
    document.getElementById('productInfoForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(e.target);
      const styleNumber = data.get('style_number');

      try {
        const res = await fetch(`/api/styles/${styleNumber}/product-info`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(data))
        });
        const result = await res.json();
        showResult('productInfoResult', res.ok, res.ok ? 'Product info saved' : result.error);
      } catch (err) {
        showResult('productInfoResult', false, err.message);
      }
    });

    // Transparency data
    document.getElementById('transparencyForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(e.target);
      const styleNumber = data.get('style_number');

      try {
        const res = await fetch(`/api/styles/${styleNumber}/transparency`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            style_number: styleNumber,
            suppliers_chain: JSON.parse(data.get('suppliers_chain') || '{}'),
            certifications: JSON.parse(data.get('certifications') || '{}'),
            environmental_data: JSON.parse(data.get('environmental_data') || '{}'),
            social_data: JSON.parse(data.get('social_data') || '{}')
          })
        });
        const result = await res.json();
        showResult('transparencyResult', res.ok, res.ok ? 'Transparency data saved' : result.error);
      } catch (err) {
        showResult('transparencyResult', false, err.message);
      }
    });

    // Nudie values
    document.getElementById('nudieValuesForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(e.target);
      const styleNumber = data.get('style_number');

      try {
        const res = await fetch(`/api/styles/${styleNumber}/nudie-values`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            repair_info: data.get('repair_info'),
            trade_in_info: data.get('trade_in_info'),
            partner_links: JSON.parse(data.get('partner_links') || '[]')
          })
        });
        const result = await res.json();
        showResult('nudieValuesResult', res.ok, res.ok ? 'Nudie values saved' : result.error);
      } catch (err) {
        showResult('nudieValuesResult', false, err.message);
      }
    });

    // Storytelling
    document.getElementById('storytellingForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(e.target);
      const styleNumber = data.get('style_number');

      try {
        const res = await fetch(`/api/styles/${styleNumber}/storytelling`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            summary: data.get('summary'),
            content: data.get('content'),
            links: JSON.parse(data.get('links') || '[]')
          })
        });
        const result = await res.json();
        showResult('storytellingResult', res.ok, res.ok ? 'Storytelling saved' : result.error);
      } catch (err) {
        showResult('storytellingResult', false, err.message);
      }
    });

    // Supplier data import
    document.getElementById('supplierImportForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(e.target);

      try {
        const res = await fetch('/api/serials/import-supplier-data', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            batch_id: data.get('batch_id'),
            data: data.get('data')
          })
        });
        const result = await res.json();
        const message = `Processed: ${result.processed}, Failed: ${result.failed}${result.errors ? '\n' + result.errors.join(', ') : ''}`;
        showResult('supplierImportResult', res.ok, message);
      } catch (err) {
        showResult('supplierImportResult', false, err.message);
      }
    });

    // Serial data
    document.getElementById('serialDataForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(e.target);
      const serialNumber = data.get('serial_number');
      const addedBy = data.get('added_by');

      const fields = [
        { key: 'size', value: data.get('size') },
        { key: 'condition', value: data.get('condition') },
        { key: 'location', value: data.get('location') },
        { key: 'owner_id', value: data.get('owner_id') },
        { key: 'notes', value: data.get('notes') }
      ].filter(f => f.value);

      if (fields.length === 0) {
        showResult('serialDataResult', false, 'Please fill in at least one field');
        return;
      }

      try {
        let savedCount = 0;
        let errors = [];

        for (const field of fields) {
          const res = await fetch(`/api/serials/${serialNumber}/data`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              key: field.key,
              value: field.value,
              added_by: addedBy
            })
          });

          if (!res.ok) {
            const err = await res.json();
            errors.push(`${field.key}: ${err.error}`);
          } else {
            savedCount++;
          }
        }

        const message = `Saved: ${savedCount} fields${errors.length > 0 ? ' | Errors: ' + errors.join(', ') : ''}`;
        showResult('serialDataResult', errors.length === 0, message);
        if (errors.length === 0) {
          document.getElementById('serialDataForm').reset();
        }
      } catch (err) {
        showResult('serialDataResult', false, err.message);
      }
    });

    // Events
    document.getElementById('eventForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(e.target);

      try {
        const eventData = data.get('event_data') ? JSON.parse(data.get('event_data')) : {};
        const res = await fetch(`/api/serials/${data.get('serial_number')}/event`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            event_type: data.get('event_type'),
            event_data: eventData
          })
        });
        const result = await res.json();
        showResult('eventResult', res.ok, res.ok ? `Event logged: ${data.get('event_type')}` : result.error);
      } catch (err) {
        showResult('eventResult', false, err.message);
      }
    });
  </script>
</body>
</html>
