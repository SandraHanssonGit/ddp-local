<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= variant.product_name %> - Variant Detail</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
  <script src="/js/admin-modal.js"></script>
</head>
<body>
  <div class="wrap">
    <div class="detail-header">
      <div>
        <h1><%= variant.product_name %></h1>
        <p class="subtitle">Variant <strong><%= variant.variant_name %></strong></p>
      </div>
      <a href="/admin-v2?tab=products" class="back-link"><%- icon('arrow-left') %> Back to Products</a>
    </div>

    <div>
        <!-- Variant Info Card -->
        <div class="card card-identifiers">
          <div class="card-head">
            <h2>Variant Information</h2>
            <button onclick="toggleEdit('variant-info')" class="btn btn-primary">Edit</button>
          </div>

          <!-- View Mode -->
          <div id="variant-info-view">
            <div class="info-grid">
              <div class="info-item">
                <label class="label-sm">Style</label>
                <p class="value"><%= style.style_number %> - <%= style.product_name %></p>
              </div>
              <div class="info-item">
                <label class="label-sm">Variant Code</label>
                <p class="value mono"><strong><%= variant.variant_name %></strong></p>
              </div>
              <div class="info-item">
                <label class="label-sm">Product Type</label>
                <p class="value"><%= style.product_type %></p>
              </div>
              <div class="info-item">
                <label class="label-sm">Created</label>
                <p class="value"><%= new Date(variant.created_at).toLocaleDateString('en-US') %></p>
              </div>
            </div>
          </div>

          <!-- Edit Mode -->
          <form id="variant-info-edit" class="hidden" onsubmit="saveVariantInfo(event)">
            <div class="field-row">
              <label>Variant Code/Name</label>
              <input type="text" id="edit-variant-name" value="<%= variant.variant_name %>" required>
            </div>
            <div class="field-row">
              <label>Product Name for this variant</label>
              <input type="text" id="edit-product-name" value="<%= variant.product_name || '' %>" required>
            </div>
            <div style="display:flex; gap:10px;">
              <button type="submit" class="btn btn-primary">Save Changes</button>
              <button type="button" onclick="toggleEdit('variant-info')" class="btn">Cancel</button>
            </div>
          </form>

          <!-- Variant Image (merged in - same card, same subject, matching
               Style's Product Image treatment: hover-zoom, usage info,
               styled file input). Three states: this variant's own image,
               falling back to the Style's (dimmed), or neither yet. -->
          <div style="border-top:1px solid var(--hairline); margin-top:20px; padding-top:20px;">
            <label class="label-sm" style="display:block; margin-bottom:10px;">Variant Image</label>
            <div style="display:flex; gap:20px; align-items:flex-start;">
              <% if (variant.image_url) { %>
                <div class="image-preview-wrap">
                  <img src="<%= variant.image_url %>" alt="<%= variant.product_name %>" class="image-preview" title="Hover to zoom">
                </div>
              <% } else if (style.image_url) { %>
                <div class="image-preview-wrap">
                  <img src="<%= style.image_url %>" alt="<%= variant.product_name %>" class="image-preview" style="opacity:0.75;" title="Hover to zoom — using the Style's image">
                </div>
              <% } else { %>
                <div class="image-box" style="width:130px; height:130px; display:flex; align-items:center; justify-content:center; padding:8px; flex:none;">No image yet</div>
              <% } %>
              <div class="small muted" style="flex:1; max-width:360px;">
                <% if (variant.image_url) { %>
                  <p style="margin:0 0 8px;">Using this variant's own image.</p>
                <% } else if (style.image_url) { %>
                  <p style="margin:0 0 8px;">Using the Style's image (no variant-specific image set).</p>
                <% } else { %>
                  <p style="margin:0 0 8px;">No image set for this variant or its Style yet.</p>
                <% } %>
                <p style="margin:0 0 8px;"><strong style="color:var(--text);">Used on:</strong></p>
                <ul style="margin:0 0 12px; padding-left:18px;">
                  <li>Public passport hero image (this variant)</li>
                  <li>Products tab thumbnail</li>
                </ul>
                <p style="margin:0;">Recommended: square, at least 800&times;800px, JPG/PNG/WebP.</p>
              </div>
            </div>
            <div style="margin-top:14px; display:flex; gap:10px; align-items:center;">
              <label class="btn small file-btn">
                Choose File
                <input type="file" id="variant-image-upload" accept="image/*" class="file-input-hidden" onchange="document.getElementById('variant-image-upload-name').textContent = this.files[0] ? this.files[0].name : 'No file chosen'">
              </label>
              <span id="variant-image-upload-name" class="small muted">No file chosen</span>
              <button type="button" onclick="uploadVariantImage()" class="btn small" style="margin-left:8px;">Upload New</button>
              <% if (variant.image_url) { %>
                <a href="#" onclick="deleteVariantImage(); return false;" class="link-action danger small" style="margin-left:auto; display:inline-flex; align-items:center; gap:4px;"><%- icon('trash-2', { size: 13 }) %> Delete Image</a>
              <% } %>
            </div>
          </div>
        </div>

        <!-- DPP Fields Card -->
        <div class="card card-passport">
          <div class="card-eyebrow"><%- icon('qr-code', { size: 12 }) %> Field for digital product information</div>
          <div class="card-head">
            <h2>Field Values</h2>
            <button onclick="toggleDppEdit()" class="btn btn-primary">Edit</button>
          </div>

          <div class="locale-tabs">
            <span class="label-sm" style="margin-right:4px;">Language:</span>
            <a href="?" class="<%= !locale ? 'active' : '' %>">Default</a>
            <% (typeof availableLocales !== 'undefined' ? availableLocales : []).forEach(loc => { %>
              <a href="?lang=<%= encodeURIComponent(loc) %>" class="<%= locale === loc ? 'active' : '' %>"><%= loc %></a>
            <% }); %>
            <form method="GET" style="display:inline-flex;align-items:center;gap:6px;margin-left:8px;" onsubmit="event.preventDefault(); const v=this.newlang.value.trim(); if(v) window.location.href='?lang='+encodeURIComponent(v);">
              <input type="text" name="newlang" placeholder="+ add locale e.g. fr-FR" class="small" style="width:160px;">
              <button type="submit" class="btn small">Go</button>
            </form>
          </div>

          <div id="dpp-fields-view">
            <%
              const variantAllDppValues = typeof dppValues !== 'undefined' ? dppValues : [];
              const variantFieldGroups = [
                { label: 'EU Required', items: variantAllDppValues.filter(v => v.category === 'eu_required') },
                { label: 'Nudie', items: variantAllDppValues.filter(v => v.category === 'nudie') }
              ];
            %>
            <% variantFieldGroups.forEach(group => { %>
              <% if (group.items.length === 0) return; %>
              <div class="field-category-heading"><%= group.label %></div>
              <% group.items.forEach(val => { %>
                <% if (val.value) { %>
                  <div class="field-card overridden">
                    <div class="field-card-head">
                      <label class="label-sm"><%= val.label %></label>
                      <span class="badge badge-accent">Overridden here</span>
                    </div>
                    <p class="field-card-value"><%= val.value %></p>
                    <% if (val.inheritedValue) { %>
                      <p class="field-card-note">Inherited from <%= val.inheritedFrom %>: <span class="mono"><%= val.inheritedValue %></span></p>
                    <% } %>
                    <p style="margin-top:8px;"><a href="#" onclick="clearOverride('<%= val.field_key %>'); return false;" class="link-action danger">Clear override <span style="display:inline-flex;vertical-align:middle;"><%- icon('arrow-right', { size: 13 }) %></span> inherit</a></p>
                  </div>
                <% } else if (val.inheritedValue) { %>
                  <div class="field-card inherited">
                    <div class="field-card-head">
                      <label class="label-sm"><%= val.label %></label>
                      <span class="badge badge-muted">Inherited from <%= val.inheritedFrom %></span>
                    </div>
                    <p class="field-card-value muted"><%= val.inheritedValue %></p>
                  </div>
                <% } else { %>
                  <div class="field-card notset">
                    <div class="field-card-head">
                      <label class="label-sm"><%= val.label %></label>
                      <span class="badge" style="background:var(--lock-border); color:var(--lock-text);">Not set anywhere</span>
                    </div>
                    <% if (val.editable === false) { %>
                      <p class="field-card-note">Not editable at Variant level (see Field Config &rsaquo; Levels).</p>
                    <% } %>
                  </div>
                <% } %>
              <% }); %>
            <% }); %>
            <% if (variantAllDppValues.length === 0) { %>
              <p class="muted" style="font-style:italic;">No fields are configured to be editable at the Variant level.</p>
            <% } %>
          </div>

          <div id="dpp-fields-edit" class="hidden">
            <% if (typeof dppValues !== 'undefined' && dppValues.length > 0) { %>
              <% dppValues.forEach(val => { %>
                <% if (val.editable === false) { %>
                  <div class="field-row">
                    <label style="display:block; margin-bottom:6px;"><%= val.label %></label>
                    <p class="small muted" style="display:flex; align-items:center; gap:4px;">
                      <%- icon('lock', { size: 12 }) %> Not editable at this level - <%= (val.value || val.inheritedValue) ? ('current value: ' + (val.value || val.inheritedValue)) : 'no value set' %>
                    </p>
                  </div>
                <% } else { %>
                  <div class="field-row">
                    <label style="display:block; margin-bottom:6px;"><%= val.label %></label>
                    <% if (val.inheritedValue) { %>
                      <p class="small muted" style="margin-bottom:6px;">Inherited from <%= val.inheritedFrom %>: <span class="mono"><%= val.inheritedValue %></span> — leave blank to keep inheriting</p>
                    <% } %>
                    <textarea id="field-<%= val.field_key %>" rows="3"><%= val.value %></textarea>
                  </div>
                <% } %>
              <% }); %>
            <% } else { %>
              <p class="muted" style="font-style:italic;">No fields are configured to be editable at the Variant level.</p>
            <% } %>
            <div style="display:flex; gap:10px;">
              <button type="button" onclick="saveVariantDppValues()" class="btn btn-primary">Save Changes</button>
              <button type="button" onclick="toggleDppEdit()" class="btn">Cancel</button>
            </div>
          </div>
        </div>

        <!-- GTINs Card -->
        <% if (gtins && gtins.length > 0) { %>
          <div class="card">
            <div class="card-head">
              <h2>GTINs for <%= variant.variant_name %></h2>
              <input type="text" id="variant-gtin-search" placeholder="Search GTIN or Item #…" class="small" style="width:220px;" oninput="filterVariantGtins(this.value)">
            </div>
            <div class="table-wrap <%= gtins.length > 5 ? 'table-wrap-scroll' : '' %>">
              <table>
                <thead>
                  <tr>
                    <th>GTIN</th>
                    <th>Item #</th>
                    <th>Size</th>
                    <th class="center">SGTINs</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody id="variant-gtin-table-body">
                  <% gtins.forEach(g => {
                    let sizeDisplay = '';
                    if (g.size_value_1) sizeDisplay += g.size_value_1;
                    if (g.size_value_2) sizeDisplay += '-' + g.size_value_2;
                    if (g.size_value_3) sizeDisplay += '-' + g.size_value_3;
                  %>
                    <tr data-search="<%= (g.gtin + ' ' + (g.item_number || '')).toLowerCase() %>">
                      <td class="mono"><strong><%= g.gtin %></strong></td>
                      <td class="small"><%= g.item_number || '—' %></td>
                      <td class="small"><%= sizeDisplay || '—' %></td>
                      <td class="center"><span class="badge badge-muted small"><%= g.sgtin_count || 0 %></span></td>
                      <td><a href="/admin-v2/gtin/<%= g.id %>" class="link-action"><%- icon('arrow-right') %></a></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
            <p id="variant-gtin-no-match" class="empty-state hidden">No GTINs match "<span id="variant-gtin-no-match-term"></span>"</p>
          </div>
        <% } %>

    </div>
  </div>

  <script>
    function filterVariantGtins(term) {
      const needle = term.trim().toLowerCase();
      const rows = document.querySelectorAll('#variant-gtin-table-body tr');
      let visibleCount = 0;
      rows.forEach(row => {
        const match = !needle || row.dataset.search.includes(needle);
        row.classList.toggle('hidden', !match);
        if (match) visibleCount++;
      });
      document.getElementById('variant-gtin-no-match-term').textContent = term;
      document.getElementById('variant-gtin-no-match').classList.toggle('hidden', visibleCount > 0 || !needle);
    }

    function toggleEdit(section) {
      const view = document.getElementById(section + '-view');
      const edit = document.getElementById(section + '-edit');

      if (view && edit) {
        view.classList.toggle('hidden');
        edit.classList.toggle('hidden');
      }
    }

    async function saveVariantInfo(e) {
      e.preventDefault();

      const data = {
        variant_name: document.getElementById('edit-variant-name').value,
        product_name: document.getElementById('edit-product-name').value
      };

      try {
        const res = await fetch('/admin-v2/variant/<%= variant.id %>', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (res.ok) {
          await dppAlert('Variant updated successfully');
          location.reload();
        } else {
          await dppAlert('Error updating variant');
        }
      } catch (err) {
        await dppAlert('Error: ' + err.message);
      }
    }

    async function uploadVariantImage() {
      const fileInput = document.getElementById('variant-image-upload');
      if (!fileInput.files[0]) { await dppAlert('Please select an image'); return; }

      const formData = new FormData();
      formData.append('image', fileInput.files[0]);

      try {
        const res = await fetch('/admin-v2/variant/<%= variant.id %>/image', {
          method: 'POST',
          body: formData
        });
        if (res.ok) { await dppAlert('Image uploaded successfully'); location.reload(); }
        else { await dppAlert('Error uploading image'); }
      } catch (err) {
        await dppAlert('Error: ' + err.message);
      }
    }

    async function deleteVariantImage() {
      if (!(await dppConfirm('Delete this image? The variant will revert to using the Style\'s image.'))) return;

      try {
        const res = await fetch('/admin-v2/variant/<%= variant.id %>/image', { method: 'DELETE' });
        if (res.ok) { await dppAlert('Image deleted'); location.reload(); }
        else { await dppAlert('Error deleting image'); }
      } catch (err) {
        await dppAlert('Error: ' + err.message);
      }
    }

    const currentLocale = <%- JSON.stringify(locale || null) %>;
    const localeQuery = currentLocale ? '?lang=' + encodeURIComponent(currentLocale) : '';

    function toggleDppEdit() {
      document.getElementById('dpp-fields-view').classList.toggle('hidden');
      document.getElementById('dpp-fields-edit').classList.toggle('hidden');
    }

    async function saveVariantDppValues() {
      const values = {};
      document.querySelectorAll('[id^="field-"]').forEach(el => { values[el.id.substring(6)] = el.value; });
      try {
        const res = await fetch('/admin-v2/variant/<%= variant.id %>/dpp-values' + localeQuery, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(values)
        });
        if (res.ok) { await dppAlert('DPP values saved'); location.reload(); }
        else { await dppAlert('Error saving DPP values'); }
      } catch (err) { await dppAlert('Error: ' + err.message); }
    }

    async function clearOverride(fieldKey) {
      if (!(await dppConfirm('Clear this override? The field will go back to its inherited value.'))) return;
      try {
        const res = await fetch('/api/admin/overrides/variant/<%= variant.id %>/field/' + encodeURIComponent(fieldKey) + localeQuery, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({})
        });
        if (res.ok) { location.reload(); }
        else { await dppAlert('Error clearing override'); }
      } catch (err) { await dppAlert('Error: ' + err.message); }
    }
  </script>
</body>
</html>
