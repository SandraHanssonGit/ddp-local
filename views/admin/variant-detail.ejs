<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= style.product_name %> - <%= variant.variant_name %> - Variant Detail</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
  <div class="min-h-screen">
    <!-- Header -->
    <div class="bg-white shadow-md p-6 flex justify-between items-center">
      <div>
        <h1 class="text-3xl font-bold text-gray-900"><%= style.product_name %></h1>
        <p class="text-gray-600 mt-2">Variant <strong><%= variant.variant_name %></strong></p>
      </div>
      <a href="/admin-v2/style/<%= style.id %>" class="text-blue-600 hover:underline font-semibold">
        ← Back to Style
      </a>
    </div>

    <div class="max-w-7xl mx-auto p-6">
      <div class="grid grid-cols-3 gap-6">
        <!-- Main Content (2/3) -->
        <div class="col-span-2 space-y-6">

          <!-- Variant Info Card -->
          <div class="bg-white rounded-lg shadow-md p-8">
            <div class="flex justify-between items-center mb-6">
              <h2 class="text-2xl font-bold text-gray-900">Variant Information</h2>
              <button onclick="toggleEdit('variant-info')" class="bg-gray-900 text-white px-4 py-2 rounded hover:bg-gray-800 font-semibold">
                Edit
              </button>
            </div>

            <!-- View Mode -->
            <div id="variant-info-view" class="space-y-4">
              <div class="grid grid-cols-2 gap-6">
                <div>
                  <label class="text-xs text-gray-500 uppercase tracking-wide font-semibold">Style</label>
                  <p class="text-gray-900 text-lg"><%= style.style_number %> - <%= style.product_name %></p>
                </div>
                <div>
                  <label class="text-xs text-gray-500 uppercase tracking-wide font-semibold">Variant Code</label>
                  <p class="text-gray-900 text-lg font-mono text-xl"><strong><%= variant.variant_name %></strong></p>
                </div>
                <div>
                  <label class="text-xs text-gray-500 uppercase tracking-wide font-semibold">Product Name (this variant)</label>
                  <p class="text-gray-900 text-lg">
                    <%= variant.product_name || style.product_name %>
                    <% if (!variant.product_name) { %><span class="text-xs text-gray-400">(from Style)</span><% } %>
                  </p>
                </div>
                <div>
                  <label class="text-xs text-gray-500 uppercase tracking-wide font-semibold">Product Type</label>
                  <p class="text-gray-900 text-lg"><%= style.product_type %></p>
                </div>
                <div>
                  <label class="text-xs text-gray-500 uppercase tracking-wide font-semibold">Created</label>
                  <p class="text-gray-900 text-lg"><%= new Date(variant.created_at).toLocaleDateString('en-US') %></p>
                </div>
              </div>
            </div>
          </div>

          <!-- Image Management Card -->
          <div class="bg-white rounded-lg shadow-md p-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Variant Image</h2>

            <% if (variant.image_url) { %>
              <div class="mb-6">
                <p class="text-sm text-gray-600 mb-2">Current image (this variant):</p>
                <img src="<%= variant.image_url %>" alt="" class="w-64 h-64 object-cover rounded border border-gray-200">
                <button onclick="deleteVariantImage()" class="mt-3 text-red-600 hover:text-red-800 text-sm font-semibold">
                  Delete Image (revert to Style's)
                </button>
              </div>
            <% } else if (style.image_url) { %>
              <div class="mb-6">
                <p class="text-sm text-gray-600 mb-2">Using Style's image (no variant-specific image set):</p>
                <img src="<%= style.image_url %>" alt="" class="w-64 h-64 object-cover rounded border border-gray-200 opacity-75">
              </div>
            <% } else { %>
              <div class="mb-6 p-6 bg-gray-50 rounded border-2 border-dashed border-gray-300 text-center">
                <p class="text-gray-500">No image uploaded yet</p>
              </div>
            <% } %>

            <div class="border-t pt-6">
              <label class="block text-sm font-bold text-gray-700 mb-3">Upload New Image for this Variant</label>
              <input type="file" id="variant-image-upload" accept="image/*" class="w-full border border-gray-300 rounded px-4 py-3 focus:outline-none focus:border-gray-900 mb-3">
              <button type="button" onclick="uploadVariantImage()" class="bg-gray-900 text-white px-6 py-3 rounded hover:bg-gray-800 font-semibold">
                Upload Image
              </button>
            </div>

            <!-- Edit Mode -->
            <form id="variant-info-edit" class="hidden space-y-6" onsubmit="saveVariantInfo(event)">
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Variant Code/Name</label>
                <input type="text" id="edit-variant-name" value="<%= variant.variant_name %>" class="w-full border border-gray-300 rounded px-4 py-3 focus:outline-none focus:border-gray-900" required>
              </div>
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Product Name for this variant</label>
                <input type="text" id="edit-product-name" value="<%= variant.product_name || '' %>" placeholder="Leave blank to use the Style's name (<%= style.product_name %>)" class="w-full border border-gray-300 rounded px-4 py-3 focus:outline-none focus:border-gray-900">
              </div>
              <p class="text-xs text-gray-500">Image is managed separately below, in the Variant Image card.</p>
              <div class="flex gap-3">
                <button type="submit" class="bg-gray-900 text-white px-6 py-3 rounded hover:bg-gray-800 font-semibold">
                  Save Changes
                </button>
                <button type="button" onclick="toggleEdit('variant-info')" class="bg-gray-300 text-gray-900 px-6 py-3 rounded hover:bg-gray-400 font-semibold">
                  Cancel
                </button>
              </div>
            </form>
          </div>

          <!-- DPP Fields Card -->
          <div class="bg-white rounded-lg shadow-md p-8">
            <div class="flex justify-between items-center mb-6">
              <h2 class="text-2xl font-bold text-gray-900">DPP Field Values</h2>
              <button onclick="toggleDppEdit()" class="bg-gray-900 text-white px-4 py-2 rounded hover:bg-gray-800 font-semibold">
                Edit
              </button>
            </div>

            <div class="flex items-center gap-2 mb-4" style="flex-wrap:wrap;">
              <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide mr-1">Language:</span>
              <a href="?" class="px-3 py-1 rounded text-xs font-semibold <%= !locale ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700' %>">Default</a>
              <% (typeof availableLocales !== 'undefined' ? availableLocales : []).forEach(loc => { %>
                <a href="?lang=<%= encodeURIComponent(loc) %>" class="px-3 py-1 rounded text-xs font-semibold <%= locale === loc ? 'bg-gray-900 text-white' : 'bg-gray-100 text-gray-700' %>"><%= loc %></a>
              <% }); %>
              <form method="GET" style="display:inline-flex;align-items:center;gap:4px;margin-left:8px;" onsubmit="event.preventDefault(); const v=this.newlang.value.trim(); if(v) window.location.href='?lang='+encodeURIComponent(v);">
                <input type="text" name="newlang" placeholder="+ add locale e.g. fr-FR" class="text-xs border border-gray-300 rounded px-2 py-1" style="width:160px;">
                <button type="submit" class="text-xs font-semibold text-blue-600">Go</button>
              </form>
            </div>

            <div id="dpp-fields-view" class="space-y-4">
              <% (typeof dppValues !== 'undefined' ? dppValues : []).forEach(val => { %>
                <% if (val.value) { %>
                  <div class="p-4 rounded border" style="background-color: #eaf1f8; border-color: #b9cfe6;">
                    <div class="flex justify-between items-start mb-2">
                      <label class="text-sm font-bold text-gray-700"><%= val.label %></label>
                      <span class="text-xs font-semibold px-2 py-1 rounded" style="color: #2c5aa0; background-color: #b3d9e8;">Overridden here</span>
                    </div>
                    <p class="text-gray-900 mt-1"><%= val.value %></p>
                    <% if (val.inheritedValue) { %>
                      <p class="text-xs text-gray-500 mt-2">Inherited from <%= val.inheritedFrom %>: <span class="font-mono"><%= val.inheritedValue %></span></p>
                    <% } %>
                    <a href="#" onclick="clearOverride('<%= val.field_key %>'); return false;" class="text-xs font-semibold text-red-600 hover:underline mt-2 inline-block">Clear override → inherit</a>
                  </div>
                <% } else if (val.inheritedValue) { %>
                  <div class="p-4 rounded border border-gray-200 bg-gray-50">
                    <div class="flex justify-between items-start mb-2">
                      <label class="text-sm font-bold text-gray-700"><%= val.label %></label>
                      <span class="text-xs font-semibold px-2 py-1 rounded bg-gray-200 text-gray-600">Inherited from <%= val.inheritedFrom %></span>
                    </div>
                    <p class="text-gray-600 mt-1"><%= val.inheritedValue %></p>
                  </div>
                <% } else { %>
                  <div class="p-4 rounded border border-amber-200 bg-amber-50">
                    <div class="flex justify-between items-start mb-2">
                      <label class="text-sm font-bold text-gray-700"><%= val.label %></label>
                      <span class="text-xs font-semibold px-2 py-1 rounded bg-amber-100 text-amber-800">Not set yet</span>
                    </div>
                    <p class="text-sm text-amber-800 mt-1">No value at Style level either — this can be filled in here.</p>
                  </div>
                <% } %>
              <% }); %>
              <% if (typeof dppValues === 'undefined' || dppValues.length === 0) { %>
                <p class="text-gray-500 italic">No fields are configured to be editable at the Variant level.</p>
              <% } %>
            </div>

            <div id="dpp-fields-edit" class="hidden space-y-6">
              <% if (typeof dppValues !== 'undefined' && dppValues.length > 0) { %>
                <% dppValues.forEach(val => { %>
                  <div class="space-y-2">
                    <label class="block text-sm font-bold text-gray-700"><%= val.label %></label>
                    <% if (val.inheritedValue) { %>
                      <p class="text-xs text-gray-500">Inherited from <%= val.inheritedFrom %>: <span class="font-mono"><%= val.inheritedValue %></span> — leave blank to keep inheriting</p>
                    <% } %>
                    <textarea id="field-<%= val.field_key %>" class="w-full border border-gray-300 rounded px-4 py-3 focus:outline-none focus:border-gray-900" rows="3"><%= val.value %></textarea>
                  </div>
                <% }); %>
              <% } else { %>
                <p class="text-gray-500 italic">No fields are configured to be editable at the Variant level.</p>
              <% } %>
              <div class="flex gap-3">
                <button type="button" onclick="saveVariantDppValues()" class="bg-gray-900 text-white px-6 py-3 rounded hover:bg-gray-800 font-semibold">
                  Save Changes
                </button>
                <button type="button" onclick="toggleDppEdit()" class="bg-gray-300 text-gray-900 px-6 py-3 rounded hover:bg-gray-400 font-semibold">
                  Cancel
                </button>
              </div>
            </div>
          </div>

          <!-- GTINs Card -->
          <div class="bg-white rounded-lg shadow-md p-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">GTINs for <%= variant.variant_name %></h2>

            <% if (gtins && gtins.length > 0) { %>
              <div class="overflow-x-auto">
                <table class="w-full border-collapse text-sm">
                  <thead>
                    <tr class="bg-gray-100 border-b border-gray-300">
                      <th class="px-4 py-3 text-left font-semibold">GTIN</th>
                      <th class="px-4 py-3 text-left font-semibold">Item #</th>
                      <th class="px-4 py-3 text-left font-semibold">Size</th>
                      <th class="px-4 py-3 text-center font-semibold">SGTINs</th>
                      <th class="px-4 py-3 text-left font-semibold">Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% gtins.forEach(g => {
                      let sizeDisplay = '';
                      if (g.size_value_1) sizeDisplay += g.size_value_1;
                      if (g.size_value_2) sizeDisplay += '-' + g.size_value_2;
                      if (g.size_value_3) sizeDisplay += '-' + g.size_value_3;
                    %>
                      <tr class="border-b border-gray-200 hover:bg-gray-50">
                        <td class="px-4 py-3 font-mono"><strong><%= g.gtin %></strong></td>
                        <td class="px-4 py-3 text-sm"><%= g.item_number || '—' %></td>
                        <td class="px-4 py-3 text-sm"><%= sizeDisplay || '—' %></td>
                        <td class="px-4 py-3 text-center"><span class="bg-green-100 text-green-900 px-2 py-1 rounded text-xs"><%= g.sgtin_count || 0 %></span></td>
                        <td class="px-4 py-3"><a href="/admin-v2/gtin/<%= g.id %>" class="text-blue-600 hover:underline">→</a></td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="text-center py-12 text-gray-500">No GTINs for this variant</div>
            <% } %>
          </div>

        </div>

        <!-- Sidebar (1/3) -->
        <div class="space-y-6">

          <!-- Statistics Card -->
          <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-lg font-bold text-gray-900 mb-4">Statistics</h3>
            <div class="space-y-3 text-sm">
              <div class="flex justify-between">
                <span class="text-gray-600">Style:</span>
                <span class="font-semibold"><%= style.style_number %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-600">Variant:</span>
                <span class="font-semibold font-mono"><%= variant.variant_name %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-600">GTINs:</span>
                <span class="font-semibold"><%= gtinCount %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-600">SGTINs:</span>
                <span class="font-semibold"><%= sgtinCount %></span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <script>
    function toggleEdit(section) {
      const view = document.getElementById(section + '-view');
      const edit = document.getElementById(section + '-edit');

      if (view && edit) {
        view.classList.toggle('hidden');
        edit.classList.toggle('hidden');
      }
    }

    async function saveVariantInfo(e) {
      e.preventDefault();

      const data = {
        variant_name: document.getElementById('edit-variant-name').value,
        product_name: document.getElementById('edit-product-name').value
      };

      try {
        const res = await fetch('/admin-v2/variant/<%= variant.id %>', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (res.ok) {
          alert('Variant updated successfully');
          location.reload();
        } else {
          alert('Error updating variant');
        }
      } catch (err) {
        alert('Error: ' + err.message);
      }
    }

    async function uploadVariantImage() {
      const fileInput = document.getElementById('variant-image-upload');
      if (!fileInput.files[0]) { alert('Please select an image'); return; }

      const formData = new FormData();
      formData.append('image', fileInput.files[0]);

      try {
        const res = await fetch('/admin-v2/variant/<%= variant.id %>/image', {
          method: 'POST',
          body: formData
        });
        if (res.ok) { alert('Image uploaded successfully'); location.reload(); }
        else { alert('Error uploading image'); }
      } catch (err) {
        alert('Error: ' + err.message);
      }
    }

    async function deleteVariantImage() {
      if (!confirm('Delete this image? The variant will revert to using the Style\'s image.')) return;

      try {
        const res = await fetch('/admin-v2/variant/<%= variant.id %>/image', { method: 'DELETE' });
        if (res.ok) { alert('Image deleted'); location.reload(); }
        else { alert('Error deleting image'); }
      } catch (err) {
        alert('Error: ' + err.message);
      }
    }

    const currentLocale = <%- JSON.stringify(locale || null) %>;
    const localeQuery = currentLocale ? '?lang=' + encodeURIComponent(currentLocale) : '';

    function toggleDppEdit() {
      document.getElementById('dpp-fields-view').classList.toggle('hidden');
      document.getElementById('dpp-fields-edit').classList.toggle('hidden');
    }

    async function saveVariantDppValues() {
      const values = {};
      document.querySelectorAll('[id^="field-"]').forEach(el => { values[el.id.substring(6)] = el.value; });
      try {
        const res = await fetch('/admin-v2/variant/<%= variant.id %>/dpp-values' + localeQuery, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(values)
        });
        if (res.ok) { alert('DPP values saved'); location.reload(); }
        else { alert('Error saving DPP values'); }
      } catch (err) { alert('Error: ' + err.message); }
    }

    async function clearOverride(fieldKey) {
      if (!confirm('Clear this override? The field will go back to its inherited value.')) return;
      try {
        const res = await fetch('/api/admin/overrides/variant/<%= variant.id %>/field/' + encodeURIComponent(fieldKey) + localeQuery, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({})
        });
        if (res.ok) { location.reload(); }
        else { alert('Error clearing override'); }
      } catch (err) { alert('Error: ' + err.message); }
    }
  </script>
</body>
</html>
