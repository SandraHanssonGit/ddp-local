<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= toGtin14(gtin.gtin) %> - GTIN</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
  <script src="/js/admin-modal.js"></script>
</head>
<body>
  <div class="wrap">
    <div class="detail-header">
      <div>
        <h1 class="mono"><%= toGtin14(gtin.gtin) %></h1>
        <p class="subtitle">SKU <strong><%= gtin.item_number || '—' %></strong></p>
      </div>
      <a href="/admin-v2?tab=products" class="back-link"><%- icon('arrow-left') %> Back to Products</a>
    </div>

    <div class="info-grid" style="margin-bottom:20px;">
      <div class="card card-identifiers">
        <h3 style="margin-bottom:14px;">GTIN Info</h3>
        <p style="margin-bottom:6px;"><span class="label-sm">EAN (as printed on barcode):</span> <span class="mono"><%= gtin.gtin %></span></p>
        <p style="margin-bottom:6px;"><span class="label-sm">GTIN (GS1, 14-digit):</span> <span class="mono"><%= toGtin14(gtin.gtin) %></span></p>
        <p style="margin-bottom:6px;"><span class="label-sm">SKU / Item #:</span> <%= gtin.item_number || '—' %></p>
        <p style="margin-bottom:6px;"><span class="label-sm">Product:</span> <%= style.style_number %></p>
        <p><span class="label-sm">Variant:</span> <%= variant ? variant.variant_name : '—' %></p>
      </div>
      <div class="card">
        <div class="stat-label">SGTINs Produced</div>
        <div class="stat-value" style="color:var(--success);"><%= sgtins.length %></div>
        <div class="stat-list" style="margin-top:16px;">
          <div class="stat-row"><span class="k">Batches:</span><span class="v"><%= batchCount %></span></div>
          <div class="stat-row"><span class="k">Last Produced:</span><span class="v"><%= lastProducedDate ? new Date(lastProducedDate).toLocaleDateString('sv-SE') : '—' %></span></div>
        </div>
      </div>
    </div>

    <div class="card card-passport">
      <div class="card-eyebrow"><%- icon('qr-code', { size: 12 }) %> Shown on the public passport</div>
      <div class="card-head">
        <h2>Field Values</h2>
        <button onclick="toggleDppEdit()" class="btn btn-primary">Edit</button>
      </div>

      <div class="locale-tabs">
        <span class="label-sm" style="margin-right:4px;">Language:</span>
        <a href="?" class="<%= !locale ? 'active' : '' %>">Default</a>
        <% (typeof availableLocales !== 'undefined' ? availableLocales : []).forEach(loc => { %>
          <a href="?lang=<%= encodeURIComponent(loc) %>" class="<%= locale === loc ? 'active' : '' %>"><%= loc %></a>
        <% }); %>
        <form method="GET" style="display:inline-flex;align-items:center;gap:6px;margin-left:8px;" onsubmit="event.preventDefault(); const v=this.newlang.value.trim(); if(v) window.location.href='?lang='+encodeURIComponent(v);">
          <input type="text" name="newlang" placeholder="+ add locale e.g. fr-FR" class="small" style="width:160px;">
          <button type="submit" class="btn small">Go</button>
        </form>
      </div>

      <div id="dpp-fields-view">
        <%
          const allDppValues = typeof dppValues !== 'undefined' ? dppValues : [];
          const fieldGroups = [
            { label: 'EU Required', items: allDppValues.filter(v => v.category === 'eu_required') },
            { label: 'Nudie', items: allDppValues.filter(v => v.category === 'nudie') }
          ];
        %>
        <% fieldGroups.forEach(group => { %>
          <% if (group.items.length === 0) return; %>
          <div class="field-category-heading"><%= group.label %></div>
          <% group.items.forEach(val => { %>
            <% if (val.value) { %>
              <div class="field-card overridden">
                <div class="field-card-head">
                  <label class="label-sm"><%= val.label %></label>
                  <span class="badge badge-accent">Overridden here</span>
                </div>
                <p class="field-card-value"><%= val.value %></p>
                <% if (val.inheritedValue) { %>
                  <p class="field-card-note">Inherited from <%= val.inheritedFrom %>: <span class="mono"><%= val.inheritedValue %></span></p>
                <% } %>
                <p style="margin-top:8px;"><a href="#" onclick="clearOverride('<%= val.field_key %>'); return false;" class="link-action danger">Clear override <span style="display:inline-flex;vertical-align:middle;"><%- icon('arrow-right', { size: 13 }) %></span> inherit</a></p>
              </div>
            <% } else if (val.inheritedValue) { %>
              <div class="field-card inherited">
                <div class="field-card-head">
                  <label class="label-sm"><%= val.label %></label>
                  <span class="badge badge-muted">Inherited from <%= val.inheritedFrom %></span>
                </div>
                <p class="field-card-value muted"><%= val.inheritedValue %></p>
              </div>
            <% } else { %>
              <div class="field-card notset">
                <div class="field-card-head">
                  <label class="label-sm"><%= val.label %></label>
                  <span class="badge" style="background:var(--lock-border); color:var(--lock-text);">Not set anywhere</span>
                </div>
                <% if (val.editable === false) { %>
                  <p class="field-card-note">Not editable at GTIN level (see Field Config &rsaquo; Levels).</p>
                <% } else { %>
                  <p class="field-card-note">No value at Variant/Style level either — this can be filled in here.</p>
                <% } %>
              </div>
            <% } %>
          <% }); %>
        <% }); %>
        <% if (allDppValues.length === 0) { %>
          <p class="muted" style="font-style:italic;">No fields are configured to be editable at the GTIN level.</p>
        <% } %>
      </div>

      <div id="dpp-fields-edit" class="hidden">
        <% if (typeof dppValues !== 'undefined' && dppValues.length > 0) { %>
          <% dppValues.forEach(val => { %>
            <% if (val.editable === false) { %>
              <div class="field-row">
                <label style="display:block; margin-bottom:6px;"><%= val.label %></label>
                <p class="small muted" style="display:flex; align-items:center; gap:4px;">
                  <%- icon('lock', { size: 12 }) %> Not editable at this level - <%= (val.value || val.inheritedValue) ? ('current value: ' + (val.value || val.inheritedValue)) : 'no value set' %>
                </p>
              </div>
            <% } else { %>
              <div class="field-row">
                <label style="display:block; margin-bottom:6px;"><%= val.label %></label>
                <% if (val.inheritedValue) { %>
                  <p class="small muted" style="margin-bottom:6px;">Inherited from <%= val.inheritedFrom %>: <span class="mono"><%= val.inheritedValue %></span> — leave blank to keep inheriting</p>
                <% } %>
                <textarea id="field-<%= val.field_key %>" rows="3"><%= val.value %></textarea>
              </div>
            <% } %>
          <% }); %>
        <% } else { %>
          <p class="muted" style="font-style:italic;">No fields are configured to be editable at the GTIN level.</p>
        <% } %>
        <div style="display:flex; gap:10px;">
          <button type="button" onclick="saveGtinDppValues()" class="btn btn-primary">Save Changes</button>
          <button type="button" onclick="toggleDppEdit()" class="btn">Cancel</button>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-head">
        <h2>Individual Garments</h2>
        <% if (sgtins.length > 5) { %>
          <input type="text" id="sgtin-search" placeholder="Search serial…" class="small" style="width:200px;" oninput="filterSgtins(this.value)">
        <% } %>
      </div>
      <% if (sgtins.length > 0) { %>
        <div class="table-wrap <%= sgtins.length > 5 ? 'table-wrap-scroll' : '' %>">
          <table>
            <thead>
              <tr>
                <th>Serial</th>
                <th>Batch</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="sgtin-table-body">
              <% sgtins.forEach(sg => { %>
                <tr data-serial="<%= sg.serial_number.toLowerCase() %>">
                  <td class="mono"><%= sg.serial_number %></td>
                  <td class="mono small"><%= sg.batch_id %></td>
                  <td><a href="/admin-v2/sgtin/<%= sg.id %>" class="link-action"><%- icon('arrow-right') %></a></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <p id="sgtin-no-match" class="empty-state hidden">No garments match "<span id="sgtin-no-match-term"></span>"</p>
      <% } else { %>
        <div class="empty-state">No SGTINs produced yet</div>
      <% } %>
    </div>
  </div>

  <script>
    function filterSgtins(term) {
      const needle = term.trim().toLowerCase();
      const rows = document.querySelectorAll('#sgtin-table-body tr');
      let visibleCount = 0;
      rows.forEach(row => {
        const match = !needle || row.dataset.serial.includes(needle);
        row.classList.toggle('hidden', !match);
        if (match) visibleCount++;
      });
      document.getElementById('sgtin-no-match-term').textContent = term;
      document.getElementById('sgtin-no-match').classList.toggle('hidden', visibleCount > 0 || !needle);
    }

    function toggleDppEdit() {
      document.getElementById('dpp-fields-view').classList.toggle('hidden');
      document.getElementById('dpp-fields-edit').classList.toggle('hidden');
    }
    const currentLocale = <%- JSON.stringify(locale || null) %>;
    const localeQuery = currentLocale ? '?lang=' + encodeURIComponent(currentLocale) : '';

    async function saveGtinDppValues() {
      const values = {};
      document.querySelectorAll('[id^="field-"]').forEach(el => { values[el.id.substring(6)] = el.value; });
      try {
        const res = await fetch('/admin-v2/gtin/<%= gtin.id %>/dpp-values' + localeQuery, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(values)
        });
        if (res.ok) { await dppAlert('DPP values saved'); location.reload(); }
        else { await dppAlert('Error saving DPP values'); }
      } catch (err) { await dppAlert('Error: ' + err.message); }
    }
    async function clearOverride(fieldKey) {
      if (!(await dppConfirm('Clear this override? The field will go back to its inherited value.'))) return;
      try {
        const res = await fetch('/api/admin/overrides/gtin/<%= gtin.id %>/field/' + encodeURIComponent(fieldKey) + localeQuery, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({})
        });
        if (res.ok) { location.reload(); }
        else { await dppAlert('Error clearing override'); }
      } catch (err) { await dppAlert('Error: ' + err.message); }
    }
  </script>
</body>
</html>
