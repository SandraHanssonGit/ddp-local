<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GTIN <%= gtin.gtin %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
  <div class="max-w-7xl mx-auto py-12 px-4">
    <!-- Header -->
    <div class="flex justify-between items-center mb-8">
      <div>
        <h1 class="text-4xl font-bold text-gray-900"><%= gtin.gtin %></h1>
        <p class="text-gray-600 mt-2"><%= style.product_name %> - <%= gtin.size %> <%= gtin.color %></p>
      </div>
      <a href="/admin-v2" class="bg-gray-900 text-white px-4 py-2 rounded hover:bg-gray-800">
        ← Back to Hub
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Main Content -->
      <div class="lg:col-span-2 space-y-8">

        <!-- GTIN Information Card -->
        <div class="bg-white rounded-lg shadow-md p-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">GTIN Details</h2>
          <div class="space-y-4">
            <div class="grid grid-cols-2 gap-6">
              <div>
                <label class="text-xs text-gray-500 uppercase tracking-wide font-semibold">GTIN</label>
                <p class="text-gray-900 font-mono text-lg"><%= gtin.gtin %></p>
              </div>
              <div>
                <label class="text-xs text-gray-500 uppercase tracking-wide font-semibold">EAN</label>
                <p class="text-gray-900 text-lg"><%= gtin.ean || '-' %></p>
              </div>
              <div>
                <label class="text-xs text-gray-500 uppercase tracking-wide font-semibold">Style</label>
                <p class="text-gray-900 text-lg"><%= style.style_number %> - <%= style.product_name %></p>
              </div>
              <div>
                <label class="text-xs text-gray-500 uppercase tracking-wide font-semibold">Batch</label>
                <p class="text-gray-900 text-lg"><%= batch.batch_id %></p>
              </div>
              <div>
                <label class="text-xs text-gray-500 uppercase tracking-wide font-semibold">Size</label>
                <p class="text-gray-900 text-lg"><%= gtin.size %></p>
              </div>
              <div>
                <label class="text-xs text-gray-500 uppercase tracking-wide font-semibold">Color</label>
                <p class="text-gray-900 text-lg"><%= gtin.color %></p>
              </div>
            </div>
          </div>
        </div>

        <!-- GTIN DPP Fields -->
        <div class="bg-white rounded-lg shadow-md p-8">
          <div class="flex justify-between items-center mb-6">
            <h2 class="text-2xl font-bold text-gray-900">GTIN Overrides</h2>
            <button onclick="toggleEdit('gtin-dpp')" class="bg-gray-900 text-white px-4 py-2 rounded hover:bg-gray-800 font-semibold">
              Edit
            </button>
          </div>

          <div class="bg-purple-50 border-l-4 border-purple-300 p-4 rounded mb-6">
            <p class="text-sm text-purple-800">
              <strong>Inheritance:</strong> Fields defined here override Style and Batch values. Leave blank to inherit from parent.
            </p>
          </div>

          <!-- View Mode -->
          <div id="gtin-dpp-view" class="space-y-4">
            <% if (gtinValues && gtinValues.length > 0) { %>
              <% gtinValues.forEach(val => { %>
                <div class="p-4 bg-blue-50 border-l-4 border-blue-300 rounded">
                  <label class="text-sm font-bold text-gray-700"><%= val.label %></label>
                  <p class="text-gray-900 mt-1"><%= val.value %></p>
                  <span class="text-xs font-semibold text-blue-600 mt-1 inline-block px-2 py-1 bg-blue-100 rounded">
                    Defined at GTIN level
                  </span>
                </div>
              <% }); %>
            <% } else { %>
              <p class="text-gray-500">No GTIN-level overrides (inheriting from Style and Batch)</p>
            <% } %>
          </div>

          <!-- Edit Mode -->
          <div id="gtin-dpp-edit" class="hidden space-y-6">
            <% allFields.forEach(field => { %>
              <div class="space-y-2">
                <label class="block text-sm font-bold text-gray-700">
                  <%= field.label %>
                  <span class="text-xs font-semibold text-gray-500 ml-2 px-2 py-1 bg-gray-100 rounded">
                    <%= field.category === 'eu_required' ? 'EU' : 'Nudie' %>
                  </span>
                </label>
                <% let currentValue = gtinValues.find(v => v.field_key === field.field_key)?.value || ''; %>
                <textarea id="field-<%= field.field_key %>" class="w-full border border-gray-300 rounded px-4 py-3 focus:outline-none focus:border-gray-900" rows="2" placeholder="Leave blank to inherit from Style/Batch"><%= currentValue %></textarea>
              </div>
            <% }); %>
            <div class="flex gap-3">
              <button type="button" onclick="saveGtinValues()" class="bg-gray-900 text-white px-6 py-3 rounded hover:bg-gray-800 font-semibold">
                Save GTIN Overrides
              </button>
              <button type="button" onclick="toggleEdit('gtin-dpp')" class="bg-gray-300 text-gray-900 px-6 py-3 rounded hover:bg-gray-400 font-semibold">
                Cancel
              </button>
            </div>
          </div>
        </div>

      </div>

      <!-- Sidebar -->
      <div class="space-y-6">
        <!-- SGTINs List -->
        <div class="bg-white rounded-lg shadow-md p-6">
          <h3 class="text-lg font-bold text-gray-900 mb-4">Individual Garments (SGTINs)</h3>
          <% if (sgtins && sgtins.length > 0) { %>
            <div class="space-y-2">
              <% sgtins.forEach(sgtin => { %>
                <a href="/admin-v2/sgtins/<%= sgtin.id %>" class="block p-3 bg-gray-50 hover:bg-blue-50 rounded border border-gray-200 hover:border-blue-300 transition">
                  <p class="font-mono font-semibold text-gray-900"><%= sgtin.serial_number %></p>
                  <p class="text-xs text-gray-600">QC: <%= sgtin.qc_status %></p>
                </a>
              <% }); %>
            </div>
          <% } else { %>
            <p class="text-gray-500 text-sm">No SGTINs for this GTIN</p>
          <% } %>
        </div>

        <!-- Hierarchy Info -->
        <div class="bg-white rounded-lg shadow-md p-6">
          <h3 class="text-lg font-bold text-gray-900 mb-4">Hierarchy</h3>
          <div class="space-y-3 text-sm">
            <div class="p-3 rounded" style="background-color: #e8f4f8; border: 1px solid #b3d9e8;">
              <p class="text-xs font-semibold mb-1" style="color: #2c5aa0;">STYLE</p>
              <p class="text-gray-900 font-semibold"><%= style.style_number %></p>
              <p class="text-gray-600"><%= style.product_name %></p>
            </div>
            <div class="p-3 rounded" style="background-color: #d1e3f0; border: 1px solid #5b9dc3;">
              <p class="text-xs font-semibold mb-1" style="color: #2c5aa0;">BATCH</p>
              <p class="text-gray-900 font-semibold"><%= batch.batch_id %></p>
              <p class="text-gray-600"><%= batch.country_of_production %></p>
            </div>
            <div class="p-3 rounded" style="background-color: #b3d9e8; border-left: 4px solid #5b9dc3;">
              <p class="text-xs font-semibold mb-1" style="color: #2c5aa0;">GTIN (You are here)</p>
              <p class="text-gray-900 font-semibold"><%= gtin.gtin %></p>
              <p class="text-gray-600"><%= gtin.size %> / <%= gtin.color %></p>
            </div>
          </div>
        </div>

        <!-- Inheritance Info -->
        <div class="bg-white rounded-lg shadow-md p-6">
          <h3 class="text-lg font-bold text-gray-900 mb-4">Value Resolution</h3>
          <p class="text-sm text-gray-600 mb-3">
            GTIN values override Batch and Style. Undefined fields inherit from parent levels.
          </p>
          <div class="text-xs text-gray-500 space-y-1">
            <p>1. GTIN value (if set)</p>
            <p>2. Batch value (if set)</p>
            <p>3. Style value (default)</p>
          </div>
        </div>
      </div>

    </div>
  </div>

  <script>
    const gtinId = '<%= gtin.id %>';

    function toggleEdit(section) {
      const view = document.getElementById(`${section}-view`);
      const edit = document.getElementById(`${section}-edit`);
      view.classList.toggle('hidden');
      edit.classList.toggle('hidden');
    }

    async function saveGtinValues() {
      const values = {};
      <% allFields.forEach(field => { %>
        const val = document.getElementById('field-<%= field.field_key %>').value;
        if (val.trim()) {
          values['<%= field.field_key %>'] = val.trim();
        }
      <% }); %>

      try {
        const response = await fetch(`/admin-v2/gtins/${gtinId}/dpp-values`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(values)
        });
        if (response.ok) {
          alert('GTIN values saved!');
          location.reload();
        } else {
          alert('Error saving values');
        }
      } catch (err) {
        alert('Error: ' + err.message);
      }
    }
  </script>
</body>
</html>
