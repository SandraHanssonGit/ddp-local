<!DOCTYPE html>
<html><head><meta charset="UTF-8"><title><%= gtin.gtin %> - GTIN</title><script src="https://cdn.tailwindcss.com"></script></head><body class="bg-gray-100"><div class="max-w-7xl mx-auto py-12 px-4"><div class="flex justify-between items-center mb-8"><h1 class="text-4xl font-bold font-mono"><%= gtin.gtin %></h1><a href="/admin-v2?tab=gtins" class="text-blue-600">← Back</a></div><div class="grid grid-cols-2 gap-8 mb-8"><div class="bg-white rounded-lg shadow p-6"><h3 class="font-bold mb-4">GTIN Info</h3><p><strong>Style:</strong> <%= style.style_number %></p><p><strong>Variant:</strong> <%= variant ? variant.variant_name : '—' %></p><p><strong>Item:</strong> <%= gtin.item_number || '—' %></p></div><div class="bg-white rounded-lg shadow p-6"><div class="text-gray-600 text-sm">SGTINs Produced</div><div class="text-3xl font-bold text-green-600"><%= sgtins.length %></div></div></div><div class="bg-white rounded-lg shadow-md p-8"><h2 class="text-2xl font-bold mb-6">Individual Garments</h2><% if (sgtins.length > 0) { %><table class="w-full text-sm"><thead><tr class="bg-gray-100"><th class="px-4 py-3 text-left">Serial</th><th class="px-4 py-3 text-left">Batch</th><th class="px-4 py-3">Action</th></tr></thead><tbody><% sgtins.forEach(sg => { %><tr class="border-b hover:bg-gray-50"><td class="px-4 py-3 font-mono"><%= sg.serial_number %></td><td class="px-4 py-3 font-mono text-xs"><%= sg.batch_id %></td><td class="px-4 py-3"><a href="/admin-v2/sgtin/<%= sg.id %>" class="text-blue-600">→</a></td></tr><% }); %></tbody></table><% } %></div></div></body></html>
