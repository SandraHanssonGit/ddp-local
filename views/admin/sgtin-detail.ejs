<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= sgtin.serial_number %> - SGTIN Detail</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
  <div class="max-w-7xl mx-auto py-12 px-4">
    <!-- Header -->
    <div class="flex justify-between items-center mb-8">
      <div>
        <h1 class="text-4xl font-bold text-gray-900">SGTIN: <%= sgtin.serial_number %></h1>
        <p class="text-gray-600 mt-2"><%= style.product_name %> (Style <%= style.style_number %>)</p>
      </div>
      <div class="space-y-2">
        <a href="/admin-v2?tab=sgtins" class="block bg-gray-900 text-white px-4 py-2 rounded hover:bg-gray-800 text-center">
          ← Back to SGTINs
        </a>
        <a href="/dpp/<%= batch.batch_id %>/<%= gtin.gtin %>/<%= sgtin.serial_number %>" target="_blank" class="block bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 text-center">
          → Produktpass
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Main Content -->
      <div class="lg:col-span-2 space-y-8">

        <!-- Basic Info -->
        <div class="bg-white rounded-lg shadow-md p-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Basic Information</h2>
          <div class="grid grid-cols-2 gap-6">
            <div>
              <label class="text-xs text-gray-500 uppercase font-semibold">Serial Number</label>
              <p class="text-lg font-mono font-bold text-gray-900 mt-1"><%= sgtin.serial_number %></p>
            </div>
            <div>
              <label class="text-xs text-gray-500 uppercase font-semibold">SGTIN ID</label>
              <p class="text-lg font-mono text-gray-900 mt-1"><%= sgtin.sgtin || sgtin.id %></p>
            </div>
            <div>
              <label class="text-xs text-gray-500 uppercase font-semibold">GTIN</label>
              <p class="text-lg font-mono font-bold text-gray-900 mt-1"><%= gtin.gtin %></p>
            </div>
            <div>
              <label class="text-xs text-gray-500 uppercase font-semibold">Item Number</label>
              <p class="text-lg text-gray-900 mt-1"><%= gtin.item_number %></p>
            </div>
          </div>
        </div>

        <!-- Hierarchy Info -->
        <div class="bg-white rounded-lg shadow-md p-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Product Hierarchy</h2>
          <div class="space-y-4">
            <div>
              <label class="text-xs text-gray-500 uppercase font-semibold">Style</label>
              <p class="text-gray-900 mt-1">
                <strong><%= style.style_number %></strong> - <%= style.product_name %>
              </p>
            </div>
            <div>
              <label class="text-xs text-gray-500 uppercase font-semibold">Batch</label>
              <p class="text-gray-900 mt-1">
                <strong><%= batch.batch_id %></strong>
                <% if (batch.production_order) { %>
                  - Order: <%= batch.production_order %>
                <% } %>
              </p>
            </div>
            <% if (variant) { %>
              <div>
                <label class="text-xs text-gray-500 uppercase font-semibold">Variant</label>
                <p class="text-gray-900 mt-1"><%= variant.variant_name %></p>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Garment Information -->
        <div class="bg-white rounded-lg shadow-md p-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Garment Information</h2>
          <div class="grid grid-cols-1 gap-6">
            <div>
              <label class="text-xs text-gray-500 uppercase font-semibold">Created</label>
              <p class="text-gray-900 mt-2"><%= new Date(sgtin.created_at).toLocaleDateString('en-US') %></p>
            </div>
          </div>
        </div>

        <!-- Lifecycle Events -->
        <div class="bg-white rounded-lg shadow-md p-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Lifecycle Events</h2>

          <!-- Add Event Form -->
          <form id="addEventForm" class="mb-8 p-6 bg-gray-50 rounded-lg border-2 border-dashed border-gray-300">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Add New Event</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Event Type</label>
                <select id="eventType" name="eventType" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                  <option value="">-- Select Event Type --</option>
                  <option value="manufactured">Manufactured</option>
                  <option value="sold">Sold</option>
                  <option value="repaired">Repaired</option>
                  <option value="recycled">Recycled</option>
                  <option value="inspected">Inspected</option>
                  <option value="shipped">Shipped</option>
                  <option value="received">Received</option>
                  <option value="returned">Returned</option>
                  <option value="other">Other</option>
                </select>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Additional Data (JSON)</label>
                <input type="text" id="eventData" name="eventData" placeholder='{"location": "warehouse", "notes": "..."}' class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
              </div>
            </div>
            <button type="submit" class="mt-4 bg-green-600 text-white px-6 py-2 rounded-lg hover:bg-green-700 font-semibold">
              Add Event
            </button>
          </form>

          <!-- Events List -->
          <% if (typeof events !== 'undefined' && events.length > 0) { %>
            <div class="space-y-4">
              <% events.forEach(event => { %>
                <div class="border-l-4 border-blue-500 pl-4 py-3">
                  <p class="font-bold text-gray-900 uppercase text-sm"><%= event.event_type %></p>
                  <p class="text-sm text-gray-600 mt-1">
                    <%= new Date(event.created_at).toLocaleDateString('en-US') %>
                  </p>
                  <% if (event.event_data) { %>
                    <% try { %>
                      <% const data = JSON.parse(event.event_data); %>
                      <% if (Object.keys(data).length > 0) { %>
                        <div class="mt-2 text-sm space-y-1">
                          <% Object.entries(data).forEach(([key, value]) => { %>
                            <p class="text-gray-700"><strong><%= key %>:</strong> <%= JSON.stringify(value) %></p>
                          <% }); %>
                        </div>
                      <% } %>
                    <% } catch(e) { %>
                      <p class="text-sm text-gray-700 mt-2"><%= event.event_data %></p>
                    <% } %>
                  <% } %>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <p class="text-gray-600 text-sm">No events recorded yet</p>
          <% } %>
        </div>

        <script>
          document.getElementById('addEventForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const eventType = document.getElementById('eventType').value;
            const eventDataStr = document.getElementById('eventData').value;

            try {
              const eventData = eventDataStr ? JSON.parse(eventDataStr) : {};

              const response = await fetch('/admin-v2/lifecycle/<%= sgtin.id %>/events', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ event_type: eventType, event_data: eventData })
              });

              const result = await response.json();
              if (result.success) {
                alert('Event added successfully');
                location.reload();
              } else {
                alert('Error: ' + (result.error || 'Unknown error'));
              }
            } catch (err) {
              alert('Error: ' + err.message);
            }
          });
        </script>

      </div>

      <!-- Sidebar -->
      <div class="space-y-8">
        <!-- Quick Links -->
        <div class="bg-white rounded-lg shadow-md p-8">
          <h3 class="text-lg font-bold text-gray-900 mb-4">Quick Links</h3>
          <div class="space-y-3">
            <a href="/admin-v2/gtin/<%= gtin.id %>" class="block text-blue-600 hover:underline">
              ↓ View GTIN
            </a>
            <a href="/admin-v2/batch/<%= batch.id %>" class="block text-blue-600 hover:underline">
              ↓ View Batch
            </a>
            <a href="/admin-v2/style/<%= style.id %>" class="block text-blue-600 hover:underline">
              ↓ View Style
            </a>
          </div>
        </div>

        <!-- DPP URL -->
        <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
          <h3 class="text-sm font-bold text-blue-900 mb-3">Produktpass URL</h3>
          <p class="font-mono text-xs text-blue-900 break-all">
            /dpp/<%= batch.batch_id %>/<%= gtin.gtin %>/<%= sgtin.serial_number %>
          </p>
          <a href="/dpp/<%= batch.batch_id %>/<%= gtin.gtin %>/<%= sgtin.serial_number %>" target="_blank" class="mt-3 inline-block text-blue-600 hover:underline text-sm font-semibold">
            Öppna produktpass →
          </a>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
