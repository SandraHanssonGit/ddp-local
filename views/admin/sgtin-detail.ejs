<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= sgtin.serial_number %> - Individual Unit</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
  <script src="/js/admin-modal.js"></script>
</head>
<body>
  <div class="wrap">
    <div class="detail-header">
      <div>
        <h1>Individual Unit: <span class="mono"><%= sgtin.serial_number %></span></h1>
        <p class="subtitle"><%= style.product_name %> (Style <%= style.style_number %>)</p>
      </div>
      <div style="display:flex; flex-direction:column; gap:8px; align-items:flex-end;">
        <a href="/admin-v2?tab=sgtins" class="btn"><%- icon('arrow-left') %> Back to Individual Units</a>
        <a href="/01/<%= toGtin14(gtin.gtin) %>/21/<%= sgtin.serial_number %>" target="_blank" class="btn btn-primary"><%- icon('arrow-right') %> Produktpass</a>
      </div>
    </div>

    <% if (batch.produced_at) { %>
      <div class="lock-banner">
        <%- icon('lock') %> <strong>Production-locked</strong> — batch <%= batch.batch_id %> was marked produced on
        <%= new Date(batch.produced_at).toLocaleString('en-US') %>. Field changes here are kept in the
        change log, not silently overwritten.
      </div>
    <% } %>

    <div class="detail-grid">
      <!-- Main Content -->
      <div>

        <!-- Basic Info -->
        <div class="card">
          <h2 style="margin-bottom:20px;">Basic Information</h2>
          <div class="info-grid">
            <div class="info-item">
              <label class="label-sm">Serial Number</label>
              <p class="value mono" style="font-weight:700;"><%= sgtin.serial_number %></p>
            </div>
            <div class="info-item">
              <label class="label-sm">SGTIN ID</label>
              <p class="value mono"><%= sgtin.sgtin || sgtin.id %></p>
            </div>
            <div class="info-item">
              <label class="label-sm">EAN</label>
              <p class="value mono"><%= gtin.gtin %></p>
            </div>
            <div class="info-item">
              <label class="label-sm">GTIN (GS1, 14-digit)</label>
              <p class="value mono" style="font-weight:700;"><%= toGtin14(gtin.gtin) %></p>
            </div>
            <div class="info-item">
              <label class="label-sm">Item Number</label>
              <p class="value"><%= gtin.item_number %></p>
            </div>
          </div>
        </div>

        <!-- Hierarchy Info -->
        <div class="card">
          <h2 style="margin-bottom:20px;">Product Hierarchy</h2>
          <div style="display:flex; flex-direction:column; gap:14px;">
            <div>
              <label class="label-sm">Style</label>
              <p class="value"><strong><%= style.style_number %></strong> - <%= style.product_name %></p>
            </div>
            <div>
              <label class="label-sm">Batch</label>
              <p class="value">
                <strong><%= batch.batch_id %></strong>
                <% if (batch.production_order) { %> - Order: <%= batch.production_order %><% } %>
              </p>
            </div>
            <% if (variant) { %>
              <div>
                <label class="label-sm">Variant</label>
                <p class="value"><%= variant.variant_name %></p>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Garment Information -->
        <div class="card">
          <h2 style="margin-bottom:20px;">Garment Information</h2>
          <div class="info-item">
            <label class="label-sm">Created</label>
            <p class="value"><%= new Date(sgtin.created_at).toLocaleDateString('en-US') %></p>
          </div>
        </div>

        <!-- Lifecycle Events -->
        <div class="card">
          <h2 style="margin-bottom:20px;">Lifecycle Events</h2>

          <!-- Add Event Form -->
          <form id="addEventForm" class="form-panel">
            <h3 style="margin-bottom:16px; font-size:16px;">Add New Event</h3>
            <div class="field-grid">
              <div>
                <label>Event Type</label>
                <select id="eventType" name="eventType" required>
                  <option value="">-- Select Event Type --</option>
                  <option value="viewed">Viewed</option>
                  <option value="sold">Sold</option>
                  <option value="repaired">Repaired</option>
                  <option value="reuse">Reuse</option>
                  <option value="recycled">Recycled</option>
                  <option value="returned">Returned</option>
                </select>
              </div>
              <div>
                <label>Additional Data (JSON)</label>
                <input type="text" id="eventData" name="eventData" placeholder='{"location": "warehouse", "notes": "..."}' />
              </div>
            </div>
            <button type="submit" class="btn btn-primary">Add Event</button>
          </form>

          <!-- Events List -->
          <% if (typeof events !== 'undefined' && events.length > 0) { %>
            <% events.forEach(event => { %>
              <div style="border-left:3px solid var(--accent); padding:8px 0 8px 14px; margin-bottom:12px;">
                <p class="label-sm"><%= event.event_type %></p>
                <p class="small muted" style="margin-top:4px;"><%= new Date(event.created_at).toLocaleDateString('en-US') %></p>
                <% if (event.event_data) { %>
                  <% try { %>
                    <% const data = JSON.parse(event.event_data); %>
                    <% if (Object.keys(data).length > 0) { %>
                      <div style="margin-top:8px;">
                        <% Object.entries(data).forEach(([key, value]) => { %>
                          <p class="small"><strong><%= key %>:</strong> <%= JSON.stringify(value) %></p>
                        <% }); %>
                      </div>
                    <% } %>
                  <% } catch(e) { %>
                    <p class="small" style="margin-top:8px;"><%= event.event_data %></p>
                  <% } %>
                <% } %>
              </div>
            <% }); %>
          <% } else { %>
            <p class="small muted">No events recorded yet</p>
          <% } %>
        </div>

        <script>
          document.getElementById('addEventForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const eventType = document.getElementById('eventType').value;
            const eventDataStr = document.getElementById('eventData').value;

            try {
              const eventData = eventDataStr ? JSON.parse(eventDataStr) : {};

              const response = await fetch('/admin-v2/lifecycle/<%= sgtin.id %>/events', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ event_type: eventType, event_data: eventData })
              });

              const result = await response.json();
              if (result.success) {
                await dppAlert('Event added successfully');
                location.reload();
              } else {
                await dppAlert('Error: ' + (result.error || 'Unknown error'));
              }
            } catch (err) {
              await dppAlert('Error: ' + err.message);
            }
          });
        </script>

        <!-- DPP Fields Card -->
        <div class="card">
          <div class="card-head">
            <h2>Field Values</h2>
            <button onclick="toggleDppEdit()" class="btn btn-primary">Edit</button>
          </div>

          <div class="locale-tabs">
            <span class="label-sm" style="margin-right:4px;">Language:</span>
            <a href="?" class="<%= !locale ? 'active' : '' %>">Default</a>
            <% (typeof availableLocales !== 'undefined' ? availableLocales : []).forEach(loc => { %>
              <a href="?lang=<%= encodeURIComponent(loc) %>" class="<%= locale === loc ? 'active' : '' %>"><%= loc %></a>
            <% }); %>
            <form method="GET" style="display:inline-flex;align-items:center;gap:6px;margin-left:8px;" onsubmit="event.preventDefault(); const v=this.newlang.value.trim(); if(v) window.location.href='?lang='+encodeURIComponent(v);">
              <input type="text" name="newlang" placeholder="+ add locale e.g. fr-FR" class="small" style="width:160px;">
              <button type="submit" class="btn small">Go</button>
            </form>
          </div>

          <div id="dpp-fields-view">
            <% (typeof dppValues !== 'undefined' ? dppValues : []).forEach(val => { %>
              <% if (val.value) { %>
                <div class="field-card overridden">
                  <div class="field-card-head">
                    <label class="label-sm"><%= val.label %></label>
                    <span class="badge badge-accent">Overridden here</span>
                  </div>
                  <p class="field-card-value"><%= val.value %></p>
                  <% if (val.inheritedValue) { %>
                    <p class="field-card-note">Inherited from <%= val.inheritedFrom %>: <span class="mono"><%= val.inheritedValue %></span></p>
                  <% } %>
                  <p style="margin-top:8px;"><a href="#" onclick="clearOverride('<%= val.field_key %>'); return false;" class="link-action danger">Clear override <span style="display:inline-flex;vertical-align:middle;"><%- icon('arrow-right', { size: 13 }) %></span> inherit</a></p>
                </div>
              <% } else if (val.inheritedValue) { %>
                <div class="field-card inherited">
                  <div class="field-card-head">
                    <label class="label-sm"><%= val.label %></label>
                    <span class="badge badge-muted">Inherited from <%= val.inheritedFrom %></span>
                  </div>
                  <p class="field-card-value muted"><%= val.inheritedValue %></p>
                </div>
              <% } else { %>
                <div class="field-card notset">
                  <div class="field-card-head">
                    <label class="label-sm"><%= val.label %></label>
                    <span class="badge" style="background:var(--lock-border); color:var(--lock-text);">Not set yet</span>
                  </div>
                  <p class="field-card-note">No value at GTIN, Batch, or Style level either — this can be filled in here.</p>
                </div>
              <% } %>
            <% }); %>
            <% if (typeof dppValues === 'undefined' || dppValues.length === 0) { %>
              <p class="muted" style="font-style:italic;">No fields are configured to be editable at the SGTIN level.</p>
            <% } %>
          </div>

          <div id="dpp-fields-edit" class="hidden">
            <% if (typeof dppValues !== 'undefined' && dppValues.length > 0) { %>
              <% dppValues.forEach(val => { %>
                <div class="field-row">
                  <label style="display:block; margin-bottom:6px;"><%= val.label %></label>
                  <% if (val.inheritedValue) { %>
                    <p class="small muted" style="margin-bottom:6px;">Inherited from <%= val.inheritedFrom %>: <span class="mono"><%= val.inheritedValue %></span> — leave blank to keep inheriting</p>
                  <% } %>
                  <textarea id="field-<%= val.field_key %>" rows="3"><%= val.value %></textarea>
                </div>
              <% }); %>
            <% } else { %>
              <p class="muted" style="font-style:italic;">No fields are configured to be editable at the SGTIN level.</p>
            <% } %>
            <div style="display:flex; gap:10px;">
              <button type="button" onclick="saveSgtinDppValues()" class="btn btn-primary">Save Changes</button>
              <button type="button" onclick="toggleDppEdit()" class="btn">Cancel</button>
            </div>
          </div>
        </div>

        <script>
          function toggleDppEdit() {
            document.getElementById('dpp-fields-view').classList.toggle('hidden');
            document.getElementById('dpp-fields-edit').classList.toggle('hidden');
          }
          const currentLocale = <%- JSON.stringify(locale || null) %>;
          const localeQuery = currentLocale ? '?lang=' + encodeURIComponent(currentLocale) : '';

          async function saveSgtinDppValues() {
            const values = {};
            document.querySelectorAll('[id^="field-"]').forEach(el => { values[el.id.substring(6)] = el.value; });

            // This unit's batch is production-locked - capture an
            // optional reason so the audit trail can show why a locked
            // value was changed, not just who/when.
            const isLocked = <%- JSON.stringify(!!batch.produced_at) %>;
            const reason = isLocked
              ? await dppPrompt('This unit\'s batch is production-locked. Why are you changing a value?', 'Reason (optional)')
              : '';

            try {
              const res = await fetch('/admin-v2/sgtin/<%= sgtin.id %>/dpp-values' + localeQuery, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ values, reason })
              });
              if (res.ok) { await dppAlert('DPP values saved'); location.reload(); }
              else { await dppAlert('Error saving DPP values'); }
            } catch (err) { await dppAlert('Error: ' + err.message); }
          }
          async function clearOverride(fieldKey) {
            if (!(await dppConfirm('Clear this override? The field will go back to its inherited value.'))) return;
            try {
              const res = await fetch('/api/admin/overrides/sgtin/<%= sgtin.id %>/field/' + encodeURIComponent(fieldKey) + localeQuery, {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({})
              });
              if (res.ok) { location.reload(); }
              else { await dppAlert('Error clearing override'); }
            } catch (err) { await dppAlert('Error: ' + err.message); }
          }
        </script>

      </div>

      <!-- Sidebar -->
      <div>
        <!-- Version History -->
        <div class="card">
          <h3 style="margin-bottom:16px;">Passport Version History</h3>
          <% if (typeof versionHistory !== 'undefined' && versionHistory.length > 0) { %>
            <% versionHistory.forEach((v, i) => { %>
              <div class="field-card <%= i === 0 ? 'overridden' : 'inherited' %>" style="margin-bottom:10px;">
                <div class="field-card-head">
                  <span class="label-sm">v<%= v.version_number %></span>
                  <% if (i === 0) { %><span class="badge badge-accent">current</span><% } %>
                </div>
                <p class="small"><%= v.change_note || v.change_type %></p>
                <p class="field-card-note"><%= new Date(v.issued_at).toLocaleString('en-US') %></p>
              </div>
            <% }); %>
          <% } else { %>
            <p class="small muted" style="font-style:italic;">No field changes recorded directly on this SGTIN yet. Note: changes to its Style, Batch, or GTIN don't bump this version — only direct SGTIN edits do.</p>
          <% } %>
        </div>

        <!-- Quick Links -->
        <div class="card">
          <h3 style="margin-bottom:16px;">Quick Links</h3>
          <div class="link-list">
            <a href="/admin-v2/gtin/<%= gtin.id %>"><%- icon('arrow-right', { size: 14 }) %> View GTIN</a>
            <a href="/admin-v2/batch/<%= batch.id %>"><%- icon('arrow-right', { size: 14 }) %> View Batch</a>
            <% if (variant) { %>
              <a href="/admin-v2/variant/<%= variant.id %>"><%- icon('arrow-right', { size: 14 }) %> View Variant</a>
            <% } %>
            <a href="/admin-v2/style/<%= style.id %>"><%- icon('arrow-right', { size: 14 }) %> View Product</a>
          </div>
        </div>

        <!-- DPP URL -->
        <div class="callout">
          <p class="callout-title">Produktpass URL (GS1 Digital Link)</p>
          <p class="mono small" style="word-break:break-all;">/01/<%= toGtin14(gtin.gtin) %>/21/<%= sgtin.serial_number %></p>
          <p style="margin-top:10px;"><a href="/01/<%= toGtin14(gtin.gtin) %>/21/<%= sgtin.serial_number %>" target="_blank" class="link-action">Öppna produktpass <%- icon('arrow-right', { size: 14 }) %></a></p>
          <p class="small muted" style="margin-top:14px; padding-top:12px; border-top:1px solid var(--hairline);">
            Legacy-länk (fungerar fortfarande internt):<br>
            <a href="/dpp/<%= batch.batch_id %>/<%= gtin.gtin %>/<%= sgtin.serial_number %>" target="_blank" class="mono" style="word-break:break-all;">
              /dpp/<%= batch.batch_id %>/<%= gtin.gtin %>/<%= sgtin.serial_number %>
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
