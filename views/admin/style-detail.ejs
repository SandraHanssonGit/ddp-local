<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= style.product_name %> - Style Detail</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
  <script src="/js/admin-modal.js"></script>
</head>
<body>
  <div class="wrap">
    <div class="detail-header">
      <div>
        <h1><%= style.style_number %></h1>
        <p class="subtitle"><%= style.product_name %></p>
      </div>
      <a href="/admin-v2?tab=products" class="btn btn-primary"><%- icon('arrow-left') %> Back to Products</a>
    </div>

    <div>
        <!-- Style Information Card -->
        <div class="card card-identifiers">
          <div class="card-head">
            <h2>Style Information</h2>
            <button onclick="toggleEdit('style-info')" class="btn btn-primary">Edit</button>
          </div>

          <!-- View Mode -->
          <div id="style-info-view">
            <div class="info-grid">
              <div class="info-item">
                <label class="label-sm">Style Number</label>
                <p class="value mono"><%= style.style_number %></p>
              </div>
              <div class="info-item">
                <label class="label-sm">Product Name</label>
                <p class="value"><%= style.product_name %></p>
              </div>
              <div class="info-item">
                <label class="label-sm">Product Type</label>
                <p class="value">
                  <% const currentProductType = (typeof productTypes !== 'undefined' ? productTypes : []).find(pt => pt.id === style.product_type_id); %>
                  <%= currentProductType ? currentProductType.label : (style.product_type || '—') %>
                </p>
              </div>
              <div class="info-item">
                <label class="label-sm">Created</label>
                <p class="value"><%= new Date(style.created_at).toLocaleDateString('en-US') %></p>
              </div>
            </div>
          </div>

          <!-- Edit Mode -->
          <form id="style-info-edit" class="hidden" onsubmit="saveStyleInfo(event)">
            <div class="field-grid">
              <div>
                <label>Style Number</label>
                <input type="text" id="edit-style-number" value="<%= style.style_number %>" readonly>
              </div>
              <div>
                <label>Product Name</label>
                <input type="text" id="edit-product-name" value="<%= style.product_name %>" required>
              </div>
              <div>
                <label>Product Type</label>
                <select id="edit-product-type-id">
                  <option value="">-- None --</option>
                  <% (typeof productTypes !== 'undefined' ? productTypes : []).forEach(pt => { %>
                    <option value="<%= pt.id %>" <%= style.product_type_id === pt.id ? 'selected' : '' %>><%= pt.label %></option>
                  <% }); %>
                </select>
              </div>
            </div>
            <div style="display:flex; gap:10px;">
              <button type="submit" class="btn btn-primary">Save Changes</button>
              <button type="button" onclick="toggleEdit('style-info')" class="btn">Cancel</button>
            </div>
          </form>

          <!-- Product Image (merged in - same card, same subject: this
               Style's own identity, not a separate concern) -->
          <div style="border-top:1px solid var(--hairline); margin-top:20px; padding-top:20px;">
            <label class="label-sm" style="display:block; margin-bottom:10px;">Product Image</label>
            <div style="display:flex; gap:20px; align-items:flex-start;">
              <% if (style.image_url) { %>
                <div class="image-preview-wrap">
                  <img src="<%= style.image_url %>" alt="<%= style.product_name %>" class="image-preview" title="Hover to zoom">
                </div>
              <% } else { %>
                <div class="image-box" style="width:130px; height:130px; display:flex; align-items:center; justify-content:center; padding:8px; flex:none;">No image yet</div>
              <% } %>
              <div class="small muted" style="flex:1; max-width:360px;">
                <p style="margin:0 0 8px;"><strong style="color:var(--text);">Used on:</strong></p>
                <ul style="margin:0 0 12px; padding-left:18px;">
                  <li>Public passport hero image</li>
                  <li>Products tab thumbnail</li>
                  <li>Variants without their own image (fallback)</li>
                </ul>
                <p style="margin:0;">Recommended: square, at least 800&times;800px, JPG/PNG/WebP.</p>
              </div>
            </div>
            <% if (style.image_url) { %>
              <div style="margin-top:14px; display:flex; gap:10px; align-items:center;">
                <label class="btn small file-btn">
                  Choose File
                  <input type="file" id="image-upload" accept="image/*" class="file-input-hidden" onchange="document.getElementById('image-upload-name').textContent = this.files[0] ? this.files[0].name : 'No file chosen'">
                </label>
                <span id="image-upload-name" class="small muted">No file chosen</span>
                <button type="button" onclick="uploadImage()" class="btn small" style="margin-left:8px;">Upload New</button>
                <a href="#" onclick="deleteStyleImage(); return false;" class="link-action muted small" style="margin-left:auto; display:inline-flex; align-items:center; gap:4px;"><%- icon('trash-2', { size: 13 }) %> Delete</a>
              </div>
            <% } else { %>
              <div style="margin-top:14px; display:flex; gap:10px; align-items:center;">
                <label class="btn file-btn">
                  Choose File
                  <input type="file" id="image-upload" accept="image/*" class="file-input-hidden" onchange="document.getElementById('image-upload-name').textContent = this.files[0] ? this.files[0].name : 'No file chosen'">
                </label>
                <span id="image-upload-name" class="small muted">No file chosen</span>
                <button type="button" onclick="uploadImage()" class="btn btn-primary">Upload Image</button>
              </div>
            <% } %>
          </div>
        </div>

        <!-- DPP Fields Card -->
        <div class="card card-passport" id="dpp-fields">
          <div class="card-eyebrow"><%- icon('qr-code', { size: 12 }) %> Field for digital product information</div>
          <div class="card-head">
            <h2>Field Values</h2>
            <button onclick="toggleEdit('dpp-fields')" class="btn btn-primary">Edit</button>
          </div>

          <div class="locale-tabs">
            <span class="label-sm" style="margin-right:4px;">Language:</span>
            <a href="?" class="<%= !locale ? 'active' : '' %>">Default</a>
            <% (typeof availableLocales !== 'undefined' ? availableLocales : []).forEach(loc => { %>
              <a href="?lang=<%= encodeURIComponent(loc) %>" class="<%= locale === loc ? 'active' : '' %>"><%= loc %></a>
            <% }); %>
            <form method="GET" style="display:inline-flex;align-items:center;gap:6px;margin-left:8px;" onsubmit="event.preventDefault(); const v=this.newlang.value.trim(); if(v) window.location.href='?lang='+encodeURIComponent(v);">
              <input type="text" name="newlang" placeholder="+ add locale e.g. fr-FR" class="small" style="width:160px;">
              <button type="submit" class="btn small">Go</button>
            </form>
          </div>

          <!-- View Mode -->
          <div id="dpp-fields-view">
            <%
              // Same class of gap already fixed on GTIN detail (2026-09-20,
              // "Det känns inte som alla fält syns"): this used to filter
              // to only fields with a value, so a Style with nothing set
              // yet showed no field list at all - just an italic message -
              // instead of the configured fields as empty/fillable. dppValues
              // already comes from getFieldsForLevel() (a LEFT JOIN), so it
              // already includes every editable_at_style field whether or
              // not it has a value; just stop filtering that away here.
              const allStyleDppValues = typeof dppValues !== 'undefined' ? dppValues : [];
              // Structured fields (data_type='json') - pretty-print
              // instead of showing the raw JSON string, same rendering
              // used on the public passport (dpp-passport.ejs).
              const renderFieldLabel = (k) => k.replace(/([A-Z])/g, ' $1').replace(/^./, c => c.toUpperCase());
              const structuredValueHtml = (raw) => {
                let parsed;
                try { parsed = JSON.parse(raw); } catch (e) { return null; }
                if (Array.isArray(parsed)) {
                  return parsed.map(item => (typeof item === 'object' && item !== null)
                    ? Object.entries(item).map(([k, v]) => `<strong>${renderFieldLabel(k)}:</strong> ${v}`).join(', ')
                    : String(item)
                  ).map(line => `<div>${line}</div>`).join('');
                }
                if (typeof parsed === 'object' && parsed !== null) {
                  return Object.entries(parsed)
                    .filter(([, v]) => v !== null && v !== undefined && !(Array.isArray(v) && v.length === 0))
                    .map(([k, v]) => `<div><strong>${renderFieldLabel(k)}:</strong> ${Array.isArray(v) ? v.join(', ') : v}</div>`)
                    .join('');
                }
                return null;
              };
            %>
            <% if (allStyleDppValues.length > 0) { %>
              <%
                const styleFieldGroups = [
                  { label: 'EU Required', items: allStyleDppValues.filter(v => v.category === 'eu_required') },
                  { label: 'Nudie', items: allStyleDppValues.filter(v => v.category === 'nudie') }
                ];
              %>
              <% styleFieldGroups.forEach(group => { %>
                <% if (group.items.length === 0) return; %>
                <div class="field-category-heading"><%= group.label %></div>
                <% group.items.forEach(val => { %>
                  <% if (val.value) { %>
                    <% const structuredHtml = val.data_type === 'json' ? structuredValueHtml(val.value) : null; %>
                    <div class="field-card overridden">
                      <div class="field-card-head">
                        <label class="label-sm"><%= val.label %></label>
                        <span class="badge badge-accent">Defined at Style</span>
                      </div>
                      <% if (structuredHtml) { %>
                        <div class="field-card-value"><%- structuredHtml %></div>
                      <% } else { %>
                        <p class="field-card-value"><%= val.value %></p>
                      <% } %>
                    </div>
                  <% } else { %>
                    <div class="field-card notset">
                      <div class="field-card-head">
                        <label class="label-sm"><%= val.label %></label>
                        <span class="badge" style="background:var(--lock-border); color:var(--lock-text);">Not set</span>
                      </div>
                      <p class="field-card-note">No value at Product level - this can be filled in here.</p>
                    </div>
                  <% } %>
                <% }); %>
              <% }); %>
            <% } else { %>
              <p class="muted" style="font-style:italic;">No fields are configured to be editable at the Product level (see Field Config &rsaquo; Levels).</p>
            <% } %>
          </div>

          <!-- Edit Mode -->
          <div id="dpp-fields-edit" class="hidden">
            <% if (typeof dppValues !== 'undefined' && dppValues.length > 0) { %>
              <% dppValues.forEach(val => { %>
                <% if (val.data_type === 'repeating_group') return; %>
                <div class="field-row">
                  <label style="display:block; margin-bottom:6px;"><%= val.label %></label>
                  <textarea id="field-<%= val.field_key %>" rows="3"><%= val.value %></textarea>
                </div>
              <% }); %>
            <% } %>
            <div style="display:flex; gap:10px;">
              <button type="button" onclick="saveDppValues()" class="btn btn-primary">Save Changes</button>
              <button type="button" onclick="toggleEdit('dpp-fields')" class="btn">Cancel</button>
            </div>
          </div>

          <!-- Transparency (merged in - same card, same subject: it's a
               digital product information field too (data_type=
               'repeating_group'), just with its own dedicated UI instead
               of a plain text/textarea like the fields above. Internal
               code/table names stay "supply chain". -->
          <div style="border-top:1px solid var(--hairline); margin-top:20px; padding-top:20px;">
          <div class="card-head">
            <h2>Transparency</h2>
            <button onclick="document.getElementById('addSupplyChainForm').classList.toggle('hidden')" class="btn btn-primary">+ Add Step</button>
          </div>

          <!-- Add/Edit step form (shared - editSupplyChainStep() switches
               it into edit mode by pre-filling values and setting
               editingStepId, which the submit handler checks to PUT
               instead of POST) -->
          <div id="addSupplyChainForm" class="form-panel hidden">
            <h3 id="supplyChainFormTitle" style="margin-bottom:16px; font-size:16px;">Add Transparency Step</h3>
            <form id="supplyChainForm">
              <div class="field-grid">
                <div>
                  <label>Category *</label>
                  <input type="text" name="step_category" placeholder="e.g. Raw Material, Trims, Manufacturing" required />
                </div>
                <div>
                  <label>Role / Label *</label>
                  <input type="text" name="step_label" placeholder="e.g. Spinning, Weaving Mill, Thread Supplier" required />
                </div>
                <div>
                  <label>Supplier Name</label>
                  <input type="text" name="supplier_name" />
                </div>
                <div>
                  <label>Employee Range</label>
                  <input type="text" name="employee_range" placeholder="e.g. 51-100" />
                </div>
                <div>
                  <label>City</label>
                  <input type="text" name="city" />
                </div>
                <div>
                  <label>Country</label>
                  <input type="text" name="country" />
                </div>
              </div>
              <label class="checkbox-row" style="margin-bottom:16px;"><input type="checkbox" name="visited_by_brand" /> Visited by Nudie Jeans</label>
              <div style="display:flex; gap:10px;">
                <button type="submit" id="supplyChainSubmitBtn" class="btn btn-primary">Add Step</button>
                <button type="button" onclick="cancelSupplyChainEdit()" class="btn">Cancel</button>
              </div>
            </form>
          </div>

          <% if (typeof supplyChainGroups !== 'undefined' && supplyChainGroups.length > 0) { %>
            <% supplyChainGroups.forEach(group => { %>
              <div class="sc-group">
                <h3 class="label-sm" style="margin-bottom:10px;"><%= group.category %></h3>
                <% group.steps.forEach(step => { %>
                  <div class="sc-step">
                    <div>
                      <div class="sc-label"><%= step.step_label %></div>
                      <% if (step.supplier_name) { %><div class="small" style="margin-top:2px;"><%= step.supplier_name %></div><% } %>
                      <div class="sc-meta">
                        <%= [step.city, step.country].filter(Boolean).join(', ') || '—' %>
                        <% if (step.employee_range) { %> &middot; Employees: <%= step.employee_range %><% } %>
                      </div>
                      <% if (step.visited_by_brand) { %>
                        <div class="sc-visited" style="display:flex; align-items:center; gap:4px;"><%- icon('check', { size: 13 }) %> Visited by Nudie Jeans</div>
                      <% } %>
                    </div>
                    <div style="display:flex; gap:12px;">
                      <a href="#" onclick="editSupplyChainStep(this); return false;" data-step='<%- JSON.stringify(step).replace(/'/g, "&#39;") %>' class="link-action">Edit</a>
                      <a href="#" onclick="deleteSupplyChainStep(<%= step.id %>); return false;" class="link-action danger">Delete</a>
                    </div>
                  </div>
                <% }); %>
              </div>
            <% }); %>
          <% } else { %>
            <p class="muted" style="font-style:italic;">No transparency steps added yet.</p>
          <% } %>
          </div>
        </div>

        <!-- Variants Card - moved below the passport-content cards
             (Field Values, Transparency): this is structural/navigation
             info about the Style's own sub-entities, not something
             shown on the public passport itself. Only renders when
             this Style actually has variants (2026-09-20, user
             request) - jeans-type products never use this level (see
             the GTINs card below), so an always-empty "Variants" card
             with nothing in it was just noise. This also means
             "+ Add Variant" isn't available once a style has zero
             variants - accepted trade-off, matching the GTINs card's
             existing "only render when there's something to show"
             convention exactly. -->
        <% if (variants && variants.length > 0) { %>
          <div class="card">
            <div class="card-head" style="margin-bottom:20px;">
              <h2>Variants</h2>
            </div>

            <% variants.forEach((variant, idx) => {
                const variantGtins = gtins.filter(g => g.variant_id === variant.id);
              %>
                <div style="<%= idx > 0 ? 'border-top:1px solid var(--hairline); margin-top:20px; padding-top:20px;' : '' %>">
                  <div class="card-head" style="margin-bottom:12px;">
                    <h3><%= variant.variant_name %> <span class="muted small" style="font-weight:400;">— <%= variant.product_name || style.product_name %></span></h3>
                    <span class="badge badge-accent"><%= variantGtins.length %> GTIN<%= variantGtins.length !== 1 ? 's' : '' %></span>
                  </div>

                  <% if (variantGtins.length > 0) { %>
                    <div class="table-wrap">
                      <table>
                        <thead>
                          <tr>
                            <th>GTIN</th>
                            <th>Item #</th>
                            <th>Size</th>
                            <th class="center">SGTINs</th>
                            <th>Action</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% variantGtins.forEach(gtin => { %>
                            <tr>
                              <td class="mono small"><%= gtin.gtin %></td>
                              <td class="small"><%= gtin.item_number %></td>
                              <td class="small">
                                <% let size = gtin.size_value_1 || ''; %>
                                <% if (gtin.size_value_2) size += '-' + gtin.size_value_2; %>
                                <% if (gtin.size_value_3) size += '-' + gtin.size_value_3; %>
                                <%= size %>
                              </td>
                              <td class="center"><span class="badge badge-success small"><%= gtin.sgtin_count || 0 %></span></td>
                              <td><a href="/admin-v2/gtin/<%= gtin.id %>" class="link-action"><%- icon('arrow-right') %></a></td>
                            </tr>
                          <% }); %>
                        </tbody>
                      </table>
                    </div>
                  <% } %>
                </div>
              <% }); %>
          </div>
        <% } %>

        <!-- GTINs Card (direct-under-Style GTINs - jeans without variants
             use this). Read-only: no "+ Add GTIN" here - per explicit
             decision (2026-09-20), GTIN creation will come from an
             external system, not this admin UI, so the form was
             removed rather than kept as dead-end functionality. Card
             only renders at all when there's something to show. -->
        <% const directGtins = gtins.filter(g => !g.variant_id); %>
        <% if (directGtins.length > 0) { %>
          <div class="card">
            <div class="card-head">
              <h2>GTINs</h2>
              <input type="text" id="style-gtin-search" placeholder="Search GTIN or Item #…" class="small" style="width:220px;" oninput="filterStyleGtins(this.value)">
            </div>
            <div class="table-wrap <%= directGtins.length > 5 ? 'table-wrap-scroll' : '' %>">
              <table>
                <thead>
                  <tr>
                    <th>GTIN</th>
                    <th>Item #</th>
                    <th>Size</th>
                    <th class="center">SGTINs</th>
                  </tr>
                </thead>
                <tbody id="style-gtin-table-body">
                  <% directGtins.forEach(gtin => { %>
                    <tr data-search="<%= (gtin.gtin + ' ' + (gtin.item_number || '')).toLowerCase() %>">
                      <td class="mono small"><%= gtin.gtin %></td>
                      <td class="small"><%= gtin.item_number %></td>
                      <td class="small">
                        <% let size = gtin.size_value_1 || ''; %>
                        <% if (gtin.size_value_2) size += '-' + gtin.size_value_2; %>
                        <% if (gtin.size_value_3) size += '-' + gtin.size_value_3; %>
                        <%= size %>
                      </td>
                      <td class="center"><span class="badge badge-success small"><%= gtin.sgtin_count || 0 %></span></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
            <p id="style-gtin-no-match" class="empty-state hidden">No GTINs match "<span id="style-gtin-no-match-term"></span>"</p>
          </div>
        <% } %>

    </div>
  </div>

  <script>
    function filterStyleGtins(term) {
      const needle = term.trim().toLowerCase();
      const rows = document.querySelectorAll('#style-gtin-table-body tr');
      let visibleCount = 0;
      rows.forEach(row => {
        const match = !needle || row.dataset.search.includes(needle);
        row.classList.toggle('hidden', !match);
        if (match) visibleCount++;
      });
      document.getElementById('style-gtin-no-match-term').textContent = term;
      document.getElementById('style-gtin-no-match').classList.toggle('hidden', visibleCount > 0 || !needle);
    }

    function toggleEdit(section) {
      const view = document.getElementById(section + '-view');
      const edit = document.getElementById(section + '-edit');

      if (view && edit) {
        view.classList.toggle('hidden');
        edit.classList.toggle('hidden');
      }
    }

    async function saveStyleInfo(e) {
      e.preventDefault();

      const productTypeIdValue = document.getElementById('edit-product-type-id').value;
      const data = {
        product_name: document.getElementById('edit-product-name').value,
        product_type_id: productTypeIdValue ? parseInt(productTypeIdValue) : null
      };

      try {
        const res = await fetch('/api/admin/styles/<%= style.id %>', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (res.ok) {
          await dppAlert('Style updated successfully');
          location.reload();
        } else {
          await dppAlert('Error updating style');
        }
      } catch (err) {
        await dppAlert('Error: ' + err.message);
      }
    }

    async function uploadImage() {
      const fileInput = document.getElementById('image-upload');
      if (!fileInput.files[0]) {
        await dppAlert('Please select an image');
        return;
      }

      const formData = new FormData();
      formData.append('image', fileInput.files[0]);

      try {
        const res = await fetch('/api/admin/styles/<%= style.id %>/image', {
          method: 'POST',
          body: formData
        });

        if (res.ok) {
          await dppAlert('Image uploaded successfully');
          location.reload();
        } else {
          await dppAlert('Error uploading image');
        }
      } catch (err) {
        await dppAlert('Error: ' + err.message);
      }
    }

    async function deleteStyleImage() {
      if (!(await dppConfirm('Delete this image?'))) return;

      try {
        const res = await fetch('/api/admin/styles/<%= style.id %>/image', {
          method: 'DELETE'
        });

        if (res.ok) {
          await dppAlert('Image deleted');
          location.reload();
        } else {
          await dppAlert('Error deleting image');
        }
      } catch (err) {
        await dppAlert('Error: ' + err.message);
      }
    }

    const currentLocale = <%- JSON.stringify(locale || null) %>;
    const localeQuery = currentLocale ? '?lang=' + encodeURIComponent(currentLocale) : '';

    async function saveDppValues() {
      const values = {};
      document.querySelectorAll('[id^="field-"]').forEach(el => {
        const key = el.id.substring(6);
        values[key] = el.value;
      });

      try {
        const res = await fetch('/api/admin/styles/<%= style.id %>/dpp-values' + localeQuery, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(values)
        });

        if (res.ok) {
          await dppAlert('DPP values saved');
          location.reload();
        } else {
          await dppAlert('Error saving DPP values');
        }
      } catch (err) {
        await dppAlert('Error: ' + err.message);
      }
    }

    let editingSupplyChainStepId = null;

    function editSupplyChainStep(el) {
      const step = JSON.parse(el.dataset.step);
      editingSupplyChainStepId = step.id;
      const form = document.getElementById('supplyChainForm');
      form.step_category.value = step.step_category || '';
      form.step_label.value = step.step_label || '';
      form.supplier_name.value = step.supplier_name || '';
      form.employee_range.value = step.employee_range || '';
      form.city.value = step.city || '';
      form.country.value = step.country || '';
      form.visited_by_brand.checked = !!step.visited_by_brand;
      document.getElementById('supplyChainFormTitle').textContent = 'Edit Transparency Step';
      document.getElementById('supplyChainSubmitBtn').textContent = 'Save Changes';
      document.getElementById('addSupplyChainForm').classList.remove('hidden');
      form.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function cancelSupplyChainEdit() {
      editingSupplyChainStepId = null;
      document.getElementById('supplyChainForm').reset();
      document.getElementById('supplyChainFormTitle').textContent = 'Add Transparency Step';
      document.getElementById('supplyChainSubmitBtn').textContent = 'Add Step';
      document.getElementById('addSupplyChainForm').classList.add('hidden');
    }

    document.getElementById('supplyChainForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const data = {
        step_category: formData.get('step_category'),
        step_label: formData.get('step_label'),
        supplier_name: formData.get('supplier_name'),
        city: formData.get('city'),
        country: formData.get('country'),
        employee_range: formData.get('employee_range'),
        visited_by_brand: formData.has('visited_by_brand')
      };

      try {
        const url = editingSupplyChainStepId
          ? '/admin-v2/supply-chain/' + editingSupplyChainStepId
          : '/admin-v2/style/<%= style.id %>/supply-chain';
        const response = await fetch(url, {
          method: editingSupplyChainStepId ? 'PUT' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const result = await response.json();
        if (result.success) {
          location.reload();
        } else {
          await dppAlert('Error: ' + (result.error || 'Unknown error'));
        }
      } catch (err) {
        await dppAlert('Error: ' + err.message);
      }
    });

    async function deleteSupplyChainStep(stepId) {
      if (!(await dppConfirm('Delete this transparency step?'))) return;
      try {
        const response = await fetch('/admin-v2/supply-chain/' + stepId, { method: 'DELETE' });
        const result = await response.json();
        if (result.success) {
          location.reload();
        } else {
          await dppAlert('Error: ' + (result.error || 'Unknown error'));
        }
      } catch (err) {
        await dppAlert('Error: ' + err.message);
      }
    }
  </script>
</body>
</html>
