<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Product Data Hub</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
  <script src="/js/admin-modal.js"></script>
</head>
<body>
  <div class="wrap">
    <div class="admin-header">
      <div class="brand">
        <div class="logo-crop" title="Nudie Jeans co">
          <img src="/nudie-logo.png" alt="Nudie Jeans co">
        </div>
        <h1>Product Data Hub</h1>
      </div>
      <div class="user-info">
        <span><%= user.username %></span>
        <a href="/login" class="btn">Logout</a>
      </div>
    </div>

    <div class="admin-nav">
      <a href="/admin-v2" class="<%= tab === 'products' ? 'active' : '' %>">Products</a>
      <a href="/admin-v2?tab=batches" class="<%= tab === 'batches' ? 'active' : '' %>">Batches</a>
      <a href="/admin-v2?tab=sgtins" class="<%= tab === 'sgtins' ? 'active' : '' %>">Individual Units</a>
      <a href="/admin-v2?tab=analytics" class="<%= tab === 'analytics' ? 'active' : '' %>">Scan Analytics</a>
      <a href="/admin-v2?tab=settings" class="<%= tab === 'settings' ? 'active' : '' %>">Settings</a>
    </div>

    <div class="card">
      <!-- PRODUCTS TAB - unified Style/Style+Variant/GTIN masterdata
           view, replaced the old separate Styles/Variants/GTINs tabs
           on 2026-09-17 -->
      <% if (tab === 'products') { %>
        <div class="section-head">
          <h2>Products</h2>
          <button onclick="document.getElementById('addStyleForm').classList.toggle('hidden')" class="btn btn-primary">
            + Add Style
          </button>
        </div>

        <!-- Add Style Form -->
        <div id="addStyleForm" class="form-panel hidden">
          <h3 style="margin-bottom:16px; font-size:16px;">Add New Style</h3>
          <form id="styleForm">
            <div class="field-grid">
              <div>
                <label>Style Number *</label>
                <input type="text" name="style_number" placeholder="114519" required />
              </div>
              <div>
                <label>Product Name</label>
                <input type="text" name="product_name" placeholder="Thin Finn" />
              </div>
              <div>
                <label>Product Type</label>
                <input type="text" name="product_type" placeholder="jeans" />
              </div>
            </div>
            <button type="submit" class="btn btn-primary">Add Style</button>
          </form>
        </div>

        <div class="field-row">
          <input type="text" id="productSearch" placeholder="Search Style #, Product Name, Variant, GTIN, SKU..." style="width:340px;" value="<%= search || '' %>">
        </div>

        <% if (products && products.length > 0) { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Style / Variant / GTIN</th>
                  <th>Name / GTIN</th>
                  <th>Type / SKU</th>
                  <th class="center">GTINs</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% const expanded = !!search; %>
                <% products.forEach(p => { %>
                  <% const styleKey = 'style-' + p.id; %>
                  <% const styleHasChildren = p.variants.length > 0 || p.gtins.length > 0; %>
                  <tr
                    style="background:var(--surface-2); <%= styleHasChildren ? 'cursor:pointer;' : '' %>"
                    <% if (styleHasChildren) { %>onclick="toggleGroup('<%= styleKey %>')"<% } %>
                  >
                    <td class="mono">
                      <% if (styleHasChildren) { %>
                        <span data-chevron="<%= styleKey %>" style="display:inline-flex; margin-right:6px; transition:transform 0.15s ease; color:var(--muted);"><%- icon('chevron-right', { size: 14 }) %></span>
                      <% } %>
                      <strong><%= p.style_number %></strong>
                    </td>
                    <td>
                      <%= p.product_name %>
                      <% if (p.variants.length > 0) { %>
                        <span class="small muted">(<%= p.variants.length %> variant<%= p.variants.length === 1 ? '' : 's' %>)</span>
                      <% } %>
                      <% if (p.story) { %>
                        <span title="Story: <%= p.story.length > 140 ? p.story.slice(0, 140) + '…' : p.story %>" style="display:inline-flex; margin-left:6px; color:var(--muted); vertical-align:middle;"><%- icon('book-open', { size: 13 }) %></span>
                      <% } %>
                    </td>
                    <td class="small muted"><%= p.product_type %></td>
                    <td class="center"><span class="badge badge-accent"><%= p.gtin_count || 0 %></span></td>
                    <td><a href="/admin-v2/style/<%= p.id %>" onclick="event.stopPropagation();" class="link-action"><%- icon('arrow-right') %></a></td>
                  </tr>

                  <!-- GTINs directly under the Style (no Variant) -->
                  <% p.gtins.forEach(g => { %>
                    <tr data-parent="<%= styleKey %>" class="hidden">
                      <td class="mono small" style="padding-left:28px;"><%- icon('corner-down-right', { size: 13 }) %> <%= gtinLabel(g) %></td>
                      <td class="small mono"><%= g.gtin %></td>
                      <td class="small muted"><%= g.item_number || '—' %></td>
                      <td></td>
                      <td><a href="/admin-v2/gtin/<%= g.id %>" class="link-action"><%- icon('arrow-right') %></a></td>
                    </tr>
                  <% }); %>

                  <!-- Variants, each optionally expandable to their own GTINs -->
                  <% p.variants.forEach(v => { %>
                    <% const variantKey = 'variant-' + v.id; %>
                    <tr
                      data-parent="<%= styleKey %>" class="hidden"
                      style="<%= v.gtins.length > 0 ? 'cursor:pointer;' : '' %>"
                      <% if (v.gtins.length > 0) { %>onclick="toggleGroup('<%= variantKey %>')"<% } %>
                    >
                      <td class="mono small" style="padding-left:28px;">
                        <% if (v.gtins.length > 0) { %>
                          <span data-chevron="<%= variantKey %>" style="display:inline-flex; margin-right:4px; transition:transform 0.15s ease; color:var(--muted);"><%- icon('chevron-right', { size: 14 }) %></span>
                        <% } %>
                        <%- icon('corner-down-right', { size: 13 }) %> <%= v.variant_name %>
                      </td>
                      <td class="small">
                        <%= v.effective_product_name %>
                        <% if (v.story) { %>
                          <span title="Story: <%= v.story.length > 140 ? v.story.slice(0, 140) + '…' : v.story %>" style="display:inline-flex; margin-left:6px; color:var(--muted); vertical-align:middle;"><%- icon('book-open', { size: 13 }) %></span>
                        <% } %>
                      </td>
                      <td></td>
                      <td class="center"><span class="badge badge-accent small"><%= v.gtin_count || 0 %></span></td>
                      <td><a href="/admin-v2/variant/<%= v.id %>" onclick="event.stopPropagation();" class="link-action"><%- icon('arrow-right') %></a></td>
                    </tr>
                    <% v.gtins.forEach(g => { %>
                      <tr data-parent="<%= variantKey %>" data-grandparent="<%= styleKey %>" class="hidden">
                        <td class="mono small" style="padding-left:48px;"><%- icon('corner-down-right', { size: 13 }) %> <%= gtinLabel(g) %></td>
                        <td class="small mono"><%= g.gtin %></td>
                        <td class="small muted"><%= g.item_number || '—' %></td>
                        <td></td>
                        <td><a href="/admin-v2/gtin/<%= g.id %>" class="link-action"><%- icon('arrow-right') %></a></td>
                      </tr>
                    <% }); %>
                  <% }); %>

                <% }); %>
              </tbody>
            </table>
          </div>
          <script>
            (function() {
              const expanded = <%- expanded %>;
              const keys = [];
              <% products.forEach(p => { %>
                <% if (p.variants.length > 0 || p.gtins.length > 0) { %>
                  keys.push(<%- JSON.stringify('style-' + p.id) %>);
                <% } %>
                <% p.variants.forEach(v => { %>
                  <% if (v.gtins.length > 0) { %>
                    keys.push(<%- JSON.stringify('variant-' + v.id) %>);
                  <% } %>
                <% }); %>
              <% }); %>
              keys.forEach(k => initGroup(k, expanded));
              renderProductVisibility();
            })();
          </script>
        <% } else { %>
          <div class="empty-state">No products found</div>
        <% } %>
      <% } %>

      <!-- BATCHES TAB -->
      <% if (tab === 'batches') { %>
        <div class="section-head">
          <h2>Production Batches</h2>
          <div style="display:flex; gap:10px;">
            <% if (styles && styles.length > 0) { %>
              <select id="filterStyle" onchange="window.location = '/admin-v2?tab=batches&style=' + this.value" style="width:auto;">
                <option value="">All Styles</option>
                <% styles.forEach(s => { %>
                  <option value="<%= s.id %>" <%= typeof selectedStyleId !== 'undefined' && selectedStyleId == s.id ? 'selected' : '' %>><%= s.style_number %> - <%= s.product_name %></option>
                <% }); %>
              </select>
            <% } %>
            <input type="text" id="batchSearch" placeholder="Search Batch ID, Production Order..." style="width:260px;" value="<%= search || '' %>">
            <button onclick="document.getElementById('addBatchForm').classList.toggle('hidden')" class="btn btn-primary">
              + Add Batch
            </button>
          </div>
        </div>

        <!-- Add Batch Form -->
        <div id="addBatchForm" class="form-panel hidden">
          <h3 style="margin-bottom:16px; font-size:16px;">Add New Batch</h3>
          <form id="batchForm">
            <div class="field-grid">
              <div>
                <label>Batch ID *</label>
                <input type="text" name="batch_id" placeholder="PO45001234" required />
              </div>
              <div>
                <label>Production Order</label>
                <input type="text" name="production_order" placeholder="PO45001234" />
              </div>
              <div>
                <label>Production Date</label>
                <input type="date" name="production_date" />
              </div>
              <div>
                <label>Country of Production</label>
                <input type="text" name="country_of_production" placeholder="Italy" />
              </div>
            </div>
            <p class="small muted" style="margin:-8px 0 14px;">Supplier and Factory are set via Field Values below, like every other field - not at creation time.</p>
            <button type="submit" class="btn btn-primary">Add Batch</button>
          </form>
        </div>

        <% if (batches && batches.length > 0) { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Batch ID</th>
                  <th>Production Order</th>
                  <th class="center">Styles</th>
                  <th class="center">GTINs</th>
                  <th class="center">SGTINs</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% batches.forEach(b => { %>
                  <tr>
                    <td class="mono"><strong><%= b.batch_id %></strong></td>
                    <td><%= b.production_order || '—' %></td>
                    <td class="center"><span class="badge badge-accent"><%= b.style_count || 0 %></span></td>
                    <td class="center"><span class="badge badge-accent"><%= b.gtin_count || 0 %></span></td>
                    <td class="center"><span class="badge badge-success"><%= b.sgtin_count || 0 %></span></td>
                    <td><a href="/admin-v2/batch/<%= b.id %>" class="link-action"><%- icon('arrow-right') %></a></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">No batches found</div>
        <% } %>
      <% } %>

      <!-- SGTINS TAB (Individual Units - one row per physical, serialized item) -->
      <% if (tab === 'sgtins') { %>
        <div class="section-head">
          <h2>Individual Units</h2>
          <input type="text" id="sgtinSearch" placeholder="Search Serial, GTIN, SKU, Batch, Style #..." style="width:300px;" value="<%= search || '' %>">
        </div>

        <% if (sgtins && sgtins.length > 0) { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Serial</th>
                  <th>GTIN</th>
                  <th>SKU / Name</th>
                  <th>Batch</th>
                  <th>QC Status</th>
                  <th>Produktpass</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% sgtins.forEach(sg => {
                  const dppUrl = `/01/${toGtin14(sg.gtin)}/21/${sg.serial_number}`;
                %>
                  <tr>
                    <td class="mono"><strong><%= sg.serial_number %></strong></td>
                    <td class="mono small"><%= sg.gtin %></td>
                    <td class="small">
                      <%= sg.item_number || '—' %>
                      <span class="muted" style="display:block;"><%= sg.product_name %></span>
                    </td>
                    <td class="mono small"><%= sg.batch_id %></td>
                    <td>
                      <% if (sg.qc_status === 'passed') { %>
                        <span class="badge badge-success small"><%- icon('check', { size: 12 }) %> Passed</span>
                      <% } else if (sg.qc_status === 'failed') { %>
                        <span class="badge badge-danger small"><%- icon('x', { size: 12 }) %> Failed</span>
                      <% } else { %>
                        <span class="badge badge-muted small">—</span>
                      <% } %>
                    </td>
                    <td><a href="<%= dppUrl %>" target="_blank" class="link-action"><%- icon('arrow-right') %></a></td>
                    <td><a href="/admin-v2/sgtin/<%= sg.id %>" class="link-action"><%- icon('arrow-right') %></a></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <% if (typeof sgtinTotalPages !== 'undefined' && sgtinTotalPages > 1) { %>
            <div style="display:flex; align-items:center; gap:14px; margin-top:16px;">
              <% const sgtinPageQuery = (p) => '/admin-v2?tab=sgtins&page=' + p + (search ? '&search=' + encodeURIComponent(search) : ''); %>
              <% if (sgtinPage > 1) { %>
                <a href="<%= sgtinPageQuery(sgtinPage - 1) %>" class="btn">Prev</a>
              <% } %>
              <span class="small muted">Page <%= sgtinPage %> of <%= sgtinTotalPages %> (<%= sgtinTotal %> units)</span>
              <% if (sgtinPage < sgtinTotalPages) { %>
                <a href="<%= sgtinPageQuery(sgtinPage + 1) %>" class="btn">Next</a>
              <% } %>
            </div>
          <% } %>
        <% } else { %>
          <div class="empty-state">No individual units found</div>
        <% } %>
      <% } %>

      <!-- SETTINGS TAB (2026-09-17) - global, system-wide configuration
           lives here with its own sub-nav rather than as separate
           top-level tabs. Natural place to add Users/Permissions later. -->
      <% if (tab === 'settings') { %>
        <div class="admin-nav" style="margin-bottom:24px; border-bottom:1px solid var(--hairline); padding-bottom:0;">
          <a href="/admin-v2?tab=settings&sub=fields" class="<%= settingsSub === 'fields' ? 'active' : '' %>">Field Config</a>
          <a href="/admin-v2?tab=settings&sub=product_types" class="<%= settingsSub === 'product_types' ? 'active' : '' %>">Product Types</a>
          <a href="/admin-v2?tab=settings&sub=access" class="<%= settingsSub === 'access' ? 'active' : '' %>">Digital Access</a>
        </div>
      <% } %>

      <!-- DIGITAL ACCESS TAB (2026-09-20) - the configurable roles list
           (Consumer, Authority, Recycler, ...) replacing the old
           consumer_visible/authority_visible booleans. Each field in
           Field Config picks which of these roles can see it. -->
      <% if (tab === 'settings' && settingsSub === 'access') { %>
        <div class="section-head">
          <h2>Digital Access</h2>
          <button onclick="document.getElementById('addRoleForm').classList.toggle('hidden')" class="btn btn-primary">
            + Add Role
          </button>
        </div>
        <p class="small muted" style="margin:-8px 0 20px;">Roles control who sees which DPP fields on the public passport (<code>?role=</code>). Set on each field in Field Config. "Requires Login" roles aren't selectable on the passport until they're authenticated - off means anyone can switch to that role today.</p>

        <div id="addRoleForm" class="form-panel hidden">
          <h3 style="margin-bottom:16px; font-size:16px;">Add New Role</h3>
          <form id="roleForm">
            <div class="field-grid">
              <div>
                <label>Role Key *</label>
                <input type="text" name="role_key" placeholder="customs" required />
              </div>
              <div>
                <label>Label *</label>
                <input type="text" name="label" placeholder="Customs" required />
              </div>
            </div>
            <label class="checkbox-row"><input type="checkbox" name="requires_auth" /> Requires Login</label>
            <div style="margin-top:14px;">
              <button type="submit" class="btn btn-primary">Add Role</button>
            </div>
          </form>
        </div>

        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Role Key</th>
                <th>Label</th>
                <th class="center">Default</th>
                <th class="center">Requires Login</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% roles.forEach(r => { %>
                <tr>
                  <td class="mono small"><strong><%= r.role_key %></strong></td>
                  <td><%= r.label %></td>
                  <td class="center"><%- r.is_default ? icon('check', { size: 14 }) : '—' %></td>
                  <td class="center"><%- r.requires_auth ? icon('lock', { size: 14 }) : '—' %></td>
                  <td style="white-space:nowrap;">
                    <a href="#" onclick="toggleRoleEdit(<%= r.id %>); return false;" class="link-action" style="margin-right:12px;">Edit</a>
                    <% if (!r.is_default) { %>
                      <a href="#" onclick="deleteRole(<%= r.id %>, '<%= r.role_key %>'); return false;" class="link-action danger">Delete</a>
                    <% } %>
                  </td>
                </tr>
                <tr id="role-edit-row-<%= r.id %>" class="hidden">
                  <td colspan="5" style="background:var(--surface-2); padding:20px;">
                    <form onsubmit="saveRoleEdit(event, <%= r.id %>)">
                      <div class="field-grid-3" style="margin-bottom:14px;">
                        <div>
                          <label class="label-sm">Label</label>
                          <input type="text" name="label" value="<%= r.label %>" required />
                        </div>
                        <div>
                          <label class="checkbox-row" style="margin-top:22px;"><input type="checkbox" name="requires_auth" <%= r.requires_auth ? 'checked' : '' %> /> Requires Login</label>
                        </div>
                      </div>
                      <div style="display:flex; gap:10px;">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <button type="button" onclick="toggleRoleEdit(<%= r.id %>)" class="btn">Cancel</button>
                      </div>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <script>
          function toggleRoleEdit(roleId) {
            document.getElementById('role-edit-row-' + roleId).classList.toggle('hidden');
          }

          document.getElementById('roleForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = {
              role_key: formData.get('role_key'),
              label: formData.get('label'),
              requires_auth: formData.has('requires_auth')
            };
            try {
              const response = await fetch('/admin-v2/roles', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
              });
              const result = await response.json();
              if (result.success) {
                location.reload();
              } else {
                await dppAlert('Error: ' + (result.error || 'Unknown error'));
              }
            } catch (err) {
              await dppAlert('Error: ' + err.message);
            }
          });

          async function saveRoleEdit(e, roleId) {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = {
              label: formData.get('label'),
              requires_auth: formData.has('requires_auth')
            };
            try {
              const response = await fetch('/admin-v2/roles/' + roleId, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
              });
              const result = await response.json();
              if (result.success) {
                location.reload();
              } else {
                await dppAlert('Error: ' + (result.error || 'Unknown error'));
              }
            } catch (err) {
              await dppAlert('Error: ' + err.message);
            }
          }

          async function deleteRole(roleId, roleKey) {
            if (!(await dppConfirm('Delete role "' + roleKey + '"? Fields set to only this role will become invisible on the passport until reconfigured.'))) return;
            try {
              const response = await fetch('/admin-v2/roles/' + roleId, { method: 'DELETE' });
              const result = await response.json();
              if (result.success) {
                location.reload();
              } else {
                await dppAlert('Error: ' + (result.error || 'Unknown error'));
              }
            } catch (err) {
              await dppAlert('Error: ' + err.message);
            }
          }
        </script>
      <% } %>

      <!-- FIELDS TAB (Field Config - field_definitions) -->
      <% if (tab === 'settings' && settingsSub === 'fields') { %>
        <!-- Passport Sections (2026-09-20) - the headings shown on the
             public passport (was hardcoded "EU Required Information" /
             "Transparency" / "Nudie Information"). Each field below
             picks one of these sections; a section with no fields
             assigned simply doesn't render on the passport. -->
        <div class="section-head">
          <h2>Passport Sections</h2>
          <button onclick="document.getElementById('addSectionForm').classList.toggle('hidden')" class="btn btn-primary">
            + Add Section
          </button>
        </div>
        <p class="small muted" style="margin:-8px 0 20px;">Controls the section headings/icons/order shown on the public passport. Assign each field to a section below.</p>

        <div id="addSectionForm" class="form-panel hidden">
          <h3 style="margin-bottom:16px; font-size:16px;">Add New Section</h3>
          <form id="sectionForm">
            <div class="field-grid-3">
              <div>
                <label>Section Key *</label>
                <input type="text" name="section_key" placeholder="materials" required />
              </div>
              <div>
                <label>Label *</label>
                <input type="text" name="label" placeholder="Materials" required />
              </div>
              <div>
                <label>Icon</label>
                <select name="icon">
                  <% sectionIconOptions.forEach(opt => { %>
                    <option value="<%= opt.key %>"><%= opt.label %></option>
                  <% }); %>
                </select>
              </div>
            </div>
            <div style="margin-top:14px;">
              <button type="submit" class="btn btn-primary">Add Section</button>
            </div>
          </form>
        </div>

        <div class="table-wrap" style="margin-bottom:32px;">
          <table>
            <thead>
              <tr>
                <th>Icon</th>
                <th>Section Key</th>
                <th>Label</th>
                <th>Order</th>
                <th>Fields</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% sections.forEach(s => {
                const fieldCount = fields ? fields.filter(f => f.section_id === s.id).length : 0;
              %>
                <tr>
                  <td><%- icon(s.icon, { size: 16 }) %></td>
                  <td class="mono small"><strong><%= s.section_key %></strong></td>
                  <td><%= s.label %></td>
                  <td class="small muted"><%= s.sort_order %></td>
                  <td class="small muted"><%= fieldCount %></td>
                  <td style="white-space:nowrap;">
                    <a href="#" onclick="toggleSectionEdit(<%= s.id %>); return false;" class="link-action" style="margin-right:12px;">Edit</a>
                    <a href="#" onclick="deleteSection(<%= s.id %>, '<%= s.section_key %>', <%= fieldCount %>); return false;" class="link-action danger">Delete</a>
                  </td>
                </tr>
                <tr id="section-edit-row-<%= s.id %>" class="hidden">
                  <td colspan="6" style="background:var(--surface-2); padding:20px;">
                    <form onsubmit="saveSectionEdit(event, <%= s.id %>)">
                      <div class="field-grid-3" style="margin-bottom:14px;">
                        <div>
                          <label class="label-sm">Label</label>
                          <input type="text" name="label" value="<%= s.label %>" required />
                        </div>
                        <div>
                          <label class="label-sm">Icon</label>
                          <select name="icon">
                            <% sectionIconOptions.forEach(opt => { %>
                              <option value="<%= opt.key %>" <%= s.icon === opt.key ? 'selected' : '' %>><%= opt.label %></option>
                            <% }); %>
                          </select>
                        </div>
                        <div>
                          <label class="label-sm">Sort Order</label>
                          <input type="number" name="sort_order" value="<%= s.sort_order %>" />
                        </div>
                      </div>
                      <div style="display:flex; gap:10px;">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <button type="button" onclick="toggleSectionEdit(<%= s.id %>)" class="btn">Cancel</button>
                      </div>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <script>
          function toggleSectionEdit(sectionId) {
            document.getElementById('section-edit-row-' + sectionId).classList.toggle('hidden');
          }

          document.getElementById('sectionForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = {
              section_key: formData.get('section_key'),
              label: formData.get('label'),
              icon: formData.get('icon')
            };
            try {
              const response = await fetch('/api/admin/fields/sections', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
              });
              const result = await response.json();
              if (result.success) {
                location.reload();
              } else {
                await dppAlert('Error: ' + (result.error || 'Unknown error'));
              }
            } catch (err) {
              await dppAlert('Error: ' + err.message);
            }
          });

          async function saveSectionEdit(e, sectionId) {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = {
              label: formData.get('label'),
              icon: formData.get('icon'),
              sort_order: Number(formData.get('sort_order'))
            };
            try {
              const response = await fetch('/api/admin/fields/sections/' + sectionId, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
              });
              const result = await response.json();
              if (result.success) {
                location.reload();
              } else {
                await dppAlert('Error: ' + (result.error || 'Unknown error'));
              }
            } catch (err) {
              await dppAlert('Error: ' + err.message);
            }
          }

          async function deleteSection(sectionId, sectionKey, fieldCount) {
            if (fieldCount > 0) {
              await dppAlert('Cannot delete "' + sectionKey + '" - ' + fieldCount + ' field(s) are still assigned to it. Reassign them to another section first.');
              return;
            }
            if (!(await dppConfirm('Delete section "' + sectionKey + '"?'))) return;
            try {
              const response = await fetch('/api/admin/fields/sections/' + sectionId, { method: 'DELETE' });
              const result = await response.json();
              if (result.success) {
                location.reload();
              } else {
                await dppAlert('Error: ' + (result.error || 'Unknown error'));
              }
            } catch (err) {
              await dppAlert('Error: ' + err.message);
            }
          }
        </script>

        <div class="section-head">
          <h2>Field Config</h2>
          <button onclick="document.getElementById('addFieldForm').classList.toggle('hidden')" class="btn btn-primary">
            + Add Field
          </button>
        </div>

        <!-- Add Field Form -->
        <div id="addFieldForm" class="form-panel hidden">
          <h3 style="margin-bottom:16px; font-size:16px;">Add New Field</h3>
          <form id="fieldForm">
            <div class="field-grid">
              <div>
                <label>Field Key *</label>
                <input type="text" name="field_key" placeholder="fiber_composition" required />
              </div>
              <div>
                <label>Label *</label>
                <input type="text" name="label" placeholder="Fiber Composition" required />
              </div>
              <div>
                <label>Category *</label>
                <select name="category" required>
                  <option value="">-- Select Category --</option>
                  <option value="eu_required">EU Required</option>
                  <option value="nudie">Nudie Specific</option>
                </select>
              </div>
              <div>
                <label>Data Type</label>
                <select name="data_type">
                  <option value="text">Text</option>
                  <option value="textarea">Textarea</option>
                  <option value="number">Number</option>
                  <option value="date">Date</option>
                  <option value="url">URL</option>
                  <option value="json">Structured (JSON)</option>
                  <option value="repeating_group">Repeating list (managed elsewhere)</option>
                </select>
              </div>
              <div>
                <label>Section (passport heading)</label>
                <select name="section_id">
                  <option value="">-- Default for category --</option>
                  <% sections.forEach(s => { %>
                    <option value="<%= s.id %>"><%= s.label %></option>
                  <% }); %>
                </select>
              </div>
            </div>
            <div class="field-row">
              <label>Description</label>
              <input type="text" name="description" placeholder="Field description" />
            </div>
            <div class="field-row" style="display:flex; gap:20px;">
              <label class="checkbox-row"><input type="checkbox" name="required" /> Required</label>
              <label class="checkbox-row"><input type="checkbox" name="locks_at_production" /> Locks at Production</label>
            </div>
            <p class="small muted" style="margin:-8px 0 14px;">EU-required fields normally lock when a batch is marked produced (proving the compliance data is fixed); Nudie fields normally stay editable. Check/uncheck to override that default for this field.</p>
            <div class="hint-panel" style="margin-bottom:14px;">
              <label style="display:block; margin-bottom:10px;">Visible to which roles on the public passport?</label>
              <div style="display:flex; gap:18px; flex-wrap:wrap;">
                <% roles.forEach(r => { %>
                  <label class="checkbox-row"><input type="checkbox" name="role_ids" value="<%= r.id %>" checked /> <%= r.label %></label>
                <% }); %>
              </div>
              <p class="small muted" style="margin:10px 0 0;">Manage the role list itself under Settings &rsaquo; Digital Access.</p>
            </div>
            <div class="hint-panel">
              <label style="display:block; margin-bottom:10px;">Which levels can set this field?</label>
              <div style="display:flex; gap:18px;">
                <label class="checkbox-row"><input type="checkbox" name="editable_at_style" checked /> Style</label>
                <label class="checkbox-row"><input type="checkbox" name="editable_at_variant" checked /> Variant</label>
                <label class="checkbox-row"><input type="checkbox" name="editable_at_gtin" /> GTIN (Masterdata)</label>
                <label class="checkbox-row"><input type="checkbox" name="editable_at_batch" checked /> Batch</label>
                <label class="checkbox-row"><input type="checkbox" name="editable_at_batch_gtin" /> GTIN (Batch)</label>
                <label class="checkbox-row"><input type="checkbox" name="editable_at_sgtin" /> SGTIN</label>
              </div>
              <p class="small muted" style="margin:10px 0 0;">The field only appears as an editable row on the levels checked here. GTIN (Masterdata) is the GTIN's own detail page; GTIN (Batch) is that GTIN scoped to one Batch in the Batch tree - independent settings.</p>
            </div>
            <button type="submit" class="btn btn-primary">Add Field</button>
          </form>
        </div>

        <!-- Category Filter -->
        <% if (categories && categories.length > 0) { %>
          <div class="filter-pills">
            <a href="/admin-v2?tab=settings&sub=fields" class="<%= !selectedCategory ? 'active' : '' %>">All</a>
            <% categories.forEach(cat => { %>
              <a href="/admin-v2?tab=settings&sub=fields&category=<%= cat %>" class="<%= selectedCategory === cat ? 'active' : '' %>">
                <%= cat.replace('_', ' ').toUpperCase() %>
              </a>
            <% }); %>
          </div>
        <% } %>

        <!-- Fields List -->
        <% if (fields && fields.length > 0) { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Field Key</th>
                  <th>Label</th>
                  <th>Category</th>
                  <th title="Which passport heading this field renders under - manage sections above">Section</th>
                  <th>Type</th>
                  <th>Levels</th>
                  <th class="center">Required</th>
                  <th title="Which passport roles see this field - manage the role list under Settings > Digital Access">Roles</th>
                  <th class="center" title="Whether this field's value freezes when a batch is marked produced">Locks</th>
                  <th>Description</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% fields.forEach(f => {
                  const levels = [
                    { key: 'editable_at_style', short: 'S', name: 'Style' },
                    { key: 'editable_at_variant', short: 'V', name: 'Variant' },
                    { key: 'editable_at_gtin', short: 'G', name: 'GTIN (Masterdata)' },
                    { key: 'editable_at_batch', short: 'B', name: 'Batch' },
                    { key: 'editable_at_batch_gtin', short: 'BG', name: 'GTIN (Batch)' },
                    { key: 'editable_at_sgtin', short: 'SG', name: 'SGTIN' }
                  ];
                  const fieldSection = sections.find(s => s.id === f.section_id);
                %>
                  <tr>
                    <td class="mono small"><strong><%= f.field_key %></strong></td>
                    <td><%= f.label %></td>
                    <td>
                      <% if (f.category === 'eu_required') { %>
                        <span class="badge badge-accent">EU Required</span>
                      <% } else if (f.category === 'nudie') { %>
                        <span class="badge">Nudie</span>
                      <% } else { %>
                        <span class="badge badge-muted"><%= f.category %></span>
                      <% } %>
                    </td>
                    <td class="small muted"><%= fieldSection ? fieldSection.label : '—' %></td>
                    <td class="small muted"><%= f.data_type || 'text' %></td>
                    <td>
                      <div style="display:flex; gap:4px;">
                        <% levels.forEach(lvl => { %>
                          <span title="<%= lvl.name %>" class="level-pill <%= f[lvl.key] ? 'on' : '' %>"><%= lvl.short %></span>
                        <% }); %>
                      </div>
                    </td>
                    <td class="center"><%- f.required ? icon('check', { size: 14 }) : '—' %></td>
                    <td>
                      <% const fieldRoleLabels = roles.filter(r => f.role_ids.includes(r.id)).map(r => r.label); %>
                      <% if (fieldRoleLabels.length === 0) { %>
                        <span class="small muted">None</span>
                      <% } else { %>
                        <div style="display:flex; gap:4px; flex-wrap:wrap;">
                          <% fieldRoleLabels.forEach(label => { %>
                            <span class="badge small"><%= label %></span>
                          <% }); %>
                        </div>
                      <% } %>
                    </td>
                    <td class="center"><%- f.locks_at_production ? icon('lock', { size: 14 }) : '—' %></td>
                    <td class="small muted"><%= f.description || '—' %></td>
                    <td style="white-space:nowrap;">
                      <a href="#" onclick="toggleFieldEdit(<%= f.id %>); return false;" class="link-action" style="margin-right:12px;">Edit</a>
                      <a href="#" onclick="deleteField(<%= f.id %>, '<%= f.field_key %>'); return false;" class="link-action danger">Delete</a>
                    </td>
                  </tr>
                  <tr id="field-edit-row-<%= f.id %>" class="hidden">
                    <td colspan="11" style="background:var(--surface-2); padding:20px;">
                      <form onsubmit="saveFieldEdit(event, <%= f.id %>)">
                        <div class="field-grid-3" style="margin-bottom:14px;">
                          <div>
                            <label class="label-sm">Label</label>
                            <input type="text" name="label" value="<%= f.label %>" required />
                          </div>
                          <div>
                            <label class="label-sm">Category</label>
                            <select name="category">
                              <option value="eu_required" <%= f.category === 'eu_required' ? 'selected' : '' %>>EU Required</option>
                              <option value="nudie" <%= f.category === 'nudie' ? 'selected' : '' %>>Nudie Specific</option>
                            </select>
                          </div>
                          <div>
                            <label class="label-sm">Description</label>
                            <input type="text" name="description" value="<%= f.description || '' %>" />
                          </div>
                          <div>
                            <label class="label-sm">Section (passport heading)</label>
                            <select name="section_id">
                              <option value="">-- None --</option>
                              <% sections.forEach(s => { %>
                                <option value="<%= s.id %>" <%= f.section_id === s.id ? 'selected' : '' %>><%= s.label %></option>
                              <% }); %>
                            </select>
                          </div>
                        </div>
                        <div style="display:flex; gap:20px; margin-bottom:14px;">
                          <label class="checkbox-row"><input type="checkbox" name="required" <%= f.required ? 'checked' : '' %> /> Required</label>
                          <label class="checkbox-row"><input type="checkbox" name="locks_at_production" <%= f.locks_at_production ? 'checked' : '' %> /> Locks at Production</label>
                        </div>
                        <div style="margin-bottom:14px;">
                          <label class="label-sm" style="display:block; margin-bottom:8px;">Visible to which roles?</label>
                          <div style="display:flex; gap:18px; flex-wrap:wrap;">
                            <% roles.forEach(r => { %>
                              <label class="checkbox-row">
                                <input type="checkbox" name="role_ids" value="<%= r.id %>" <%= f.role_ids.includes(r.id) ? 'checked' : '' %> /> <%= r.label %>
                              </label>
                            <% }); %>
                          </div>
                        </div>
                        <div style="margin-bottom:14px;">
                          <label class="label-sm" style="display:block; margin-bottom:8px;">Levels</label>
                          <div style="display:flex; gap:18px;">
                            <% levels.forEach(lvl => { %>
                              <label class="checkbox-row">
                                <input type="checkbox" name="<%= lvl.key %>" <%= f[lvl.key] ? 'checked' : '' %> /> <%= lvl.name %>
                              </label>
                            <% }); %>
                          </div>
                        </div>
                        <div style="display:flex; gap:10px;">
                          <button type="submit" class="btn btn-primary">Save</button>
                          <button type="button" onclick="toggleFieldEdit(<%= f.id %>)" class="btn">Cancel</button>
                        </div>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">No fields found</div>
        <% } %>

        <script>
          function toggleFieldEdit(fieldId) {
            document.getElementById('field-edit-row-' + fieldId).classList.toggle('hidden');
          }

          async function saveFieldEdit(e, fieldId) {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = {
              label: formData.get('label'),
              category: formData.get('category'),
              description: formData.get('description'),
              section_id: formData.get('section_id'),
              required: formData.has('required'),
              role_ids: formData.getAll('role_ids').map(Number),
              locks_at_production: formData.has('locks_at_production'),
              editable_at_style: formData.has('editable_at_style'),
              editable_at_variant: formData.has('editable_at_variant'),
              editable_at_batch: formData.has('editable_at_batch'),
              editable_at_gtin: formData.has('editable_at_gtin'),
              editable_at_batch_gtin: formData.has('editable_at_batch_gtin'),
              editable_at_sgtin: formData.has('editable_at_sgtin')
            };

            try {
              const response = await fetch('/api/admin/fields/' + fieldId, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
              });
              const result = await response.json();
              if (result.success) {
                location.reload();
              } else {
                await dppAlert('Error: ' + (result.error || 'Unknown error'));
              }
            } catch (err) {
              await dppAlert('Error: ' + err.message);
            }
          }

          async function deleteField(fieldId, fieldKey) {
            if (!(await dppConfirm('Delete field "' + fieldKey + '"? This only works if no values have been set for it anywhere.'))) return;

            try {
              const response = await fetch('/api/admin/fields/' + fieldId, { method: 'DELETE' });
              const result = await response.json();
              if (result.success) {
                location.reload();
              } else {
                await dppAlert('Error: ' + (result.error || 'Unknown error'));
              }
            } catch (err) {
              await dppAlert('Error: ' + err.message);
            }
          }

          document.getElementById('fieldForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = {
              field_key: formData.get('field_key'),
              label: formData.get('label'),
              category: formData.get('category'),
              data_type: formData.get('data_type'),
              section_id: formData.get('section_id'),
              description: formData.get('description'),
              required: formData.has('required'),
              role_ids: formData.getAll('role_ids').map(Number),
              locks_at_production: formData.has('locks_at_production'),
              editable_at_style: formData.has('editable_at_style'),
              editable_at_variant: formData.has('editable_at_variant'),
              editable_at_batch: formData.has('editable_at_batch'),
              editable_at_gtin: formData.has('editable_at_gtin'),
              editable_at_batch_gtin: formData.has('editable_at_batch_gtin'),
              editable_at_sgtin: formData.has('editable_at_sgtin')
            };

            try {
              const response = await fetch('/api/admin/fields', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
              });

              const result = await response.json();
              if (result.success) {
                await dppAlert('Field created successfully');
                location.reload();
              } else {
                await dppAlert('Error: ' + (result.error || 'Unknown error'));
              }
            } catch (err) {
              await dppAlert('Error: ' + err.message);
            }
          });
        </script>
      <% } %>

      <!-- PRODUCT TYPES TAB (GS1 hierarchy design, 2026-09-19) - which
           levels make up a product's identifier/QR code, configured
           per product type. See CHANGELOG.md for the three schemes. -->
      <% if (tab === 'settings' && settingsSub === 'product_types') { %>
        <div class="section-head">
          <h2>Product Types</h2>
          <button onclick="document.getElementById('addProductTypeForm').classList.toggle('hidden')" class="btn btn-primary">
            + Add Product Type
          </button>
        </div>

        <p class="small muted" style="margin-bottom:20px;">
          Controls which levels make up a product's identifier/QR code.
          "Full hierarchy" is a serialized individual unit per garment
          (today's default). "Batch + GTIN, no individual units" shares
          one code across a whole production run - no per-garment
          tracking. "Individual units, no Batch" serializes each unit
          but doesn't let Batch-level overrides affect its passport.
        </p>

        <!-- Add Product Type Form -->
        <div id="addProductTypeForm" class="form-panel hidden">
          <h3 style="margin-bottom:16px; font-size:16px;">Add Product Type</h3>
          <form id="productTypeForm">
            <div class="field-grid">
              <div>
                <label>Key *</label>
                <input type="text" name="key" placeholder="denim" required />
              </div>
              <div>
                <label>Label *</label>
                <input type="text" name="label" placeholder="Denim" required />
              </div>
              <div>
                <label>GS1 Scheme</label>
                <select name="gs1_scheme">
                  <option value="batch_gtin_sgtin">Full hierarchy (Batch + GTIN + SGTIN)</option>
                  <option value="batch_gtin">Batch + GTIN, no individual units</option>
                  <option value="gtin_sgtin">Individual units, no Batch (GTIN + SGTIN)</option>
                </select>
              </div>
            </div>
            <button type="submit" class="btn btn-primary">Add Product Type</button>
          </form>
        </div>

        <% if (productTypes && productTypes.length > 0) { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Label</th>
                  <th>Key</th>
                  <th>GS1 Scheme</th>
                  <th class="center">Styles</th>
                </tr>
              </thead>
              <tbody>
                <% const schemeLabels = {
                  batch_gtin_sgtin: 'Full hierarchy',
                  batch_gtin: 'Batch + GTIN only',
                  gtin_sgtin: 'GTIN + SGTIN only'
                }; %>
                <% productTypes.forEach(pt => { %>
                  <tr>
                    <td><strong><%= pt.label %></strong></td>
                    <td class="mono small"><%= pt.key %></td>
                    <td>
                      <select onchange="updateProductTypeScheme(<%= pt.id %>, this.value)">
                        <option value="batch_gtin_sgtin" <%= pt.gs1_scheme === 'batch_gtin_sgtin' ? 'selected' : '' %>>Full hierarchy (Batch + GTIN + SGTIN)</option>
                        <option value="batch_gtin" <%= pt.gs1_scheme === 'batch_gtin' ? 'selected' : '' %>>Batch + GTIN, no individual units</option>
                        <option value="gtin_sgtin" <%= pt.gs1_scheme === 'gtin_sgtin' ? 'selected' : '' %>>Individual units, no Batch (GTIN + SGTIN)</option>
                      </select>
                    </td>
                    <td class="center"><%= pt.style_count || 0 %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">No product types configured yet</div>
        <% } %>

        <script>
          async function updateProductTypeScheme(id, gs1Scheme) {
            try {
              const response = await fetch('/admin-v2/product-types/' + id, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ gs1_scheme: gs1Scheme })
              });
              const result = await response.json();
              if (!result.success) {
                await dppAlert('Error: ' + (result.error || 'Unknown error'));
                location.reload();
              }
            } catch (err) {
              await dppAlert('Error: ' + err.message);
              location.reload();
            }
          }

          document.getElementById('productTypeForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData.entries());
            try {
              const response = await fetch('/admin-v2/product-types', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
              });
              const result = await response.json();
              if (result.success) {
                location.reload();
              } else {
                await dppAlert('Error: ' + (result.error || 'Unknown error'));
              }
            } catch (err) {
              await dppAlert('Error: ' + err.message);
            }
          });
        </script>
      <% } %>

      <!-- ACCESS TAB (placeholder - user accounts/roles/permissions
           not built yet, added here so the Settings sub-nav already
           has its future home) -->
      <% if (tab === 'settings' && settingsSub === 'access') { %>
        <div class="section-head">
          <h2>Access</h2>
        </div>
        <div class="empty-state">
          User accounts and role-based permissions - feature arriving soon.
        </div>
      <% } %>

      <!-- ANALYTICS TAB (Scan statistics) -->
      <% if (tab === 'analytics') { %>
        <div class="section-head">
          <h2>Scan Analytics</h2>
        </div>

        <div class="stat-grid">
          <div class="stat-card">
            <div class="stat-label">Total Scans</div>
            <div class="stat-value"><%= totals.total_scans || 0 %></div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Unique Products Scanned</div>
            <div class="stat-value"><%= totals.unique_sgtins_scanned || 0 %></div>
          </div>
          <div class="stat-card">
            <div class="stat-label">First Scan</div>
            <div class="stat-value" style="font-size:16px;">
              <%= totals.first_scan ? new Date(totals.first_scan).toLocaleDateString('sv-SE') : '–' %>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Last Scan</div>
            <div class="stat-value" style="font-size:16px;">
              <%= totals.last_scan ? new Date(totals.last_scan).toLocaleDateString('sv-SE') : '–' %>
            </div>
          </div>
        </div>

        <div style="margin-bottom:32px;">
          <h3 style="font-size:16px; margin-bottom:16px;">Scans per day (last 14 days with activity)</h3>
          <% if (scansByDay.length > 0) { %>
            <% const maxCount = Math.max(...scansByDay.map(d => d.scan_count)); %>
            <% scansByDay.forEach(d => { %>
              <div class="bar-row">
                <div class="bar-label"><%= d.day %></div>
                <div class="bar-track">
                  <div class="bar-fill" style="width: <%= Math.round((d.scan_count / maxCount) * 100) %>%"></div>
                </div>
                <div class="bar-count"><%= d.scan_count %></div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="empty-state">No scan data yet</div>
          <% } %>
        </div>

        <div style="margin-bottom:32px;">
          <h3 style="font-size:16px; margin-bottom:16px;">Most scanned products</h3>
          <% if (topProducts.length > 0) { %>
            <table>
              <thead>
                <tr>
                  <th>Style</th>
                  <th>GTIN</th>
                  <th style="text-align:right;">Scans</th>
                </tr>
              </thead>
              <tbody>
                <% topProducts.forEach(p => { %>
                  <tr>
                    <td class="small"><%= p.style_number %> <span class="muted"><%= p.product_name || '' %></span></td>
                    <td class="small mono"><%= p.gtin %></td>
                    <td class="small" style="text-align:right; font-weight:600;"><%= p.scan_count %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } else { %>
            <div class="empty-state">No scan data yet</div>
          <% } %>
        </div>

        <div>
          <h3 style="font-size:16px; margin-bottom:16px;">Recent scans</h3>
          <% if (recentScans.length > 0) { %>
            <table>
              <thead>
                <tr>
                  <th>Time</th>
                  <th>Style</th>
                  <th>Serial</th>
                  <th>Batch</th>
                  <th>Method</th>
                  <th>Location</th>
                </tr>
              </thead>
              <tbody>
                <% recentScans.forEach(sc => { %>
                  <tr>
                    <td class="small"><%= new Date(sc.scan_timestamp).toLocaleString('sv-SE') %></td>
                    <td class="small"><%= sc.style_number %> <span class="muted"><%= sc.product_name || '' %></span></td>
                    <td class="small mono"><%= sc.serial_number %></td>
                    <td class="small"><%= sc.batch_id %></td>
                    <td class="small"><%= sc.scan_method || '–' %></td>
                    <td class="small"><%= sc.scan_location || '–' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } else { %>
            <div class="empty-state">No scans logged yet</div>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>

  <script>
    document.getElementById('productSearch')?.addEventListener('change', function() {
      window.location = '/admin-v2?tab=products&search=' + encodeURIComponent(this.value);
    });

    // Products tab: 3-level accordion (Style > Variant > GTIN). A row
    // is visible only if every ancestor group it declares
    // (data-parent, data-grandparent) is expanded - recomputed as a
    // whole on every toggle rather than blindly flipping classList,
    // so a GTIN nested under a Variant can't end up visible while its
    // Style is collapsed (or vice versa via stale toggle state).
    const productGroupState = {};

    function initGroup(key, isExpanded) {
      productGroupState[key] = isExpanded;
    }

    function toggleGroup(key) {
      productGroupState[key] = !productGroupState[key];
      renderProductVisibility();
    }

    function renderProductVisibility() {
      document.querySelectorAll('[data-parent]').forEach(row => {
        let visible = !!productGroupState[row.getAttribute('data-parent')];
        const grandparent = row.getAttribute('data-grandparent');
        if (visible && grandparent) visible = !!productGroupState[grandparent];
        row.classList.toggle('hidden', !visible);
      });
      document.querySelectorAll('[data-chevron]').forEach(chevron => {
        const key = chevron.getAttribute('data-chevron');
        chevron.style.transform = productGroupState[key] ? 'rotate(90deg)' : '';
      });
    }

    document.getElementById('batchSearch')?.addEventListener('change', function() {
      const style = <%- JSON.stringify(typeof selectedStyleId !== 'undefined' ? selectedStyleId : null) %>;
      window.location = '/admin-v2?tab=batches' + (style ? '&style=' + style : '') + '&search=' + encodeURIComponent(this.value);
    });

    document.getElementById('sgtinSearch')?.addEventListener('change', function() {
      window.location = '/admin-v2?tab=sgtins&search=' + encodeURIComponent(this.value);
    });

    document.getElementById('styleForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const data = {
        style_number: formData.get('style_number'),
        product_name: formData.get('product_name'),
        product_type: formData.get('product_type')
      };

      try {
        const response = await fetch('/api/admin/styles', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        const result = await response.json();
        if (result.success) {
          await dppAlert('Style created successfully');
          location.reload();
        } else {
          await dppAlert('Error: ' + (result.error || 'Unknown error'));
        }
      } catch (err) {
        await dppAlert('Error: ' + err.message);
      }
    });

    document.getElementById('batchForm')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const data = {
        batch_id: formData.get('batch_id'),
        production_order: formData.get('production_order'),
        production_date: formData.get('production_date'),
        country_of_production: formData.get('country_of_production')
      };

      try {
        const response = await fetch('/admin-v2/batch', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        const result = await response.json();
        if (result.success) {
          await dppAlert('Batch created successfully');
          location.reload();
        } else {
          await dppAlert('Error: ' + (result.error || 'Unknown error'));
        }
      } catch (err) {
        await dppAlert('Error: ' + err.message);
      }
    });
  </script>
</body>
</html>
