<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DPP Hub v2</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
  <div class="max-w-7xl mx-auto py-12 px-4">
    <!-- Header -->
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-4xl font-bold text-gray-900">DPP Hub v2</h1>
      <div class="flex items-center gap-4">
        <span class="text-sm text-gray-600"><%= user.username %></span>
        <a href="/login" class="bg-gray-900 text-white px-4 py-2 rounded hover:bg-gray-800">Logout</a>
      </div>
    </div>

    <!-- Tabs -->
    <div class="flex gap-4 mb-8 border-b border-gray-300">
      <a href="/admin-v2" class="px-6 py-4 font-semibold <%= tab === 'styles' ? 'text-gray-900 border-b-2 border-gray-900' : 'text-gray-700' %>">Styles</a>
      <a href="/admin-v2?tab=variants" class="px-6 py-4 font-semibold <%= tab === 'variants' ? 'text-gray-900 border-b-2 border-gray-900' : 'text-gray-700' %>">Variants</a>
      <a href="/admin-v2?tab=gtins" class="px-6 py-4 font-semibold <%= tab === 'gtins' ? 'text-gray-900 border-b-2 border-gray-900' : 'text-gray-700' %>">GTINs</a>
      <a href="/admin-v2?tab=batches" class="px-6 py-4 font-semibold <%= tab === 'batches' ? 'text-gray-900 border-b-2 border-gray-900' : 'text-gray-700' %>">Batches</a>
      <a href="/admin-v2?tab=sgtins" class="px-6 py-4 font-semibold <%= tab === 'sgtins' ? 'text-gray-900 border-b-2 border-gray-900' : 'text-gray-700' %>">SGTINs</a>
      <a href="/admin-v2?tab=fields" class="px-6 py-4 font-semibold <%= tab === 'fields' ? 'text-gray-900 border-b-2 border-gray-900' : 'text-gray-700' %>">DPP Fields</a>
    </div>

    <div class="bg-white rounded-lg shadow-md p-8">
      <!-- STYLES TAB -->
      <% if (tab === 'styles') { %>
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-2xl font-bold text-gray-900">Styles Masterdata</h2>
        </div>

        <% if (styles && styles.length > 0) { %>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr class="bg-gray-100 border-b border-gray-300">
                  <th class="px-4 py-3 text-left font-semibold">Style #</th>
                  <th class="px-4 py-3 text-left font-semibold">Name</th>
                  <th class="px-4 py-3 text-left font-semibold">Type</th>
                  <th class="px-4 py-3 text-center font-semibold">Variants</th>
                  <th class="px-4 py-3 text-center font-semibold">GTINs</th>
                  <th class="px-4 py-3 text-center font-semibold">SGTINs</th>
                  <th class="px-4 py-3 text-left font-semibold">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% styles.forEach(s => { %>
                  <tr class="border-b border-gray-200 hover:bg-gray-50">
                    <td class="px-4 py-3 font-mono text-sm"><strong><%= s.style_number %></strong></td>
                    <td class="px-4 py-3"><%= s.product_name %></td>
                    <td class="px-4 py-3 text-sm text-gray-600"><%= s.product_type %></td>
                    <td class="px-4 py-3 text-center text-sm"><span class="bg-purple-100 text-purple-900 px-2 py-1 rounded"><%= s.variant_count || 0 %></span></td>
                    <td class="px-4 py-3 text-center text-sm"><span class="bg-blue-100 text-blue-900 px-2 py-1 rounded"><%= s.gtin_count || 0 %></span></td>
                    <td class="px-4 py-3 text-center text-sm"><span class="bg-green-100 text-green-900 px-2 py-1 rounded"><%= s.sgtin_count || 0 %></span></td>
                    <td class="px-4 py-3 text-sm"><a href="/admin-v2/style/<%= s.id %>" class="text-blue-600 hover:underline">Detail →</a></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="text-center py-12 text-gray-500">No styles found</div>
        <% } %>
      <% } %>

      <!-- VARIANTS TAB -->
      <% if (tab === 'variants') { %>
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-2xl font-bold text-gray-900">Product Variants</h2>
          <% if (styles && styles.length > 0) { %>
            <select id="filterStyle" class="border border-gray-300 rounded px-3 py-2" onchange="window.location = '/admin-v2?tab=variants&style=' + this.value">
              <option value="">All Styles</option>
              <% styles.forEach(s => { %>
                <option value="<%= s.id %>" <%= typeof selectedStyleId !== 'undefined' && selectedStyleId == s.id ? 'selected' : '' %>><%= s.style_number %> - <%= s.product_name %></option>
              <% }); %>
            </select>
          <% } %>
        </div>

        <% if (variants && variants.length > 0) { %>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr class="bg-gray-100 border-b border-gray-300">
                  <th class="px-4 py-3 text-left font-semibold">Style</th>
                  <th class="px-4 py-3 text-left font-semibold">Style #</th>
                  <th class="px-4 py-3 text-left font-semibold">Variant</th>
                  <th class="px-4 py-3 text-center font-semibold">GTINs</th>
                  <th class="px-4 py-3 text-center font-semibold">SGTINs</th>
                  <th class="px-4 py-3 text-left font-semibold">Action</th>
                </tr>
              </thead>
              <tbody>
                <% variants.forEach(v => { %>
                  <tr class="border-b border-gray-200 hover:bg-gray-50">
                    <td class="px-4 py-3"><%= v.product_name %></td>
                    <td class="px-4 py-3 font-mono text-sm"><strong><%= v.style_number %></strong></td>
                    <td class="px-4 py-3 font-mono text-lg"><strong><%= v.variant_name %></strong></td>
                    <td class="px-4 py-3 text-center"><span class="bg-blue-100 text-blue-900 px-2 py-1 rounded"><%= v.gtin_count || 0 %></span></td>
                    <td class="px-4 py-3 text-center"><span class="bg-green-100 text-green-900 px-2 py-1 rounded"><%= v.sgtin_count || 0 %></span></td>
                    <td class="px-4 py-3"><a href="/admin-v2/variant/<%= v.id %>" class="text-blue-600 hover:underline">Detail →</a></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="text-center py-12 text-gray-500">No variants found (jeans styles have no variants)</div>
        <% } %>
      <% } %>

      <!-- GTINS TAB (Masterdata) -->
      <% if (tab === 'gtins') { %>
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-2xl font-bold text-gray-900">GTIN Masterdata</h2>
          <div class="flex gap-3">
            <% if (typeof styles !== 'undefined' && styles && styles.length > 0) { %>
              <select id="filterStyle" class="border border-gray-300 rounded px-3 py-2" onchange="window.location = '/admin-v2?tab=gtins&style=' + this.value">
                <option value="">All Styles</option>
                <% styles.forEach(s => { %>
                  <option value="<%= s.id %>" <%= typeof selectedStyleId !== 'undefined' && selectedStyleId == s.id ? 'selected' : '' %>><%= s.style_number %> - <%= s.product_name %></option>
                <% }); %>
              </select>
            <% } %>
            <% if (typeof selectedStyleId !== 'undefined' && selectedStyleId && typeof variants !== 'undefined' && variants && variants.length > 0) { %>
              <select id="filterVariant" class="border border-gray-300 rounded px-3 py-2" onchange="window.location = '/admin-v2?tab=gtins&style=<%= selectedStyleId %>&variant=' + this.value">
                <option value="">All Variants</option>
                <% variants.forEach(v => { %>
                  <option value="<%= v.id %>" <%= typeof selectedVariantId !== 'undefined' && selectedVariantId == v.id ? 'selected' : '' %>><%= v.variant_name %></option>
                <% }); %>
              </select>
            <% } %>
            <input type="text" id="gtinSearch" placeholder="Search GTIN/Item..." class="border border-gray-300 rounded px-3 py-2" value="<%= search || '' %>">
          </div>
        </div>

        <% if (gtins && gtins.length > 0) { %>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse text-sm">
              <thead>
                <tr class="bg-gray-100 border-b border-gray-300">
                  <th class="px-4 py-3 text-left font-semibold">GTIN</th>
                  <th class="px-4 py-3 text-left font-semibold">Style</th>
                  <th class="px-4 py-3 text-left font-semibold">Product</th>
                  <th class="px-4 py-3 text-left font-semibold">Variant</th>
                  <th class="px-4 py-3 text-left font-semibold">Size</th>
                  <th class="px-4 py-3 text-center font-semibold">SGTINs</th>
                  <th class="px-4 py-3 text-left font-semibold">Action</th>
                </tr>
              </thead>
              <tbody>
                <% gtins.forEach(g => {
                  let sizeDisplay = '';
                  // If has variant, show only size_value_1 (variant is in separate column)
                  if (g.variant_id) {
                    sizeDisplay = g.size_value_1 || '—';
                  } else {
                    // No variant: show all size parts (e.g., L30-W24 for jeans)
                    if (g.size_value_1) sizeDisplay += g.size_value_1;
                    if (g.size_value_2) sizeDisplay += '-' + g.size_value_2;
                    if (g.size_value_3) sizeDisplay += '-' + g.size_value_3;
                  }
                %>
                  <tr class="border-b border-gray-200 hover:bg-gray-50">
                    <td class="px-4 py-3 font-mono"><strong><%= g.gtin %></strong></td>
                    <td class="px-4 py-3 font-mono text-xs"><%= g.style_number %></td>
                    <td class="px-4 py-3 text-sm"><strong><%= g.product_name || '—' %></strong></td>
                    <td class="px-4 py-3 text-sm"><%= g.variant_name || '—' %></td>
                    <td class="px-4 py-3 text-sm"><%= sizeDisplay || '—' %></td>
                    <td class="px-4 py-3 text-center"><span class="bg-green-100 text-green-900 px-2 py-1 rounded text-xs"><%= g.sgtin_count || 0 %></span></td>
                    <td class="px-4 py-3"><a href="/admin-v2/gtin/<%= g.id %>" class="text-blue-600 hover:underline">→</a></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="text-center py-12 text-gray-500">No GTINs found</div>
        <% } %>
      <% } %>

      <!-- BATCHES TAB -->
      <% if (tab === 'batches') { %>
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-2xl font-bold text-gray-900">Production Batches</h2>
          <% if (styles && styles.length > 0) { %>
            <select id="filterStyle" class="border border-gray-300 rounded px-3 py-2" onchange="window.location = '/admin-v2?tab=batches&style=' + this.value">
              <option value="">All Batches</option>
              <% styles.forEach(s => { %>
                <option value="<%= s.id %>"><%= s.style_number %> - <%= s.product_name %></option>
              <% }); %>
            </select>
          <% } %>
        </div>

        <% if (batches && batches.length > 0) { %>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse">
              <thead>
                <tr class="bg-gray-100 border-b border-gray-300">
                  <th class="px-4 py-3 text-left font-semibold">Batch ID</th>
                  <th class="px-4 py-3 text-left font-semibold">Production Order</th>
                  <th class="px-4 py-3 text-center font-semibold">Styles</th>
                  <th class="px-4 py-3 text-center font-semibold">GTINs</th>
                  <th class="px-4 py-3 text-center font-semibold">SGTINs</th>
                  <th class="px-4 py-3 text-left font-semibold">Action</th>
                </tr>
              </thead>
              <tbody>
                <% batches.forEach(b => { %>
                  <tr class="border-b border-gray-200 hover:bg-gray-50">
                    <td class="px-4 py-3 font-mono"><strong><%= b.batch_id %></strong></td>
                    <td class="px-4 py-3"><%= b.production_order || '—' %></td>
                    <td class="px-4 py-3 text-center"><span class="bg-purple-100 text-purple-900 px-2 py-1 rounded"><%= b.style_count || 0 %></span></td>
                    <td class="px-4 py-3 text-center"><span class="bg-blue-100 text-blue-900 px-2 py-1 rounded"><%= b.gtin_count || 0 %></span></td>
                    <td class="px-4 py-3 text-center"><span class="bg-green-100 text-green-900 px-2 py-1 rounded"><%= b.sgtin_count || 0 %></span></td>
                    <td class="px-4 py-3"><a href="/admin-v2/batch/<%= b.id %>" class="text-blue-600 hover:underline">Detail →</a></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="text-center py-12 text-gray-500">No batches found</div>
        <% } %>
      <% } %>

      <!-- SGTINS TAB (Individual garments) -->
      <% if (tab === 'sgtins') { %>
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-2xl font-bold text-gray-900">Individual Garments (SGTINs)</h2>
        </div>

        <% if (sgtins && sgtins.length > 0) { %>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse text-sm">
              <thead>
                <tr class="bg-gray-100 border-b border-gray-300">
                  <th class="px-4 py-3 text-left font-semibold">Serial</th>
                  <th class="px-4 py-3 text-left font-semibold">GTIN</th>
                  <th class="px-4 py-3 text-left font-semibold">Style</th>
                  <th class="px-4 py-3 text-left font-semibold">Batch</th>
                  <th class="px-4 py-3 text-left font-semibold">QC Status</th>
                  <th class="px-4 py-3 text-left font-semibold">Produktpass URL</th>
                  <th class="px-4 py-3 text-left font-semibold">Action</th>
                </tr>
              </thead>
              <tbody>
                <% sgtins.forEach(sg => {
                  const dppUrl = `/dpp/${sg.batch_id}/${sg.gtin}/${sg.serial_number}`;
                %>
                  <tr class="border-b border-gray-200 hover:bg-gray-50">
                    <td class="px-4 py-3 font-mono"><strong><%= sg.serial_number %></strong></td>
                    <td class="px-4 py-3 font-mono text-xs"><%= sg.gtin %></td>
                    <td class="px-4 py-3 text-xs"><%= sg.style_number %></td>
                    <td class="px-4 py-3 font-mono text-xs"><%= sg.batch_id %></td>
                    <td class="px-4 py-3">
                      <% if (sg.qc_status === 'passed') { %>
                        <span class="bg-green-100 text-green-900 px-2 py-1 rounded text-xs">✓ Passed</span>
                      <% } else if (sg.qc_status === 'failed') { %>
                        <span class="bg-red-100 text-red-900 px-2 py-1 rounded text-xs">✗ Failed</span>
                      <% } else { %>
                        <span class="bg-gray-100 text-gray-900 px-2 py-1 rounded text-xs">—</span>
                      <% } %>
                    </td>
                    <td class="px-4 py-3">
                      <a href="<%= dppUrl %>" target="_blank" class="text-blue-600 hover:underline font-mono text-xs">
                        Öppna →
                      </a>
                    </td>
                    <td class="px-4 py-3"><a href="/admin-v2/sgtin/<%= sg.id %>" class="text-blue-600 hover:underline">Edit</a></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="text-center py-12 text-gray-500">No SGTINs found</div>
        <% } %>
      <% } %>

      <!-- FIELDS TAB (DPP Field Definitions) -->
      <% if (tab === 'fields') { %>
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-2xl font-bold text-gray-900">DPP Field Definitions</h2>
          <button onclick="document.getElementById('addFieldForm').classList.toggle('hidden')" class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700">
            + Add Field
          </button>
        </div>

        <!-- Add Field Form -->
        <div id="addFieldForm" class="hidden mb-8 p-6 bg-gray-50 rounded-lg border-2 border-dashed border-gray-300">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Add New DPP Field</h3>
          <form id="fieldForm">
            <div class="grid grid-cols-2 gap-4 mb-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Field Key *</label>
                <input type="text" name="field_key" placeholder="fiber_composition" required class="w-full px-4 py-2 border border-gray-300 rounded-lg" />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Label *</label>
                <input type="text" name="label" placeholder="Fiber Composition" required class="w-full px-4 py-2 border border-gray-300 rounded-lg" />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Category *</label>
                <select name="category" required class="w-full px-4 py-2 border border-gray-300 rounded-lg">
                  <option value="">-- Select Category --</option>
                  <option value="eu_required">EU Required</option>
                  <option value="nudie">Nudie Specific</option>
                </select>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Data Type</label>
                <select name="data_type" class="w-full px-4 py-2 border border-gray-300 rounded-lg">
                  <option value="text">Text</option>
                  <option value="textarea">Textarea</option>
                  <option value="number">Number</option>
                  <option value="date">Date</option>
                  <option value="url">URL</option>
                </select>
              </div>
            </div>
            <div class="mb-4">
              <label class="block text-sm font-medium text-gray-700 mb-2">Description</label>
              <input type="text" name="description" placeholder="Field description" class="w-full px-4 py-2 border border-gray-300 rounded-lg" />
            </div>
            <div class="flex gap-4 mb-4">
              <label class="flex items-center">
                <input type="checkbox" name="required" class="mr-2" /> Required
              </label>
              <label class="flex items-center">
                <input type="checkbox" name="consumer_visible" class="mr-2" checked /> Consumer Visible
              </label>
            </div>
            <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700">Add Field</button>
          </form>
        </div>

        <!-- Category Filter -->
        <% if (categories && categories.length > 0) { %>
          <div class="mb-6 flex gap-2">
            <a href="/admin-v2?tab=fields" class="px-4 py-2 rounded <%= !selectedCategory ? 'bg-gray-900 text-white' : 'bg-gray-200 text-gray-900' %>">All</a>
            <% categories.forEach(cat => { %>
              <a href="/admin-v2?tab=fields&category=<%= cat %>" class="px-4 py-2 rounded <%= selectedCategory === cat ? 'bg-gray-900 text-white' : 'bg-gray-200 text-gray-900' %>">
                <%= cat.replace('_', ' ').toUpperCase() %>
              </a>
            <% }); %>
          </div>
        <% } %>

        <!-- Fields List -->
        <% if (fields && fields.length > 0) { %>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse text-sm">
              <thead>
                <tr class="bg-gray-100 border-b border-gray-300">
                  <th class="px-4 py-3 text-left font-semibold">Field Key</th>
                  <th class="px-4 py-3 text-left font-semibold">Label</th>
                  <th class="px-4 py-3 text-left font-semibold">Category</th>
                  <th class="px-4 py-3 text-left font-semibold">Type</th>
                  <th class="px-4 py-3 text-center font-semibold">Required</th>
                  <th class="px-4 py-3 text-center font-semibold">Consumer</th>
                  <th class="px-4 py-3 text-left font-semibold">Description</th>
                </tr>
              </thead>
              <tbody>
                <% fields.forEach(f => { %>
                  <tr class="border-b border-gray-200 hover:bg-gray-50">
                    <td class="px-4 py-3 font-mono text-xs"><strong><%= f.field_key %></strong></td>
                    <td class="px-4 py-3"><%= f.label %></td>
                    <td class="px-4 py-3">
                      <% if (f.category === 'eu_required') { %>
                        <span class="bg-blue-100 text-blue-900 px-2 py-1 rounded text-xs font-semibold">EU Required</span>
                      <% } else if (f.category === 'nudie') { %>
                        <span class="bg-purple-100 text-purple-900 px-2 py-1 rounded text-xs font-semibold">Nudie</span>
                      <% } else { %>
                        <span class="bg-gray-100 text-gray-900 px-2 py-1 rounded text-xs"><%= f.category %></span>
                      <% } %>
                    </td>
                    <td class="px-4 py-3 text-xs text-gray-600"><%= f.data_type || 'text' %></td>
                    <td class="px-4 py-3 text-center"><%= f.required ? '✓' : '—' %></td>
                    <td class="px-4 py-3 text-center"><%= f.consumer_visible ? '✓' : '—' %></td>
                    <td class="px-4 py-3 text-xs text-gray-600"><%= f.description || '—' %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="text-center py-12 text-gray-500">No fields found</div>
        <% } %>

        <script>
          document.getElementById('fieldForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = {
              field_key: formData.get('field_key'),
              label: formData.get('label'),
              category: formData.get('category'),
              data_type: formData.get('data_type'),
              description: formData.get('description'),
              required: formData.has('required'),
              consumer_visible: formData.has('consumer_visible')
            };

            try {
              const response = await fetch('/api/admin/fields', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
              });

              const result = await response.json();
              if (result.success) {
                alert('Field created successfully');
                location.reload();
              } else {
                alert('Error: ' + (result.error || 'Unknown error'));
              }
            } catch (err) {
              alert('Error: ' + err.message);
            }
          });
        </script>
      <% } %>
    </div>
  </div>

  <script>
    document.getElementById('gtinSearch')?.addEventListener('change', function() {
      window.location = '/admin-v2?tab=gtins&search=' + encodeURIComponent(this.value);
    });
  </script>
</body>
</html>
