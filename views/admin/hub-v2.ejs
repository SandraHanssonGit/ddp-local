<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DPP Hub v2</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
  <script src="/js/admin-modal.js"></script>
</head>
<body>
  <div class="wrap">
    <div class="admin-header">
      <div class="brand">
        <div class="logo-crop" title="Nudie Jeans co">
          <img src="/nudie-logo.png" alt="Nudie Jeans co">
        </div>
        <h1>DPP Hub</h1>
      </div>
      <div class="user-info">
        <span><%= user.username %></span>
        <a href="/login" class="btn">Logout</a>
      </div>
    </div>

    <div class="admin-nav">
      <a href="/admin-v2" class="<%= tab === 'styles' ? 'active' : '' %>">Styles</a>
      <a href="/admin-v2?tab=variants" class="<%= tab === 'variants' ? 'active' : '' %>">Variants</a>
      <a href="/admin-v2?tab=gtins" class="<%= tab === 'gtins' ? 'active' : '' %>">GTINs</a>
      <a href="/admin-v2?tab=batches" class="<%= tab === 'batches' ? 'active' : '' %>">Batches</a>
      <a href="/admin-v2?tab=sgtins" class="<%= tab === 'sgtins' ? 'active' : '' %>">SGTINs</a>
      <a href="/admin-v2?tab=fields" class="<%= tab === 'fields' ? 'active' : '' %>">DPP Fields</a>
      <a href="/admin-v2?tab=operators" class="<%= tab === 'operators' ? 'active' : '' %>">Economic Operators</a>
      <a href="/admin-v2?tab=analytics" class="<%= tab === 'analytics' ? 'active' : '' %>">Scan Analytics</a>
    </div>

    <div class="card">
      <!-- STYLES TAB -->
      <% if (tab === 'styles') { %>
        <div class="section-head">
          <h2>Styles Masterdata</h2>
        </div>

        <% if (styles && styles.length > 0) { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Style #</th>
                  <th>Name</th>
                  <th>Type</th>
                  <th class="center">Variants</th>
                  <th class="center">GTINs</th>
                  <th class="center">SGTINs</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% styles.forEach(s => { %>
                  <tr>
                    <td class="mono"><strong><%= s.style_number %></strong></td>
                    <td><%= s.product_name %></td>
                    <td class="muted small"><%= s.product_type %></td>
                    <td class="center"><span class="badge badge-accent"><%= s.variant_count || 0 %></span></td>
                    <td class="center"><span class="badge badge-accent"><%= s.gtin_count || 0 %></span></td>
                    <td class="center"><span class="badge badge-success"><%= s.sgtin_count || 0 %></span></td>
                    <td><a href="/admin-v2/style/<%= s.id %>" class="link-action">Detail →</a></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">No styles found</div>
        <% } %>
      <% } %>

      <!-- VARIANTS TAB -->
      <% if (tab === 'variants') { %>
        <div class="section-head">
          <h2>Product Variants</h2>
          <% if (styles && styles.length > 0) { %>
            <select id="filterStyle" onchange="window.location = '/admin-v2?tab=variants&style=' + this.value" style="width:auto;">
              <option value="">All Styles</option>
              <% styles.forEach(s => { %>
                <option value="<%= s.id %>" <%= typeof selectedStyleId !== 'undefined' && selectedStyleId == s.id ? 'selected' : '' %>><%= s.style_number %> - <%= s.product_name %></option>
              <% }); %>
            </select>
          <% } %>
        </div>

        <% if (variants && variants.length > 0) { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Style</th>
                  <th>Style #</th>
                  <th>Variant</th>
                  <th class="center">GTINs</th>
                  <th class="center">SGTINs</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% variants.forEach(v => { %>
                  <tr>
                    <td>
                      <%= v.effective_product_name %>
                      <% if (v.effective_product_name !== v.product_name) { %>
                        <span class="small muted" style="display:block;"><%= v.product_name %> (style default)</span>
                      <% } %>
                    </td>
                    <td class="mono"><strong><%= v.style_number %></strong></td>
                    <td class="mono"><strong><%= v.variant_name %></strong></td>
                    <td class="center"><span class="badge badge-accent"><%= v.gtin_count || 0 %></span></td>
                    <td class="center"><span class="badge badge-success"><%= v.sgtin_count || 0 %></span></td>
                    <td><a href="/admin-v2/variant/<%= v.id %>" class="link-action">Detail →</a></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">No variants found (jeans styles have no variants)</div>
        <% } %>
      <% } %>

      <!-- GTINS TAB (Masterdata) -->
      <% if (tab === 'gtins') { %>
        <div class="section-head">
          <h2>GTIN Masterdata</h2>
          <div style="display:flex; gap:10px;">
            <% if (typeof styles !== 'undefined' && styles && styles.length > 0) { %>
              <select id="filterStyle" onchange="window.location = '/admin-v2?tab=gtins&style=' + this.value" style="width:auto;">
                <option value="">All Styles</option>
                <% styles.forEach(s => { %>
                  <option value="<%= s.id %>" <%= typeof selectedStyleId !== 'undefined' && selectedStyleId == s.id ? 'selected' : '' %>><%= s.style_number %> - <%= s.product_name %></option>
                <% }); %>
              </select>
            <% } %>
            <% if (typeof selectedStyleId !== 'undefined' && selectedStyleId && typeof variants !== 'undefined' && variants && variants.length > 0) { %>
              <select id="filterVariant" onchange="window.location = '/admin-v2?tab=gtins&style=<%= selectedStyleId %>&variant=' + this.value" style="width:auto;">
                <option value="">All Variants</option>
                <% variants.forEach(v => { %>
                  <option value="<%= v.id %>" <%= typeof selectedVariantId !== 'undefined' && selectedVariantId == v.id ? 'selected' : '' %>><%= v.variant_name %></option>
                <% }); %>
              </select>
            <% } %>
            <input type="text" id="gtinSearch" placeholder="Search GTIN/Item..." style="width:220px;" value="<%= search || '' %>">
          </div>
        </div>

        <% if (gtins && gtins.length > 0) { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>GTIN</th>
                  <th>Style</th>
                  <th>Product</th>
                  <th>Variant</th>
                  <th>Size</th>
                  <th class="center">SGTINs</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% gtins.forEach(g => {
                  let sizeDisplay = '';
                  if (g.variant_id) {
                    sizeDisplay = g.size_value_1 || '—';
                  } else {
                    if (g.size_value_1) sizeDisplay += g.size_value_1;
                    if (g.size_value_2) sizeDisplay += '-' + g.size_value_2;
                    if (g.size_value_3) sizeDisplay += '-' + g.size_value_3;
                  }
                %>
                  <tr>
                    <td class="mono"><strong><%= g.gtin %></strong></td>
                    <td class="mono small"><%= g.style_number %></td>
                    <td class="small"><strong><%= g.product_name || '—' %></strong></td>
                    <td class="small"><%= g.variant_name || '—' %></td>
                    <td class="small"><%= sizeDisplay || '—' %></td>
                    <td class="center"><span class="badge badge-success small"><%= g.sgtin_count || 0 %></span></td>
                    <td><a href="/admin-v2/gtin/<%= g.id %>" class="link-action">→</a></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">No GTINs found</div>
        <% } %>
      <% } %>

      <!-- BATCHES TAB -->
      <% if (tab === 'batches') { %>
        <div class="section-head">
          <h2>Production Batches</h2>
          <% if (styles && styles.length > 0) { %>
            <select id="filterStyle" onchange="window.location = '/admin-v2?tab=batches&style=' + this.value" style="width:auto;">
              <option value="">All Batches</option>
              <% styles.forEach(s => { %>
                <option value="<%= s.id %>"><%= s.style_number %> - <%= s.product_name %></option>
              <% }); %>
            </select>
          <% } %>
        </div>

        <% if (batches && batches.length > 0) { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Batch ID</th>
                  <th>Production Order</th>
                  <th class="center">Styles</th>
                  <th class="center">GTINs</th>
                  <th class="center">SGTINs</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% batches.forEach(b => { %>
                  <tr>
                    <td class="mono"><strong><%= b.batch_id %></strong></td>
                    <td><%= b.production_order || '—' %></td>
                    <td class="center"><span class="badge badge-accent"><%= b.style_count || 0 %></span></td>
                    <td class="center"><span class="badge badge-accent"><%= b.gtin_count || 0 %></span></td>
                    <td class="center"><span class="badge badge-success"><%= b.sgtin_count || 0 %></span></td>
                    <td><a href="/admin-v2/batch/<%= b.id %>" class="link-action">Detail →</a></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">No batches found</div>
        <% } %>
      <% } %>

      <!-- SGTINS TAB (Individual garments) -->
      <% if (tab === 'sgtins') { %>
        <div class="section-head">
          <h2>Individual Garments (SGTINs)</h2>
        </div>

        <% if (sgtins && sgtins.length > 0) { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Serial</th>
                  <th>GTIN</th>
                  <th>Style</th>
                  <th>Batch</th>
                  <th>QC Status</th>
                  <th>Produktpass URL</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% sgtins.forEach(sg => {
                  const dppUrl = `/01/${sg.gtin}/21/${sg.serial_number}`;
                %>
                  <tr>
                    <td class="mono"><strong><%= sg.serial_number %></strong></td>
                    <td class="mono small"><%= sg.gtin %></td>
                    <td class="small"><%= sg.style_number %></td>
                    <td class="mono small"><%= sg.batch_id %></td>
                    <td>
                      <% if (sg.qc_status === 'passed') { %>
                        <span class="badge badge-success small">✓ Passed</span>
                      <% } else if (sg.qc_status === 'failed') { %>
                        <span class="badge badge-danger small">✗ Failed</span>
                      <% } else { %>
                        <span class="badge badge-muted small">—</span>
                      <% } %>
                    </td>
                    <td>
                      <a href="<%= dppUrl %>" target="_blank" class="link-action mono small">
                        Öppna →
                      </a>
                    </td>
                    <td><a href="/admin-v2/sgtin/<%= sg.id %>" class="link-action">Edit</a></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">No SGTINs found</div>
        <% } %>
      <% } %>

      <!-- FIELDS TAB (DPP Field Definitions) -->
      <% if (tab === 'fields') { %>
        <div class="section-head">
          <h2>DPP Field Definitions</h2>
          <button onclick="document.getElementById('addFieldForm').classList.toggle('hidden')" class="btn btn-primary">
            + Add Field
          </button>
        </div>

        <!-- Add Field Form -->
        <div id="addFieldForm" class="form-panel hidden">
          <h3 style="margin-bottom:16px; font-size:16px;">Add New DPP Field</h3>
          <form id="fieldForm">
            <div class="field-grid">
              <div>
                <label>Field Key *</label>
                <input type="text" name="field_key" placeholder="fiber_composition" required />
              </div>
              <div>
                <label>Label *</label>
                <input type="text" name="label" placeholder="Fiber Composition" required />
              </div>
              <div>
                <label>Category *</label>
                <select name="category" required>
                  <option value="">-- Select Category --</option>
                  <option value="eu_required">EU Required</option>
                  <option value="nudie">Nudie Specific</option>
                </select>
              </div>
              <div>
                <label>Data Type</label>
                <select name="data_type">
                  <option value="text">Text</option>
                  <option value="textarea">Textarea</option>
                  <option value="number">Number</option>
                  <option value="date">Date</option>
                  <option value="url">URL</option>
                </select>
              </div>
            </div>
            <div class="field-row">
              <label>Description</label>
              <input type="text" name="description" placeholder="Field description" />
            </div>
            <div class="field-row" style="display:flex; gap:20px;">
              <label class="checkbox-row"><input type="checkbox" name="required" /> Required</label>
              <label class="checkbox-row"><input type="checkbox" name="consumer_visible" checked /> Consumer Visible</label>
            </div>
            <div class="hint-panel">
              <label style="display:block; margin-bottom:10px;">Which levels can set this field?</label>
              <div style="display:flex; gap:18px;">
                <label class="checkbox-row"><input type="checkbox" name="editable_at_style" checked /> Style</label>
                <label class="checkbox-row"><input type="checkbox" name="editable_at_variant" checked /> Variant</label>
                <label class="checkbox-row"><input type="checkbox" name="editable_at_batch" checked /> Batch</label>
                <label class="checkbox-row"><input type="checkbox" name="editable_at_gtin" /> GTIN</label>
                <label class="checkbox-row"><input type="checkbox" name="editable_at_sgtin" /> SGTIN</label>
              </div>
              <p class="small muted" style="margin:10px 0 0;">The field only appears as an editable row on the levels checked here.</p>
            </div>
            <button type="submit" class="btn btn-primary">Add Field</button>
          </form>
        </div>

        <!-- Category Filter -->
        <% if (categories && categories.length > 0) { %>
          <div class="filter-pills">
            <a href="/admin-v2?tab=fields" class="<%= !selectedCategory ? 'active' : '' %>">All</a>
            <% categories.forEach(cat => { %>
              <a href="/admin-v2?tab=fields&category=<%= cat %>" class="<%= selectedCategory === cat ? 'active' : '' %>">
                <%= cat.replace('_', ' ').toUpperCase() %>
              </a>
            <% }); %>
          </div>
        <% } %>

        <!-- Fields List -->
        <% if (fields && fields.length > 0) { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Field Key</th>
                  <th>Label</th>
                  <th>Category</th>
                  <th>Type</th>
                  <th>Levels</th>
                  <th class="center">Required</th>
                  <th class="center">Consumer</th>
                  <th>Description</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% fields.forEach(f => {
                  const levels = [
                    { key: 'editable_at_style', short: 'S', name: 'Style' },
                    { key: 'editable_at_variant', short: 'V', name: 'Variant' },
                    { key: 'editable_at_batch', short: 'B', name: 'Batch' },
                    { key: 'editable_at_gtin', short: 'G', name: 'GTIN' },
                    { key: 'editable_at_sgtin', short: 'SG', name: 'SGTIN' }
                  ];
                %>
                  <tr>
                    <td class="mono small"><strong><%= f.field_key %></strong></td>
                    <td><%= f.label %></td>
                    <td>
                      <% if (f.category === 'eu_required') { %>
                        <span class="badge badge-accent">EU Required</span>
                      <% } else if (f.category === 'nudie') { %>
                        <span class="badge">Nudie</span>
                      <% } else { %>
                        <span class="badge badge-muted"><%= f.category %></span>
                      <% } %>
                    </td>
                    <td class="small muted"><%= f.data_type || 'text' %></td>
                    <td>
                      <div style="display:flex; gap:4px;">
                        <% levels.forEach(lvl => { %>
                          <span title="<%= lvl.name %>" class="level-pill <%= f[lvl.key] ? 'on' : '' %>"><%= lvl.short %></span>
                        <% }); %>
                      </div>
                    </td>
                    <td class="center"><%= f.required ? '✓' : '—' %></td>
                    <td class="center"><%= f.consumer_visible ? '✓' : '—' %></td>
                    <td class="small muted"><%= f.description || '—' %></td>
                    <td style="white-space:nowrap;">
                      <a href="#" onclick="toggleFieldEdit(<%= f.id %>); return false;" class="link-action" style="margin-right:12px;">Edit</a>
                      <a href="#" onclick="deleteField(<%= f.id %>, '<%= f.field_key %>'); return false;" class="link-action danger">Delete</a>
                    </td>
                  </tr>
                  <tr id="field-edit-row-<%= f.id %>" class="hidden">
                    <td colspan="9" style="background:var(--surface-2); padding:20px;">
                      <form onsubmit="saveFieldEdit(event, <%= f.id %>)">
                        <div class="field-grid-3" style="margin-bottom:14px;">
                          <div>
                            <label class="label-sm">Label</label>
                            <input type="text" name="label" value="<%= f.label %>" required />
                          </div>
                          <div>
                            <label class="label-sm">Category</label>
                            <select name="category">
                              <option value="eu_required" <%= f.category === 'eu_required' ? 'selected' : '' %>>EU Required</option>
                              <option value="nudie" <%= f.category === 'nudie' ? 'selected' : '' %>>Nudie Specific</option>
                            </select>
                          </div>
                          <div>
                            <label class="label-sm">Description</label>
                            <input type="text" name="description" value="<%= f.description || '' %>" />
                          </div>
                        </div>
                        <div style="display:flex; gap:20px; margin-bottom:14px;">
                          <label class="checkbox-row"><input type="checkbox" name="required" <%= f.required ? 'checked' : '' %> /> Required</label>
                          <label class="checkbox-row"><input type="checkbox" name="consumer_visible" <%= f.consumer_visible ? 'checked' : '' %> /> Consumer Visible</label>
                        </div>
                        <div style="margin-bottom:14px;">
                          <label class="label-sm" style="display:block; margin-bottom:8px;">Levels</label>
                          <div style="display:flex; gap:18px;">
                            <% levels.forEach(lvl => { %>
                              <label class="checkbox-row">
                                <input type="checkbox" name="<%= lvl.key %>" <%= f[lvl.key] ? 'checked' : '' %> /> <%= lvl.name %>
                              </label>
                            <% }); %>
                          </div>
                        </div>
                        <div style="display:flex; gap:10px;">
                          <button type="submit" class="btn btn-primary">Save</button>
                          <button type="button" onclick="toggleFieldEdit(<%= f.id %>)" class="btn">Cancel</button>
                        </div>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">No fields found</div>
        <% } %>

        <script>
          function toggleFieldEdit(fieldId) {
            document.getElementById('field-edit-row-' + fieldId).classList.toggle('hidden');
          }

          async function saveFieldEdit(e, fieldId) {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = {
              label: formData.get('label'),
              category: formData.get('category'),
              description: formData.get('description'),
              required: formData.has('required'),
              consumer_visible: formData.has('consumer_visible'),
              editable_at_style: formData.has('editable_at_style'),
              editable_at_variant: formData.has('editable_at_variant'),
              editable_at_batch: formData.has('editable_at_batch'),
              editable_at_gtin: formData.has('editable_at_gtin'),
              editable_at_sgtin: formData.has('editable_at_sgtin')
            };

            try {
              const response = await fetch('/api/admin/fields/' + fieldId, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
              });
              const result = await response.json();
              if (result.success) {
                location.reload();
              } else {
                await dppAlert('Error: ' + (result.error || 'Unknown error'));
              }
            } catch (err) {
              await dppAlert('Error: ' + err.message);
            }
          }

          async function deleteField(fieldId, fieldKey) {
            if (!(await dppConfirm('Delete field "' + fieldKey + '"? This only works if no values have been set for it anywhere.'))) return;

            try {
              const response = await fetch('/api/admin/fields/' + fieldId, { method: 'DELETE' });
              const result = await response.json();
              if (result.success) {
                location.reload();
              } else {
                await dppAlert('Error: ' + (result.error || 'Unknown error'));
              }
            } catch (err) {
              await dppAlert('Error: ' + err.message);
            }
          }

          document.getElementById('fieldForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = {
              field_key: formData.get('field_key'),
              label: formData.get('label'),
              category: formData.get('category'),
              data_type: formData.get('data_type'),
              description: formData.get('description'),
              required: formData.has('required'),
              consumer_visible: formData.has('consumer_visible'),
              editable_at_style: formData.has('editable_at_style'),
              editable_at_variant: formData.has('editable_at_variant'),
              editable_at_batch: formData.has('editable_at_batch'),
              editable_at_gtin: formData.has('editable_at_gtin'),
              editable_at_sgtin: formData.has('editable_at_sgtin')
            };

            try {
              const response = await fetch('/api/admin/fields', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
              });

              const result = await response.json();
              if (result.success) {
                await dppAlert('Field created successfully');
                location.reload();
              } else {
                await dppAlert('Error: ' + (result.error || 'Unknown error'));
              }
            } catch (err) {
              await dppAlert('Error: ' + err.message);
            }
          });
        </script>
      <% } %>

      <!-- ECONOMIC OPERATORS TAB (ROADMAP.md Phase 4) -->
      <% if (tab === 'operators') { %>
        <div class="section-head">
          <h2>Economic Operators</h2>
          <button onclick="document.getElementById('addOperatorForm').classList.toggle('hidden')" class="btn btn-primary">
            + Add Operator
          </button>
        </div>

        <p class="small muted" style="margin-bottom:20px;">
          ESPR requires the passport to name who is legally responsible
          for the product (manufacturer, importer, or authorized
          representative). Assign an operator on a Style's detail page -
          a Batch can optionally override it for that production run.
        </p>

        <!-- Add Operator Form -->
        <div id="addOperatorForm" class="form-panel hidden">
          <h3 style="margin-bottom:16px; font-size:16px;">Add Economic Operator</h3>
          <form id="operatorForm">
            <div class="field-grid">
              <div>
                <label>Role *</label>
                <select name="role" required>
                  <option value="">-- Select Role --</option>
                  <option value="manufacturer">Manufacturer</option>
                  <option value="importer">Importer</option>
                  <option value="authorized_representative">Authorized Representative</option>
                </select>
              </div>
              <div>
                <label>Legal Name *</label>
                <input type="text" name="legal_name" placeholder="Nudie Jeans AB" required />
              </div>
              <div>
                <label>Country</label>
                <input type="text" name="country" placeholder="Sweden" />
              </div>
              <div>
                <label>Registration Number</label>
                <input type="text" name="registration_number" placeholder="Org./VAT number" />
              </div>
            </div>
            <div class="field-row">
              <label>Address</label>
              <input type="text" name="address" placeholder="Street, postcode, city" />
            </div>
            <button type="submit" class="btn btn-primary">Add Operator</button>
          </form>
        </div>

        <% if (operators && operators.length > 0) { %>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Legal Name</th>
                  <th>Role</th>
                  <th>Country</th>
                  <th>Registration #</th>
                  <th class="center">Styles</th>
                  <th class="center">Batches</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% operators.forEach(op => { %>
                  <tr>
                    <td><strong><%= op.legal_name %></strong></td>
                    <td><span class="badge badge-accent"><%= op.role.replace(/_/g, ' ') %></span></td>
                    <td class="small"><%= op.country || '—' %></td>
                    <td class="mono small"><%= op.registration_number || '—' %></td>
                    <td class="center"><%= op.style_count || 0 %></td>
                    <td class="center"><%= op.batch_count || 0 %></td>
                    <td style="white-space:nowrap;">
                      <a href="#" onclick="toggleOperatorEdit(<%= op.id %>); return false;" class="link-action" style="margin-right:12px;">Edit</a>
                      <a href="#" onclick="deleteOperator(<%= op.id %>, '<%= op.legal_name %>'); return false;" class="link-action danger">Delete</a>
                    </td>
                  </tr>
                  <tr id="operator-edit-row-<%= op.id %>" class="hidden">
                    <td colspan="7" style="background:var(--surface-2); padding:20px;">
                      <form onsubmit="saveOperatorEdit(event, <%= op.id %>)">
                        <div class="field-grid-3" style="margin-bottom:14px;">
                          <div>
                            <label class="label-sm">Legal Name</label>
                            <input type="text" name="legal_name" value="<%= op.legal_name %>" required />
                          </div>
                          <div>
                            <label class="label-sm">Role</label>
                            <select name="role">
                              <option value="manufacturer" <%= op.role === 'manufacturer' ? 'selected' : '' %>>Manufacturer</option>
                              <option value="importer" <%= op.role === 'importer' ? 'selected' : '' %>>Importer</option>
                              <option value="authorized_representative" <%= op.role === 'authorized_representative' ? 'selected' : '' %>>Authorized Representative</option>
                            </select>
                          </div>
                          <div>
                            <label class="label-sm">Country</label>
                            <input type="text" name="country" value="<%= op.country || '' %>" />
                          </div>
                        </div>
                        <div class="field-grid" style="margin-bottom:14px;">
                          <div>
                            <label class="label-sm">Registration Number</label>
                            <input type="text" name="registration_number" value="<%= op.registration_number || '' %>" />
                          </div>
                          <div>
                            <label class="label-sm">Address</label>
                            <input type="text" name="address" value="<%= op.address || '' %>" />
                          </div>
                        </div>
                        <div style="display:flex; gap:10px;">
                          <button type="submit" class="btn btn-primary">Save</button>
                          <button type="button" onclick="toggleOperatorEdit(<%= op.id %>)" class="btn">Cancel</button>
                        </div>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state">No economic operators added yet</div>
        <% } %>

        <script>
          function toggleOperatorEdit(id) {
            document.getElementById('operator-edit-row-' + id).classList.toggle('hidden');
          }

          async function saveOperatorEdit(e, id) {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData.entries());
            try {
              const response = await fetch('/admin-v2/operators/' + id, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
              });
              const result = await response.json();
              if (result.success) {
                location.reload();
              } else {
                await dppAlert('Error: ' + (result.error || 'Unknown error'));
              }
            } catch (err) {
              await dppAlert('Error: ' + err.message);
            }
          }

          async function deleteOperator(id, legalName) {
            if (!(await dppConfirm('Delete operator "' + legalName + '"? Styles/batches referencing it will fall back to no operator assigned.'))) return;
            try {
              const response = await fetch('/admin-v2/operators/' + id, { method: 'DELETE' });
              const result = await response.json();
              if (result.success) {
                location.reload();
              } else {
                await dppAlert('Error: ' + (result.error || 'Unknown error'));
              }
            } catch (err) {
              await dppAlert('Error: ' + err.message);
            }
          }

          document.getElementById('operatorForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData.entries());
            try {
              const response = await fetch('/admin-v2/operators', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
              });
              const result = await response.json();
              if (result.success) {
                location.reload();
              } else {
                await dppAlert('Error: ' + (result.error || 'Unknown error'));
              }
            } catch (err) {
              await dppAlert('Error: ' + err.message);
            }
          });
        </script>
      <% } %>

      <!-- ANALYTICS TAB (Scan statistics) -->
      <% if (tab === 'analytics') { %>
        <div class="section-head">
          <h2>Scan Analytics</h2>
        </div>

        <div class="stat-grid">
          <div class="stat-card">
            <div class="stat-label">Total Scans</div>
            <div class="stat-value"><%= totals.total_scans || 0 %></div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Unique Products Scanned</div>
            <div class="stat-value"><%= totals.unique_sgtins_scanned || 0 %></div>
          </div>
          <div class="stat-card">
            <div class="stat-label">First Scan</div>
            <div class="stat-value" style="font-size:16px;">
              <%= totals.first_scan ? new Date(totals.first_scan).toLocaleDateString('sv-SE') : '–' %>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Last Scan</div>
            <div class="stat-value" style="font-size:16px;">
              <%= totals.last_scan ? new Date(totals.last_scan).toLocaleDateString('sv-SE') : '–' %>
            </div>
          </div>
        </div>

        <div style="margin-bottom:32px;">
          <h3 style="font-size:16px; margin-bottom:16px;">Scans per day (last 14 days with activity)</h3>
          <% if (scansByDay.length > 0) { %>
            <% const maxCount = Math.max(...scansByDay.map(d => d.scan_count)); %>
            <% scansByDay.forEach(d => { %>
              <div class="bar-row">
                <div class="bar-label"><%= d.day %></div>
                <div class="bar-track">
                  <div class="bar-fill" style="width: <%= Math.round((d.scan_count / maxCount) * 100) %>%"></div>
                </div>
                <div class="bar-count"><%= d.scan_count %></div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="empty-state">No scan data yet</div>
          <% } %>
        </div>

        <div style="margin-bottom:32px;">
          <h3 style="font-size:16px; margin-bottom:16px;">Most scanned products</h3>
          <% if (topProducts.length > 0) { %>
            <table>
              <thead>
                <tr>
                  <th>Style</th>
                  <th>GTIN</th>
                  <th style="text-align:right;">Scans</th>
                </tr>
              </thead>
              <tbody>
                <% topProducts.forEach(p => { %>
                  <tr>
                    <td class="small"><%= p.style_number %> <span class="muted"><%= p.product_name || '' %></span></td>
                    <td class="small mono"><%= p.gtin %></td>
                    <td class="small" style="text-align:right; font-weight:600;"><%= p.scan_count %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } else { %>
            <div class="empty-state">No scan data yet</div>
          <% } %>
        </div>

        <div>
          <h3 style="font-size:16px; margin-bottom:16px;">Recent scans</h3>
          <% if (recentScans.length > 0) { %>
            <table>
              <thead>
                <tr>
                  <th>Time</th>
                  <th>Style</th>
                  <th>Serial</th>
                  <th>Batch</th>
                  <th>Method</th>
                  <th>Location</th>
                </tr>
              </thead>
              <tbody>
                <% recentScans.forEach(sc => { %>
                  <tr>
                    <td class="small"><%= new Date(sc.scan_timestamp).toLocaleString('sv-SE') %></td>
                    <td class="small"><%= sc.style_number %> <span class="muted"><%= sc.product_name || '' %></span></td>
                    <td class="small mono"><%= sc.serial_number %></td>
                    <td class="small"><%= sc.batch_id %></td>
                    <td class="small"><%= sc.scan_method || '–' %></td>
                    <td class="small"><%= sc.scan_location || '–' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } else { %>
            <div class="empty-state">No scans logged yet</div>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>

  <script>
    document.getElementById('gtinSearch')?.addEventListener('change', function() {
      window.location = '/admin-v2?tab=gtins&search=' + encodeURIComponent(this.value);
    });
  </script>
</body>
</html>
