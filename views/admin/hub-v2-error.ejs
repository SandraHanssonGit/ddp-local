      <p class="text-lg text-gray-600 mb-8"><%= error %></p>
      <div class="space-y-3">
        <a href="/admin-v2" class="block bg-blue-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-blue-700 transition">
          Tillbaka till Hub
        </a>
        <a href="/login" class="block bg-gray-200 text-gray-900 px-6 py-3 rounded-lg font-semibold hover:bg-gray-300 transition">
