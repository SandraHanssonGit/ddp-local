<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Batch <%= batch.batch_id %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
  <div class="max-w-7xl mx-auto py-12 px-4">
    <!-- Header -->
    <div class="flex justify-between items-center mb-8">
      <div>
        <h1 class="text-4xl font-bold text-gray-900"><%= batch.batch_id %></h1>
        <p class="text-gray-600 mt-2">Production Batch</p>
      </div>
      <a href="/admin-v2?tab=batches" class="bg-gray-900 text-white px-4 py-2 rounded hover:bg-gray-800">
        ← Back to Batches
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Main Content (2/3) -->
      <div class="lg:col-span-2 space-y-8">

        <!-- Batch Information -->
        <div class="bg-white rounded-lg shadow-md p-8">
          <div class="flex justify-between items-center mb-6">
            <h2 class="text-2xl font-bold text-gray-900">Batch Information</h2>
            <button onclick="toggleEdit('batch-info')" class="bg-gray-900 text-white px-4 py-2 rounded hover:bg-gray-800 font-semibold">
              Edit
            </button>
          </div>

          <!-- View Mode -->
          <div id="batch-info-view" class="space-y-4">
            <div class="grid grid-cols-2 gap-6">
              <div>
                <label class="text-xs text-gray-500 uppercase tracking-wide font-semibold">Batch ID</label>
                <p class="text-gray-900 font-mono text-lg"><%= batch.batch_id %></p>
              </div>
              <div>
                <label class="text-xs text-gray-500 uppercase tracking-wide font-semibold">Production Order</label>
                <p class="text-gray-900 text-lg"><%= batch.production_order || '-' %></p>
              </div>
              <div>
                <label class="text-xs text-gray-500 uppercase tracking-wide font-semibold">Factory</label>
                <p class="text-gray-900 text-lg"><%= batch.factory || '-' %></p>
              </div>
              <div>
                <label class="text-xs text-gray-500 uppercase tracking-wide font-semibold">Production Date</label>
                <p class="text-gray-900 text-lg"><%= batch.production_date ? new Date(batch.production_date).toLocaleDateString() : '-' %></p>
              </div>
              <div class="col-span-2">
                <label class="text-xs text-gray-500 uppercase tracking-wide font-semibold">Country of Production</label>
                <p class="text-gray-900 text-lg"><%= batch.country_of_production || '-' %></p>
              </div>
            </div>
          </div>

          <!-- Edit Mode -->
          <form id="batch-info-edit" class="hidden space-y-6" onsubmit="saveBatchInfo(event)">
            <div class="grid grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Production Order</label>
                <input type="text" id="edit-production-order" value="<%= batch.production_order || '' %>" class="w-full border border-gray-300 rounded px-4 py-3 focus:outline-none focus:border-gray-900">
              </div>
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Factory</label>
                <input type="text" id="edit-factory" value="<%= batch.factory || '' %>" class="w-full border border-gray-300 rounded px-4 py-3 focus:outline-none focus:border-gray-900">
              </div>
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Production Date</label>
                <input type="date" id="edit-production-date" value="<%= batch.production_date ? batch.production_date.substring(0, 10) : '' %>" class="w-full border border-gray-300 rounded px-4 py-3 focus:outline-none focus:border-gray-900">
              </div>
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-2">Country of Production</label>
                <input type="text" id="edit-country" value="<%= batch.country_of_production || '' %>" class="w-full border border-gray-300 rounded px-4 py-3 focus:outline-none focus:border-gray-900">
              </div>
            </div>
            <div class="flex gap-3">
              <button type="submit" class="bg-gray-900 text-white px-6 py-3 rounded hover:bg-gray-800 font-semibold">
                Save Changes
              </button>
              <button type="button" onclick="toggleEdit('batch-info')" class="bg-gray-300 text-gray-900 px-6 py-3 rounded hover:bg-gray-400 font-semibold">
                Cancel
              </button>
            </div>
          </form>
        </div>

        <!-- GTINs in this Batch (grouped by style) -->
        <div class="bg-white rounded-lg shadow-md p-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">GTINs (grouped by style)</h2>

          <% if (gtins && gtins.length > 0) {
            // Group GTINs by style
            const gtinsByStyle = {};
            gtins.forEach(gtin => {
              if (!gtinsByStyle[gtin.style_number]) {
                gtinsByStyle[gtin.style_number] = { styleName: '', items: [] };
              }
              // Store first gtin object to get style info
              if (!gtinsByStyle[gtin.style_number].styleName) {
                gtinsByStyle[gtin.style_number].styleName = gtin.style_number;
              }
              gtinsByStyle[gtin.style_number].items.push(gtin);
            });
          %>
            <div class="space-y-6">
              <% Object.entries(gtinsByStyle).forEach(([styleNum, styleData]) => { %>
                <div class="border border-gray-200 rounded-lg overflow-hidden">
                  <!-- Style Header -->
                  <div class="bg-gradient-to-r from-blue-50 to-blue-100 border-b border-blue-200 px-6 py-4">
                    <h3 class="font-bold text-gray-900 text-lg"><%= styleNum %></h3>
                    <p class="text-sm text-gray-600 mt-1"><%= styleData.items.length %> GTIN variant<%= styleData.items.length !== 1 ? 's' : '' %></p>
                  </div>

                  <!-- GTINs for this style -->
                  <div class="overflow-x-auto">
                    <table class="w-full">
                      <thead>
                        <tr class="bg-gray-50 border-b border-gray-300">
                          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900">GTIN</th>
                          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900">Size</th>
                          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900">Color</th>
                          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900">SGTINs</th>
                          <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900"></th>
                        </tr>
                      </thead>
                      <tbody>
                        <% styleData.items.forEach(gtin => { %>
                          <tr class="border-b border-gray-200 hover:bg-blue-50 transition-colors">
                            <td class="px-6 py-4 font-mono text-sm text-blue-600 font-semibold">
                              <a href="/admin-v2/gtins/<%= gtin.id %>" class="hover:underline">
                                <%= gtin.gtin %>
                              </a>
                            </td>
                            <td class="px-6 py-4 text-sm"><%= gtin.size || '-' %></td>
                            <td class="px-6 py-4 text-sm"><%= gtin.color || '-' %></td>
                            <td class="px-6 py-4 text-sm font-semibold text-gray-900"><%= gtin.sgtin_count || 0 %></td>
                            <td class="px-6 py-4 text-right">
                              <a href="/admin-v2/gtins/<%= gtin.id %>" class="text-blue-600 hover:text-blue-800 text-sm font-medium">
                                View →
                              </a>
                            </td>
                          </tr>
                        <% }); %>
                      </tbody>
                    </table>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <p class="text-gray-500">No GTINs in this batch</p>
          <% } %>
        </div>

      </div>

      <!-- Sidebar (1/3) -->
      <div class="space-y-6">

        <!-- Statistics -->
        <div class="bg-white rounded-lg shadow-md p-6">
          <h3 class="text-lg font-bold text-gray-900 mb-4">Statistics</h3>
          <div class="space-y-3 text-sm">
            <div class="flex justify-between">
              <span class="text-gray-600">Styles:</span>
              <span class="font-semibold"><%= styleCount %></span>
            </div>
            <div class="flex justify-between">
              <span class="text-gray-600">GTINs:</span>
              <span class="font-semibold"><%= gtinCount %></span>
            </div>
            <div class="flex justify-between">
              <span class="text-gray-600">SGTINs:</span>
              <span class="font-semibold"><%= sgtinCount %></span>
            </div>
          </div>
        </div>

        <!-- Multi-Style Info -->
        <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
          <h3 class="text-sm font-bold text-blue-900 mb-2">Multi-Style Batch</h3>
          <p class="text-xs text-blue-800">
            This batch contains GTINs from <strong><%= styleCount %> different styles</strong>.
          </p>
        </div>

      </div>
    </div>
  </div>

  <script>
    function toggleEdit(section) {
      const view = document.getElementById(section + '-view');
      const edit = document.getElementById(section + '-edit');

      if (view && edit) {
        view.classList.toggle('hidden');
        edit.classList.toggle('hidden');
      }
    }

    async function saveBatchInfo(e) {
      e.preventDefault();

      const data = {
        production_order: document.getElementById('edit-production-order').value,
        factory: document.getElementById('edit-factory').value,
        production_date: document.getElementById('edit-production-date').value,
        country_of_production: document.getElementById('edit-country').value
      };

      try {
        const res = await fetch('/admin-v2/batches/<%= batch.id %>', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (res.ok) {
          alert('Batch updated successfully');
          location.reload();
        } else {
          alert('Error updating batch');
        }
      } catch (err) {
        alert('Error: ' + err.message);
      }
    }
  </script>
</body>
</html>
