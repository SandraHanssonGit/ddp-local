<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= batch.batch_id %> - Batch Detail</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
  <script src="/js/admin-modal.js"></script>
</head>
<body>
  <div class="wrap">
    <div class="detail-header">
      <div>
        <h1>Batch <%= batch.batch_id %></h1>
        <p class="subtitle">Production Order: <%= batch.production_order || '—' %></p>
      </div>
      <a href="/admin-v2?tab=batches" class="back-link">← Back to Batches</a>
    </div>

    <!-- Production lock status -->
    <% if (batch.produced_at) { %>
      <div class="lock-banner" style="display:flex; justify-content:space-between; align-items:center;">
        <div>
          🔒 <strong>Production-locked</strong> since <%= new Date(batch.produced_at).toLocaleString('en-US') %>.
          Field changes from here on are kept in the change log, not silently overwritten.
        </div>
      </div>
    <% } else { %>
      <div class="card" style="display:flex; justify-content:space-between; align-items:center; padding:16px 20px; margin-bottom:20px;">
        <div class="small muted">This batch is not yet marked as produced — field values can be freely edited.</div>
        <button onclick="markProduced()" class="btn btn-primary">Mark as Produced</button>
      </div>
    <% } %>

    <!-- Statistics Cards -->
    <div class="stat-grid">
      <div class="stat-card">
        <div class="stat-label">Status</div>
        <div class="stat-value" style="<%= batchStatus === 'Completed' ? 'color:var(--success);' : '' %> font-size:20px;"><%= batchStatus %></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Styles</div>
        <div class="stat-value" style="color:var(--accent);"><%= style_count %></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">GTINs Planned</div>
        <div class="stat-value" style="color:var(--accent);"><%= gtin_count %></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Code Needed</div>
        <div class="stat-value"><%= typeof planned_total !== 'undefined' ? planned_total : 0 %></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Individual Units Created</div>
        <div class="stat-value" style="color:var(--success);"><%= sgtin_count %></div>
      </div>
    </div>

    <!-- Add GTINs Card -->
    <div class="card">
      <h2 style="margin-bottom:20px;">Add GTINs to Batch</h2>

      <form id="addGtinForm">
        <div class="field-grid-3" style="margin-bottom:16px;">
          <div>
            <label>Select Style</label>
            <select id="styleSelect" required>
              <option value="">Choose a Style...</option>
            </select>
          </div>
          <div id="variantDiv" class="hidden">
            <label>Select Variant</label>
            <select id="variantSelect">
              <option value="">All Variants</option>
            </select>
          </div>
          <div>
            <label>Select GTIN</label>
            <select id="gtinSelect" required disabled>
              <option value="">Choose Style first...</option>
            </select>
          </div>
        </div>

        <div class="field-row">
          <label>Code Needed</label>
          <input type="number" id="quantityInput" min="1" value="100" required>
        </div>

        <button type="submit" class="btn btn-primary">Add GTIN to Batch</button>
      </form>
    </div>

    <!-- Batch Planning Card -->
    <div class="card">
      <h2 style="margin-bottom:4px;">QR Codes per GTIN</h2>
      <p class="small muted" style="margin-bottom:16px;">
        Number of QR codes needed per GTIN in this batch. Once production
        is complete this can be updated to match what was actually produced.
      </p>

      <% if (typeof batchGtins !== 'undefined' && batchGtins && batchGtins.length > 0) { %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Style</th>
                <th>Variant</th>
                <th>Item #</th>
                <th>GTIN</th>
                <th class="center">Code Needed</th>
                <th class="center" title="Units received from the factory, each with a code attached">Units Shipped</th>
                <th class="center" title="First time the Viewed event was triggered for that unit">Code Activated</th>
              </tr>
            </thead>
            <tbody>
              <% batchGtins.forEach(bg => {
                const used = bg.created_quantity || 0;
                const needed = bg.planned_quantity || 0;
                const activated = bg.activated_quantity || 0;
              %>
                <tr>
                  <td class="mono small"><strong><%= bg.style_number %></strong></td>
                  <td class="small"><%= bg.variant_name || '—' %></td>
                  <td class="small"><%= bg.item_number %></td>
                  <td class="mono small"><strong><%= bg.gtin %></strong></td>
                  <td class="center" style="font-weight:600;"><%= needed %></td>
                  <td class="center"><span class="badge badge-success small"><%= used %></span></td>
                  <td class="center"><span class="badge small"><%= activated %></span></td>
                </tr>
              <% }); %>
              <tr class="totals-row">
                <td colspan="4" style="text-align:right;">TOTALS:</td>
                <td class="center"><%= planned_total %></td>
                <td class="center"><span class="badge badge-success small"><%= sgtin_count %></span></td>
                <td class="center"><span class="badge small"><%= typeof activated_total !== 'undefined' ? activated_total : 0 %></span></td>
              </tr>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="muted" style="font-style:italic;">No GTINs planned for this batch yet</p>
      <% } %>
    </div>

    <!-- SGTINs Detail Card -->
    <div class="card">
      <h2 style="margin-bottom:20px;">Individual Units Created</h2>

      <% if (sgtins && sgtins.length > 0) { %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Serial #</th>
                <th>GTIN</th>
                <th>Style</th>
                <th>Variant</th>
                <th>Size</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% sgtins.forEach(sg => { %>
                <tr>
                  <td class="mono"><strong><%= sg.serial_number %></strong></td>
                  <td class="mono small"><%= sg.gtin %></td>
                  <td class="mono"><%= sg.style_number %></td>
                  <td><%= sg.variant_name || '—' %></td>
                  <td class="small">
                    <% const size = [sg.size_value_1, sg.size_value_2, sg.size_value_3].filter(s => s).join('-') %>
                    <%= size %>
                  </td>
                  <td><a href="/admin-v2/sgtin/<%= sg.id %>" class="link-action">→</a></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty-state">No individual units created yet for this batch</div>
      <% } %>
    </div>

    <!-- Economic Operator Override Card (ROADMAP.md Phase 4) -->
    <div class="card">
      <h2 style="margin-bottom:8px;">Legal Responsibility Override</h2>
      <p class="small muted" style="margin-bottom:16px;">
        Optional - a batch can span multiple styles, each with their
        own economic operator. Only set this if this specific
        production run used a different manufacturer/importer than
        its GTINs' styles.
      </p>
      <form id="operatorAssignForm" style="display:flex; gap:12px; align-items:flex-end;">
        <div style="flex:1;">
          <label class="label-sm">Economic Operator</label>
          <select name="operator_id">
            <option value="">-- No override (use each GTIN's Style) --</option>
            <% (typeof operators !== 'undefined' ? operators : []).forEach(op => { %>
              <option value="<%= op.id %>" <%= batch.operator_id == op.id ? 'selected' : '' %>>
                <%= op.legal_name %> (<%= op.role.replace(/_/g, ' ') %>)
              </option>
            <% }); %>
          </select>
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
      </form>
    </div>

    <!-- DPP Fields Card -->
    <div class="card">
      <div class="card-head">
        <h2>DPP Field Values</h2>
        <button onclick="toggleDppEdit()" class="btn btn-primary">Edit</button>
      </div>

      <%
        const scopeQuery = (styleId, variantId) => {
          const params = [];
          if (styleId) params.push('scopeStyle=' + styleId);
          if (variantId) params.push('scopeVariant=' + variantId);
          if (locale) params.push('lang=' + encodeURIComponent(locale));
          return '?' + params.join('&');
        };
        const isActiveScope = (styleId, variantId) =>
          (typeof scopeStyleId !== 'undefined' ? scopeStyleId : null) == (styleId || null) &&
          (typeof scopeVariantId !== 'undefined' ? scopeVariantId : null) == (variantId || null);
      %>
      <% if (typeof scopeCombos !== 'undefined' && scopeCombos.length > 0) { %>
        <div class="locale-tabs">
          <span class="label-sm" style="margin-right:4px;">Scope:</span>
          <a href="<%= scopeQuery(null, null) %>" class="<%= isActiveScope(null, null) ? 'active' : '' %>">Whole batch</a>
          <% scopeCombos.forEach(c => { %>
            <a href="<%= scopeQuery(c.style_id, c.variant_id) %>" class="<%= isActiveScope(c.style_id, c.variant_id) ? 'active' : '' %>">
              <%= c.style_number %><% if (c.variant_name) { %> – <%= c.variant_name %><% } %>
            </a>
          <% }); %>
        </div>
      <% } %>

      <div class="locale-tabs">
        <span class="label-sm" style="margin-right:4px;">Language:</span>
        <a href="<%= scopeQuery(scopeStyleId, scopeVariantId).replace(/&?lang=[^&]*/, '') || '?' %>" class="<%= !locale ? 'active' : '' %>">Default</a>
        <% (typeof availableLocales !== 'undefined' ? availableLocales : []).forEach(loc => { %>
          <a href="<%= scopeQuery(scopeStyleId, scopeVariantId) %>&lang=<%= encodeURIComponent(loc) %>" class="<%= locale === loc ? 'active' : '' %>"><%= loc %></a>
        <% }); %>
        <form method="GET" style="display:inline-flex;align-items:center;gap:6px;margin-left:8px;" onsubmit="event.preventDefault(); const v=this.newlang.value.trim(); if(v) window.location.href='<%- scopeQuery(scopeStyleId, scopeVariantId).replace(/&?lang=[^&]*/, '') %>&lang='+encodeURIComponent(v);">
          <input type="text" name="newlang" placeholder="+ add locale e.g. fr-FR" class="small" style="width:160px;">
          <button type="submit" class="btn small">Go</button>
        </form>
      </div>

      <p class="small muted" style="margin-bottom:16px;">
        <% if (typeof scopeStyleId !== 'undefined' && scopeStyleId) { %>
          Showing values scoped to this Style<% if (scopeVariantId) { %> and Variant<% } %> within this batch only - other Styles in this batch are unaffected.
        <% } else { %>
          A batch can include GTINs from several different styles - showing
          whole-batch values here. Use the Scope tabs above to set a value for
          just one Style (or Style + Variant) within this batch instead.
        <% } %>
      </p>

      <!-- View Mode -->
      <div id="dpp-fields-view">
        <% (typeof dppValues !== 'undefined' ? dppValues : []).forEach(val => { %>
          <% if (val.value) { %>
            <div class="field-card overridden">
              <div class="field-card-head">
                <label class="label-sm"><%= val.label %></label>
                <span class="badge badge-accent"><%= (typeof scopeStyleId !== 'undefined' && scopeStyleId) ? 'Set for this scope' : 'Set at Batch' %></span>
              </div>
              <p class="field-card-value"><%= val.value %></p>
              <p style="margin-top:8px;"><a href="#" onclick="clearOverride('<%= val.field_key %>'); return false;" class="link-action danger">Clear</a></p>
            </div>
          <% } else { %>
            <div class="field-card notset">
              <div class="field-card-head">
                <label class="label-sm"><%= val.label %></label>
                <span class="badge" style="background:var(--lock-border); color:var(--lock-text);">Not set yet</span>
              </div>
            </div>
          <% } %>
        <% }); %>
        <% if (typeof dppValues === 'undefined' || dppValues.length === 0) { %>
          <p class="muted" style="font-style:italic;">No fields are configured to be editable at the Batch level.</p>
        <% } %>
      </div>

      <!-- Edit Mode -->
      <div id="dpp-fields-edit" class="hidden">
        <% if (typeof dppValues !== 'undefined' && dppValues.length > 0) { %>
          <% dppValues.forEach(val => { %>
            <div class="field-row">
              <label style="display:block; margin-bottom:6px;"><%= val.label %></label>
              <textarea id="field-<%= val.field_key %>" rows="3"><%= val.value %></textarea>
            </div>
          <% }); %>
        <% } else { %>
          <p class="muted" style="font-style:italic;">No fields are configured to be editable at the Batch level.</p>
        <% } %>
        <div style="display:flex; gap:10px;">
          <button type="button" onclick="saveBatchDppValues()" class="btn btn-primary">Save Changes</button>
          <button type="button" onclick="toggleDppEdit()" class="btn">Cancel</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    function toggleDppEdit() {
      document.getElementById('dpp-fields-view').classList.toggle('hidden');
      document.getElementById('dpp-fields-edit').classList.toggle('hidden');
    }

    const currentLocale = <%- JSON.stringify(locale || null) %>;
    const currentScopeStyleId = <%- JSON.stringify(typeof scopeStyleId !== 'undefined' ? scopeStyleId : null) %>;
    const currentScopeVariantId = <%- JSON.stringify(typeof scopeVariantId !== 'undefined' ? scopeVariantId : null) %>;

    function scopeAndLocaleQuery() {
      const params = [];
      if (currentScopeStyleId) params.push('scopeStyle=' + currentScopeStyleId);
      if (currentScopeVariantId) params.push('scopeVariant=' + currentScopeVariantId);
      if (currentLocale) params.push('lang=' + encodeURIComponent(currentLocale));
      return params.length ? '?' + params.join('&') : '';
    }

    async function saveBatchDppValues() {
      const values = {};
      document.querySelectorAll('[id^="field-"]').forEach(el => {
        const key = el.id.substring(6);
        values[key] = el.value;
      });

      try {
        const res = await fetch('/admin-v2/batch/<%= batch.id %>/dpp-values' + scopeAndLocaleQuery(), {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(values)
        });

        if (res.ok) {
          await dppAlert('DPP values saved');
          location.reload();
        } else {
          await dppAlert('Error saving DPP values');
        }
      } catch (err) {
        await dppAlert('Error: ' + err.message);
      }
    }

    document.getElementById('operatorAssignForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      try {
        const res = await fetch('/admin-v2/batch/<%= batch.id %>/operator', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ operator_id: formData.get('operator_id') || null })
        });
        const result = await res.json();
        if (result.success) {
          location.reload();
        } else {
          await dppAlert('Error: ' + (result.error || 'Unknown error'));
        }
      } catch (err) {
        await dppAlert('Error: ' + err.message);
      }
    });

    async function markProduced() {
      if (!(await dppConfirm('Mark this batch as produced? Field edits after this point will be kept in the change log instead of overwritten.'))) return;
      try {
        const res = await fetch('/admin-v2/batch/<%= batch.id %>/mark-produced', { method: 'POST' });
        if (res.ok) { location.reload(); }
        else { const data = await res.json(); await dppAlert('Error: ' + (data.error || 'could not mark as produced')); }
      } catch (err) { await dppAlert('Error: ' + err.message); }
    }

    const clearOverrideEntity = currentScopeStyleId
      ? { type: 'batch_style', id: <%- JSON.stringify(typeof scope !== 'undefined' && scope ? scope.id : null) %> }
      : { type: 'batch', id: <%= batch.id %> };

    async function clearOverride(fieldKey) {
      if (!(await dppConfirm('Clear this value' + (currentScopeStyleId ? ' for this scope?' : ' for the batch?')))) return;
      try {
        const localeQuery = currentLocale ? '?lang=' + encodeURIComponent(currentLocale) : '';
        const res = await fetch('/api/admin/overrides/' + clearOverrideEntity.type + '/' + clearOverrideEntity.id + '/field/' + encodeURIComponent(fieldKey) + localeQuery, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({})
        });
        if (res.ok) { location.reload(); }
        else { await dppAlert('Error clearing value'); }
      } catch (err) { await dppAlert('Error: ' + err.message); }
    }

    // Inject data from server
    const allStyles = <%- JSON.stringify(styles || []) %>;
    const allGtinsData = <%- JSON.stringify(gtins || []) %>;

    // Initialize style dropdown
    const styleSelect = document.getElementById('styleSelect');
    styleSelect.innerHTML = '<option value="">Choose a Style...</option>' +
      allStyles.map(s => `<option value="${s.id}">${s.style_number} - ${s.product_name} (${s.product_type})</option>`).join('');

    function updateFormByStyle() {
      const styleId = parseInt(styleSelect.value);
      const variantDiv = document.getElementById('variantDiv');
      const variantSelect = document.getElementById('variantSelect');
      const gtinSelect = document.getElementById('gtinSelect');

      if (!styleId) {
        variantDiv.classList.add('hidden');
        gtinSelect.disabled = true;
        gtinSelect.innerHTML = '<option value="">Choose Style first...</option>';
        return;
      }

      // Get GTINs for selected style
      const styleGtins = allGtinsData.filter(g => g.style_id === styleId);

      // Get unique variants for this style
      const variantsSet = new Set();
      const variantMap = {};
      styleGtins.forEach(g => {
        if (g.variant_id && g.variant_name) {
          variantsSet.add(g.variant_id);
          variantMap[g.variant_id] = g.variant_name;
        }
      });

      // Show/hide variant dropdown
      if (variantsSet.size > 0) {
        variantDiv.classList.remove('hidden');
        variantSelect.innerHTML = '<option value="">All Variants</option>' +
          Array.from(variantsSet).map(vid =>
            `<option value="${vid}">${variantMap[vid]}</option>`
          ).join('');
      } else {
        variantDiv.classList.add('hidden');
        variantSelect.value = '';
      }

      updateGtinsDropdown(styleGtins);
    }

    function updateGtinsDropdown(styleGtins) {
      const variantId = document.getElementById('variantSelect').value;
      const gtinSelect = document.getElementById('gtinSelect');

      let filtered = styleGtins;
      if (variantId) {
        filtered = styleGtins.filter(g => g.variant_id === parseInt(variantId));
      }

      gtinSelect.disabled = filtered.length === 0;
      gtinSelect.innerHTML = '<option value="">Choose GTIN...</option>' +
        filtered.map(g => `<option value="${g.id}">${g.gtin} (${g.item_number})</option>`).join('');
    }

    styleSelect.addEventListener('change', updateFormByStyle);
    document.getElementById('variantSelect').addEventListener('change', function() {
      const styleId = parseInt(styleSelect.value);
      const styleGtins = allGtinsData.filter(g => g.style_id === styleId);
      updateGtinsDropdown(styleGtins);
    });

    document.getElementById('addGtinForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      const batchId = <%= batch.id %>;
      const gtinId = document.getElementById('gtinSelect').value;
      const quantity = document.getElementById('quantityInput').value;

      try {
        const res = await fetch('/admin-v2/batch-gtins', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            batch_id: batchId,
            gtin_id: gtinId,
            planned_quantity: parseInt(quantity)
          })
        });

        const data = await res.json();

        if (res.ok) {
          await dppAlert('GTIN added successfully');
          location.reload();
        } else {
          await dppAlert('Error: ' + (data.error || 'Failed to add GTIN'));
        }
      } catch (err) {
        await dppAlert('Error: ' + err.message);
      }
    });

  </script>
</body>
</html>
