<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= batch.batch_id %> - Batch Detail</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
  <script src="/js/admin-modal.js"></script>
</head>
<body>
  <div class="wrap">
    <div class="detail-header">
      <div>
        <h1>Batch <%= batch.batch_id %></h1>
        <p class="subtitle">Production Order: <%= batch.production_order || '—' %></p>
      </div>
      <a href="/admin-v2?tab=batches" class="back-link"><%- icon('arrow-left') %> Back to Batches</a>
    </div>

    <!-- Batch Information Card - same info-grid pattern as Style/GTIN/
         SGTIN detail pages' master-field cards, so batch dates aren't
         shown differently from everywhere else. Also matches their
         .card-identifiers muted styling (master/structural info, not
         passport content). -->
    <div class="card card-identifiers">
      <div class="card-head">
        <h2>Batch Information</h2>
      </div>
      <div class="info-grid">
        <div class="info-item">
          <label class="label-sm">Batch ID</label>
          <p class="value mono"><%= batch.batch_id %></p>
        </div>
        <div class="info-item">
          <label class="label-sm">Production Order</label>
          <p class="value"><%= batch.production_order || '—' %></p>
        </div>
        <div class="info-item">
          <label class="label-sm">Sent for Production</label>
          <p class="value"><%= new Date(batch.created_at).toLocaleDateString('en-US') %></p>
        </div>
        <div class="info-item">
          <label class="label-sm">Status</label>
          <p class="value" style="<%= batchStatus === 'Completed' ? 'color:var(--success);' : '' %>"><%= batchStatus %></p>
        </div>
        <div class="info-item">
          <label class="label-sm">Production Date</label>
          <% if (batch.produced_at) { %>
            <p class="value"><%= new Date(batch.produced_at).toLocaleDateString('en-US') %></p>
          <% } else { %>
            <p class="value muted">Not yet produced</p>
          <% } %>
        </div>
      </div>
      <% if (batch.produced_at) { %>
        <p class="small muted" style="margin-top:16px; display:flex; align-items:center; gap:4px;">
          <%- icon('lock', { size: 13 }) %> Locked - field changes from here on are kept in the change log, not silently overwritten.
        </p>
      <% } else { %>
        <button onclick="markProduced()" class="btn btn-primary" style="margin-top:16px;">Mark as Produced</button>
      <% } %>
    </div>

    <!-- Statistics Cards -->
    <div class="stat-grid">
      <div class="stat-card">
        <div class="stat-label">Styles</div>
        <div class="stat-value" style="color:var(--accent);"><%= style_count %></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">GTINs</div>
        <div class="stat-value" style="color:var(--accent);"><%= gtin_count %></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Individual Units Created</div>
        <div class="stat-value"><%= sgtin_count %></div>
      </div>
    </div>

    <!-- Batch Contents Tree (Style -> Variant -> GTIN -> SGTIN),
         design confirmed 2026-09-19 - replaces the old separate
         "QR Codes per GTIN" and "Individual Units Created" tables.
         GTINs will never be added here manually (fed from other
         systems), so there's no "Add GTIN" form either. -->
    <div class="card">
      <h2 style="margin-bottom:4px;">Batch Contents</h2>
      <p class="small muted" style="margin-bottom:16px;">
        Everything in this batch - Code Needed/Units Shipped/Code
        Activated are per GTIN. Click a row to expand it.
      </p>

      <div class="field-row">
        <input type="text" id="batchTreeSearch" placeholder="Search Style #, Product Name, Variant, GTIN, SKU..." style="width:100%; max-width:480px;" value="<%= treeSearch || '' %>">
      </div>

      <% if (typeof batchTree !== 'undefined' && batchTree && batchTree.length > 0) { %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Name</th>
                <th class="center">Code Needed</th>
                <th class="center" title="Units received from the factory, each with a code attached">Units Shipped</th>
                <th class="center" title="First time the Viewed event was triggered for that unit">Code Activated</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% batchTree.forEach(s => {
                const styleKey = 'style-' + s.id;
                const styleHasChildren = s.gtins.length > 0 || s.variants.length > 0;
              %>
                <tr
                  <% if (styleHasChildren) { %>style="cursor:pointer;" onclick="toggleTreeGroup('<%= styleKey %>')"<% } %>
                >
                  <td class="mono">
                    <% if (styleHasChildren) { %>
                      <span data-chevron="<%= styleKey %>" style="display:inline-flex; margin-right:6px; transition:transform 0.15s ease; color:var(--muted);"><%- icon('chevron-right', { size: 14 }) %></span>
                    <% } %>
                    <strong><%= s.style_number %></strong> <span class="small muted"><%= s.product_name %></span>
                  </td>
                  <td></td><td></td><td></td>
                  <td><a href="?scopeStyle=<%= s.id %>#dpp-fields-card" class="link-action" title="Edit values scoped to this Style within the batch"><%- icon('arrow-right') %></a></td>
                </tr>

                <!-- GTINs directly under the Style (no Variant) -->
                <% s.gtins.forEach(g => { %>
                  <tr data-parent="<%= styleKey %>" class="hidden">
                    <td class="mono small" style="padding-left:28px;"><%= g.item_number %> <span class="muted"><%= g.gtin %></span></td>
                    <td class="center" style="font-weight:600;"><%= g.planned_quantity || 0 %></td>
                    <td class="center"><span class="badge badge-success small"><%= g.created_quantity || 0 %></span></td>
                    <td class="center"><span class="badge small"><%= g.activated_quantity || 0 %></span></td>
                    <td style="white-space:nowrap;">
                      <a href="?scopeGtin=<%= g.gtin_id %>#dpp-fields-card" onclick="event.stopPropagation();" class="link-action" title="Edit values scoped to this GTIN within the batch"><%- icon('arrow-right') %></a>
                    </td>
                  </tr>
                  <% if (g.sgtins.length > 0) { %>
                    <% const gtinKey = 'gtin-' + g.gtin_id; %>
                    <tr data-parent="<%= styleKey %>" class="hidden" style="cursor:pointer;" onclick="toggleTreeGroup('<%= gtinKey %>')">
                      <td class="small muted" style="padding-left:44px;">
                        <span data-chevron="<%= gtinKey %>" style="display:inline-flex; margin-right:4px; transition:transform 0.15s ease;"><%- icon('chevron-right', { size: 12 }) %></span>
                        Show <%= g.sgtins.length %> unit<%= g.sgtins.length === 1 ? '' : 's' %>
                      </td>
                      <td></td><td></td><td></td><td></td>
                    </tr>
                    <% g.sgtins.forEach(sg => { %>
                      <tr data-parent="<%= gtinKey %>" data-grandparent="<%= styleKey %>" class="hidden">
                        <td class="mono small" style="padding-left:60px;"><%- icon('corner-down-right', { size: 12 }) %> <%= sg.serial_number %></td>
                        <td></td><td></td><td></td>
                        <td><a href="/admin-v2/sgtin/<%= sg.id %>" class="link-action"><%- icon('arrow-right') %></a></td>
                      </tr>
                    <% }); %>
                  <% } %>
                <% }); %>

                <!-- Variants, each with their own GTINs -->
                <% s.variants.forEach(v => { %>
                  <% const variantKey = 'variant-' + v.id; %>
                  <tr data-parent="<%= styleKey %>" class="hidden" style="cursor:pointer;" onclick="toggleTreeGroup('<%= variantKey %>')">
                    <td class="mono small" style="padding-left:28px;">
                      <span data-chevron="<%= variantKey %>" style="display:inline-flex; margin-right:4px; transition:transform 0.15s ease; color:var(--muted);"><%- icon('chevron-right', { size: 13 }) %></span>
                      <%- icon('corner-down-right', { size: 13 }) %> <%= v.variant_name %>
                    </td>
                    <td></td><td></td><td></td>
                    <td><a href="?scopeStyle=<%= s.id %>&scopeVariant=<%= v.id %>#dpp-fields-card" onclick="event.stopPropagation();" class="link-action" title="Edit values scoped to this Variant within the batch"><%- icon('arrow-right') %></a></td>
                  </tr>
                  <% v.gtins.forEach(g => { %>
                    <tr data-parent="<%= variantKey %>" data-grandparent="<%= styleKey %>" class="hidden">
                      <td class="mono small" style="padding-left:52px;"><%= g.item_number %> <span class="muted"><%= g.gtin %></span></td>
                      <td class="center" style="font-weight:600;"><%= g.planned_quantity || 0 %></td>
                      <td class="center"><span class="badge badge-success small"><%= g.created_quantity || 0 %></span></td>
                      <td class="center"><span class="badge small"><%= g.activated_quantity || 0 %></span></td>
                      <td style="white-space:nowrap;">
                        <a href="?scopeGtin=<%= g.gtin_id %>#dpp-fields-card" onclick="event.stopPropagation();" class="link-action" title="Edit values scoped to this GTIN within the batch"><%- icon('arrow-right') %></a>
                      </td>
                    </tr>
                    <% if (g.sgtins.length > 0) { %>
                      <% const gtinKey = 'gtin-' + g.gtin_id; %>
                      <tr data-parent="<%= variantKey %>" data-grandparent="<%= styleKey %>" class="hidden" style="cursor:pointer;" onclick="toggleTreeGroup('<%= gtinKey %>')">
                        <td class="small muted" style="padding-left:68px;">
                          <span data-chevron="<%= gtinKey %>" style="display:inline-flex; margin-right:4px; transition:transform 0.15s ease;"><%- icon('chevron-right', { size: 12 }) %></span>
                          Show <%= g.sgtins.length %> unit<%= g.sgtins.length === 1 ? '' : 's' %>
                        </td>
                        <td></td><td></td><td></td><td></td>
                      </tr>
                      <% g.sgtins.forEach(sg => { %>
                        <tr data-parent="<%= gtinKey %>" data-grandparent="<%= variantKey %>" data-greatgrandparent="<%= styleKey %>" class="hidden">
                          <td class="mono small" style="padding-left:84px;"><%- icon('corner-down-right', { size: 12 }) %> <%= sg.serial_number %></td>
                          <td></td><td></td><td></td>
                          <td><a href="/admin-v2/sgtin/<%= sg.id %>" class="link-action"><%- icon('arrow-right') %></a></td>
                        </tr>
                      <% }); %>
                    <% } %>
                  <% }); %>
                <% }); %>
              <% }); %>
              <tr class="totals-row">
                <td style="text-align:right;">TOTALS:</td>
                <td class="center"><%= planned_total %></td>
                <td class="center"><%= sgtin_count %></td>
                <td class="center"><span class="badge small"><%= typeof activated_total !== 'undefined' ? activated_total : 0 %></span></td>
                <td></td>
              </tr>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="muted" style="font-style:italic;">Nothing planned for this batch yet</p>
      <% } %>
    </div>

    <!-- DPP Fields Card -->
    <div class="card" id="dpp-fields-card">
      <div class="card-head">
        <h2>Field Values</h2>
        <button onclick="toggleDppEdit()" class="btn btn-primary">Edit</button>
      </div>

      <%
        // Scope navigation now comes from clicking a row in the Batch
        // Contents tree above (design 2026-09-20 - merged the tree and
        // this card into one flow instead of two separate ones), not a
        // separate flat scope-tab list. scopeQuery still builds the
        // query string, just used by the tree's row links and the
        // language tabs below, not a standalone tab bar here.
        const scopeQuery = (styleId, variantId, gtinId) => {
          const params = [];
          if (gtinId) params.push('scopeGtin=' + gtinId);
          else if (styleId) {
            params.push('scopeStyle=' + styleId);
            if (variantId) params.push('scopeVariant=' + variantId);
          }
          if (locale) params.push('lang=' + encodeURIComponent(locale));
          return '?' + params.join('&');
        };
        const currentScopeGtinId = typeof scopeGtinId !== 'undefined' ? scopeGtinId : null;
        const scopedGtin = currentScopeGtinId ? batchGtins.find(g => g.gtin_id === currentScopeGtinId) : null;
      %>

      <div class="locale-tabs">
        <span class="label-sm" style="margin-right:4px;">Language:</span>
        <a href="<%= scopeQuery(scopeStyleId, scopeVariantId, currentScopeGtinId).replace(/&?lang=[^&]*/, '') || '?' %>" class="<%= !locale ? 'active' : '' %>">Default</a>
        <% (typeof availableLocales !== 'undefined' ? availableLocales : []).forEach(loc => { %>
          <a href="<%= scopeQuery(scopeStyleId, scopeVariantId, currentScopeGtinId) %>&lang=<%= encodeURIComponent(loc) %>" class="<%= locale === loc ? 'active' : '' %>"><%= loc %></a>
        <% }); %>
        <form method="GET" style="display:inline-flex;align-items:center;gap:6px;margin-left:8px;" onsubmit="event.preventDefault(); const v=this.newlang.value.trim(); if(v) window.location.href='<%- scopeQuery(scopeStyleId, scopeVariantId, currentScopeGtinId).replace(/&?lang=[^&]*/, '') %>&lang='+encodeURIComponent(v);">
          <input type="text" name="newlang" placeholder="+ add locale e.g. fr-FR" class="small" style="width:160px;">
          <button type="submit" class="btn small">Go</button>
        </form>
      </div>

      <p class="small muted" style="margin-bottom:16px;">
        <% if (scopedGtin) { %>
          Now editing: GTIN <strong><%= scopedGtin.item_number %></strong> (<%= scopedGtin.style_number %><% if (scopedGtin.variant_name) { %> – <%= scopedGtin.variant_name %><% } %>) within this batch only.
          <a href="?<%= locale ? 'lang=' + encodeURIComponent(locale) : '' %>" class="link-action">← Whole batch</a>
        <% } else if (typeof scopeStyleId !== 'undefined' && scopeStyleId) { %>
          Now editing: values scoped to this Style<% if (scopeVariantId) { %> and Variant<% } %> within this batch only.
          <a href="?<%= locale ? 'lang=' + encodeURIComponent(locale) : '' %>" class="link-action">← Whole batch</a>
        <% } else { %>
          A batch can include GTINs from several different styles - showing
          whole-batch values here. Click a Style, Variant, or GTIN row in
          Batch Contents above to edit values scoped to just that one instead.
        <% } %>
      </p>

      <%
        // Scoped views (Style/Variant/GTIN) carry `source`/`locked`/
        // `set_at_this_scope` per field (resolveBatchScopedFields);
        // whole-batch view's fields (getFieldsForLevel) don't - kept
        // as two branches below rather than forcing whole-batch
        // through the scoped shape, since a Batch can span multiple
        // Styles and has no single resolved passport of its own.
        const fieldSourceLabel = (s) => ({
          batch_gtin: 'Batch (this GTIN)',
          gtin: 'GTIN',
          batch_variant: 'Batch (this Variant)',
          batch_style: 'Batch (this Style)',
          batch: 'Batch',
          variant: 'Variant',
          style: 'Style'
        })[s] || s;
      %>

      <!-- View Mode -->
      <div id="dpp-fields-view">
        <% (typeof dppValues !== 'undefined' ? dppValues : []).forEach(val => { %>
          <% const isScopedField = typeof val.source !== 'undefined'; %>
          <% if (isScopedField && val.set_at_this_scope) { %>
            <div class="field-card overridden">
              <div class="field-card-head">
                <label class="label-sm"><%= val.label %></label>
                <span class="badge badge-accent" style="display:inline-flex; align-items:center; gap:4px;">
                  <% if (val.locked) { %><%- icon('lock', { size: 12 }) %><% } %>Set for this scope
                </span>
              </div>
              <p class="field-card-value"><%= val.value %></p>
              <p style="margin-top:8px;"><a href="#" onclick="clearOverride('<%= val.field_key %>'); return false;" class="link-action danger">Clear</a></p>
            </div>
          <% } else if (isScopedField && val.value) { %>
            <div class="field-card inherited">
              <div class="field-card-head">
                <label class="label-sm"><%= val.label %></label>
                <span class="badge badge-muted" style="display:inline-flex; align-items:center; gap:4px;">
                  <% if (val.locked) { %><%- icon('lock', { size: 12 }) %><% } %>Inherited from <%= fieldSourceLabel(val.source) %>
                </span>
              </div>
              <p class="field-card-value muted"><%= val.value %></p>
            </div>
          <% } else if (isScopedField) { %>
            <div class="field-card notset">
              <div class="field-card-head">
                <label class="label-sm"><%= val.label %></label>
                <span class="badge" style="background:var(--lock-border); color:var(--lock-text);">Not set anywhere</span>
              </div>
            </div>
          <% } else if (val.value) { %>
            <div class="field-card overridden">
              <div class="field-card-head">
                <label class="label-sm"><%= val.label %></label>
                <span class="badge badge-accent">Set at Batch</span>
              </div>
              <p class="field-card-value"><%= val.value %></p>
              <p style="margin-top:8px;"><a href="#" onclick="clearOverride('<%= val.field_key %>'); return false;" class="link-action danger">Clear</a></p>
            </div>
          <% } else { %>
            <div class="field-card notset">
              <div class="field-card-head">
                <label class="label-sm"><%= val.label %></label>
                <span class="badge" style="background:var(--lock-border); color:var(--lock-text);">Not set yet</span>
              </div>
            </div>
          <% } %>
        <% }); %>
        <% if (typeof dppValues === 'undefined' || dppValues.length === 0) { %>
          <p class="muted" style="font-style:italic;">No fields are configured to be editable at the Batch level.</p>
        <% } %>
      </div>

      <!-- Edit Mode -->
      <div id="dpp-fields-edit" class="hidden">
        <% if (typeof dppValues !== 'undefined' && dppValues.length > 0) { %>
          <% dppValues.forEach(val => { %>
            <% const isScopedField = typeof val.source !== 'undefined'; %>
            <% const notEditableHere = isScopedField && val.editable === false; %>
            <div class="field-row">
              <label style="display:block; margin-bottom:6px;"><%= val.label %></label>
              <% if (notEditableHere) { %>
                <p class="small muted" style="display:flex; align-items:center; gap:4px;">
                  <%- icon('lock', { size: 12 }) %> Not editable at this level (see Field Config &rsaquo; Levels) - <%= val.value ? ('current value: ' + val.value) : 'no value set' %>
                </p>
              <% } else { %>
                <% if (isScopedField && !val.set_at_this_scope && val.value) { %>
                  <p class="small muted" style="margin-bottom:6px; display:flex; align-items:center; gap:4px;">
                    <% if (val.locked) { %><%- icon('lock', { size: 12 }) %><% } %>
                    Inherited from <%= fieldSourceLabel(val.source) %>: <span class="mono"><%= val.value %></span> — leave blank to keep inheriting
                  </p>
                <% } %>
                <textarea id="field-<%= val.field_key %>" rows="3"><%= (isScopedField && !val.set_at_this_scope) ? '' : (val.value || '') %></textarea>
              <% } %>
            </div>
          <% }); %>
        <% } else { %>
          <p class="muted" style="font-style:italic;">No fields are configured to be editable at the Batch level.</p>
        <% } %>
        <div style="display:flex; gap:10px;">
          <button type="button" onclick="saveBatchDppValues()" class="btn btn-primary">Save Changes</button>
          <button type="button" onclick="toggleDppEdit()" class="btn">Cancel</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    function toggleDppEdit() {
      document.getElementById('dpp-fields-view').classList.toggle('hidden');
      document.getElementById('dpp-fields-edit').classList.toggle('hidden');
    }

    const currentLocale = <%- JSON.stringify(locale || null) %>;
    const currentScopeStyleId = <%- JSON.stringify(typeof scopeStyleId !== 'undefined' ? scopeStyleId : null) %>;
    const currentScopeVariantId = <%- JSON.stringify(typeof scopeVariantId !== 'undefined' ? scopeVariantId : null) %>;
    const currentScopeGtinId = <%- JSON.stringify(typeof scopeGtinId !== 'undefined' ? scopeGtinId : null) %>;

    function scopeAndLocaleQuery() {
      const params = [];
      if (currentScopeGtinId) params.push('scopeGtin=' + currentScopeGtinId);
      else if (currentScopeStyleId) {
        params.push('scopeStyle=' + currentScopeStyleId);
        if (currentScopeVariantId) params.push('scopeVariant=' + currentScopeVariantId);
      }
      if (currentLocale) params.push('lang=' + encodeURIComponent(currentLocale));
      return params.length ? '?' + params.join('&') : '';
    }

    async function saveBatchDppValues() {
      const values = {};
      document.querySelectorAll('[id^="field-"]').forEach(el => {
        const key = el.id.substring(6);
        values[key] = el.value;
      });

      // Batch is production-locked - capture an optional reason so the
      // audit trail can show why a locked value was changed, not just
      // who/when (ROADMAP.md freeze-at-production gap).
      const isLocked = <%- JSON.stringify(!!batch.produced_at) %>;
      const reason = isLocked
        ? await dppPrompt('This batch is production-locked. Why are you changing a value?', 'Reason (optional)')
        : '';

      try {
        const res = await fetch('/admin-v2/batch/<%= batch.id %>/dpp-values' + scopeAndLocaleQuery(), {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ values, reason })
        });

        if (res.ok) {
          await dppAlert('DPP values saved');
          location.reload();
        } else {
          await dppAlert('Error saving DPP values');
        }
      } catch (err) {
        await dppAlert('Error: ' + err.message);
      }
    }

    async function markProduced() {
      if (!(await dppConfirm('Mark this batch as produced? Field edits after this point will be kept in the change log instead of overwritten.'))) return;
      try {
        const res = await fetch('/admin-v2/batch/<%= batch.id %>/mark-produced', { method: 'POST' });
        if (res.ok) { location.reload(); }
        else { const data = await res.json(); await dppAlert('Error: ' + (data.error || 'could not mark as produced')); }
      } catch (err) { await dppAlert('Error: ' + err.message); }
    }

    const clearOverrideEntity = currentScopeGtinId
      ? { type: 'batch_gtin', id: <%- JSON.stringify(typeof scope !== 'undefined' && scope ? scope.id : null) %> }
      : currentScopeStyleId
      ? { type: 'batch_style', id: <%- JSON.stringify(typeof scope !== 'undefined' && scope ? scope.id : null) %> }
      : { type: 'batch', id: <%= batch.id %> };

    async function clearOverride(fieldKey) {
      if (!(await dppConfirm('Clear this value' + ((currentScopeGtinId || currentScopeStyleId) ? ' for this scope?' : ' for the batch?')))) return;
      try {
        const localeQuery = currentLocale ? '?lang=' + encodeURIComponent(currentLocale) : '';
        const res = await fetch('/api/admin/overrides/' + clearOverrideEntity.type + '/' + clearOverrideEntity.id + '/field/' + encodeURIComponent(fieldKey) + localeQuery, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({})
        });
        if (res.ok) { location.reload(); }
        else { await dppAlert('Error clearing value'); }
      } catch (err) { await dppAlert('Error: ' + err.message); }
    }

    // Batch Contents tree expand/collapse - same pattern as the
    // Products tab (hub-v2.ejs), extended one level for SGTIN
    // (data-greatgrandparent) since this tree goes Style -> Variant ->
    // GTIN -> SGTIN, one level deeper than Products' Style -> Variant
    // -> GTIN.
    const treeGroupState = {};
    function initTreeGroup(key, isExpanded) { treeGroupState[key] = isExpanded; }
    function toggleTreeGroup(key) {
      treeGroupState[key] = !treeGroupState[key];
      renderTreeVisibility();
    }
    function renderTreeVisibility() {
      document.querySelectorAll('[data-parent]').forEach(row => {
        let visible = !!treeGroupState[row.getAttribute('data-parent')];
        const grandparent = row.getAttribute('data-grandparent');
        if (visible && grandparent) visible = !!treeGroupState[grandparent];
        const greatgrandparent = row.getAttribute('data-greatgrandparent');
        if (visible && greatgrandparent) visible = !!treeGroupState[greatgrandparent];
        row.classList.toggle('hidden', !visible);
      });
      document.querySelectorAll('[data-chevron]').forEach(chevron => {
        chevron.style.transform = treeGroupState[chevron.getAttribute('data-chevron')] ? 'rotate(90deg)' : '';
      });
    }

    document.getElementById('batchTreeSearch')?.addEventListener('change', function() {
      window.location = '/admin-v2/batch/<%= batch.id %>?search=' + encodeURIComponent(this.value);
    });

    // A search reloads the page with every matching Style's tree
    // already expanded (same pattern as the Products tab), so results
    // are visible immediately instead of needing every row clicked
    // open by hand.
    (function() {
      const expanded = <%- JSON.stringify(!!treeSearch) %>;
      const keys = [];
      <% batchTree.forEach(s => {
        const styleKey = 'style-' + s.id;
      %>
        <% if (s.gtins.length > 0 || s.variants.length > 0) { %>
          keys.push(<%- JSON.stringify(styleKey) %>);
        <% } %>
        <% s.gtins.forEach(g => { %>
          <% if (g.sgtins.length > 0) { %>
            keys.push(<%- JSON.stringify('gtin-' + g.gtin_id) %>);
          <% } %>
        <% }); %>
        <% s.variants.forEach(v => { %>
          <% if (v.gtins.length > 0) { %>
            keys.push(<%- JSON.stringify('variant-' + v.id) %>);
          <% } %>
          <% v.gtins.forEach(g => { %>
            <% if (g.sgtins.length > 0) { %>
              keys.push(<%- JSON.stringify('gtin-' + g.gtin_id) %>);
            <% } %>
          <% }); %>
        <% }); %>
      <% }); %>
      keys.forEach(k => initTreeGroup(k, expanded));
      renderTreeVisibility();
    })();
  </script>
</body>
</html>
