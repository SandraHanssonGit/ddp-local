<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= batch.batch_id %> - Batch Detail</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
  <div class="min-h-screen">
    <!-- Header -->
    <div class="bg-white shadow-md p-6 flex justify-between items-center">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Batch <%= batch.batch_id %></h1>
        <p class="text-gray-600 mt-2">Production Order: <%= batch.production_order || '—' %></p>
      </div>
      <a href="/admin-v2?tab=batches" class="text-blue-600 hover:underline font-semibold">← Back to Batches</a>
    </div>

    <div class="max-w-7xl mx-auto p-6">

      <!-- Statistics Cards -->
      <div class="grid grid-cols-4 gap-4 mb-8">
        <div class="bg-white rounded-lg shadow p-6">
          <div class="text-gray-600 text-sm font-semibold">Styles</div>
          <div class="text-3xl font-bold text-purple-600 mt-2"><%= style_count %></div>
        </div>
        <div class="bg-white rounded-lg shadow p-6">
          <div class="text-gray-600 text-sm font-semibold">GTINs Planned</div>
          <div class="text-3xl font-bold text-blue-600 mt-2"><%= gtin_count %></div>
        </div>
        <div class="bg-white rounded-lg shadow p-6">
          <div class="text-gray-600 text-sm font-semibold">Total Planned</div>
          <div class="text-3xl font-bold text-orange-600 mt-2"><%= typeof planned_total !== 'undefined' ? planned_total : 0 %></div>
        </div>
        <div class="bg-white rounded-lg shadow p-6">
          <div class="text-gray-600 text-sm font-semibold">SGTINs Created</div>
          <div class="text-3xl font-bold text-green-600 mt-2"><%= sgtin_count %></div>
        </div>
      </div>

      <!-- Add GTINs Card -->
      <div class="bg-white rounded-lg shadow-md p-8 mb-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Add GTINs to Batch</h2>

        <form id="addGtinForm" class="space-y-4">
          <div class="grid grid-cols-3 gap-4">
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-2">Select Style</label>
              <select id="styleSelect" class="w-full border border-gray-300 rounded px-4 py-2" required>
                <option value="">Choose a Style...</option>
              </select>
            </div>
            <div id="variantDiv" class="hidden">
              <label class="block text-sm font-bold text-gray-700 mb-2">Select Variant</label>
              <select id="variantSelect" class="w-full border border-gray-300 rounded px-4 py-2">
                <option value="">All Variants</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-2">Select GTIN</label>
              <select id="gtinSelect" class="w-full border border-gray-300 rounded px-4 py-2" required disabled>
                <option value="">Choose Style first...</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-sm font-bold text-gray-700 mb-2">Planned Quantity</label>
            <input type="number" id="quantityInput" class="w-full border border-gray-300 rounded px-4 py-2" min="1" value="100" required>
          </div>

          <button type="submit" class="bg-gray-900 text-white px-6 py-2 rounded hover:bg-gray-800 font-semibold">
            Add GTIN to Batch
          </button>
        </form>
      </div>

      <!-- Batch Planning Card -->
      <div class="bg-white rounded-lg shadow-md p-8 mb-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Batch Planning & Production Progress</h2>

        <% if (typeof batchGtins !== 'undefined' && batchGtins && batchGtins.length > 0) { %>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse text-sm">
              <thead>
                <tr class="bg-gray-100 border-b border-gray-300">
                  <th class="px-4 py-3 text-left font-semibold">Style</th>
                  <th class="px-4 py-3 text-left font-semibold">Variant</th>
                  <th class="px-4 py-3 text-left font-semibold">Item #</th>
                  <th class="px-4 py-3 text-left font-semibold">GTIN</th>
                  <th class="px-4 py-3 text-center font-semibold">Planned Qty</th>
                  <th class="px-4 py-3 text-center font-semibold">Created</th>
                  <th class="px-4 py-3 text-center font-semibold">Progress</th>
                  <th class="px-4 py-3 text-left font-semibold">Action</th>
                </tr>
              </thead>
              <tbody>
                <% batchGtins.forEach(bg => {
                  const created = bg.created_quantity || 0;
                  const planned = bg.planned_quantity || 0;
                  const pct = planned > 0 ? Math.round((created/planned)*100) : 0;
                %>
                  <tr class="border-b border-gray-200 hover:bg-gray-50">
                    <td class="px-4 py-3 font-mono text-xs"><strong><%= bg.style_number %></strong></td>
                    <td class="px-4 py-3"><%= bg.variant_name || '—' %></td>
                    <td class="px-4 py-3 text-sm"><%= bg.item_number %></td>
                    <td class="px-4 py-3 font-mono text-xs"><strong><%= bg.gtin %></strong></td>
                    <td class="px-4 py-3 text-center font-semibold"><%= planned %></td>
                    <td class="px-4 py-3 text-center"><span class="bg-green-100 text-green-900 px-2 py-1 rounded text-xs font-semibold"><%= created %></span></td>
                    <td class="px-4 py-3">
                      <div class="flex items-center gap-2">
                        <div class="flex-1 bg-gray-200 rounded-full h-2">
                          <div class="bg-blue-600 h-2 rounded-full" style="width: <%= Math.min(pct, 100) %>%"></div>
                        </div>
                        <span class="text-xs text-gray-600 font-semibold w-8"><%= pct %>%</span>
                      </div>
                    </td>
                    <td class="px-4 py-3">
                      <button onclick="removeBatchGtin(<%= bg.batch_gtin_id %>)" class="text-red-600 hover:text-red-800 text-sm font-semibold">Remove</button>
                    </td>
                  </tr>
                <% }); %>
                <tr class="bg-gray-50 border-t-2 border-gray-300 font-bold">
                  <td colspan="4" class="px-4 py-3 text-right">TOTALS:</td>
                  <td class="px-4 py-3 text-center border-l"><%= planned_total %></td>
                  <td class="px-4 py-3 text-center"><span class="bg-green-100 text-green-900 px-2 py-1 rounded text-xs"><%= sgtin_count %></span></td>
                  <td class="px-4 py-3 text-center">
                    <% const totalPct = planned_total > 0 ? Math.round((sgtin_count/planned_total)*100) : 0; %>
                    <span class="text-sm"><%= totalPct %>%</span>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p class="text-gray-500 italic">No GTINs planned for this batch yet</p>
        <% } %>
      </div>

      <!-- SGTINs Detail Card -->
      <div class="bg-white rounded-lg shadow-md p-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Created Garments (SGTINs)</h2>

        <% if (sgtins && sgtins.length > 0) { %>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse text-sm">
              <thead>
                <tr class="bg-gray-100 border-b border-gray-300">
                  <th class="px-4 py-3 text-left font-semibold">Serial #</th>
                  <th class="px-4 py-3 text-left font-semibold">GTIN</th>
                  <th class="px-4 py-3 text-left font-semibold">Style</th>
                  <th class="px-4 py-3 text-left font-semibold">Variant</th>
                  <th class="px-4 py-3 text-left font-semibold">Size</th>
                  <th class="px-4 py-3 text-left font-semibold">QC Status</th>
                  <th class="px-4 py-3 text-left font-semibold">Action</th>
                </tr>
              </thead>
              <tbody>
                <% sgtins.forEach(sg => { %>
                  <tr class="border-b border-gray-200 hover:bg-gray-50">
                    <td class="px-4 py-3 font-mono text-sm"><strong><%= sg.serial_number %></strong></td>
                    <td class="px-4 py-3 font-mono text-xs"><%= sg.gtin %></td>
                    <td class="px-4 py-3 font-mono"><%= sg.style_number %></td>
                    <td class="px-4 py-3"><%= sg.variant_name || '—' %></td>
                    <td class="px-4 py-3 text-xs">
                      <% const size = [sg.size_value_1, sg.size_value_2, sg.size_value_3].filter(s => s).join('-') %>
                      <%= size %>
                    </td>
                    <td class="px-4 py-3">
                      <% if (sg.qc_status === 'passed') { %>
                        <span class="bg-green-100 text-green-900 px-2 py-1 rounded text-xs">✓ Passed</span>
                      <% } else if (sg.qc_status === 'failed') { %>
                        <span class="bg-red-100 text-red-900 px-2 py-1 rounded text-xs">✗ Failed</span>
                      <% } else { %>
                        <span class="bg-gray-100 text-gray-900 px-2 py-1 rounded text-xs">—</span>
                      <% } %>
                    </td>
                    <td class="px-4 py-3"><a href="/admin-v2/sgtin/<%= sg.id %>" class="text-blue-600 hover:underline">→</a></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="text-center py-12 text-gray-500">No SGTINs created yet for this batch</div>
        <% } %>
      </div>

    </div>
  </div>

  <script>
    // Inject data from server
    const allStyles = <%- JSON.stringify(styles || []) %>;
    const allGtinsData = <%- JSON.stringify(gtins || []) %>;

    // Initialize style dropdown
    const styleSelect = document.getElementById('styleSelect');
    styleSelect.innerHTML = '<option value="">Choose a Style...</option>' +
      allStyles.map(s => `<option value="${s.id}">${s.style_number} - ${s.product_name} (${s.product_type})</option>`).join('');

    function updateFormByStyle() {
      const styleId = parseInt(styleSelect.value);
      const variantDiv = document.getElementById('variantDiv');
      const variantSelect = document.getElementById('variantSelect');
      const gtinSelect = document.getElementById('gtinSelect');

      if (!styleId) {
        variantDiv.classList.add('hidden');
        gtinSelect.disabled = true;
        gtinSelect.innerHTML = '<option value="">Choose Style first...</option>';
        return;
      }

      // Get GTINs for selected style
      const styleGtins = allGtinsData.filter(g => g.style_id === styleId);

      // Get unique variants for this style
      const variantsSet = new Set();
      const variantMap = {};
      styleGtins.forEach(g => {
        if (g.variant_id && g.variant_name) {
          variantsSet.add(g.variant_id);
          variantMap[g.variant_id] = g.variant_name;
        }
      });

      // Show/hide variant dropdown
      if (variantsSet.size > 0) {
        variantDiv.classList.remove('hidden');
        variantSelect.innerHTML = '<option value="">All Variants</option>' +
          Array.from(variantsSet).map(vid =>
            `<option value="${vid}">${variantMap[vid]}</option>`
          ).join('');
      } else {
        variantDiv.classList.add('hidden');
        variantSelect.value = '';
      }

      updateGtinsDropdown(styleGtins);
    }

    function updateGtinsDropdown(styleGtins) {
      const variantId = document.getElementById('variantSelect').value;
      const gtinSelect = document.getElementById('gtinSelect');

      let filtered = styleGtins;
      if (variantId) {
        filtered = styleGtins.filter(g => g.variant_id === parseInt(variantId));
      }

      gtinSelect.disabled = filtered.length === 0;
      gtinSelect.innerHTML = '<option value="">Choose GTIN...</option>' +
        filtered.map(g => `<option value="${g.id}">${g.gtin} (${g.item_number})</option>`).join('');
    }

    styleSelect.addEventListener('change', updateFormByStyle);
    document.getElementById('variantSelect').addEventListener('change', function() {
      const styleId = parseInt(styleSelect.value);
      const styleGtins = allGtinsData.filter(g => g.style_id === styleId);
      updateGtinsDropdown(styleGtins);
    });

    document.getElementById('addGtinForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      const batchId = <%= batch.id %>;
      const gtinId = document.getElementById('gtinSelect').value;
      const quantity = document.getElementById('quantityInput').value;

      try {
        const res = await fetch('/admin-v2/batch-gtins', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            batch_id: batchId,
            gtin_id: gtinId,
            planned_quantity: parseInt(quantity)
          })
        });

        const data = await res.json();

        if (res.ok) {
          alert('GTIN added successfully');
          location.reload();
        } else {
          alert('Error: ' + (data.error || 'Failed to add GTIN'));
        }
      } catch (err) {
        alert('Error: ' + err.message);
      }
    });

    async function removeBatchGtin(batchGtinId) {
      if (!confirm('Remove this GTIN from batch?')) return;

      try {
        const res = await fetch(`/admin-v2/batch-gtins/${batchGtinId}`, {
          method: 'DELETE'
        });

        if (res.ok) {
          alert('GTIN removed');
          location.reload();
        } else {
          const data = await res.json();
          alert('Error: ' + (data.error || 'Failed to remove GTIN'));
        }
      } catch (err) {
        alert('Error: ' + err.message);
      }
    }
  </script>
</body>
</html>
