<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DPP Hub v2 - Login</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      background-image: linear-gradient(rgba(23,22,19,0.35), rgba(23,22,19,0.55)), url('/nudie-background.jpg');
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
    }

    .login-card {
      width: 100%;
      max-width: 400px;
      background: var(--surface);
      border-radius: 8px;
      box-shadow: 0 20px 50px rgba(0,0,0,0.25);
      padding: 36px;
    }

    .login-card .logo-crop { height: 22px; width: 160px; margin-bottom: 20px; }
    .login-card .logo-crop img { top: -77px; left: -9px; width: 178px; height: 178px; }

    .login-card h1 { font-size: 22px; margin-bottom: 6px; }
    .login-card .subtitle { color: var(--muted); font-size: 13px; }
    .login-card .subtitle.small2 { font-size: 11px; margin-top: 2px; }

    .login-error {
      padding: 10px 14px;
      background: var(--danger-soft);
      border: 1px solid var(--danger);
      color: var(--danger);
      border-radius: 6px;
      font-size: 13px;
      margin-bottom: 16px;
    }

    .demo-box {
      margin-top: 20px;
      padding: 14px 16px;
      background: var(--surface-2);
      border: 1px solid var(--hairline);
      border-radius: 6px;
      font-size: 12px;
    }

    .demo-box .demo-row { display: flex; justify-content: space-between; color: var(--muted); }
    .demo-box .demo-row strong { color: var(--text); }

    .login-footer {
      text-align: center;
      color: var(--muted);
      font-size: 12px;
      margin-top: 20px;
    }
  </style>
</head>
<body>
  <div class="login-card">
    <div class="logo-crop" title="Nudie Jeans co">
      <img src="/nudie-logo.png" alt="Nudie Jeans co">
    </div>
    <h1>DPP Hub</h1>
    <p class="subtitle">Digital Product Passport Administration</p>

    <form id="loginForm" style="margin-top:24px;">
      <div class="field-row">
        <label>Username or Email</label>
        <input type="text" id="username" name="username" placeholder="demo" required autofocus>
      </div>

      <div class="field-row">
        <label>Password</label>
        <input type="password" id="password" name="password" placeholder="••••••••" required>
      </div>

      <div id="error" class="login-error hidden"></div>

      <button type="submit" class="btn btn-primary" style="width:100%; justify-content:center; padding:12px;">Login</button>
    </form>

    <div class="demo-box">
      <p class="label-sm" style="margin-bottom:8px;">Demo Credentials</p>
      <div class="demo-row"><strong>demo</strong><span>password</span></div>
    </div>

    <p class="login-footer">Nudie Jeans</p>
  </div>

  <script>
    document.getElementById('loginForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      const username = document.getElementById('username').value;
      const password = document.getElementById('password').value;
      const errorDiv = document.getElementById('error');

      try {
        const res = await fetch('/api/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password })
        });

        const data = await res.json();

        if (res.ok && data.token) {
          // Save token
          localStorage.setItem('token', data.token);
          localStorage.setItem('user', JSON.stringify(data.user || { username }));

          // Redirect to v2 admin hub
          window.location.href = '/admin-v2';
        } else {
          errorDiv.textContent = data.error || 'Login failed. Please try again.';
          errorDiv.classList.remove('hidden');
        }
      } catch (err) {
        errorDiv.textContent = 'Connection error. Please try again.';
        errorDiv.classList.remove('hidden');
      }
    });
  </script>
</body>
</html>
