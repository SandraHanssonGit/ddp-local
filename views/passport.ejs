<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Product Passport - <%= serial.serial_number %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white">
  <!-- Header -->
  <div class="border-b border-gray-200">
    <div class="max-w-5xl mx-auto py-6 px-4">
      <h1 class="text-sm font-bold text-gray-900 uppercase tracking-wide">Product Passport</h1>
      <p class="text-xs text-gray-600 mt-1" id="styleTitle"><%= serial.style_number %></p>
    </div>
  </div>

  <div class="max-w-5xl mx-auto py-12 px-4">
    <!-- Two Column Layout: Image + Info -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 mb-16">

      <!-- Left: Product Image & Gallery -->
      <div class="sticky top-8">
        <div id="productImage" class="flex items-center justify-center bg-gray-50 rounded-lg p-8 min-h-96 mb-6 cursor-pointer" onclick="openLightbox(0)">
          <div class="text-center">
            <div class="text-6xl mb-4">👖</div>
            <p class="text-gray-600">Loading image...</p>
          </div>
        </div>
        <div id="galleryThumbnails" class="grid grid-cols-3 gap-2 hidden"></div>
      </div>

      <!-- Lightbox Modal -->
      <div id="lightboxModal" class="hidden fixed inset-0 bg-black bg-opacity-90 z-50 flex items-center justify-center">
        <button onclick="closeLightbox()" class="absolute top-4 right-4 text-white text-3xl hover:bg-white hover:bg-opacity-20 rounded-lg w-10 h-10">✕</button>
        <button onclick="prevImage()" class="absolute left-4 text-white text-3xl hover:bg-white hover:bg-opacity-20 rounded-lg w-10 h-10">‹</button>
        <img id="lightboxImage" src="" alt="Product" class="max-w-4xl max-h-screen object-contain">
        <button onclick="nextImage()" class="absolute right-4 text-white text-3xl hover:bg-white hover:bg-opacity-20 rounded-lg w-10 h-10">›</button>
        <p id="imageCounter" class="absolute bottom-4 left-1/2 transform -translate-x-1/2 text-white text-sm bg-black bg-opacity-50 px-4 py-2 rounded-lg"></p>
      </div>

      <!-- Right: Product Info -->
      <div class="space-y-8">

        <!-- Serial Info -->
        <div>
          <h2 class="text-xs font-bold text-gray-500 uppercase tracking-wide mb-4">Serial Information</h2>
          <div class="space-y-4">
            <div class="border-b border-gray-200 pb-3">
              <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Serial Number</p>
              <p class="text-lg font-mono font-bold text-gray-900"><%= serial.serial_number %></p>
            </div>
            <div class="border-b border-gray-200 pb-3">
              <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Style</p>
              <p class="text-gray-900"><%= serial.style_number %></p>
            </div>
            <div>
              <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Created</p>
              <p class="text-gray-700"><%= new Date(serial.created_at).toLocaleDateString('sv-SE') %></p>
            </div>
          </div>
        </div>

        <!-- Product Name & Description -->
        <div id="productInfo">
          <h2 class="text-xs font-bold text-gray-500 uppercase tracking-wide mb-4">Product</h2>
          <div class="space-y-3">
            <div>
              <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Name</p>
              <div id="productName" class="text-lg font-bold text-gray-900"></div>
            </div>
            <div id="gtin14Section" class="hidden">
              <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">GTIN-14</p>
              <p id="productGTIN14" class="text-gray-900 font-mono"></p>
            </div>
            <div>
              <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Description</p>
              <div id="productDesc" class="text-gray-600 text-sm leading-relaxed"></div>
            </div>
          </div>
        </div>

        <!-- Batch Data -->
        <% if (batchData.length > 0) { %>
          <div>
            <h2 class="text-xs font-bold text-gray-500 uppercase tracking-wide mb-4">Batch Information</h2>
            <div class="space-y-3">
              <% batchData.forEach(item => { %>
                <div class="border-b border-gray-200 pb-3 last:border-0">
                  <p class="text-xs text-gray-500 uppercase tracking-wide mb-1"><%= item.key %></p>
                  <p class="text-gray-900"><%= item.value %></p>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>

        <!-- Unit Data -->
        <% if (serialData.length > 0) { %>
          <div>
            <h2 class="text-xs font-bold text-gray-500 uppercase tracking-wide mb-4">Unit Information</h2>
            <div class="space-y-3">
              <% serialData.forEach(item => { %>
                <div class="border-b border-gray-200 pb-3 last:border-0">
                  <p class="text-xs text-gray-500 uppercase tracking-wide mb-1"><%= item.key %></p>
                  <p class="text-gray-900"><%= item.value %></p>
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Full Width Sections -->

    <!-- ✨ Material Composition (Minimalist, Production-style) -->
    <div id="compositionSection" class="border-t border-gray-200 pt-12 mb-16 hidden">
      <h2 class="text-lg font-bold text-gray-900 uppercase tracking-wide mb-6">Material Composition</h2>

      <div class="space-y-6">
        <p id="compositionContent" class="text-gray-700 leading-relaxed"></p>

        <!-- Pass Versioning Info (subtle) -->
        <div id="passVersionInfo" class="hidden text-xs text-gray-500 space-y-1">
          <p>Pass version: <span id="passVersion" class="font-mono font-semibold text-gray-900">-</span></p>
          <p id="passVersionTime" class="hidden">Issued: <span id="passIssuedAt"></span></p>
          <p id="changeNoteRow" class="hidden">Correction: <span id="changeNoteContent" class="text-gray-700"></span></p>
        </div>
      </div>
    </div>

    <!-- Care Instructions -->
    <div id="careSection" class="border-t border-gray-200 pt-12 mb-16 hidden">
      <h2 class="text-lg font-bold text-gray-900 uppercase tracking-wide mb-6">Care Instructions</h2>
      <div id="careContent"></div>
    </div>

    <!-- Transparency -->
    <div id="transparencySection" class="border-t border-gray-200 pt-12 mb-16 hidden">
      <h2 class="text-lg font-bold text-gray-900 uppercase tracking-wide mb-6">Transparency</h2>
      <div id="transparencyContent" class="space-y-8"></div>
    </div>

    <!-- Nudie Values -->
    <div id="nudieSection" class="border-t border-gray-200 pt-12 mb-16 hidden">
      <h2 class="text-lg font-bold text-gray-900 uppercase tracking-wide mb-6">Nudie Values</h2>
      <div id="nudieContent" class="space-y-6"></div>
    </div>

    <!-- Storytelling -->
    <div id="storySection" class="border-t border-gray-200 pt-12 mb-16 hidden">
      <h2 class="text-lg font-bold text-gray-900 uppercase tracking-wide mb-6">Our Story</h2>
      <div id="storyContent"></div>
    </div>

    <!-- Events Timeline -->
    <% if (events.length > 0) { %>
      <div class="border-t border-gray-200 pt-12 mb-16">
        <h2 class="text-lg font-bold text-gray-900 uppercase tracking-wide mb-6">Lifecycle Events</h2>
        <div class="space-y-6">
          <% events.forEach(event => { %>
            <div class="border-b border-gray-200 pb-6 last:border-0">
              <p class="text-xs text-gray-500 uppercase tracking-wide mb-1"><%= event.event_type %></p>
              <p class="text-sm text-gray-600"><%= new Date(event.created_at).toLocaleDateString('sv-SE') %></p>
              <% if (Object.keys(event.event_data).length > 0) { %>
                <div class="mt-2 text-sm space-y-1">
                  <% Object.entries(event.event_data).forEach(([key, value]) => { %>
                    <p class="text-gray-700"><strong><%= key %>:</strong> <%= JSON.stringify(value) %></p>
                  <% }) %>
                </div>
              <% } %>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

    <!-- Footer -->
    <div class="border-t border-gray-200 pt-12">
      <p class="text-xs text-gray-500 text-center">
        Digital Product Passport managed by Nudie Jeans
      </p>
    </div>
  </div>

  <script>
    const styleNumber = '<%= serial.style_number %>';
    const batchId = '<%= batch_id %>';
    let allImages = [];
    let currentImageIndex = 0;

    // Lightbox functions
    function openLightbox(index) {
      if (allImages.length === 0) return;
      currentImageIndex = index;
      showLightboxImage();
      document.getElementById('lightboxModal').classList.remove('hidden');
    }

    function closeLightbox() {
      document.getElementById('lightboxModal').classList.add('hidden');
    }

    function nextImage() {
      currentImageIndex = (currentImageIndex + 1) % allImages.length;
      showLightboxImage();
    }

    function prevImage() {
      currentImageIndex = (currentImageIndex - 1 + allImages.length) % allImages.length;
      showLightboxImage();
    }

    function showLightboxImage() {
      const img = allImages[currentImageIndex];
      document.getElementById('lightboxImage').src = `data:image/jpeg;base64,${img.image_data}`;
      document.getElementById('imageCounter').textContent = `${currentImageIndex + 1} / ${allImages.length}`;
    }

    // Fetch and display style data
    async function loadStyleData() {
      try {
        const res = await fetch(`/api/styles/${styleNumber}/full-data`);
        const data = await res.json();

        // Product info
        if (data.style) {
          document.getElementById('productName').textContent = data.style.product_name || '';
          document.getElementById('productDesc').textContent = data.style.description || '';

          if (data.style.gtin_14) {
            document.getElementById('gtin14Section').classList.remove('hidden');
            document.getElementById('productGTIN14').textContent = data.style.gtin_14;
          }
        }

        // Load image - prefer batch image first, then style
        allImages = [];

        // Try batch images first
        if (batchId) {
          try {
            const batchImageRes = await fetch(`/api/batches/${batchId}/images`);
            const batchImages = await batchImageRes.json();
            if (batchImages.length > 0) {
              allImages.push(batchImages[0]); // Only first batch image
            }
          } catch (err) {
            // Continue
          }
        }

        // If no batch image, try style image
        if (allImages.length === 0) {
          try {
            const styleImageRes = await fetch(`/api/styles/${styleNumber}/images`);
            const styleImages = await styleImageRes.json();
            if (styleImages.length > 0) {
              allImages.push(styleImages[0]); // Only first style image
            }
          } catch (err) {
            // Continue
          }
        }

        // Render main image (single image only)
        if (allImages.length > 0) {
          currentImageIndex = 0;
          document.getElementById('productImage').innerHTML = `
            <img src="data:image/jpeg;base64,${allImages[0].image_data}" alt="${allImages[0].image_name}" class="w-full h-auto object-cover rounded-lg">
          `;
          // No gallery thumbnails - single image only
        }

        // ✨ Material Composition with Pass Versioning
        const composition = '<%= pass?.material_composition || '' %>';
        const passVersion = '<%= pass?.version || 0 %>';
        const passIssuedAt = '<%= pass?.issued_at || '' %>';
        const changeType = '<%= pass?.change_type || '' %>';
        const changeNote = '<%= pass?.change_note || '' %>';

        if (composition) {
          document.getElementById('compositionSection').classList.remove('hidden');
          document.getElementById('compositionContent').textContent = composition;
          document.getElementById('passVersion').textContent = passVersion || '1';
          document.getElementById('passVersionInfo').classList.remove('hidden');

          if (passIssuedAt) {
            document.getElementById('passVersionTime').classList.remove('hidden');
            document.getElementById('passIssuedAt').textContent = new Date(passIssuedAt).toLocaleDateString('sv-SE');
          }

          if (changeNote) {
            document.getElementById('changeNoteRow').classList.remove('hidden');
            document.getElementById('changeNoteContent').textContent = changeNote;
          }
        }

        // Care instructions
        if (data.style && data.style.care_instructions) {
          document.getElementById('careSection').classList.remove('hidden');
          document.getElementById('careContent').innerHTML = `
            <p class="text-gray-700 whitespace-pre-wrap">${data.style.care_instructions}</p>
          `;
        }

        // Transparency
        if (data.transparency_data) {
          document.getElementById('transparencySection').classList.remove('hidden');
          const trans = data.transparency_data;
          let transHTML = '';

          if (trans.environmental_data && trans.environmental_data.PEF) {
            transHTML += `
              <div>
                <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wide mb-2">Environmental Impact</h3>
                <div class="space-y-3">
                  <div class="border-b border-gray-200 pb-3">
                    <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">CO2 Emission</p>
                    <p class="text-gray-700">${trans.environmental_data.PEF}</p>
                  </div>
                  ${trans.environmental_data.water_usage ? `
                    <div>
                      <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Water Usage</p>
                      <p class="text-gray-700">${trans.environmental_data.water_usage}</p>
                    </div>
                  ` : ''}
                </div>
              </div>
            `;
          }

          if (trans.certifications && Object.keys(trans.certifications).length > 0) {
            transHTML += `
              <div>
                <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wide mb-3">Certifications</h3>
                <div class="space-y-2">
                  ${Object.entries(trans.certifications).map(([cert, val]) =>
                    `<p class="text-gray-700">✓ ${cert}</p>`
                  ).join('')}
                </div>
              </div>
            `;
          }

          document.getElementById('transparencyContent').innerHTML = transHTML;
        }

        // Nudie Values (Repair info)
        if (data.nudie_values && data.nudie_values.repair_info) {
          document.getElementById('nudieSection').classList.remove('hidden');
          document.getElementById('nudieContent').innerHTML = `
            <div>
              <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wide mb-3">Repair</h3>
              <p class="text-gray-700 text-sm">${data.nudie_values.repair_info}</p>
            </div>
          `;
        }

        // Storytelling
        if (data.storytelling && data.storytelling.content) {
          document.getElementById('storySection').classList.remove('hidden');
          document.getElementById('storyContent').innerHTML = `
            <p class="text-gray-700 leading-relaxed">${data.storytelling.content}</p>
          `;
        }

      } catch (err) {
        console.error('Error loading style data:', err);
      }
    }

    loadStyleData();

    // Track page view (public passport)
    // Send analytics without requiring authentication
    fetch('/api/track-public-view', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        page_type: 'public_passport',
        page_id: serialNumber
      })
    }).catch(() => {}); // Silent fail - don't break the page if tracking fails
  </script>
</body>
</html>
