<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>QR Code Labels - <%= batch.batch_number %></title>
  <script src="https://cdn.jsdelivr.net/gh/davidshimjs/qrcodejs/qrcode.min.js"></script>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: white;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }

    .label-sheet {
      width: 210mm;
      height: 297mm;
      margin: 0 auto;
      padding: 5mm;
      display: grid;
      grid-template-columns: repeat(4, 30mm);
      grid-auto-rows: 50mm;
      gap: 0;
      page-break-after: always;
    }

    .label {
      width: 30mm;
      height: 50mm;
      border: 0.5mm solid #ddd;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      padding: 1.5mm;
      font-size: 6px;
      text-align: center;
      background: white;
      position: relative;
      overflow: hidden;
    }

    .label-header {
      font-weight: bold;
      font-size: 5px;
      color: #000;
      line-height: 1.1;
      width: 100%;
    }

    .label-qr {
      width: 20mm;
      height: 20mm;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .label-qr canvas,
    .label-qr img {
      max-width: 100%;
      max-height: 100%;
    }

    .label-footer {
      font-weight: 600;
      font-size: 4px;
      color: #333;
      line-height: 1.1;
      width: 100%;
      word-break: break-word;
    }

    @media print {
      body {
        margin: 0;
        padding: 0;
      }
      .label-sheet {
        margin: 0;
        padding: 0;
        page-break-after: always;
        page-break-inside: avoid;
      }
    }

    .no-print {
      margin-bottom: 20mm;
      padding: 20px;
      background: #f5f5f5;
    }

    .no-print button {
      padding: 10px 20px;
      background: #000;
      color: white;
      border: none;
      font-weight: bold;
      cursor: pointer;
      font-size: 14px;
    }

    .no-print button:hover {
      background: #333;
    }
  </style>
</head>
<body>
  <div class="no-print">
    <h2 style="margin-bottom: 10px;">QR Code Labels</h2>
    <p style="margin-bottom: 15px;">Style <%= batch.style_number %> • Batch <%= batch.batch_number %></p>
    <p style="margin-bottom: 15px;">Labels: <%= quantity %> • Size: 3cm wide × 5cm tall • Layout: 4 per row × 5 per page</p>
    <button onclick="window.print()">🖨️ Print Labels</button>
  </div>

  <%
    let labelCount = 0;
    const labelsPerPage = 20; // 4 columns × 5 rows
    const totalPages = Math.ceil(quantity / labelsPerPage);
  %>

  <% for (let page = 0; page < totalPages; page++) { %>
    <div class="label-sheet">
      <%
        const labelsOnThisPage = Math.min(labelsPerPage, quantity - (page * labelsPerPage));
        for (let i = 0; i < labelsOnThisPage; i++) {
          const labelNum = page * labelsPerPage + i + 1;
      %>
        <div class="label">
          <div class="label-header">NUDIE JEANS</div>
          <div class="label-qr" id="qr-<%= labelNum %>"></div>
          <div class="label-footer">
            <div><%= batch.style_number %></div>
            <div><%= batch.batch_number %></div>
          </div>
        </div>
      <% } %>

      <!-- Empty spaces to fill the grid -->
      <% for (let i = labelsOnThisPage; i < labelsPerPage; i++) { %>
        <div class="label" style="border: none;"></div>
      <% } %>
    </div>
  <% } %>

  <script>
    const batchNumber = '<%= batch.batch_number %>';
    const passportUrl = '/p/' + batchNumber;

    // Generate QR codes for each label
    <% for (let i = 1; i <= quantity; i++) { %>
      new QRCode(document.getElementById('qr-<%= i %>'), {
        text: passportUrl,
        width: 120,
        height: 120,
        colorDark: '#000000',
        colorLight: '#ffffff',
        correctLevel: QRCode.CorrectLevel.H
      });
    <% } %>
  </script>
</body>
</html>
