<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= passport.style.product_name %><% if (!passport.isGtinOnly) { %> - <%= passport.sgtin.serial_number %><% } %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
            background-color: #faf8f3;
            color: #333;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }

        .label {
            color: #8b6f47;
            font-size: 0.875rem;
            font-weight: 500;
            text-transform: capitalize;
        }

        .value {
            color: #333;
            font-size: 1rem;
            margin-top: 0.25rem;
        }

        .section-title {
            color: #333;
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 1rem;
            margin-top: 2rem;
            padding-bottom: 0.5rem;
            border-bottom: 1px solid #ddd;
        }

        .data-row {
            display: grid;
            grid-template-columns: 150px 1fr;
            gap: 2rem;
            padding: 1rem 0;
            border-bottom: 1px solid #eee;
        }

        .data-row:last-child {
            border-bottom: none;
        }

        @media print {
            body { background: white; }
            .no-print { display: none; }
        }
    </style>
</head>
<body>
  <div class="max-w-3xl mx-auto px-8 py-12">

    <!-- Logo -->
    <div class="mb-8">
      <h2 class="text-lg font-bold text-gray-900">Nudie Jeans co</h2>
    </div>

    <!-- Product Header -->
    <div class="mb-12 pb-12 border-b border-gray-300">
      <!-- Product Image (if available) -->
      <% if (passport.style && passport.style.image_url) { %>
        <div class="mb-8">
          <img src="<%= passport.style.image_url %>" alt="<%= passport.style.product_name %>" class="w-40 h-56 object-cover rounded" onerror="console.log('Image failed to load from:', this.src)">
        </div>
      <% } else { %>
        <!-- Debug: Show why image is not displayed -->
        <script>
          console.log('Image not shown. passport.style:', <%= JSON.stringify(passport.style) %>);
        </script>
      <% } %>

      <!-- Product Info -->
      <div>
        <h1 class="text-3xl font-bold text-gray-900 mb-2"><%= passport.style.product_name %></h1>
        <p class="text-sm font-mono text-gray-600">
          W<%= passport.gtin.size || '-' %>/L<%= passport.gtin.size || '-' %>
          <%= passport.style.style_number %>-<%= passport.gtin.color ? passport.gtin.color.substring(0, 1) : '-' %><% if (!passport.isGtinOnly) { %>-<%= passport.sgtin.serial_number %><% } else { %>-XXXX<% } %>
        </p>
      </div>
    </div>

    <!-- Composition Section -->
    <div class="mb-12">
      <h2 class="section-title">Composition</h2>
      <div class="data-row">
        <div class="label">Composition</div>
        <div class="value">
          <%= passport.resolvedFields?.find(f => f.field_key === 'fiber_composition')?.value || '100% Cotton' %>
        </div>
      </div>
    </div>

    <!-- Production Section -->
    <div class="mb-12">
      <h2 class="section-title">Production</h2>
      <p class="text-sm text-gray-600 mb-4"><%= passport.resolvedFields?.length || 0 %> steps · <%= passport.resolvedFields?.length || 0 %> suppliers</p>

      <div class="data-row">
        <div class="label">Made in</div>
        <div class="value"><%= passport.batch.country_of_production || 'N/A' %></div>
      </div>

      <div class="data-row">
        <div class="label">Factory</div>
        <div class="value"><%= passport.batch.factory || 'N/A' %></div>
      </div>

      <div class="data-row">
        <div class="label">Production Date</div>
        <div class="value"><%= passport.batch.production_date ? new Date(passport.batch.production_date).toLocaleDateString('sv-SE') : 'N/A' %></div>
      </div>

      <div class="data-row">
        <div class="label">Production Order</div>
        <div class="value"><%= passport.batch.production_order || 'N/A' %></div>
      </div>
    </div>

    <!-- Climate and Water Section -->
    <div class="mb-12">
      <h2 class="section-title">Climate and water</h2>

      <div class="data-row">
        <div class="label">Carbon footprint</div>
        <div class="value">Calculated per garment</div>
      </div>

      <div class="data-row">
        <div class="label">Water use</div>
        <div class="value">Calculated per garment</div>
      </div>
    </div>

    <!-- Care Instructions Section -->
    <div class="mb-12">
      <h2 class="section-title">Care instructions</h2>

      <div class="value text-sm leading-relaxed">
        <%= passport.resolvedFields?.find(f => f.field_key === 'care_instructions')?.value || 'See label for care instructions' %>
      </div>
    </div>

    <!-- Additional Info Sections -->
    <% formattedCategories?.forEach(category => { %>
      <% if (category.fields && category.fields.length > 0 && category.category !== 'eu_required') { %>
        <div class="mb-12">
          <h2 class="section-title"><%= category.label %></h2>

          <% category.fields.forEach(field => { %>
            <div class="data-row">
              <div class="label"><%= field.label %></div>
              <div class="value text-sm"><%= field.value || 'N/A' %></div>
            </div>
          <% }); %>
        </div>
      <% } %>
    <% }); %>

    <!-- Identifiers Section -->
    <div class="mb-12">
      <h2 class="section-title">Identifiers</h2>

      <div class="data-row">
        <div class="label">Article number</div>
        <div class="value font-mono"><%= passport.style.style_number %></div>
      </div>

      <div class="data-row">
        <div class="label">GTIN</div>
        <div class="value font-mono"><%= passport.gtin.gtin || 'N/A' %></div>
      </div>

      <% if (!passport.isGtinOnly) { %>
        <div class="data-row">
          <div class="label">Serial</div>
          <div class="value font-mono"><%= passport.sgtin.serial_number %></div>
        </div>
      <% } else { %>
        <div class="data-row">
          <div class="label">Serial</div>
          <div class="value text-sm italic text-gray-500">Not assigned yet (circular information)</div>
        </div>
      <% } %>

      <div class="data-row">
        <div class="label">Batch</div>
        <div class="value font-mono"><%= passport.batch.batch_id %></div>
      </div>
    </div>

    <!-- Lifecycle Events Section -->
    <% if (events && events.length > 0) { %>
      <div class="mb-12">
        <h2 class="section-title">Product Lifecycle</h2>

        <div class="space-y-6">
          <% events.forEach((event, idx) => { %>
            <div class="flex gap-4">
              <!-- Event icon -->
              <div class="flex-shrink-0 w-12 h-12 rounded-full bg-gray-100 flex items-center justify-center text-xl">
                <% if (event.type === 'manufactured') { %>🏭
                <% } else if (event.type === 'quality_checked') { %>✓
                <% } else if (event.type === 'packaged') { %>📦
                <% } else if (event.type === 'shipped') { %>🚚
                <% } else if (event.type === 'delivered') { %>📬
                <% } else if (event.type === 'sold') { %>💳
                <% } else if (event.type === 'worn') { %>👕
                <% } else if (event.type === 'repaired') { %>🔧
                <% } else if (event.type === 'resold') { %>♻️
                <% } else if (event.type === 'returned') { %>↩️
                <% } else if (event.type === 'recycled') { %>🌱
                <% } else { %>📌
                <% } %>
              </div>

              <!-- Event details -->
              <div class="flex-grow">
                <p class="font-semibold text-gray-900">
                  <%
                    const labels = {
                      manufactured: 'Manufactured',
                      quality_checked: 'Quality Checked',
                      packaged: 'Packaged',
                      shipped: 'Shipped',
                      delivered: 'Delivered',
                      sold: 'Sold',
                      worn: 'Worn',
                      repaired: 'Repaired',
                      resold: 'Resold',
                      returned: 'Returned',
                      recycled: 'Recycled'
                    };
                  %>
                  <%= labels[event.type] || event.type %>
                </p>
                <p class="text-sm text-gray-600 mt-1">
                  <%= new Date(event.date).toLocaleString('sv-SE') %>
                </p>
                <% if (event.details && Object.keys(event.details).length > 0) { %>
                  <div class="text-sm text-gray-700 mt-2 bg-gray-50 p-3 rounded">
                    <% for (const [key, value] of Object.entries(event.details)) { %>
                      <p><strong><%= key.replace(/_/g, ' ') %>:</strong> <%= value %></p>
                    <% } %>
                  </div>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    <% } %>

    <!-- Footer -->
    <div class="mt-16 pt-8 border-t border-gray-300 text-center text-xs text-gray-600">
      <p class="mb-2">Digital Product Passport · Nudie Jeans</p>
      <p>Passport version 1, issued <%= new Date().toISOString().split('T')[0] %>.</p>

      <!-- Machine-readable formats -->
      <div class="mt-4 space-y-2">
        <% if (!passport.isGtinOnly) { %>
          <p class="text-gray-500 font-semibold">Machine-readable (SGTIN):</p>
          <p>
            <a href="/dpp/<%= passport.gtin.gtin %>/<%= passport.sgtin.serial_number %>/json" class="text-blue-600 hover:underline">Full Passport (JSON)</a>
            ·
            <a href="/dpp/<%= passport.gtin.gtin %>/<%= passport.sgtin.serial_number %>/eu" class="text-blue-600 hover:underline">EU-Required Fields (JSON)</a>
          </p>
        <% } else { %>
          <p class="text-gray-500 font-semibold">GTIN-level view</p>
          <p class="text-sm text-gray-600">SGTIN will be created on first consumer interaction with this product. The unique serial will then track this specific garment through its lifecycle.</p>
        <% } %>
      </div>

      <% if (!passport.isGtinOnly && passport.sgtin) { %>
        <p class="mt-4 font-mono text-gray-400">Serial: <%= passport.sgtin.serial_number %></p>
      <% } else if (passport.isGtinOnly) { %>
        <p class="mt-4 font-mono text-gray-400">GTIN: <%= passport.gtin.gtin %></p>
      <% } %>
    </div>

  </div>
</body>
</html>
