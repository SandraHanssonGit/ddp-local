  <script>
    // Check if user is logged in
    const user = JSON.parse(localStorage.getItem('user') || '{}');
    if (!user.id) {
      window.location.href = '/login';
    }

    // Load logo from server + Setup event listeners when DOM is ready
    window.addEventListener('DOMContentLoaded', () => {
      const logoContainer = document.getElementById('headerLogoContainer');
      const img = new Image();
      img.onload = () => {
        logoContainer.innerHTML = `<img src="/nudie-logo.png" style="max-height: 60px; max-width: 200px;" alt="Nudie Jeans">`;
      };
      img.onerror = () => {
        logoContainer.innerHTML = `<span style="font-family: cursive; font-size: 18px; font-weight: 300; letter-spacing: 1px;">Nudie Jeans</span>`;
      };
      img.src = '/nudie-logo.png';

      // Setup search form after DOM is ready
      const searchForm = document.getElementById('searchForm');
      if (searchForm) {
        searchForm.addEventListener('submit', handleSearch);
      }

      // Setup delegated click handler for onclick attributes
      // This handles inline onclick="functionName()" calls
      document.addEventListener('click', (e) => {
        const target = e.target.closest('[onclick]');
        if (!target) return;

        const onclick = target.getAttribute('onclick');
        if (!onclick) return;

        try {
          // Simple function call parser: handles "functionName()" and "functionName('arg')"
          const match = onclick.match(/(\w+)\((.*)\)/);
          if (match) {
            const funcName = match[1];
            const argsStr = match[2];

            if (typeof window[funcName] === 'function') {
              if (argsStr.trim()) {
                // Parse arguments (handles quoted strings)
                const args = argsStr.split(',').map(arg => {
                  arg = arg.trim();
                  if (arg.startsWith("'") && arg.endsWith("'")) {
                    return arg.slice(1, -1);
                  } else if (arg.startsWith('"') && arg.endsWith('"')) {
                    return arg.slice(1, -1);
                  }
                  return arg;
                });
                window[funcName](...args);
              } else {
                window[funcName]();
              }
            }
          }
        } catch (err) {
          console.error('onclick error:', err, onclick);
        }
      });

      // Load dashboard on initial page load
      loadDashboard();
    });

    function escapeHtml(value) {
      return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    // Search handler function
    async function handleSearch(e) {
      e.preventDefault();
      const q = document.getElementById('searchQuery').value.trim();
      const status = document.getElementById('searchStatus');

      if (!q) {
        status.textContent = 'Please enter a search term';
        document.getElementById('resultsListContainer').classList.add('hidden');
        document.getElementById('recentBatchesContainer').classList.remove('hidden');
        return;
      }

      status.textContent = 'Searching...';

      try {
        // Handle different search patterns
        const isNumeric = /^\d+$/.test(q);
        const isExactStyleNum = isNumeric && q.length >= 4;
        const isStyleVariant = /^\d+-[A-Z0-9-]+$/.test(q);
        const isPartialStyleNum = isNumeric && q.length >= 4;

        let res, result;

        if (isStyleVariant) {
          // Search for exact style-variant (e.g., "114519-B20")
          const [styleNum, variant] = q.split('-');
          res = await authFetch(`/api/search?q=${encodeURIComponent(styleNum)}`);
          result = await res.json();
          // Filter to only variants matching the query
          if (result.results) {
            result.results = result.results.filter(r =>
              r.result_type === 'style' && (r.variant || '').toUpperCase() === variant.toUpperCase()
            );
          }
        } else if (isPartialStyleNum) {
          // Search for styles that start with the numeric query, including exact style numbers like 123456
          res = await authFetch(`/api/search?q=${encodeURIComponent(q)}`);
          result = await res.json();
          // Filter to only styles matching the numeric query
          if (result.results) {
            result.results = result.results.filter(r =>
              r.result_type === 'style' && (
                r.style_number === q ||
                String(r.style_number || '').startsWith(q)
              )
            );
          }
        } else {
          // Normal search for anything
          res = await authFetch(`/api/search?q=${encodeURIComponent(q)}`);
          result = await res.json();
        }

        if (!result.results || result.results.length === 0) {
          // Offer to create new style
          if (isStyleVariant) {
            const [styleNum, variant] = q.split('-');
            const safeStyleNum = JSON.stringify(styleNum);
            const safeVariant = JSON.stringify(variant);
            status.innerHTML = `No style found. <div class="inline-flex items-center gap-2 flex-wrap mt-2"><select id="createStyleTypeSelect" class="border border-gray-300 rounded px-3 py-2 text-sm"><option value="">Select type</option><option value="jeans">Jeans</option><option value="topp">Topp</option></select><button class="text-blue-600 hover:underline font-semibold" onclick='showCreateStyleForm(${safeStyleNum}, ${safeVariant}, document.getElementById("createStyleTypeSelect").value); document.getElementById("searchQuery").value=""'>Create new ${escapeHtml(q)}</button></div>`;
          } else if (isExactStyleNum || isPartialStyleNum) {
            const safeStyleNum = JSON.stringify(q);
            status.innerHTML = `No style found. <div class="inline-flex items-center gap-2 flex-wrap mt-2"><select id="createStyleTypeSelect" class="border border-gray-300 rounded px-3 py-2 text-sm"><option value="">Select type</option><option value="jeans">Jeans</option><option value="topp">Topp</option></select><button class="text-blue-600 hover:underline font-semibold" onclick='showCreateStyleForm(${safeStyleNum}, null, document.getElementById("createStyleTypeSelect").value); document.getElementById("searchQuery").value=""'>Create new style ${escapeHtml(q)}</button></div>`;
          } else {
            status.textContent = `No results found for "${q}"`;
          }
          document.getElementById('resultsListContainer').classList.add('hidden');
          document.getElementById('recentBatchesContainer').classList.remove('hidden');
          document.getElementById('resultContainer').classList.add('hidden');
          return;
        }

        // Hide recent batches when showing search results
        document.getElementById('recentBatchesContainer').classList.add('hidden');

        // Sort by relevance
        const sorted = result.results.sort((a, b) => {
          const aMatch = a.result_type === 'style' ? a.style_number : a.result_type === 'batch' ? a.batch_id : a.serial_number;
          const bMatch = b.result_type === 'style' ? b.style_number : b.result_type === 'batch' ? b.batch_id : b.serial_number;
          const aRelevance = aMatch === q ? 0 : aMatch.startsWith(q) ? 1 : 2;
          const bRelevance = bMatch === q ? 0 : bMatch.startsWith(q) ? 1 : 2;
          if (aRelevance !== bRelevance) return aRelevance - bRelevance;
          const typeOrder = { 'style': 0, 'batch': 1, 'serial': 2 };
          return (typeOrder[a.result_type] || 3) - (typeOrder[b.result_type] || 3);
        });

        // Show results
        const resultsList = document.getElementById('resultsList');
        resultsList.innerHTML = sorted.map((r, idx) => {
          const displayName = r.result_type === 'style'
            ? `${r.style_number}${r.variant ? '-' + r.variant : ''} - ${r.product_name || 'No name'}`
            : r.result_type === 'batch'
            ? `Batch: ${r.batch_id}`
            : `Serial: ${r.serial_number} (Style: ${r.style_number})`;

          return `<button class="w-full text-left p-3 bg-gray-50 rounded hover:bg-blue-50 border border-gray-200 result-btn" data-result-index="${idx}">
            <p class="font-semibold">${displayName}</p>
            <p class="text-xs text-gray-500">Type: ${r.result_type}</p>
          </button>`;
        }).join('');

        // Add click handlers to results
        resultsList.querySelectorAll('button.result-btn').forEach((btn, idx) => {
          btn.addEventListener('click', () => {
            const r = sorted[idx];
            loadData(r.result_type, r.style_number || '', r.batch_id || '', r.serial_number || '');
          });
        });

        document.getElementById('resultsListContainer').classList.remove('hidden');

        // Show result count
        let statusMsg = `Found ${result.results.length} result(s)`;
        status.textContent = statusMsg;

        // Check if we can add new variants
        const styles = sorted.filter(r => r.result_type === 'style');
        if (styles.length > 0 && isPartialStyleNum && !isStyleVariant) {
          // We found styles for this style_number - check what type they are
          const hasTopp = styles.some(s => (s.product_type || '').toLowerCase() === 'topp');
          const hasJeans = styles.some(s => (s.product_type || '').toLowerCase() === 'jeans');

          if (hasTopp && !hasJeans) {
            // Only topps exist - offer to add new variant
            status.innerHTML += `<div class="mt-3 text-sm"><button class="text-blue-600 hover:underline font-semibold addVariantBtn" data-style="${q}">➕ Add new variant for ${escapeHtml(q)}</button></div>`;

            // Add event listener
            setTimeout(() => {
