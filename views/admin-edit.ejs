        </div>
        <button onclick="saveBatchMetadata('${batch.batch_id}')" class="bg-gray-900 text-white px-4 py-2 rounded hover:bg-gray-800">
          ✓ Save
        </button>
      `;
      document.getElementById('batchInfo').parentElement.appendChild(batchEditDiv);

      // Pre-fill batch edit form
      if (data.batch_data && data.batch_data.length > 0) {
        const pd = data.batch_data.find(d => d.key === 'production_date');
        const mfg = data.batch_data.find(d => d.key === 'manufacturing_details');
        if (pd) document.getElementById('editBatchProductionDate').value = pd.value;
        if (mfg) document.getElementById('editBatchManufacturing').value = mfg.value;
