    // Add Serials functions
    async function showAddSerialsModal(batchId, styleNumber, variant) {
      console.log('showAddSerialsModal called, batchId:', batchId, 'styleNumber:', styleNumber, 'variant:', variant);

      // If batchId not provided, use from currentData
      if (!batchId) {
        if (!currentData.batch || !currentData.batch.batch) {
          showToast('Please select a batch first');
          return;
        }
        batchId = currentData.batch.batch.batch_id;
      }

      addSerialsForBatchId = batchId;
      if (!addSerialsForBatchId) {
        showToast('Batch ID not found');
        return;
      }

      // Load all available styles from the batch's existing serials
      const existingStyles = new Set();
      if (currentData.batch && currentData.batch.serials) {
        currentData.batch.serials.forEach(s => {
          if (s.style_number) existingStyles.add(s.style_number);
        });
      }

      // Load all styles in the system
      try {
        const res = await fetch('/api/styles');
        const allStyles = await res.json();

        const styleSelect = document.getElementById('addSerialsStyleSelect');
        styleSelect.innerHTML = '<option value="">-- Select a style --</option>';

        allStyles.forEach(style => {
          const optionValue = style.variant ? `${style.style_number}|${style.variant}` : style.style_number;
          const option = document.createElement('option');
          option.value = optionValue;
          option.textContent = `${style.style_number}${style.variant ? '-' + style.variant : ''} - ${style.product_name || 'Unnamed'}`;
          styleSelect.appendChild(option);
        });

        // Pre-select if styleNumber provided
        if (styleNumber) {
          const selectValue = variant ? `${styleNumber}|${variant}` : styleNumber;
          styleSelect.value = selectValue;
          styleSelect.disabled = true; // Lock style selection if pre-selected
        } else if (existingStyles.size === 1) {
          styleSelect.value = Array.from(existingStyles)[0];
        }
        document.getElementById('addSerialsForBatch').textContent = `Add serials to: ${addSerialsForBatchId}`;
        document.getElementById('addSerialsInput').value = '';
        document.getElementById('addSerialsModal').classList.remove('hidden');
      } catch (err) {
        console.error('Error in showAddSerialsModal:', err);
        showToast('Error: ' + err.message);
      }
    }

