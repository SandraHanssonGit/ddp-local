<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DPP Hub</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body.viewer .edit-button { display: none !important; }
    body.viewer .delete-button { display: none !important; }
    body.admin .permanent-delete-button { display: none !important; }
  </style>
</head>
<body class="bg-gray-100">
  <div class="max-w-7xl mx-auto py-12 px-4">
    <div class="flex justify-between items-center mb-8">
      <div class="flex items-center gap-6">
        <div id="headerLogoContainer" class="flex items-center justify-center" style="max-height: 60px; min-width: 150px;">
          <!-- Logo loaded from localStorage or fallback -->
        </div>
        <h1 class="text-4xl font-bold text-gray-900">DPP Hub</h1>
      </div>
      <div class="flex items-center gap-4">
        <span class="text-sm text-gray-600" id="userDisplay"></span>
        <button onclick="logout()" class="bg-gray-900 text-white px-4 py-2 rounded hover:bg-gray-800">
          Logout
        </button>
      </div>
    </div>

    <!-- TOAST NOTIFICATION -->
    <div id="toastNotification" class="hidden fixed top-4 right-4 bg-gray-900 text-white px-6 py-3 rounded-lg shadow-lg flex items-center gap-2 z-50">
      <span>✓</span>
      <span id="toastMessage">Saved!</span>
    </div>

    <!-- TAB NAVIGATION -->
    <div class="flex gap-4 mb-8 border-b border-gray-300">
      <button id="tabDashboard" class="active px-6 py-4 font-semibold text-gray-900 border-b-2 border-gray-900">
        Dashboard
      </button>
      <button id="tabScan" class="px-6 py-4 font-semibold text-gray-700">
        Scan
      </button>
      <button id="tabProduct" class="px-6 py-4 font-semibold text-gray-700">
        Product
      </button>
      <button id="tabEdit" class="px-6 py-4 font-semibold text-gray-700">
        Design
      </button>
      <button id="tabAdmin" class="adminTabBtn px-6 py-4 font-semibold text-gray-700">
        Admin
      </button>
    </div>

    <!-- DASHBOARD TAB -->
    <div id="dashboardTab" class="space-y-6">
      <!-- KPI Cards -->
      <div class="grid grid-cols-4 gap-4">
        <div class="bg-white rounded-lg shadow-md p-6 text-center">
          <div class="text-3xl font-bold text-gray-900" id="statsStyles">0</div>
          <div class="text-sm text-gray-600 mt-2">Styles</div>
        </div>
        <div class="bg-white rounded-lg shadow-md p-6 text-center">
          <div class="text-3xl font-bold text-gray-900" id="statsBatches">0</div>
          <div class="text-sm text-gray-600 mt-2">Batches</div>
        </div>
        <div class="bg-white rounded-lg shadow-md p-6 text-center">
          <div class="text-3xl font-bold text-gray-900" id="statsSerials">0</div>
          <div class="text-sm text-gray-600 mt-2">Serials</div>
        </div>
        <div class="bg-white rounded-lg shadow-md p-6 text-center">
          <div class="text-3xl font-bold text-gray-900" id="statsEvents">0</div>
          <div class="text-sm text-gray-600 mt-2">Events</div>
        </div>
      </div>

      <!-- Condition Distribution -->
      <div class="bg-white rounded-lg shadow-md p-6">
        <h2 class="text-2xl font-semibold text-gray-900 mb-6">Serial Condition Distribution</h2>
        <div class="grid grid-cols-4 gap-4">
          <div class="text-center p-4 bg-gray-50 rounded">
            <div class="text-2xl font-bold text-gray-900" id="conditionNew">0</div>
            <div class="text-sm text-gray-600">New</div>
          </div>
          <div class="text-center p-4 bg-gray-50 rounded">
            <div class="text-2xl font-bold text-gray-900" id="conditionRepaired">0</div>
            <div class="text-sm text-gray-600">Repaired</div>
          </div>
          <div class="text-center p-4 bg-gray-50 rounded">
            <div class="text-2xl font-bold text-gray-900" id="conditionReused">0</div>
            <div class="text-sm text-gray-600">Reused</div>
          </div>
          <div class="text-center p-4 bg-gray-50 rounded">
            <div class="text-2xl font-bold text-gray-900" id="conditionRecycled">0</div>
            <div class="text-sm text-gray-600">Recycled</div>
          </div>
        </div>
      </div>

      <!-- Top Styles -->
      <div class="grid grid-cols-2 gap-6">
        <div class="bg-white rounded-lg shadow-md p-6">
          <h2 class="text-xl font-semibold text-gray-900 mb-4">Top 5 Products</h2>
          <div id="topStyles" class="space-y-2"></div>
        </div>

        <!-- Data Quality -->
        <div class="bg-white rounded-lg shadow-md p-6">
          <h2 class="text-xl font-semibold text-gray-900 mb-4">Data Quality Issues</h2>
          <div id="dataQualityIssues" class="space-y-2 text-sm max-h-64 overflow-y-auto pr-2"></div>
        </div>

        <!-- Most Viewed Serials -->
        <div class="bg-white rounded-lg shadow-md p-6">
          <h2 class="text-xl font-semibold text-gray-900 mb-4">Most Viewed Product Passports</h2>
          <div class="overflow-x-auto">
            <table class="w-full text-sm border-collapse">
              <thead>
                <tr class="bg-gray-100 border-b border-gray-300">
                  <th class="px-4 py-2 text-left font-semibold text-gray-900">Serial Number</th>
                  <th class="px-4 py-2 text-left font-semibold text-gray-900">Style</th>
                  <th class="px-4 py-2 text-right font-semibold text-gray-900">Views</th>
                </tr>
              </thead>
              <tbody id="mostViewedTable">
                <tr><td colspan="3" class="px-4 py-3 text-center text-gray-500">Loading...</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Activity Timeline -->
        <div class="bg-white rounded-lg shadow-md p-6">
          <h2 class="text-xl font-semibold text-gray-900 mb-4">Activity Timeline</h2>
          <div id="activityTimeline" class="space-y-3 max-h-96 overflow-y-auto">
            <div class="text-gray-500 text-sm">Loading...</div>
          </div>
        </div>
      </div>

    </div>

    <!-- SCAN TAB -->
    <div id="scanTab" class="hidden space-y-6">
      <div class="bg-white rounded-lg shadow-md p-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Scan Serial</h2>

        <div class="space-y-6">
          <!-- Style Selection -->
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-2">Style</label>
            <select id="scanStyle" class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:border-gray-900">
              <option value="">-- Select Style --</option>
            </select>
          </div>

          <!-- Batch Input -->
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-2">Batch ID</label>
            <input type="text" id="scanBatch" placeholder="e.g., 114519-BATCH001" class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:border-gray-900">
          </div>

          <!-- Serial Number Input -->
          <div>
            <label class="block text-sm font-bold text-gray-700 mb-2">Serial Number</label>
            <input type="text" id="scanSerial" placeholder="e.g., 001AA" class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:border-gray-900" autofocus>
          </div>

          <!-- Scan Button -->
          <button onclick="performScan()" class="w-full bg-gray-900 text-white px-6 py-3 rounded-lg hover:bg-gray-800 font-semibold">
            ✓ Scan
          </button>
        </div>

        <!-- Scan Result -->
        <div id="scanResult" class="hidden mt-8 p-6 bg-gray-50 rounded-lg border border-gray-200">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Scan Result</h3>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Serial Info -->
            <div class="bg-white rounded p-4">
              <h4 class="text-sm font-semibold text-gray-700 mb-2 uppercase">Serial</h4>
              <div class="text-sm space-y-1" id="resultSerialInfo"></div>
            </div>

            <!-- Batch Info -->
            <div class="bg-white rounded p-4">
              <h4 class="text-sm font-semibold text-gray-700 mb-2 uppercase">Batch</h4>
              <div class="text-sm space-y-1" id="resultBatchInfo"></div>
            </div>

            <!-- Style Info -->
            <div class="bg-white rounded p-4">
              <h4 class="text-sm font-semibold text-gray-700 mb-2 uppercase">Style</h4>
              <div class="text-sm space-y-1" id="resultStyleInfo"></div>
            </div>
          </div>

          <div id="createdBadge" class="mt-4 text-sm px-3 py-2 bg-green-100 text-green-800 rounded-lg font-semibold text-center hidden">
            ✓ New serial created
          </div>
          <div id="existsBadge" class="mt-4 text-sm px-3 py-2 bg-blue-100 text-blue-800 rounded-lg font-semibold text-center hidden">
            Serial already exists
          </div>
        </div>
      </div>
    </div>

    <!-- PRODUCT TAB -->
    <div id="productTab" class="hidden">
    <!-- SEARCH SECTION (hidden when viewing product details) -->
    <div id="searchSection-product" class="bg-white rounded-lg shadow-md p-8 mb-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Search</h2>
      <form id="searchForm-product" class="flex gap-4">
        <input type="text" id="searchQuery-product" placeholder="Search by Style and/or Variant..." class="flex-1 border border-gray-300 rounded px-4 py-3">
        <button type="submit" class="bg-gray-900 text-white px-8 py-3 rounded font-semibold hover:bg-gray-800">
          Search
        </button>
      </form>
      <div id="searchStatus-product" class="mt-4 text-sm text-gray-600"></div>
    </div>

    <!-- PRODUCTS LIST (vertical scroll list) -->
    <div id="productsListContainer-product" class="mb-8 bg-white rounded-lg shadow-md p-4">
      <div id="productsList-product" class="space-y-2 max-h-96 overflow-y-auto">
        <div class="text-center text-gray-500 py-8">Loading products...</div>
      </div>
    </div>

    <!-- SEARCH RESULTS LIST (shown when search has results) -->
    <div id="resultsListContainer-product" class="hidden bg-white rounded-lg shadow-md p-8 mb-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Search Results</h2>
      <div id="resultsList-product" class="space-y-2 max-h-64 overflow-y-auto"></div>
    </div>

    <!-- RESULT CONTAINER -->
    <div id="resultContainer-product" class="hidden grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Main Content (2/3 width on desktop) -->
      <div class="lg:col-span-2">

      <!-- STYLE VIEW -->
      <div id="styleSection-product" class="hidden bg-white rounded-lg shadow-md p-8">
        <input type="hidden" id="styleNumber-product">
        <div class="flex justify-between items-center mb-8">
          <h2 class="text-3xl font-semibold text-gray-900">Product: <span id="styleTitle-product"></span></h2>
          <div class="flex gap-2">
            <button id="fetchNudieBtn-product" class="bg-gray-900 text-white px-4 py-2 rounded hover:bg-gray-800" onclick="showFetchNudieModal()" style="display: none;">
              Fetch from Nudie Jeans
            </button>
            <button onclick="loadAllProducts()" class="bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-700">
              ← Back to Products
            </button>
          </div>
        </div>

        <!-- Images Section -->
        <div class="bg-gray-50 p-6 rounded mb-6">
          <h3 class="text-lg font-semibold text-gray-900 mb-4">Style Images</h3>
          <div id="styleImages-product" class="flex gap-4 mb-4 flex-wrap"></div>
          <input type="file" id="styleImageUpload-product" accept="image/*" class="border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:border-gray-900 w-full">
          <button onclick="uploadStyleImage()" class="mt-2 bg-gray-900 text-white px-4 py-2 rounded hover:bg-gray-800">
            Upload Image
          </button>
        </div>

        <!-- Style Data Tabs -->
        <div class="space-y-6">
          <div class="border-t pt-6">
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-xl font-semibold text-gray-900">Product Information</h3>
              <button onclick="toggleEdit('product-info')" class="edit-button bg-gray-900 text-white px-4 py-2 rounded hover:bg-gray-800">
                Edit
              </button>
            </div>
            <div id="productInfoView-product" class="bg-gray-50 rounded-lg p-6 space-y-3"></div>
            <div id="productInfoEdit-product" class="hidden space-y-4 mt-4">
              <!-- Style Number Display (Read-only) -->
              <div class="bg-blue-50 border-l-4 border-blue-400 p-4 mb-4">
                <p class="text-sm font-semibold text-gray-900">Style #: <span id="styleNumberDisplay-product" class="text-blue-600 font-bold">-</span></p>
                <p id="variantDisplay-product" style="display: none;" class="text-sm text-gray-600 mt-1">Variant: <span id="variantDisplayValue-product" class="font-semibold">-</span></p>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label class="block text-xs text-gray-500 uppercase tracking-wide font-semibold mb-2">Product Type</label>
                  <select id="productType-product" class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:border-gray-900">
                    <option value="">Select product type</option>
                    <option value="jeans">Jeans</option>
                    <option value="tops">Tops</option>
                  </select>
                </div>
                <div>
                  <label class="block text-xs text-gray-500 uppercase tracking-wide font-semibold mb-2">Variant</label>
                  <input type="text" id="productVariant-product" placeholder="Required for Tops (e.g. B20)" class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:border-gray-900">
                  <p class="text-xs text-gray-500 mt-2">Required for Tops only. Jeans cannot have variants.</p>
                </div>
              </div>
              <div>
                <label class="block text-xs text-gray-500 uppercase tracking-wide font-semibold mb-2">Product Name</label>
                <input type="text" id="productName-product" class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:border-gray-900">
              </div>
              <div>
                <label class="block text-xs text-gray-500 uppercase tracking-wide font-semibold mb-2">Description</label>
                <textarea id="productDescription-product" rows="3" class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:border-gray-900"></textarea>
              </div>
              <div>
                <label class="block text-xs text-gray-500 uppercase tracking-wide font-semibold mb-2">Care Instructions</label>
                <textarea id="productCare-product" rows="2" class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:border-gray-900"></textarea>
              </div>
              <div>
                <label class="block text-xs text-gray-500 uppercase tracking-wide font-semibold mb-2">Delivery & Returns</label>
                <textarea id="productDelivery-product" rows="2" class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:border-gray-900"></textarea>
              </div>
              <div>
                <label class="block text-xs text-gray-500 uppercase tracking-wide font-semibold mb-2">Size, Material & Composition</label>
                <textarea id="productMaterial-product" rows="2" class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:border-gray-900"></textarea>
              </div>
              <button onclick="saveProductInfo()" class="bg-gray-900 text-white px-6 py-3 rounded-lg hover:bg-gray-800 font-semibold">
                Save
              </button>
            </div>
          </div>

          <div class="border-t pt-6">
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-xl font-semibold text-gray-900">Transparency Data</h3>
              <button onclick="toggleEdit('transparency')" class="edit-button bg-gray-900 text-white px-4 py-2 rounded hover:bg-gray-800">
                Edit
              </button>
            </div>
            <div id="transparencyView-product" class="bg-gray-50 rounded-lg p-6 text-sm overflow-auto max-h-48"></div>
            <div id="transparencyEdit-product" class="hidden space-y-4 mt-4">
              <div>
                <label class="block text-xs text-gray-500 uppercase tracking-wide font-semibold mb-2">Suppliers Chain (JSON)</label>
                <textarea id="transparencySuppliers-product" rows="3" class="w-full border border-gray-300 rounded-lg px-4 py-3 font-mono text-xs focus:outline-none focus:border-gray-900"></textarea>
              </div>
              <div>
                <label class="block text-xs text-gray-500 uppercase tracking-wide font-semibold mb-2">Certifications (JSON)</label>
                <textarea id="transparencyCerts-product" rows="3" class="w-full border border-gray-300 rounded-lg px-4 py-3 font-mono text-xs focus:outline-none focus:border-gray-900"></textarea>
              </div>
              <div>
                <label class="block text-xs text-gray-500 uppercase tracking-wide font-semibold mb-2">Environmental Data (JSON)</label>
                <textarea id="transparencyEnv-product" rows="3" class="w-full border border-gray-300 rounded-lg px-4 py-3 font-mono text-xs focus:outline-none focus:border-gray-900"></textarea>
              </div>
              <div>
                <label class="block text-xs text-gray-500 uppercase tracking-wide font-semibold mb-2">Social Data (JSON)</label>
                <textarea id="transparencySocial-product" rows="3" class="w-full border border-gray-300 rounded-lg px-4 py-3 font-mono text-xs focus:outline-none focus:border-gray-900"></textarea>
              </div>
              <button onclick="saveTransparency()" class="bg-gray-900 text-white px-6 py-3 rounded-lg hover:bg-gray-800 font-semibold">
                Save
              </button>
            </div>
          </div>

          <div class="border-t pt-6">
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-xl font-semibold text-gray-900">Nudie Values</h3>
              <button onclick="toggleEdit('nudie-values')" class="edit-button bg-gray-900 text-white px-4 py-2 rounded hover:bg-gray-800">
                Edit
              </button>
            </div>
            <div id="nudieValuesView-product" class="bg-gray-50 rounded-lg p-6 space-y-3"></div>
            <div id="nudieValuesEdit-product" class="hidden space-y-4 mt-4">
              <div>
                <label class="block text-xs text-gray-500 uppercase tracking-wide font-semibold mb-2">Repair Info</label>
                <textarea id="nudieRepair-product" rows="3" class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:border-gray-900"></textarea>
              </div>
              <button onclick="saveNudieValues()" class="bg-gray-900 text-white px-6 py-3 rounded-lg hover:bg-gray-800 font-semibold">
                Save
              </button>
            </div>
          </div>

          <div class="border-t pt-6">
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-xl font-semibold text-gray-900">Storytelling</h3>
              <button onclick="toggleEdit('storytelling')" class="edit-button bg-gray-900 text-white px-4 py-2 rounded hover:bg-gray-800">
                Edit
              </button>
            </div>
            <div id="storytellingView-product" class="bg-gray-50 rounded-lg p-6 space-y-3"></div>
            <div id="storytellingEdit-product" class="hidden space-y-4 mt-4">
              <div>
                <label class="block text-xs text-gray-500 uppercase tracking-wide font-semibold mb-2">Summary</label>
                <textarea id="storytellinSummary-product" rows="2" class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:border-gray-900"></textarea>
              </div>
              <div>
                <label class="block text-xs text-gray-500 uppercase tracking-wide font-semibold mb-2">Content</label>
                <textarea id="storytellingContent-product" rows="4" class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:border-gray-900"></textarea>
              </div>
              <div>
                <label class="block text-xs text-gray-500 uppercase tracking-wide font-semibold mb-2">Links (JSON)</label>
                <textarea id="storytellingLinks-product" rows="3" class="w-full border border-gray-300 rounded-lg px-4 py-3 font-mono text-xs focus:outline-none focus:border-gray-900"></textarea>
              </div>
              <button onclick="saveStorytelling()" class="bg-gray-900 text-white px-6 py-3 rounded-lg hover:bg-gray-800 font-semibold">
                Save
              </button>
            </div>
          </div>

          <!-- Batches for this Style -->
          <div class="border-t pt-6">
            <div class="mb-4">
              <h3 class="text-xl font-semibold text-gray-900">Batches</h3>
            </div>
            <table class="w-full border-collapse text-sm">
              <thead>
                <tr class="border-b border-gray-300">
                  <th class="text-left py-2 px-3 font-bold text-gray-900">Batch ID</th>
                  <th class="text-left py-2 px-3 font-bold text-gray-900">Serials</th>
                  <th class="text-left py-2 px-3 font-bold text-gray-900">Partner</th>
                  <th class="text-right py-2 px-3 font-bold text-gray-900">Actions</th>
                </tr>
              </thead>
              <tbody id="batchesList-product"></tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- BATCH VIEW -->
      <div id="batchSection-product" class="hidden bg-white rounded-lg shadow-md p-8">
        <h2 class="text-3xl font-semibold text-gray-900 mb-8">Batch: <span id="batchTitle-product"></span></h2>

        <div id="batchInfo-product" class="bg-gray-50 rounded-lg p-6 space-y-2"></div>

      </div>

      <!-- SERIAL VIEW -->
      <div id="serialSection-product" class="hidden bg-white rounded-lg shadow-md p-8">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-3xl font-semibold text-gray-900">Serial: <span id="serialTitle-product"></span></h2>
          <div class="flex gap-2">
            <button onclick="previewPublicPassport()" class="bg-gray-900 text-white px-4 py-2 rounded hover:bg-gray-800">
              Preview Passport
            </button>
            <button onclick="copyPublicLink()" class="bg-gray-900 text-white px-4 py-2 rounded hover:bg-gray-800">
              Copy Public Link
            </button>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
          <div class="bg-gray-50 rounded-lg p-6">
            <h3 class="text-xs text-gray-500 uppercase tracking-wide font-semibold mb-4">Serial Info</h3>
            <div id="serialInfo-product" class="text-sm space-y-2 text-gray-700"></div>
          </div>
          <div class="bg-gray-50 rounded-lg p-6">
            <h3 class="text-xs text-gray-500 uppercase tracking-wide font-semibold mb-4">Batch Info</h3>
            <div id="serialBatchInfo-product" class="text-sm space-y-2 text-gray-700"></div>
          </div>
          <div class="bg-gray-50 rounded-lg p-6">
            <h3 class="text-xs text-gray-500 uppercase tracking-wide font-semibold mb-4">Style Info</h3>
            <div id="serialStyleInfo-product" class="text-sm space-y-2 text-gray-700"></div>
          </div>
        </div>

        <!-- Serial Metadata -->
        <div class="border-t pt-6">
          <div class="flex justify-between items-center mb-4">
            <h3 class="text-xl font-bold text-gray-900">Serial Metadata</h3>
            <button onclick="toggleSerialMetadataEdit()" class="edit-button bg-gray-900 text-white px-4 py-2 rounded hover:bg-gray-800">
              Edit
            </button>
          </div>
          <div id="serialMetadataView-product" class="bg-gray-50 rounded-lg p-6 grid grid-cols-2 gap-6"></div>
          <div id="serialMetadataEdit-product" class="hidden space-y-4 mt-4 bg-gray-50 rounded-lg p-6">
