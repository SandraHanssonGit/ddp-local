  </div>

  <script>
    const currentData = {};

    function showToast(message = 'Saved!') {
      const toast = document.getElementById('toastNotification');
      const msg = document.getElementById('toastMessage');
      msg.textContent = message;
      toast.classList.remove('hidden');
      setTimeout(() => toast.classList.add('hidden'), 2500);
    }

    function copyPublicLink() {
      const serialNumber = document.getElementById('serialTitle').textContent;
      const publicLink = `${window.location.origin}/p/${serialNumber}`;
      navigator.clipboard.writeText(publicLink).then(() => {
        showToast('📋 Link copied!');
      });
    }

    function previewPublicPassport() {
      const serialNumber = document.getElementById('serialTitle').textContent;
      window.open(`/p/${serialNumber}`, '_blank');
    }

    // Serials table globals
    let serialsTableData = [];
    let serialsFilteredData = [];
    let serialsCurrentSort = { column: 'serial_number', direction: 'asc' };
    let serialsCurrentPage = 1;
    let serialsSearchQuery = '';
    const SERIALS_PER_PAGE = 50;

    function showSerialsTable(serials, allSerialData) {
      // Map serial data to serials
      serialsTableData = serials.map(s => {
        const data = {};
        const serialDataForThis = allSerialData.filter(sd => sd.serial_id === s.id);
        serialDataForThis.forEach(sd => {
          data[sd.key] = sd.value;
        });
        return {
          ...s,
          condition: data.condition || '-',
          size: data.size || '-',
          owner_id: data.owner_id || '-'
        };
      });

      serialsFilteredData = [...serialsTableData];
      document.getElementById('serialsCount').textContent = serialsTableData.length;
      document.getElementById('serialsSearchInput').value = '';
      serialsCurrentPage = 1;
      renderSerialsTable();
    }

    function filterSerials() {
      serialsSearchQuery = document.getElementById('serialsSearchInput').value.toLowerCase();
      serialsFilteredData = serialsTableData.filter(s =>
        s.serial_number.toLowerCase().includes(serialsSearchQuery)
      );
      serialsCurrentPage = 1;
      renderSerialsTable();
    }

    function renderSerialsTable() {
      const sorted = [...serialsFilteredData].sort((a, b) => {
        const aVal = a[serialsCurrentSort.column];
        const bVal = b[serialsCurrentSort.column];
        const cmp = aVal > bVal ? 1 : aVal < bVal ? -1 : 0;
        return serialsCurrentSort.direction === 'asc' ? cmp : -cmp;
      });

      const start = (serialsCurrentPage - 1) * SERIALS_PER_PAGE;
      const end = start + SERIALS_PER_PAGE;
      const pageData = sorted.slice(start, end);

      const tbody = document.getElementById('serialsTableBody');
      tbody.innerHTML = pageData.map(s => `
        <tr class="border-b border-gray-200 hover:bg-blue-50 cursor-pointer" onclick="loadSerial('${s.serial_number}')">
          <td class="px-4 py-2">${s.serial_number}</td>
          <td class="px-4 py-2">${s.condition}</td>
          <td class="px-4 py-2">${s.size}</td>
          <td class="px-4 py-2 text-xs">${s.owner_id}</td>
        </tr>
      `).join('');

      // Render pagination
      const totalPages = Math.ceil(serialsFilteredData.length / SERIALS_PER_PAGE);
      const pagination = document.getElementById('serialsPagination');
      pagination.innerHTML = '';

      if (totalPages <= 1) return;

      for (let i = 1; i <= totalPages; i++) {
        const btn = document.createElement('button');
        btn.textContent = i;
        btn.className = i === serialsCurrentPage
          ? 'px-3 py-1 bg-blue-600 text-white rounded'
          : 'px-3 py-1 border border-gray-300 rounded hover:bg-gray-100';
        btn.onclick = () => {
          serialsCurrentPage = i;
          renderSerialsTable();
          document.querySelector('#batchSection').scrollIntoView({ behavior: 'smooth' });
        };
        pagination.appendChild(btn);
      }
    }

    function sortSerials(column) {
      if (serialsCurrentSort.column === column) {
        serialsCurrentSort.direction = serialsCurrentSort.direction === 'asc' ? 'desc' : 'asc';
      } else {
        serialsCurrentSort = { column, direction: 'asc' };
      }
      serialsCurrentPage = 1;
      renderSerialsTable();
    }

    // Wizard functions
    const wizardData = {};

    function wizardNextStep(step) {
      if (step === 1) {
        wizardData.styleNumber = document.getElementById('wizardStyleNumber').value;
        wizardData.productName = document.getElementById('wizardProductName').value;
        wizardData.material = document.getElementById('wizardMaterial').value;
        if (!wizardData.styleNumber) { alert('Style Number required'); return; }
      } else if (step === 2) {
        wizardData.transparency = document.getElementById('wizardTransparency').value;
        wizardData.repair = document.getElementById('wizardRepair').value;
        wizardData.story = document.getElementById('wizardStory').value;
      } else if (step === 3) {
        wizardData.batchId = document.getElementById('wizardBatchId').value;
        wizardData.batchUnits = document.getElementById('wizardBatchUnits').value;
        wizardData.productionDate = document.getElementById('wizardProductionDate').value;
        wizardData.manufacturing = document.getElementById('wizardManufacturing').value;
        if (!wizardData.batchId) { alert('Batch ID required'); return; }
      } else if (step === 4) {
        const serialsInput = document.getElementById('wizardSerials').value.trim();
        wizardData.serials = serialsInput.split(',').map(s => s.trim()).filter(s => s);
        if (wizardData.serials.length === 0) { alert('Add at least one serial'); return; }
      } else if (step === 5) {
        wizardData.sgtin = document.getElementById('wizardSGTINData').value;
      }

      showWizardStep(step + 1);
    }

    function wizardPrevStep(step) {
      showWizardStep(step - 1);
    }

    function showWizardStep(step) {
      // Hide all steps
      document.querySelectorAll('.wizard-step').forEach(s => s.classList.add('hidden'));
      // Show current step
      document.getElementById(`wizardStep${step}`).classList.remove('hidden');
      // Update step indicators
      document.querySelectorAll('.step-indicator div:first-child').forEach((el, i) => {
        const stepNum = i + 1;
        if (stepNum < step) {
          el.className = 'bg-green-600 text-white rounded-full w-10 h-10 flex items-center justify-center font-bold';
          el.textContent = '✓';
        } else if (stepNum === step) {
          el.className = 'bg-blue-600 text-white rounded-full w-10 h-10 flex items-center justify-center font-bold';
          el.textContent = stepNum;
        } else {
          el.className = 'bg-gray-300 text-white rounded-full w-10 h-10 flex items-center justify-center font-bold';
          el.textContent = stepNum;
        }
      });

      // Update displays
      if (step >= 2) {
        document.getElementById('wizardShowStyleDetails').textContent = wizardData.styleNumber;
      }
      if (step >= 3) {
        document.getElementById('wizardShowBatch').textContent = wizardData.batchId;
      }
      if (step >= 4) {
        document.getElementById('wizardShowStyle').textContent = wizardData.styleNumber;
      }
      if (step >= 5) {
        document.getElementById('wizardShowSerials').textContent = wizardData.serials.length + ' serials';
        document.getElementById('serialsPreview').innerHTML = `<strong>Preview:</strong> ${wizardData.serials.slice(0, 3).join(', ')}${wizardData.serials.length > 3 ? '...' : ''}`;
      }
      if (step === 6) {
        showWizardReview();
      }

      window.scrollTo(0, 0);
    }

    function showWizardReview() {
      document.getElementById('wizardReviewStyle').innerHTML = `
        <div><strong>Number:</strong> ${wizardData.styleNumber}</div>
        <div><strong>Name:</strong> ${wizardData.productName}</div>
        <div><strong>Material:</strong> ${wizardData.material}</div>
      `;
      document.getElementById('wizardReviewBatch').innerHTML = `
        <div><strong>ID:</strong> ${wizardData.batchId}</div>
        <div><strong>Units:</strong> ${wizardData.batchUnits || '-'}</div>
        <div><strong>Production Date:</strong> ${wizardData.productionDate || '-'}</div>
        <div><strong>Manufacturing:</strong> ${wizardData.manufacturing || '-'}</div>
      `;
      document.getElementById('wizardReviewSerials').innerHTML = `
        <div><strong>Count:</strong> ${wizardData.serials.length}</div>
        <div><strong>Samples:</strong> ${wizardData.serials.slice(0, 5).join(', ')}${wizardData.serials.length > 5 ? '...' : ''}</div>
      `;
      document.getElementById('wizardReviewSGTIN').innerHTML = `
        <div><strong>Lines:</strong> ${wizardData.sgtin ? wizardData.sgtin.split('\n').length : 0}</div>
      `;
    }

    async function wizardCreate() {
      const resultDiv = document.getElementById('wizardResult');
      resultDiv.classList.add('hidden');

      // Step 1: Create style
      const styleRes = await fetch(`/api/styles/${wizardData.styleNumber}/product-info`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          product_name: wizardData.productName,
          size_material_composition: wizardData.material
        })
      });

      if (!styleRes.ok) {
        showWizardResult(false, 'Error creating style');
        return;
      }

      // Step 1b: Add transparency/nudie/storytelling if provided
      if (wizardData.transparency) {
        await fetch(`/api/styles/${wizardData.styleNumber}/transparency`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(JSON.parse(wizardData.transparency))
        });
      }

      if (wizardData.repair || wizardData.story) {
        const nudieData = {};
        if (wizardData.repair) nudieData.repair_info = wizardData.repair;
        if (wizardData.story) {
          const storyData = {
            summary: wizardData.story,
            content: wizardData.story,
            links: []
          };
          await fetch(`/api/styles/${wizardData.styleNumber}/storytelling`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(storyData)
          });
        }
        if (wizardData.repair) {
          await fetch(`/api/styles/${wizardData.styleNumber}/nudie-values`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(nudieData)
          });
        }
      }

      // Step 2: Create batch
      const batchRes = await fetch('/api/batch/import', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          batch_id: wizardData.batchId,
          style_number: wizardData.styleNumber,
          total_units: parseInt(wizardData.batchUnits) || 0,
          partner_name: '',
          serials: wizardData.serials
        })
      });

      if (!batchRes.ok) {
        showWizardResult(false, 'Error creating batch');
        return;
      }

      // Step 3: Save batch metadata
      if (wizardData.productionDate || wizardData.manufacturing) {
        await fetch('/api/batch/metadata', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            batch_id: wizardData.batchId,
            production_date: wizardData.productionDate,
            manufacturing_details: wizardData.manufacturing
          })
        });
      }

      // Step 4: Import SGTIN
      if (wizardData.sgtin) {
        await fetch('/api/serials/import-supplier-data', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            batch_id: wizardData.batchId,
            data: wizardData.sgtin
          })
        });
      }

      showWizardResult(true, `✓ Complete! Created batch ${wizardData.batchId} with ${wizardData.serials.length} serials`);
    }

    function showWizardResult(success, message) {
      const resultDiv = document.getElementById('wizardResult');
      resultDiv.className = success
        ? 'mt-4 p-4 rounded bg-green-50 border border-green-200 text-green-900'
        : 'mt-4 p-4 rounded bg-red-50 border border-red-200 text-red-900';
      resultDiv.innerHTML = `<p>${message}</p>`;
      resultDiv.classList.remove('hidden');
      if (success) {
        setTimeout(() => {
          document.getElementById('wizardStep1').classList.remove('hidden');
          document.querySelectorAll('.wizard-step').forEach((s, i) => {
            if (i > 0) s.classList.add('hidden');
          });
          document.getElementById('wizardStyleNumber').value = '';
          document.getElementById('wizardProductName').value = '';
          document.getElementById('wizardMaterial').value = '';
          document.getElementById('wizardBatchId').value = '';
          document.getElementById('wizardBatchUnits').value = '';
          document.getElementById('wizardProductionDate').value = '';
          document.getElementById('wizardManufacturing').value = '';
          document.getElementById('wizardSerials').value = '';
          document.getElementById('wizardSGTINData').value = '';
          showWizardStep(1);
        }, 2000);
      }
    }

    // Tab switching
    function switchTab(tab) {
      document.getElementById('editTab').classList.toggle('hidden', tab !== 'edit');
      document.getElementById('newTab').classList.toggle('hidden', tab !== 'new');
      document.getElementById('tabEdit').classList.toggle('border-b-2', tab === 'edit');
      document.getElementById('tabEdit').classList.toggle('border-blue-600', tab === 'edit');
      document.getElementById('tabEdit').classList.toggle('text-gray-900', tab === 'edit');
      document.getElementById('tabEdit').classList.toggle('text-gray-700', tab !== 'edit');
      document.getElementById('tabNew').classList.toggle('border-b-2', tab === 'new');
      document.getElementById('tabNew').classList.toggle('border-blue-600', tab === 'new');
      document.getElementById('tabNew').classList.toggle('text-gray-900', tab === 'new');
      document.getElementById('tabNew').classList.toggle('text-gray-700', tab !== 'new');
    }

    // NEW STYLE form
    document.getElementById('newStyleForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const styleNumber = document.getElementById('newStyleNumber').value;
      const res = await fetch(`/api/styles/${styleNumber}/product-info`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          product_name: document.getElementById('newProductName').value,
          description: document.getElementById('newDescription').value,
          care_instructions: document.getElementById('newCare').value,
          delivery_returns: document.getElementById('newDelivery').value,
          size_material_composition: document.getElementById('newMaterial').value
        })
      });
      const result = await res.json();
      const resultDiv = document.getElementById('newStyleResult');
      resultDiv.className = res.ok ? 'mt-4 p-4 rounded bg-green-50 border border-green-200 text-green-900' : 'mt-4 p-4 rounded bg-red-50 border border-red-200 text-red-900';
      resultDiv.innerHTML = `<p>${res.ok ? '✓ Style created! Now add transparency/nudie/storytelling data.' : '✗ Error: ' + result.error}</p>`;
      resultDiv.classList.remove('hidden');
      if (res.ok) document.getElementById('newStyleForm').reset();
    });

    // NEW BATCH form
    document.getElementById('newBatchForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const serials = document.getElementById('newSerials').value.split(',').map(s => s.trim());
      const batchId = document.getElementById('newBatchId').value;
      const productionDate = document.getElementById('newBatchProductionDate').value;
      const manufacturingDetails = document.getElementById('newBatchManufacturing').value;

      const res = await fetch('/api/batch/import', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          batch_id: batchId,
          style_number: document.getElementById('newBatchStyle').value,
          total_units: parseInt(document.getElementById('newBatchUnits').value) || 0,
          partner_name: '', // Empty now
          serials
        })
      });
      const result = await res.json();

      // Save batch metadata (production date and manufacturing details)
      if (res.ok && productionDate) {
        await fetch('/api/batch/metadata', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            batch_id: batchId,
            production_date: productionDate,
            manufacturing_details: manufacturingDetails
          })
        });
      }

      const resultDiv = document.getElementById('newBatchResult');
      resultDiv.className = res.ok ? 'mt-4 p-4 rounded bg-green-50 border border-green-200 text-green-900' : 'mt-4 p-4 rounded bg-red-50 border border-red-200 text-red-900';
      resultDiv.innerHTML = `<p>${res.ok ? '✓ Batch created with ' + result.serials_imported + ' serials!' : '✗ Error: ' + result.error}</p>`;
      resultDiv.classList.remove('hidden');
      if (res.ok) document.getElementById('newBatchForm').reset();
    });

    // IMPORT SUPPLIER DATA form
    document.getElementById('importSupplierForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const res = await fetch('/api/serials/import-supplier-data', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          batch_id: document.getElementById('importBatchId').value,
          data: document.getElementById('importData').value
        })
      });
      const result = await res.json();
      const resultDiv = document.getElementById('importSupplierResult');
      resultDiv.className = res.ok ? 'mt-4 p-4 rounded bg-green-50 border border-green-200 text-green-900' : 'mt-4 p-4 rounded bg-red-50 border border-red-200 text-red-900';
      resultDiv.innerHTML = `<p>${res.ok ? '✓ Imported ' + result.processed + ' records' : '✗ Error: ' + result.error}</p>`;
      resultDiv.classList.remove('hidden');
      if (res.ok) document.getElementById('importSupplierForm').reset();
    });

    document.getElementById('searchForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const q = document.getElementById('searchQuery').value.trim();
      const status = document.getElementById('searchStatus');

      status.textContent = 'Searching...';

      try {
        const res = await fetch(`/api/search?q=${encodeURIComponent(q)}`);
        const result = await res.json();

        if (!result.results || result.results.length === 0) {
          status.textContent = 'No results found';
          document.getElementById('resultsListContainer').classList.add('hidden');
          document.getElementById('resultContainer').classList.add('hidden');
          return;
        }

        // Sort by relevance - exact match first, then starts with, then contains
        // Also prioritize: styles > batches > serials
        const sorted = result.results.sort((a, b) => {
          const aMatch = a.result_type === 'style' ? a.style_number : a.result_type === 'batch' ? a.batch_id : a.serial_number;
          const bMatch = b.result_type === 'style' ? b.style_number : b.result_type === 'batch' ? b.batch_id : b.serial_number;

          // Calculate relevance score
          const aRelevance = aMatch === q ? 0 : aMatch.startsWith(q) ? 1 : 2;
          const bRelevance = bMatch === q ? 0 : bMatch.startsWith(q) ? 1 : 2;

          // If relevance is the same, prioritize by type
          if (aRelevance !== bRelevance) return aRelevance - bRelevance;

          const typeOrder = { 'style': 0, 'batch': 1, 'serial': 2 };
          return (typeOrder[a.result_type] || 3) - (typeOrder[b.result_type] || 3);
        });

        // Show results list
        const resultsList = document.getElementById('resultsList');
        resultsList.innerHTML = sorted.map(r => {
          const displayName = r.result_type === 'style'
            ? `📦 ${r.style_number} - ${r.product_name || 'No name'}`
            : r.result_type === 'batch'
            ? `📦 Batch: ${r.batch_id} (Style: ${r.style_number})`
            : `🏷️ Serial: ${r.serial_number} (Batch: ${r.batch_id})`;

          return `
            <button class="w-full text-left p-3 bg-gray-50 rounded hover:bg-blue-50 border border-gray-200"
                    onclick="loadData('${r.result_type}', '${r.style_number || ''}', '${r.batch_id || ''}', '${r.serial_number || ''}')">
              <p class="font-semibold">${displayName}</p>
              <p class="text-xs text-gray-500">Type: ${r.result_type}</p>
            </button>
          `;
        }).join('');

        document.getElementById('resultsListContainer').classList.remove('hidden');
        status.textContent = `Found ${result.results.length} result(s)`;
      } catch (err) {
        status.textContent = `Error: ${err.message}`;
      }
    });

    function loadData(type, styleNumber, batchId, serialNumber) {
      document.getElementById('resultContainer').classList.remove('hidden');
      if (type === 'style') {
        loadStyle(styleNumber);
      } else if (type === 'batch') {
        loadBatch(batchId);
      } else if (type === 'serial') {
        loadSerial(serialNumber);
      }
    }

    async function loadStyle(styleNumber) {
      document.getElementById('styleSection').classList.remove('hidden');
      document.getElementById('batchSection').classList.add('hidden');
      document.getElementById('serialSection').classList.add('hidden');

      const res = await fetch(`/api/styles/${styleNumber}/full-data`);
      const data = await res.json();
      currentData.style = data;

      document.getElementById('styleTitle').textContent = styleNumber;

      // Load style images
      await loadStyleImages(styleNumber);

      // Product info
      const style = data.style;
      document.getElementById('productInfoView').innerHTML = `
        <div><strong>Name:</strong> ${style.product_name || '-'}</div>
        <div><strong>Description:</strong> ${style.description || '-'}</div>
        <div><strong>Care:</strong> ${style.care_instructions || '-'}</div>
        <div><strong>Material:</strong> ${style.size_material_composition || '-'}</div>
      `;

      // Pre-fill edit form
      document.getElementById('productName').value = style.product_name || '';
      document.getElementById('productDescription').value = style.description || '';
      document.getElementById('productCare').value = style.care_instructions || '';
      document.getElementById('productDelivery').value = style.delivery_returns || '';
      document.getElementById('productMaterial').value = style.size_material_composition || '';

      // Transparency
      if (data.transparency_data) {
        document.getElementById('transparencyView').textContent = JSON.stringify(data.transparency_data, null, 2);
        document.getElementById('transparencySuppliers').value = JSON.stringify(data.transparency_data.suppliers_chain || {}, null, 2);
        document.getElementById('transparencyCerts').value = JSON.stringify(data.transparency_data.certifications || {}, null, 2);
        document.getElementById('transparencyEnv').value = JSON.stringify(data.transparency_data.environmental_data || {}, null, 2);
        document.getElementById('transparencySocial').value = JSON.stringify(data.transparency_data.social_data || {}, null, 2);
      }

      // Nudie values
      if (data.nudie_values) {
        document.getElementById('nudieValuesView').innerHTML = `
          <div><strong>Repair Info:</strong> ${data.nudie_values.repair_info || '-'}</div>
        `;
        document.getElementById('nudieRepair').value = data.nudie_values.repair_info || '';
      }

      // Storytelling
      if (data.storytelling) {
        document.getElementById('storytellingView').innerHTML = `
          <div><strong>Summary:</strong> ${data.storytelling.summary || '-'}</div>
          <div><strong>Content:</strong> ${data.storytelling.content || '-'}</div>
        `;
        document.getElementById('storytellinSummary').value = data.storytelling.summary || '';
        document.getElementById('storytellingContent').value = data.storytelling.content || '';
        document.getElementById('storytellingLinks').value = JSON.stringify(data.storytelling.links || [], null, 2);
      }

      // Batches - clickable to navigate down
      const batchesList = document.getElementById('batchesList');
      batchesList.innerHTML = data.batches.map(b => `
        <button onclick="loadBatch('${b.batch_id}')" class="w-full text-left p-3 bg-gray-50 rounded hover:bg-blue-50 border border-gray-200 cursor-pointer">
          <p class="font-semibold">📦 ${b.batch_id}</p>
          <p class="text-xs text-gray-500">${b.serial_count} serials | Partner: ${b.partner_name || '-'}</p>
        </button>
      `).join('');
    }

    async function loadStyleImages(styleNumber) {
      try {
        const res = await fetch(`/api/styles/${styleNumber}/images`);
        const images = await res.json();
        const container = document.getElementById('styleImages');
        container.innerHTML = images.map(img => `
          <div class="relative">
            <img src="data:image/jpeg;base64,${img.image_data}" class="h-24 w-24 object-cover rounded" alt="${img.image_name}">
            <button onclick="deleteStyleImage(${img.id})" class="absolute top-0 right-0 bg-red-600 text-white text-xs px-2 py-1 rounded">✕</button>
          </div>
        `).join('');
      } catch (err) {
        console.log('No images found');
      }
    }

    async function loadBatch(batchId) {
      document.getElementById('styleSection').classList.add('hidden');
      document.getElementById('batchSection').classList.remove('hidden');
      document.getElementById('serialSection').classList.add('hidden');

      const res = await fetch(`/api/batches/${batchId}/full-data`);
      const data = await res.json();
      currentData.batch = data;

      document.getElementById('batchTitle').textContent = batchId;

      await loadBatchImages(batchId);

      const batch = data.batch;

      // Get batch metadata if available
      let prodDate = '-';
      let mfgDetails = '-';
      if (data.batch_data && data.batch_data.length > 0) {
        const pd = data.batch_data.find(d => d.key === 'production_date');
        const mfg = data.batch_data.find(d => d.key === 'manufacturing_details');
        if (pd) prodDate = pd.value;
        if (mfg) mfgDetails = mfg.value;
      }

      document.getElementById('batchInfo').innerHTML = `
        <div><strong>Batch ID:</strong> ${batch.batch_id}</div>
        <div><strong>Style:</strong> <button onclick="loadStyle('${batch.style_number}')" class="text-blue-600 hover:underline cursor-pointer">${batch.style_number}</button></div>
        <div><strong>Total Units:</strong> ${batch.total_units || '-'}</div>
        <div><strong>Production Date:</strong> ${prodDate}</div>
        <div><strong>Manufacturing Details:</strong> ${mfgDetails.replace(/\n/g, '<br>')}</div>
        <button onclick="toggleEdit('batch-metadata')" class="mt-4 bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
          ✏️ Edit Batch Details
        </button>
      `;

      // Add/update batch edit form (remove old if exists)
      let batchEditDiv = document.getElementById('batchMetadataEdit');
      if (batchEditDiv) batchEditDiv.remove();

      batchEditDiv = document.createElement('div');
      batchEditDiv.id = 'batchMetadataEdit';
      batchEditDiv.className = 'hidden mt-4 space-y-4 bg-gray-50 p-4 rounded';
      batchEditDiv.innerHTML = `
        <div>
          <label class="block text-sm font-bold text-gray-700 mb-1">Production Date</label>
          <input type="date" id="editBatchProductionDate" class="w-full border border-gray-300 rounded px-3 py-2">
        </div>
        <div>
          <label class="block text-sm font-bold text-gray-700 mb-1">Manufacturing Details</label>
          <textarea id="editBatchManufacturing" rows="3" class="w-full border border-gray-300 rounded px-3 py-2"></textarea>
        </div>
        <button onclick="saveBatchMetadata('${batch.batch_id}')" class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700">
          ✓ Save
        </button>
      `;
      document.getElementById('batchInfo').parentElement.appendChild(batchEditDiv);

      // Pre-fill batch edit form
      if (data.batch_data && data.batch_data.length > 0) {
        const pd = data.batch_data.find(d => d.key === 'production_date');
        const mfg = data.batch_data.find(d => d.key === 'manufacturing_details');
        if (pd) document.getElementById('editBatchProductionDate').value = pd.value;
        if (mfg) document.getElementById('editBatchManufacturing').value = mfg.value;
      }

      // Show serials in table with pagination
      showSerialsTable(data.serials, data.serial_data || []);
    }

    async function loadBatchImages(batchId) {
      try {
        const res = await fetch(`/api/batches/${batchId}/images`);
        const images = await res.json();
        const container = document.getElementById('batchImages');
        container.innerHTML = images.map(img => `
          <div class="relative">
            <img src="data:image/jpeg;base64,${img.image_data}" class="h-24 w-24 object-cover rounded" alt="${img.image_name}">
            <button onclick="deleteBatchImage(${img.id})" class="absolute top-0 right-0 bg-red-600 text-white text-xs px-2 py-1 rounded">✕</button>
          </div>
        `).join('');
      } catch (err) {
        console.log('No images found');
      }
    }

    async function loadSerial(serialNumber) {
      document.getElementById('styleSection').classList.add('hidden');
      document.getElementById('batchSection').classList.add('hidden');
      document.getElementById('serialSection').classList.remove('hidden');

      const res = await fetch(`/api/serials/${serialNumber}/full-data`);
      const data = await res.json();
      currentData.serial = data;

      document.getElementById('serialTitle').textContent = serialNumber;

      const serial = data.serial;
      document.getElementById('serialInfo').innerHTML = `
        <div><strong>Serial:</strong> ${serial.serial_number}</div>
        <div><strong>SGTIN:</strong> ${serial.sgtin_numeric || '-'}</div>
        <div><strong>RFID:</strong> ${serial.rfid || '-'}</div>
      `;

      if (data.batch) {
        document.getElementById('serialBatchInfo').innerHTML = `
          <div><strong>Batch:</strong> ${data.batch.batch_id}</div>
          <div><strong>Units:</strong> ${data.batch.total_units || '-'}</div>
        `;
      }

      if (data.style) {
        document.getElementById('serialStyleInfo').innerHTML = `
          <div><strong>Style:</strong> ${data.style.style_number}</div>
          <div><strong>Name:</strong> ${data.style.product_name || '-'}</div>
        `;
      }

      // Serial metadata
      const metadata = {};
      data.serial_data.forEach(d => {
        metadata[d.key] = d.value;
      });

      document.getElementById('serialMetadataView').innerHTML = `
        <div><strong>Public URL:</strong> <span class="font-mono text-xs break-all">${serial.sgtin_uri || `${window.location.origin}/p/${serial.serial_number}`}</span></div>
        <div><strong>Size:</strong> ${metadata.size || '-'}</div>
        <div><strong>Condition:</strong> ${metadata.condition || '-'}</div>
        <div><strong>Location:</strong> ${metadata.location || '-'}</div>
        <div><strong>Owner:</strong> ${metadata.owner_id || '-'}</div>
        <div><strong>Notes:</strong> ${metadata.notes || '-'}</div>
      `;

      // Pre-fill edit form - SGTIN/RFID
      document.getElementById('serialSGTINNumeric').value = serial.sgtin_numeric || '';
      // Auto-generate Public URL if not set
      document.getElementById('serialSGTINUri').value = serial.sgtin_uri || `${window.location.origin}/p/${serial.serial_number}`;
      document.getElementById('serialRFID').value = serial.rfid || '';

      // Pre-fill edit form - Metadata
      document.getElementById('serialSize').value = metadata.size || '';
      document.getElementById('serialCondition').value = metadata.condition || '';
      document.getElementById('serialLocation').value = metadata.location || '';
      document.getElementById('serialOwner').value = metadata.owner_id || '';
      document.getElementById('serialNotes').value = metadata.notes || '';

      // Events
      document.getElementById('eventsTimeline').innerHTML = data.events.map(e => `
        <div class="bg-gray-50 p-4 rounded border-l-4 border-blue-600">
          <strong>${e.event_type.toUpperCase()}</strong>
          <div class="text-sm text-gray-600">${new Date(e.created_at).toLocaleDateString('sv-SE')}</div>
          ${e.event_data ? `<pre class="text-xs mt-2 bg-white p-2 rounded">${JSON.stringify(JSON.parse(e.event_data), null, 2)}</pre>` : ''}
        </div>
      `).join('');
    }

    function toggleEdit(section) {
      // Convert kebab-case to camelCase
      const camelCase = section.replace(/-([a-z])/g, (g) => g[1].toUpperCase());
      const viewId = `${camelCase}View`;
      const editId = `${camelCase}Edit`;
      const viewEl = document.getElementById(viewId);
      const editEl = document.getElementById(editId);

      if (viewEl) viewEl.classList.toggle('hidden');
      if (editEl) editEl.classList.toggle('hidden');
    }

    async function saveProductInfo() {
      const styleNumber = currentData.style.style.style_number;
      const res = await fetch(`/api/styles/${styleNumber}/product-info`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          product_name: document.getElementById('productName').value,
          description: document.getElementById('productDescription').value,
          care_instructions: document.getElementById('productCare').value,
          delivery_returns: document.getElementById('productDelivery').value,
          size_material_composition: document.getElementById('productMaterial').value
        })
      });
      const result = await res.json();
      if (res.ok) {
        showToast('Saved!');
        toggleEdit('product-info');
        await loadStyle(styleNumber);
      } else {
        showToast('Error: ' + result.error);
      }
    }

    async function saveTransparency() {
      try {
        const styleNumber = currentData.style.style.style_number;
        const res = await fetch(`/api/styles/${styleNumber}/transparency`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            suppliers_chain: JSON.parse(document.getElementById('transparencySuppliers').value || '{}'),
            certifications: JSON.parse(document.getElementById('transparencyCerts').value || '{}'),
            environmental_data: JSON.parse(document.getElementById('transparencyEnv').value || '{}'),
            social_data: JSON.parse(document.getElementById('transparencySocial').value || '{}')
          })
        });
        const result = await res.json();
        if (res.ok) {
          showToast('Saved!');
          toggleEdit('transparency');
          await loadStyle(styleNumber);
        } else {
          showToast('Error: ' + result.error);
        }
      } catch (err) {
        showToast('Invalid JSON: ' + err.message);
      }
    }

    async function saveNudieValues() {
      const styleNumber = currentData.style.style.style_number;
      const res = await fetch(`/api/styles/${styleNumber}/nudie-values`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          repair_info: document.getElementById('nudieRepair').value
        })
      });
      const result = await res.json();
      if (res.ok) {
        showToast('Saved!');
        toggleEdit('nudie-values');
        await loadStyle(styleNumber);
      } else {
        showToast('Error: ' + result.error);
      }
    }

    async function saveStorytelling() {
      try {
        const styleNumber = currentData.style.style.style_number;
        const res = await fetch(`/api/styles/${styleNumber}/storytelling`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            summary: document.getElementById('storytellinSummary').value,
            content: document.getElementById('storytellingContent').value,
            links: JSON.parse(document.getElementById('storytellingLinks').value || '[]')
          })
        });
        const result = await res.json();
        if (res.ok) {
          showToast('Saved!');
          toggleEdit('storytelling');
          await loadStyle(styleNumber);
        } else {
          showToast('Error: ' + result.error);
        }
      } catch (err) {
        showToast('Invalid JSON: ' + err.message);
      }
    }

    async function saveBatchMetadata(batchId) {
      const productionDate = document.getElementById('editBatchProductionDate').value;
      const manufacturingDetails = document.getElementById('editBatchManufacturing').value;

      const res = await fetch('/api/batch/metadata', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          batch_id: batchId,
          production_date: productionDate,
          manufacturing_details: manufacturingDetails
        })
      });

      if (res.ok) {
        showToast('Batch details saved!');
        toggleEdit('batch-metadata');
        await loadBatch(batchId);
      } else {
        showToast('Error saving batch details');
      }
    }

    async function saveSerialMetadata() {
      const serialNumber = currentData.serial.serial.serial_number;
      const fields = [
        { key: 'size', value: document.getElementById('serialSize').value },
        { key: 'condition', value: document.getElementById('serialCondition').value },
        { key: 'location', value: document.getElementById('serialLocation').value },
        { key: 'owner_id', value: document.getElementById('serialOwner').value },
        { key: 'notes', value: document.getElementById('serialNotes').value },
        { key: 'sgtin_uri', value: document.getElementById('serialSGTINUri').value }
      ].filter(f => f.value);

      for (const field of fields) {
        await fetch(`/api/serials/${serialNumber}/data`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            key: field.key,
            value: field.value,
            added_by: 'admin-edit'
          })
        });
      }
      showToast('Saved!');
      toggleEdit('serial-metadata');
      await loadSerial(serialNumber);
    }

    async function addEvent() {
      const serialNumber = currentData.serial.serial.serial_number;
      const eventType = document.getElementById('eventType').value;
      const eventData = document.getElementById('eventData').value;

      if (!eventType) {
        showToast('Please select event type');
        return;
      }

      const res = await fetch(`/api/serials/${serialNumber}/event`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          event_type: eventType,
          event_data: eventData ? JSON.parse(eventData) : {}
        })
      });

      const result = await res.json();
      if (res.ok) {
        showToast('Event added!');
        document.getElementById('eventType').value = '';
        document.getElementById('eventData').value = '';
        await loadSerial(serialNumber);
      } else {
        showToast('Error: ' + result.error);
      }
    }

    async function uploadStyleImage() {
      const file = document.getElementById('styleImageUpload').files[0];
      if (!file) return;

      const styleNumber = currentData.style.style.style_number;
      const reader = new FileReader();
      reader.onload = async (e) => {
        const base64 = e.target.result.split(',')[1];
        const res = await fetch(`/api/styles/${styleNumber}/image`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            image_data: base64,
            image_name: file.name
          })
        });
        const result = await res.json();
        showToast(res.ok ? 'Image uploaded!' : 'Error');
        if (res.ok) {
          document.getElementById('styleImageUpload').value = '';
          await loadStyleImages(styleNumber);
        }
      };
      reader.readAsDataURL(file);
    }

    async function uploadBatchImage() {
      const file = document.getElementById('batchImageUpload').files[0];
      if (!file) return;

      const batchId = currentData.batch.batch.batch_id;
      const reader = new FileReader();
      reader.onload = async (e) => {
        const base64 = e.target.result.split(',')[1];
        const res = await fetch(`/api/batches/${batchId}/image`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            image_data: base64,
            image_name: file.name
          })
        });
        const result = await res.json();
        showToast(res.ok ? 'Image uploaded!' : 'Error');
        if (res.ok) {
          document.getElementById('batchImageUpload').value = '';
          await loadBatchImages(batchId);
        }
      };
      reader.readAsDataURL(file);
    }

    async function deleteStyleImage(id) {
      if (confirm('Delete image?')) {
        await fetch(`/api/styles/image/${id}`, { method: 'DELETE' });
        const styleNumber = currentData.style.style.style_number;
        await loadStyleImages(styleNumber);
      }
    }

    async function deleteBatchImage(id) {
      if (confirm('Delete image?')) {
        await fetch(`/api/batches/image/${id}`, { method: 'DELETE' });
        const batchId = currentData.batch.batch.batch_id;
        await loadBatchImages(batchId);
      }
    }
  </script>
</body>
