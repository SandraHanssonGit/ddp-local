    let allProducts = [];

    async function loadAllProducts() {
      try {
        // Hide product details and search results
        document.getElementById('resultContainer-product').classList.add('hidden');
        document.getElementById('resultsListContainer-product').classList.add('hidden');
        // Show product list and search
        document.getElementById('searchSection-product').classList.remove('hidden');
        document.getElementById('productsListContainer-product').classList.remove('hidden');

        const res = await authFetch('/api/styles');
        allProducts = await res.json();
        if (!Array.isArray(allProducts)) allProducts = [];
        renderProductsList(allProducts);
      } catch (err) {
        console.error('Error loading products:', err);
        document.getElementById('productsList-product').innerHTML = '<div class="col-span-full text-center text-red-500 py-8">Error loading products</div>';
      }
    }

    function filterProducts(searchQuery) {
      if (!searchQuery.trim()) {
        renderProductsList(allProducts);
        return;
      }

      const q = searchQuery.toLowerCase().trim();
      const filtered = allProducts.filter(p => {
        const style = (p.style_number || '').toLowerCase();
        const variant = (p.variant || '').toLowerCase();
        const name = (p.product_name || '').toLowerCase();
        const combined = variant ? `${style}-${variant}` : style;

        return style.includes(q) || variant.includes(q) || combined.includes(q) || name.includes(q);
      });

      if (filtered.length === 0) {
        renderNoResultsFound(searchQuery);
      } else {
        renderProductsList(filtered);
      }
    }

    function renderProductsList(products) {
      const container = document.getElementById('productsList-product');
      if (products.length === 0) {
        container.innerHTML = '<div class="text-center text-gray-500 py-8">No products found</div>';
        return;
      }

      const sorted = [...products].sort((a, b) => {
        const aDisplay = (a.variant ? `${a.style_number}-${a.variant}` : a.style_number);
        const bDisplay = (b.variant ? `${b.style_number}-${b.variant}` : b.style_number);
        return aDisplay.localeCompare(bDisplay);
      });

      container.innerHTML = sorted.map(p => {
        const display = p.variant ? `${p.style_number}-${p.variant}` : p.style_number;
        const type = (p.product_type && (p.product_type.toLowerCase() === 'tops' || p.product_type.toLowerCase() === 'tops')) ? 'Tops' : 'Jeans';
        const name = p.product_name ? `<div class="text-xs text-gray-600 truncate">${p.product_name}</div>` : '';

        return `
          <button onclick="loadStyle('${p.style_number}'${p.variant ? `, '${p.variant}'` : ''})"
                  class="w-full text-left p-3 bg-gray-50 hover:bg-blue-50 border border-gray-200 rounded transition cursor-pointer">
            <div class="font-semibold text-gray-900 text-sm">${display}</div>
            ${name}
            <div class="text-xs text-gray-500 mt-1">${type}</div>
          </button>
        `;
      }).join('');
    }

    function renderNoResultsFound(searchQuery) {
      const container = document.getElementById('productsList-product');
      const q = searchQuery.trim();
      const isStyleNum = /^\d+$/.test(q);
      const isStyleVariant = /^\d+-[A-Z0-9-]+$/.test(q);

      let html = `<div class="col-span-full bg-white rounded-lg shadow-md p-8">`;
      html += `<div class="text-center">`;
      html += `<p class="text-gray-900 font-semibold mb-4">No product found for "${q}"</p>`;

      if (isStyleVariant) {
        const [styleNum, variant] = q.split('-');
        html += `<button onclick="createNewProductForm('${styleNum}', '${variant}')" class="bg-gray-900 text-white px-6 py-2 rounded hover:bg-gray-800 font-semibold">`;
        html += `Add new product</button>`;
      } else if (isStyleNum) {
        html += `<button onclick="createNewProductForm('${q}', null)" class="bg-gray-900 text-white px-6 py-2 rounded hover:bg-gray-800 font-semibold">`;
        html += `Add new product</button>`;
      } else {
        html += `<p class="text-sm text-gray-600 mb-3">Try searching by:</p>`;
        html += `<div class="text-xs text-gray-500">• Style number (e.g., 114539)</div>`;
        html += `<div class="text-xs text-gray-500">• Style-Variant (e.g., 114539-B20)</div>`;
      }

      html += `</div></div>`;
      container.innerHTML = html;
    }

