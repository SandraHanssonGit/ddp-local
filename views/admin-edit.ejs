    async function loadSerial(serialNumber) {
      // Clear old data before loading new serial
      const elementIds = ['serialInfo', 'serialBatchInfo', 'serialStyleInfo', 'serialMetadataView', 'serialMetadataEdit', 'eventsTimeline'];
      elementIds.forEach(id => {
        const el = document.getElementById(getElementId(id));
        if (el) el.innerHTML = '';
      });

      document.getElementById(getElementId('styleSection')).classList.add('hidden');
      document.getElementById(getElementId('batchSection')).classList.add('hidden');
      document.getElementById(getElementId('serialSection')).classList.remove('hidden');

      const res = await authFetch(`/api/serials/${serialNumber}/full-data`);
      const data = await res.json();
      currentData.serial = data;

      document.getElementById(getElementId('serialTitle')).textContent = serialNumber;

      const serial = data.serial;
      document.getElementById(getElementId('serialInfo')).innerHTML = `
        <div><strong>Serial:</strong> ${serial.serial_number}</div>
        <div><strong>SGTIN:</strong> ${serial.sgtin_numeric || '-'}</div>
        <div><strong>RFID:</strong> ${serial.rfid || '-'}</div>
        <div class="pt-2 border-t border-gray-300">
          <div><strong>Views:</strong> <span class="text-blue-600 font-bold text-lg">${serial.view_count || 0}</span></div>
        </div>
      `;

      if (data.batch) {
        document.getElementById(getElementId('serialBatchInfo')).innerHTML = `
          <div><strong>Batch:</strong> ${data.batch.batch_id}</div>
          <div><strong>Units:</strong> ${data.batch.total_units || '-'}</div>
        `;
      }

      if (data.style) {
        document.getElementById(getElementId('serialStyleInfo')).innerHTML = `
          <div><strong>Style:</strong> ${data.style.style_number}</div>
          <div><strong>Name:</strong> ${data.style.product_name || '-'}</div>
        `;
      }

      // Serial metadata
      const metadata = {};
      data.serial_data.forEach(d => {
        metadata[d.key] = d.value;
      });

      // Build public URL using new format: /p/STYLE/BATCH/SERIAL
      const publicUrl = serial.sgtin_uri || `${window.location.origin}/p/${data.style?.style_number || ''}/${data.batch?.batch_id || ''}/${serial.serial_number}`;

      // Calculate Condition based on latest event
      let conditionDisplay = metadata.condition || '';
      if (data.events && data.events.length > 0) {
        const sortedEvents = [...data.events].sort((a, b) => {
          const dateA = new Date(a.created_at);
          const dateB = new Date(b.created_at);
          return dateB - dateA;
        });
        const latestEvent = sortedEvents[0];
        const eventConditionMap = {
          'repair': 'repaired',
          'reuse': 'reused',
          'recycling': 'recycled',
          'service': 'new',
          'scanned': 'new'
        };
        const mappedCondition = eventConditionMap[latestEvent.event_type.toLowerCase()];
        if (mappedCondition) {
          conditionDisplay = mappedCondition;
        }
      }

      document.getElementById(getElementId('serialMetadataView')).innerHTML = `
        <div><strong>Public URL:</strong> <span class="font-mono text-xs break-all">${publicUrl}</span></div>
        <div><strong>Size:</strong> ${metadata.size || '-'}</div>
        <div><strong>Condition:</strong> ${conditionDisplay}</div>
        <div><strong>Location:</strong> ${metadata.location || '-'}</div>
        <div><strong>Owner:</strong> ${metadata.owner_id || '-'}</div>
        <div><strong>Notes:</strong> ${metadata.notes || '-'}</div>
      `;

      // Pre-fill edit form - SGTIN/RFID
      const serialSGTINNumeric = document.getElementById(getElementId('serialSGTINNumeric'));
      if (serialSGTINNumeric) serialSGTINNumeric.value = serial.sgtin_numeric || '';

      const serialSGTINUri = document.getElementById(getElementId('serialSGTINUri'));
      if (serialSGTINUri) serialSGTINUri.value = serial.sgtin_uri || publicUrl;

      const serialRFID = document.getElementById(getElementId('serialRFID'));
      if (serialRFID) serialRFID.value = serial.rfid || '';

      // Pre-fill edit form - Metadata
      const serialSize = document.getElementById(getElementId('serialSize'));
      if (serialSize) serialSize.value = metadata.size || '';

      const serialCondition = document.getElementById(getElementId('serialCondition'));
      if (serialCondition) {
        // Auto-set condition based on latest event
        let conditionValue = metadata.condition || '';
        if (data.events && data.events.length > 0) {
          // Find the latest event (most recent date)
          const sortedEvents = [...data.events].sort((a, b) => {
            const dateA = new Date(a.created_at);
            const dateB = new Date(b.created_at);
            return dateB - dateA; // Descending order (newest first)
          });
          const latestEvent = sortedEvents[0];

          const eventConditionMap = {
            'repair': 'repaired',
            'reuse': 'reused',
            'recycling': 'recycled',
            'service': 'new',
            'scanned': 'new'
          };
          const mappedCondition = eventConditionMap[latestEvent.event_type.toLowerCase()];
          if (mappedCondition) {
            conditionValue = mappedCondition;
          }
        }
        serialCondition.value = conditionValue;
      }

      const serialLocation = document.getElementById(getElementId('serialLocation'));
      if (serialLocation) serialLocation.value = metadata.location || '';

      const serialOwner = document.getElementById(getElementId('serialOwner'));
      if (serialOwner) serialOwner.value = metadata.owner_id || '';

      const serialNotes = document.getElementById(getElementId('serialNotes'));
      if (serialNotes) serialNotes.value = metadata.notes || '';

      // Events
      console.log('Loading events:', data.events);
      const eventsHTML = data.events.map(e => {
        try {
          const eventDataJson = e.event_data && typeof e.event_data === 'string' ? JSON.parse(e.event_data) : e.event_data;
          return `
            <div class="bg-gray-50 rounded-lg p-6 border-l-4 border-blue-600">
              <div class="flex justify-between items-start gap-4">
                <div class="flex-1">
                  <strong>${e.event_type.toUpperCase()}</strong>
                  <div class="text-sm text-gray-600">${new Date(e.created_at).toLocaleDateString('sv-SE')}</div>
                  ${eventDataJson && Object.keys(eventDataJson).length > 0 ? `<pre class="text-xs mt-2 bg-white p-2 rounded overflow-auto">${JSON.stringify(eventDataJson, null, 2)}</pre>` : '<div class="text-xs text-gray-500 mt-2">(no data)</div>'}
                </div>
                <div class="flex gap-2 whitespace-nowrap">
                  <button class="deleteEventBtn text-gray-900 hover:text-gray-700 text-sm font-semibold" data-event-id="${e.id}">
                    Delete
                  </button>
                </div>
              </div>
            </div>
          `;
        } catch (err) {
          console.error('Error rendering event:', e, err);
          return `
            <div class="bg-gray-50 rounded-lg p-6 border-l-4 border-blue-600">
              <div class="flex justify-between items-start gap-4">
                <div>
                  <strong>${e.event_type.toUpperCase()}</strong>
                  <div class="text-sm text-gray-600">${new Date(e.created_at).toLocaleDateString('sv-SE')}</div>
                </div>
                <button class="deleteEventBtn text-red-600 hover:text-red-800 text-sm font-semibold" data-event-id="${e.id}">
                  Delete
                </button>
              </div>
            </div>
          `;
        }
      }).join('');

      document.getElementById(getElementId('eventsTimeline')).innerHTML = eventsHTML || '<div class="text-gray-500 text-sm">No events yet</div>';
      attachEventListeners();
    }

