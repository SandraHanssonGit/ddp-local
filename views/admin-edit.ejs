                  <td class="px-3 py-2 text-blue-600 font-medium">${s.serial_number}</td>
                  <td class="px-3 py-2">${s.condition || '-'}</td>
                  <td class="px-3 py-2">${s.size || '-'}</td>
                  <td class="px-3 py-2">-</td>
                </tr>
              `).join('')}
            </tbody>
          </table>
