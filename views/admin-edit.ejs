    async function loadBatch(batchId) {
      // Clear old data before loading new batch
      const elementIds = ['batchInfo', 'batchImages', 'eventsTimeline'];
      elementIds.forEach(id => {
        const el = document.getElementById(getElementId(id));
        if (el) el.innerHTML = '';
      });

      document.getElementById(getElementId('styleSection')).classList.add('hidden');
      document.getElementById(getElementId('batchSection')).classList.remove('hidden');
      document.getElementById(getElementId('serialSection')).classList.add('hidden');

      const res = await authFetch(`/api/batches/${batchId}/full-data`);
      const data = await res.json();
      currentData.batch = data;

      document.getElementById(getElementId('batchTitle')).textContent = batchId;

      const batch = data.batch;

      // Get batch metadata if available
      let prodDate = '-';
      let mfgDetails = '-';
      if (data.batch_data && data.batch_data.length > 0) {
        const pd = data.batch_data.find(d => d.key === 'production_date');
        const mfg = data.batch_data.find(d => d.key === 'manufacturing_details');
        if (pd) prodDate = pd.value;
        if (mfg) mfgDetails = mfg.value;
      }

      // Group serials by style+variant
      const serialsByStyle = {};
      data.serials.forEach(s => {
        const key = `${s.style_number}${s.variant ? '-' + s.variant : ''}`;
        if (!serialsByStyle[key]) {
          serialsByStyle[key] = { style_number: s.style_number, variant: s.variant, serials: [] };
        }
        serialsByStyle[key].serials.push(s);
      });

      // Merge composition data from batch_style_data (for ALL styles, not just ones without serials)
      if (data.batch_style_data && data.batch_style_data.length > 0) {
        data.batch_style_data.forEach(bsd => {
          const key = `${bsd.style_number}${bsd.variant ? '-' + bsd.variant : ''}`;
          if (!serialsByStyle[key]) {
            // Style exists in batch_style_data but has no serials yet
            serialsByStyle[key] = {
              style_number: bsd.style_number,
              variant: bsd.variant,
              serials: [],
              composition: bsd.composition
            };
          } else {
            // Always merge composition from batch_style_data if it exists
            if (bsd.composition) {
              serialsByStyle[key].composition = bsd.composition;
            }
          }
        });
      }

      const stylesList = Object.values(serialsByStyle).map(item => {
        const styleKey = `${item.style_number}${item.variant ? '-' + item.variant : ''}`;
