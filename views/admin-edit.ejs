      resultDiv.innerHTML = `<p>${res.ok ? '✓ Style created! Now add transparency/nudie/storytelling data.' : 'âœ— Error: ' + result.error}</p>`;
      resultDiv.classList.remove('hidden');
      if (res.ok) document.getElementById('newStyleForm').reset();
