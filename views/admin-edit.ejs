    async function saveProductInfo() {
      const styleNumber = currentData.style?.style?.style_number || document.getElementById('styleNumber')?.dataset?.styleNumber;
      const isNewStyle = !currentData.style?.style?.style_number;
      const selectedProductType = (document.getElementById('productType')?.value || '').trim().toLowerCase();
      const variantInput = document.getElementById('productVariant');
      const variantValue = (variantInput?.value || '').trim();

      if (!styleNumber) {
        showToast('❌ Style number not set');
        return;
      }

      if (!selectedProductType) {
        showToast('❌ Please select Jeans or Topp');
        return;
      }

      // Strict validation: Topp MUST have variant
      if (selectedProductType === 'topp') {
        if (!variantValue || variantValue === 'null' || variantValue === 'undefined') {
          showToast('❌ Variant is REQUIRED for Topp (e.g., B20, C01)');
          variantInput?.focus();
          return;
        }
        if (!/^[A-Za-z0-9-]+$/.test(variantValue)) {
          showToast('❌ Variant: only letters, numbers, dashes allowed');
          return;
        }
      }

      // Strict validation: Jeans must NOT have variant
      if (selectedProductType === 'jeans' && variantValue) {
        showToast('❌ Jeans cannot have variants (should be empty)');
        variantInput.value = '';
        return;
      }

      // Check if this variant already exists (for ALL topps, not just new ones)
      if (selectedProductType === 'topp' && variantValue) {
        const searchQuery = `${styleNumber}-${variantValue.toUpperCase()}`;
        const searchRes = await authFetch(`/api/search?q=${encodeURIComponent(searchQuery)}`);
        const searchData = await searchRes.json();

        // Check if exact variant exists
        const existingVariant = searchData.results?.find(r =>
          r.result_type === 'style' &&
          r.style_number === styleNumber &&
          (r.variant || '').toUpperCase() === variantValue.toUpperCase()
        );

        if (existingVariant) {
          if (isNewStyle) {
            // For new styles, open the existing one in edit mode
            showToast('✏️ This variant already exists - opening in edit mode');
            await loadStyle(styleNumber);
            setTimeout(() => {
              document.querySelector('[id="productInfoView"]')?.scrollIntoView({ behavior: 'smooth' });
            }, 300);
            return;
          } else if (currentData.style?.style?.variant !== variantValue.toUpperCase()) {
            // For existing styles, prevent overwriting another variant
            showToast('❌ This variant already exists! Cannot overwrite it.');
            return;
          }
        }
      }

      const res = await authFetch(`/api/styles/${styleNumber}/product-info`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          product_type: selectedProductType,
          variant: selectedProductType === 'topp' ? variantValue.toUpperCase() : null,
          product_name: document.getElementById('productName').value,
          description: document.getElementById('productDescription').value,
          care_instructions: document.getElementById('productCare').value,
          delivery_returns: document.getElementById('productDelivery').value,
          size_material_composition: document.getElementById('productMaterial').value
        })
      });
      const result = await res.json();
      if (res.ok) {
        showToast('✓ Style saved!');
        toggleEdit('product-info');

        // Load/reload style data
        if (isNewStyle) {
          await loadStyle(styleNumber);
        } else {
          await loadStyle(styleNumber);
        }

        // Always refresh search results if search was active
        const searchQuery = document.getElementById('searchQuery')?.value?.trim();
        if (searchQuery) {
          handleSearch({ preventDefault: () => {} });
        }
      } else {
        showToast('Error: ' + result.error);
      }
    }

