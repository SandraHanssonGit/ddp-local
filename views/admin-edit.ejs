      document.getElementById(getElementId('styleSection')).classList.remove('hidden');
      document.getElementById(getElementId('batchSection')).classList.add('hidden');
      document.getElementById(getElementId('serialSection')).classList.add('hidden');

      // Only show variant in title if it's a real value (not null, undefined, or "null" string)
      const cleanVariant = (variant && variant !== 'null' && variant !== 'undefined') ? variant : null;
      const displayTitle = cleanVariant ? `${styleNumber}-${cleanVariant}` : styleNumber;

      // Set title directly for Product tab
      if (currentActiveTab === 'product') {
        document.getElementById('styleTitle-product').textContent = displayTitle;
      } else {
