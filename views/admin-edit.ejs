    function updateVariantRequirements() {
      const productType = document.getElementById('productType')?.value?.trim().toLowerCase() || '';
      const variantInput = document.getElementById('productVariant');
      const variantLabel = document.querySelector('#productInfoEdit label[for="productVariant"]');

      if (!variantInput) return;

      const isTopp = productType === 'topp';
      variantInput.required = isTopp;
      variantInput.placeholder = isTopp ? 'Required for topps (e.g. B20)' : 'Optional for jeans';

      if (variantLabel) {
        variantLabel.textContent = isTopp ? 'Variant (required for topps)' : 'Variant';
      }
    }

