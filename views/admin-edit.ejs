    async function proceedAddStyleToBatch(batchId) {
      try {
        const selectEl = document.getElementById('styleSelectForBatch');
        if (!selectEl) {
          console.error('Select element not found');
          showToast('Error: Select element not found');
          return;
        }
        const selected = selectEl.value;
        console.log('Selected value from select:', selected);
        console.log('Select element options:', selectEl.options.length);
        for (let i = 0; i < selectEl.options.length; i++) {
          console.log(`  Option ${i}: value="${selectEl.options[i].value}" text="${selectEl.options[i].text}"`);
        }

        if (!selected) {
          console.log('Selected is empty, showing error');
          showToast('âŒ Please select a style');
          return;
        }

        // Parse style_number and variant from selected value
        const parts = selected.split('|');
        const styleNumber = parts[0];
        const variant = parts[1] || null;
        console.log('Parsed style:', styleNumber, 'variant:', variant);

        // Check if style already exists in batch
        const batchRes = await authFetch(`/api/batches/${batchId}/full-data`);
        if (!batchRes.ok) {
          showToast('Error fetching batch data');
          return;
        }
        const batchData = await batchRes.json();
        console.log('Batch data:', batchData);

        const styleKey = `${styleNumber}${variant ? '-' + variant : ''}`;
        // Check in batch_style_data (styles at batch level)
        const styleExists = batchData.batch_style_data && batchData.batch_style_data.some(bsd => {
          const key = `${bsd.style_number}${bsd.variant ? '-' + bsd.variant : ''}`;
          return key === styleKey;
        });

        if (styleExists) {
          showToast('âŒ This style is already in the batch');
          // Close the style select modal
          if (styleSelectModalElement) {
            styleSelectModalElement.remove();
            styleSelectModalElement = null;
          }
          return;
        }

        // Close the style select modal
        if (styleSelectModalElement) {
          styleSelectModalElement.remove();
          styleSelectModalElement = null;
        }

        // Open batch details form for editing (first step)
        openBatchDetailsModal(batchId, styleNumber, variant);
      } catch (err) {
        console.error('Error in proceedAddStyleToBatch:', err);
        showToast('Error: ' + err.message);
      }
    }

