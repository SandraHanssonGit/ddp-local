      const resultDiv = document.getElementById('newBatchResult');
      resultDiv.className = res.ok ? 'mt-4 p-4 rounded bg-green-50 border border-green-200 text-green-900' : 'mt-4 p-4 rounded bg-red-50 border border-red-200 text-red-900';
      resultDiv.innerHTML = `<p>${res.ok ? '✓ Batch created with ' + result.serials_imported + ' serials!' : 'âœ— Error: ' + result.error}</p>`;
      resultDiv.classList.remove('hidden');
      if (res.ok) document.getElementById('newBatchForm').reset();
    });
