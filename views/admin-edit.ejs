      }
      document.getElementById(getElementId('fetchNudieBtn')).style.display = 'block';

      // Use product type chosen by user, or infer from variant if creating from variant search
      const finalProductType = productType || (variant ? 'tops' : 'jeans');
      const typeLabel = finalProductType === 'tops' ? 'Tops' : 'Jeans';
      document.getElementById(getElementId('productInfoView')).innerHTML = `<p class="text-gray-500">New ${typeLabel} - fill in details below</p>`;

      // Show edit form with all fields - set directly for Product tab
      if (currentActiveTab === 'product') {
