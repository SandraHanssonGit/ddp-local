            </select>
            <div class="flex gap-2 justify-end">
              <button type="button" class="px-4 py-2 text-gray-700 bg-gray-200 rounded hover:bg-gray-300" onclick="this.closest('.fixed').remove()">Cancel</button>
              <button type="button" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700" onclick="proceedAddStyleToBatch('${batchId}')">Continue</button>
            </div>
          </div>
        `;
        document.body.appendChild(modal);
        document.getElementById('styleSelectForBatch').focus();
      } catch (err) {
        showToast('Error: ' + err.message);
      }
    }

    async function proceedAddStyleToBatch(batchId) {
      const selectEl = document.getElementById('styleSelectForBatch');
      const selected = selectEl.value;

      if (!selected) {
        showToast('❌ Please select a style');
        return;
      }

      const [styleNumber, variant] = selected.split('|');
      document.querySelector('.fixed').remove();

      // Now show the add serials form for this style+batch combo
      showAddSerialsModal(batchId, styleNumber, variant || null);
    }

    // Delete Batch function
    async function deleteBatch(batchId) {
      if (!confirm(`Delete batch ${batchId}? (This will soft-delete it)`)) return;

      try {
        const res = await authFetch(`/api/batches/${batchId}/delete`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });

        const result = await res.json();
        if (res.ok) {
          showToast('Batch deleted!');
          const styleNumber = currentData.style.style.style_number;
          await loadStyle(styleNumber);
        } else {
          showToast('Error: ' + result.error);
        }
      } catch (err) {
        showToast('Error: ' + err.message);
      }
    }

    // Admin functions
    // Handle password update buttons after users are loaded
    function attachPasswordUpdateListeners() {
      document.querySelectorAll('.updatePassBtn').forEach(btn => {
        btn.removeEventListener('click', handlePasswordUpdate);
        btn.addEventListener('click', handlePasswordUpdate);
      });
    }

    function handlePasswordUpdate(e) {
      const btn = e.target;
      const username = btn.getAttribute('data-username');
      const userId = btn.getAttribute('data-user-id');
      const passField = document.getElementById(`newPass_${userId}`);
      const newPassword = passField ? passField.value : '';
      updateUserPassword(username, newPassword, userId);
    }

    async function loadAdminUsers() {
      try {
        const res = await authFetch('/api/admin/users');
        const users = await res.json();

        document.getElementById('usersList').innerHTML = users.map(u => `
          <div class="border border-gray-300 rounded-lg p-4">
            <div class="flex justify-between items-start mb-4">
              <div>
                <p class="font-semibold text-gray-900">${u.username}</p>
                <p class="text-xs text-gray-500">ID: ${u.id}</p>
              </div>
              <span class="text-sm font-semibold text-gray-700">${u.role}</span>
            </div>
            <div class="space-y-3">
              <div>
                <label class="block text-xs text-gray-500 uppercase tracking-wide font-semibold mb-1">Change Role</label>
                <select onchange="changeUserRole('${u.username}', this.value)" class="w-full text-sm border border-gray-300 rounded px-2 py-1">
                  <option value="viewer" ${u.role === 'viewer' ? 'selected' : ''}>Viewer</option>
                  <option value="editor" ${u.role === 'editor' ? 'selected' : ''}>Editor</option>
                  <option value="admin" ${u.role === 'admin' ? 'selected' : ''}>Admin</option>
                  <option value="super_admin" ${u.role === 'super_admin' ? 'selected' : ''}>Super Admin</option>
                </select>
              </div>
              <div>
                <label class="block text-xs text-gray-500 uppercase tracking-wide font-semibold mb-1">New Password</label>
                <div class="flex gap-2">
                  <input type="password" id="newPass_${u.id}" placeholder="Enter new password" class="flex-1 text-sm border border-gray-300 rounded px-2 py-1">
                  <button class="updatePassBtn bg-gray-900 text-white px-3 py-1 rounded text-sm hover:bg-gray-800" data-username="${u.username}" data-user-id="${u.id}">
                    Update
                  </button>
                </div>
              </div>
            </div>
          </div>
        `).join('');
        attachPasswordUpdateListeners();
      } catch (err) {
        console.error('Error loading users:', err);
      }
    }

    async function changeUserRole(username, newRole) {
      try {
        const res = await authFetch(`/api/admin/users/${username}/role`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ role: newRole })
        });

        if (res.ok) {
          showToast(`User ${username} role updated to ${newRole}`);
          loadAdminUsers();
        } else {
          showToast('Error updating role');
        }
      } catch (err) {
        showToast('Error: ' + err.message);
      }
    }

    async function createNewUser() {
      const username = document.getElementById('newUsername').value.trim();
      const password = document.getElementById('newPassword').value;
      const role = document.getElementById('newRole').value;

      if (!username || !password) {
        document.getElementById('createUserMessage').textContent = 'Username and password required';
        return;
      }

      try {
        const res = await authFetch('/api/admin/users', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password, role })
        });

        const result = await res.json();
        if (res.ok) {
          document.getElementById('createUserMessage').textContent = '✓ User created!';
          const usernameField = document.getElementById('newUsername');
          const passwordField = document.getElementById('newPassword');
          const roleField = document.getElementById('newRole');
          if (usernameField) usernameField.value = '';
          if (passwordField) passwordField.value = '';
          if (roleField) roleField.value = 'viewer';
          setTimeout(() => loadAdminUsers(), 500);
        } else {
          document.getElementById('createUserMessage').textContent = 'Error: ' + (result.error || 'Creation failed');
        }
      } catch (err) {
        document.getElementById('createUserMessage').textContent = 'Error: ' + err.message;
      }
    }

    async function updateUserPassword(username, newPassword, userId) {
      if (!newPassword) {
        showToast('Password cannot be empty');
        return;
      }

      try {
        const res = await authFetch(`/api/admin/users/${username}/password`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password: newPassword })
        });

        if (res.ok) {
          showToast(`✓ Password updated for ${username}`);
          const passField = document.getElementById(`newPass_${userId}`);
          if (passField) passField.value = '';
        } else {
          showToast('Error updating password');
        }
      } catch (err) {
        showToast('Error: ' + err.message);
      }
    }

    // Navigate from Dashboard to Lookup & Edit
    function goToLookup(type, target) {
      // Open Design tab and load the data directly
      if (type === 'style') {
        loadData('style', target, '', '');
      } else if (type === 'batch') {
        loadData('batch', '', target, '');
      } else if (type === 'serial') {
        loadData('serial', '', '', target);
      }
    }

    // Scanning functions
    async function loadStylesForScanning() {
      try {
        const res = await fetch('/api/styles');
        const styles = await res.json();
        const select = document.getElementById('scanStyle');

        select.innerHTML = '<option value="">-- Select Style --</option>';
        styles.forEach(style => {
          const option = document.createElement('option');
          option.value = JSON.stringify({ style_number: style.style_number, variant: style.variant });
          const label = style.variant ? `${style.style_number}-${style.variant}` : style.style_number;
          option.textContent = `${label} - ${style.product_name || 'Unnamed'}`;
          select.appendChild(option);
        });
      } catch (err) {
        showToast('Error loading styles: ' + err.message);
      }
    }

    async function performScan() {
      const styleSelect = document.getElementById('scanStyle');
      const batchInput = document.getElementById('scanBatch').value.trim();
      const serialInput = document.getElementById('scanSerial').value.trim();

      if (!styleSelect.value) {
        showToast('Please select a style');
        return;
      }
      if (!batchInput) {
        showToast('Please enter batch ID');
        return;
      }
      if (!serialInput) {
        showToast('Please enter serial number');
        return;
      }

      try {
        const styleData = JSON.parse(styleSelect.value);
        const res = await fetch('/api/scan', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            style_number: styleData.style_number,
            variant: styleData.variant || null,
            batch_id: batchInput,
            serial_number: serialInput
          })
        });

        const result = await res.json();
        if (!res.ok) {
          showToast('Error: ' + result.error);
          return;
        }

        // Show result
        document.getElementById('resultSerialInfo').innerHTML = `
          <div><strong>Serial:</strong> ${result.serial.serial_number}</div>
          <div><strong>Created:</strong> ${result.serial.created_at}</div>
        `;

        document.getElementById('resultBatchInfo').innerHTML = `
          <div><strong>Batch ID:</strong> ${result.batch.batch_id}</div>
          <div><strong>Partner:</strong> ${result.batch.partner_name || '-'}</div>
          <div><strong>Units:</strong> ${result.batch.total_units}</div>
        `;

        document.getElementById('resultStyleInfo').innerHTML = `
          <div><strong>Style:</strong> ${result.style.style_number}</div>
          ${result.style.variant ? `<div><strong>Variant:</strong> ${result.style.variant}</div>` : ''}
          <div><strong>Name:</strong> ${result.style.product_name || '-'}</div>
        `;

        if (result.created) {
          document.getElementById('createdBadge').classList.remove('hidden');
          document.getElementById('existsBadge').classList.add('hidden');
          showToast('✓ New serial created');
        } else {
          document.getElementById('createdBadge').classList.add('hidden');
          document.getElementById('existsBadge').classList.remove('hidden');
          showToast('✓ Serial already exists');
        }

        document.getElementById('scanResult').classList.remove('hidden');
        document.getElementById('scanSerial').value = '';
        document.getElementById('scanSerial').focus();
      } catch (err) {
        showToast('Error: ' + err.message);
      }
    }

    // Allow Enter key to submit scan
    document.getElementById('scanSerial')?.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') {
        performScan();
      }
    });

    // Run on load
    document.addEventListener('DOMContentLoaded', () => {});
  </script>
</body>
</html>
