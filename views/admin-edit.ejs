    async function loadBatchForDesignTab(batchId) {
      try {
        // Hide batch list, show batch details
        document.getElementById('batchesListContainer').classList.add('hidden');
        document.getElementById('batchDetailsContainer').classList.remove('hidden');

        // Load batch data
        const res = await authFetch(`/api/batches/${batchId}/full-data`);
        const data = await res.json();

        // Display batch info
        const titleEl = document.getElementById('batchDetailsTitle');
        titleEl.innerHTML = `
          <span>${batchId}</span>
          <button onclick="editBatch('${batchId}')" class="ml-4 text-sm bg-gray-900 text-white px-3 py-1 rounded hover:bg-gray-800">Edit</button>
        `;
        const batch = data.batch;
        document.getElementById('batchDetailsInfo').innerHTML = `
          <div><strong>Batch ID:</strong> ${batchId}</div>
          <div><strong>PO:</strong> ${batch.po || '-'}</div>
          <div><strong>Partner:</strong> ${batch.partner_name || '-'}</div>
          <div><strong>Status:</strong> ${batch.status || '-'}</div>
        `;

        // Group serials by product (style+variant)
        const productMap = {};
        data.serials.forEach(s => {
          const productKey = `${s.style_number}${s.variant ? '-' + s.variant : ''}`;
          if (!productMap[productKey]) {
            productMap[productKey] = {
              style_number: s.style_number,
              variant: s.variant || null,
              serials: []
            };
          }
          productMap[productKey].serials.push(s);
        });

        // Also add products from batch_style_data (even if no serials yet)
        if (data.batch_style_data) {
          data.batch_style_data.forEach(bsd => {
            const productKey = `${bsd.style_number}${bsd.variant ? '-' + bsd.variant : ''}`;
            if (!productMap[productKey]) {
              productMap[productKey] = {
                style_number: bsd.style_number,
                variant: bsd.variant || null,
                serials: []
              };
            }
          });
        }

        // Render products with expandable serials
        const products = Object.values(productMap);
        const productsHTML = products.map((product, idx) => {
          const displayName = product.variant ? `${product.style_number}-${product.variant}` : product.style_number;
          const productId = `product-${batchId}-${idx}`;
          return `
            <div class="border border-gray-200 rounded-lg overflow-hidden">
              <!-- Product Header (clickable to expand) -->
              <div class="flex items-center bg-gray-50 border-b">
                <button onclick="toggleProductSerials('${productId}')" class="flex-1 text-left p-4 hover:bg-blue-50 cursor-pointer">
                  <div class="font-semibold text-gray-900">${displayName}</div>
                  <div class="text-sm text-gray-600 mt-1">${product.serials.length} serials</div>
                </button>
                <button onclick="editProduct('${product.style_number}', '${product.variant || ''}')" class="px-4 py-2 text-sm bg-gray-900 text-white hover:bg-gray-800">Edit</button>
                <span class="px-4 text-gray-500">▼</span>
              </div>
              <!-- Serials List (expandable) -->
              <div id="${productId}" class="hidden border-t border-gray-200">
                <div class="p-4 bg-gray-50">
                  ${product.serials.length === 0
                    ? '<div class="text-gray-500">No serials</div>'
                    : `<div class="space-y-2">
                        ${product.serials.map(s => `
                          <button onclick="loadSerialDesignTab('${s.serial_number}')" class="w-full text-left p-2 bg-white rounded border border-gray-200 hover:border-blue-400 hover:bg-blue-50 text-sm cursor-pointer transition">
                            <div class="font-mono text-gray-900">${s.serial_number}</div>
                            <div class="text-gray-600 text-xs mt-1">Created: ${new Date(s.created_at).toLocaleDateString()}</div>
                          </button>
                        `).join('')}
                      </div>`
                  }
                </div>
              </div>
            </div>
          `;
        }).join('');

        document.getElementById('productsInBatchList').innerHTML = productsHTML || '<div class="text-gray-500">No products found</div>';
      } catch (err) {
        console.error('Error loading batch:', err);
        document.getElementById('productsInBatchList').innerHTML = '<div class="text-red-500">Error loading batch details</div>';
      }
    }

