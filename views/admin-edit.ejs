    // Event listeners for edit/delete buttons
    function attachEventListeners() {
      document.querySelectorAll('.editEventBtn').forEach(btn => {
        btn.removeEventListener('click', handleEditEvent);
        btn.addEventListener('click', handleEditEvent);
      });
      document.querySelectorAll('.deleteEventBtn').forEach(btn => {
