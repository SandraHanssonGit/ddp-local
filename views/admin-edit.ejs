    // Design Tab: Load all batches for display
    async function loadAllBatches() {
      try {
        // Show batch list, hide batch details
        document.getElementById('batchesListContainer').classList.remove('hidden');
        document.getElementById('batchDetailsContainer').classList.add('hidden');

        const res = await authFetch('/api/batches');
        const batches = await res.json();

