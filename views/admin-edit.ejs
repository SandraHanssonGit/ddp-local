            <label class="block text-sm font-bold text-gray-700 mb-1">Paste Data (Format: serial_number,sgtin_numeric,sgtin_uri,rfid)</label>
            <textarea id="importData" placeholder="114519-001-AA,301414170001200ABC,https://id.gs1.org/01/.../21/001AA,12AB34CD56EF" rows="8" class="w-full border border-gray-300 rounded px-3 py-2 font-mono text-sm" required></textarea>
            <p class="text-xs text-gray-500 mt-1">Each line: serial_number, sgtin_numeric, sgtin_uri, rfid (RFID can be empty)</p>
          </div>
          <button type="submit" class="bg-green-600 text-white px-6 py-3 rounded font-semibold hover:bg-green-700">
            ✓ Import Supplier Data
          </button>
          <div id="importSupplierResult" class="mt-4 hidden p-4 rounded"></div>
