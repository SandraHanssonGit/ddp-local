  <script>
    // Check if user is logged in
    const user = JSON.parse(localStorage.getItem('user') || '{}');
    if (!user.id) {
      window.location.href = '/login';
    }

    // Load logo from server + Setup event listeners when DOM is ready
    window.addEventListener('DOMContentLoaded', () => {
      const logoContainer = document.getElementById('headerLogoContainer');
      const img = new Image();
      img.onload = () => {
        logoContainer.innerHTML = `<img src="/nudie-logo.png" style="max-height: 60px; max-width: 200px;" alt="Nudie Jeans">`;
      };
      img.onerror = () => {
        logoContainer.innerHTML = `<span style="font-family: cursive; font-size: 18px; font-weight: 300; letter-spacing: 1px;">Nudie Jeans</span>`;
      };
      img.src = '/nudie-logo.png';

      // Setup search form after DOM is ready
      const searchForm = document.getElementById('searchForm');
      if (searchForm) {
        searchForm.addEventListener('submit', handleSearch);
      }

      // Setup search form for product tab (dynamic filtering)
      const searchFormProduct = document.getElementById('searchForm-product');
      const searchQueryProduct = document.getElementById('searchQuery-product');
      if (searchFormProduct && searchQueryProduct) {
        searchFormProduct.addEventListener('submit', (e) => {
          e.preventDefault();
          filterProducts(searchQueryProduct.value);
        });
        searchQueryProduct.addEventListener('input', (e) => {
          filterProducts(e.target.value);
        });
      }

      // Setup delegated click handler for onclick attributes
      // This handles inline onclick="functionName()" calls
      // Load dashboard on initial page load
      loadDashboard();
    });

    // Track the currently active tab
    let currentActiveTab = 'dashboard';

    // Helper function to get the correct element ID based on the active tab
    function getElementId(baseId) {
      if (currentActiveTab === 'product') {
        return baseId + '-product';
      }
      return baseId;
    }

    function escapeHtml(value) {
      return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    // Helper for create style button
    function createStyleFromSearch(styleNum, variant, isVariant) {
      const typeVal = document.getElementById('createStyleTypeSelect').value;
      if (!typeVal) {
        showToast('âŒ Please select Jeans or Tops');
        return;
      }
      const finalVariant = isVariant ? variant : null;
      showCreateStyleForm(styleNum, finalVariant, typeVal);
      document.getElementById(getElementId('searchQuery')).value = '';
    }

    // Search handler function
    async function handleSearch(e) {
      e.preventDefault();
      const q = document.getElementById(getElementId('searchQuery')).value.trim();
      const status = document.getElementById(getElementId('searchStatus'));

      if (!q) {
        status.textContent = 'Please enter a search term';
        document.getElementById(getElementId('resultsListContainer')).classList.add('hidden');
        document.getElementById(getElementId('recentBatchesContainer')).classList.remove('hidden');
        return;
      }

      status.textContent = 'Searching...';

      try {
        // Handle different search patterns
        const isNumeric = /^\d+$/.test(q);
        const isExactStyleNum = isNumeric && q.length >= 4;
        const isStyleVariant = /^\d+-[A-Z0-9-]+$/.test(q);
        const isPartialStyleNum = isNumeric && q.length >= 4;

        let res, result;

        if (isStyleVariant) {
          // Search for exact style-variant (e.g., "114519-B20")
          const [styleNum, variant] = q.split('-');
          res = await authFetch(`/api/search?q=${encodeURIComponent(styleNum)}`);
          result = await res.json();
          // Filter to only variants matching the query
          if (result.results) {
            result.results = result.results.filter(r =>
              r.result_type === 'style' && (r.variant || '').toUpperCase() === variant.toUpperCase()
            );
          }
        } else if (isPartialStyleNum) {
          // Search for styles that start with the numeric query, including exact style numbers like 123456
          res = await authFetch(`/api/search?q=${encodeURIComponent(q)}`);
          result = await res.json();
          // Filter to only styles matching the numeric query
          if (result.results) {
            result.results = result.results.filter(r =>
              r.result_type === 'style' && (
                r.style_number === q ||
                String(r.style_number || '').startsWith(q)
              )
            );
          }
        } else {
          // Normal search for anything
          res = await authFetch(`/api/search?q=${encodeURIComponent(q)}`);
          result = await res.json();
        }

        if (!result.results || result.results.length === 0) {
          // Offer to create new style (batch creation is on Style-sidan)
          let suggestions = '<div class="space-y-2 mt-2">';

          if (isStyleVariant) {
            const [styleNum, variant] = q.split('-');
            suggestions += `<button class="text-blue-600 hover:underline font-semibold cursor-pointer" onclick="createNewProductForm('${styleNum}', '${variant}')">Create new ${escapeHtml(q)}</button>`;
          } else if (isExactStyleNum || isPartialStyleNum) {
            suggestions += `<button class="text-blue-600 hover:underline font-semibold cursor-pointer" onclick="createNewProductForm('${q}', null)">Create new style ${escapeHtml(q)}</button>`;
          } else {
            suggestions += `<div class="text-gray-600">Try searching by:</div>`;
            suggestions += `<div class="text-sm text-gray-500">â€¢ Style number (e.g., 114519)</div>`;
            suggestions += `<div class="text-sm text-gray-500">â€¢ Batch ID (e.g., BATCH001)</div>`;
            suggestions += `<div class="text-sm text-gray-500">â€¢ Serial number</div>`;
          }

          suggestions += '</div>';
          status.innerHTML = `No results found for "${q}". ${suggestions}`;
          document.getElementById(getElementId('resultsListContainer')).classList.add('hidden');
          document.getElementById(getElementId('recentBatchesContainer')).classList.remove('hidden');
          document.getElementById(getElementId('resultContainer')).classList.add('hidden');
          return;
        }

        // Hide recent batches when showing search results
        document.getElementById(getElementId('recentBatchesContainer')).classList.add('hidden');

        // Sort by relevance
        const sorted = result.results.sort((a, b) => {
          const aMatch = a.result_type === 'style' ? a.style_number : a.result_type === 'batch' ? a.batch_id : a.serial_number;
          const bMatch = b.result_type === 'style' ? b.style_number : b.result_type === 'batch' ? b.batch_id : b.serial_number;
          const aRelevance = aMatch === q ? 0 : aMatch.startsWith(q) ? 1 : 2;
          const bRelevance = bMatch === q ? 0 : bMatch.startsWith(q) ? 1 : 2;
          if (aRelevance !== bRelevance) return aRelevance - bRelevance;
          const typeOrder = { 'style': 0, 'batch': 1, 'serial': 2 };
          return (typeOrder[a.result_type] || 3) - (typeOrder[b.result_type] || 3);
        });

        // Show results
        const resultsList = document.getElementById(getElementId('resultsList'));
        resultsList.innerHTML = sorted.map((r, idx) => {
          const displayName = r.result_type === 'style'
            ? `${r.style_number}${r.variant ? '-' + r.variant : ''} - ${r.product_name || 'No name'}`
            : r.result_type === 'batch'
            ? `Batch: ${r.batch_id}`
            : `Serial: ${r.serial_number} (Style: ${r.style_number})`;

          const variantParam = r.variant ? `, '${r.variant}'` : '';
          return `<button class="w-full text-left p-3 bg-gray-50 rounded hover:bg-blue-50 border border-gray-200 result-btn cursor-pointer" onclick="loadData('${r.result_type}', '${r.style_number || ''}', '${r.batch_id || ''}', '${r.serial_number || ''}'${variantParam})">
            <p class="font-semibold">${displayName}</p>
            <p class="text-xs text-gray-500">Type: ${r.result_type}</p>
          </button>`;
        }).join('');

        document.getElementById(getElementId('resultsListContainer')).classList.remove('hidden');

        // Show result count
        let statusMsg = `Found ${result.results.length} result(s)`;
        status.textContent = statusMsg;

        // Check if we can add new variants
        const styles = sorted.filter(r => r.result_type === 'style');
        if (styles.length > 0 && isPartialStyleNum && !isStyleVariant) {
          // We found styles for this style_number - check what type they are
          const hasTopp = styles.some(s => (s.product_type || '').toLowerCase() === 'tops');
          const hasJeans = styles.some(s => (s.product_type || '').toLowerCase() === 'jeans');

          if (hasTopp && !hasJeans) {
            // Only Tops exist - offer to add new variant
            status.innerHTML += `<div class="mt-3 text-sm"><button class="text-blue-600 hover:underline font-semibold" onclick="addNewTopVariant('${q}')">âž• Add new variant for ${escapeHtml(q)}</button></div>`;
          }
          // If only jeans exist - no action needed, just show the results
        }
      } catch (err) {
        status.textContent = `Error: ${err.message}`;
        console.error('Search error:', err);
      }
    }

    // Display user info
    document.getElementById('userDisplay').textContent = `${user.username} (${user.role})`;

    // Apply role-based CSS classes
    document.body.classList.add(user.role);

    // Check if user can edit
    function canEdit() {
      return ['editor', 'admin', 'super_admin'].includes(user.role);
    }

    function canDelete() {
      return ['admin', 'super_admin'].includes(user.role);
    }

    function isAdmin() {
      return ['admin', 'super_admin'].includes(user.role);
    }

    // Hide Admin tab for non-admins
    if (!isAdmin()) {
      const adminTabBtn = document.querySelector('.adminTabBtn');
      if (adminTabBtn) adminTabBtn.style.display = 'none';
    }

    function canPermanentDelete() {
      return user.role === 'super_admin';
    }

    // Logout function
    function logout() {
      localStorage.clear();
      window.location.href = '/login';
    }

    // Setup tab buttons
    document.getElementById('tabDashboard')?.addEventListener('click', () => switchTab('dashboard'));
    document.getElementById('tabScan')?.addEventListener('click', () => {
      switchTab('scan');
      loadStylesForScanning();
    });
    document.getElementById('tabProduct')?.addEventListener('click', () => {
      switchTab('product');
      loadAllProducts();
    });
    document.getElementById('tabEdit')?.addEventListener('click', () => {
      switchTab('edit');
      loadRecentBatches();
      loadRecentStyles();
    });
    const adminTabBtn = document.getElementById('tabAdmin');
    if (adminTabBtn) {
      adminTabBtn.addEventListener('click', () => {
        if (isAdmin()) {
          switchTab('admin');
        } else {
          showToast('Admin access denied');
        }
      });
    }


    // Setup add event button with delegation (button might be recreated)
    document.addEventListener('click', (e) => {
      if (e.target.id === 'addEventBtn') {
        addEvent();
      }
    });

    // Helper for authenticated fetch
    async function authFetch(url, options = {}) {
      const token = localStorage.getItem('token');
      if (!token) {
        console.error('No token found - redirecting to login');
        window.location.href = '/login';
        return;
      }
      return fetch(url, {
        ...options,
        headers: {
          ...options.headers,
          'Authorization': `Bearer ${token}`
        }
      });
    }

    const currentData = {};
    let styleSelectModalElement = null;

    function toggleStyleDetails(styleKeyId) {
      const el = document.getElementById(`serials-${styleKeyId}`);
      if (el) el.classList.toggle('hidden');
    }

    function toggleStyleEdit(styleKeyId) {
      console.log('toggleStyleEdit called with:', styleKeyId);
      const el = document.getElementById(`edit-${styleKeyId}`);
      console.log('Element found:', el);
      if (el) {
        el.classList.toggle('hidden');
        console.log('Toggled hidden class');
      } else {
        console.error(`Element edit-${styleKeyId} not found`);
      }
    }

    function toggleSerialMetadataEdit() {
      const editEl = document.getElementById(getElementId('serialMetadataEdit'));
      const viewEl = document.getElementById(getElementId('serialMetadataView'));
      if (editEl) {
        editEl.classList.toggle('hidden');
      }
      if (viewEl) {
        viewEl.classList.toggle('hidden');
      }
    }

    function toggleEdit(sectionId) {
      // Convert kebab-case to camelCase (e.g., 'product-info' -> 'productInfo')
      const camelId = sectionId.replace(/-([a-z])/g, (g) => g[1].toUpperCase());
      const viewId = camelId + 'View';
      const editId = camelId + 'Edit';
      const viewEl = document.getElementById(getElementId(viewId));
      const editEl = document.getElementById(getElementId(editId));

      if (viewEl) viewEl.classList.toggle('hidden');
      if (editEl) editEl.classList.toggle('hidden');
    }

    function filterSerialsList(styleKeyId, searchText) {
      const container = document.getElementById(`serials-${styleKeyId}`);
      if (!container) {
        console.warn(`Container not found: serials-${styleKeyId}`);
        return;
      }
      const rows = container.querySelectorAll('tbody tr');
      if (rows.length === 0) {
        console.warn(`No serial rows found in container`);
        return;
      }
      rows.forEach(row => {
        const serialNum = row.querySelector('td')?.textContent || '';
        const matches = serialNum.toLowerCase().includes(searchText.toLowerCase());
        row.style.display = matches ? '' : 'none';
      });
    }

    async function saveStyleCompositionInline(batchId, styleNumber, variant, styleKeyId) {
      try {
        console.log('saveStyleCompositionInline called:', {batchId, styleNumber, variant, styleKeyId});
        const composition = document.getElementById(`composition-${styleKeyId}`).value;
        console.log('Composition value:', composition);

        const res = await authFetch(`/api/batches/${batchId}/style-composition`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            style_number: styleNumber,
            variant: variant || null,
            composition: composition
          })
        });

        console.log('Response status:', res.status, 'ok:', res.ok);
        const resData = await res.json();
        console.log('Response data:', resData);

        if (res.ok) {
          showToast('✓ Composition saved!');
          await loadBatch(batchId);
          // Form is already filled with fresh data from loadBatch
        } else {
          showToast('Error saving composition: ' + (resData.error || 'Unknown error'));
        }
      } catch (err) {
        console.error('Error in saveStyleCompositionInline:', err);
        showToast('Error: ' + err.message);
      }
    }

