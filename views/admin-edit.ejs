    async function saveProductInfo() {
      try {
        const styleNumber = currentData.style?.style?.style_number || document.getElementById(getElementId('styleNumber'))?.dataset?.styleNumber;
        const isNewStyle = !currentData.style?.style?.style_number;
        const rawProductType = (document.getElementById(getElementId('productType'))?.value || '').trim().toLowerCase();
        const selectedProductType = rawProductType === 'tops' ? 'Tops' : 'Jeans';
        const variantInput = document.getElementById(getElementId('productVariant'));
        const variantValue = (variantInput?.value || '').trim();

        if (!styleNumber) {
          showToast('âŒ Style number not set');
          return;
        }

        if (!selectedProductType) {
          showToast('âŒ Please select Jeans or Tops');
          return;
        }

      // Strict validation: Tops MUST have variant
      if (selectedProductType === 'Tops') {
        if (!variantValue || variantValue === 'null' || variantValue === 'undefined') {
          showToast('âŒ Variant is REQUIRED for Tops (e.g., B20, C01)');
          variantInput?.focus();
          return;
        }
        if (!/^[A-Za-z0-9-]+$/.test(variantValue)) {
          showToast('âŒ Variant: only letters, numbers, dashes allowed');
          return;
        }
      }

      // Strict validation: Jeans must NOT have variant
      if (selectedProductType === 'Jeans' && variantValue) {
        showToast('âŒ Jeans cannot have variants (should be empty)');
        variantInput.value = '';
        return;
      }

      // For Tops: check if this Style+Variant already exists
      if (selectedProductType === 'Tops' && variantValue) {
        const searchQuery = `${styleNumber}-${variantValue.toUpperCase()}`;
        const searchRes = await authFetch(`/api/search?q=${encodeURIComponent(searchQuery)}`);
        const searchData = await searchRes.json();

        // Check if exact variant exists
        const existingVariant = searchData.results?.find(r =>
          r.result_type === 'style' &&
          r.style_number === styleNumber &&
          (r.variant || '').toUpperCase() === variantValue.toUpperCase()
        );

        if (existingVariant) {
          showToast('âŒ This Tops variant already exists - cannot save duplicate');
          return;
        }
      }

        const payload = {
          product_type: selectedProductType,
          variant: selectedProductType === 'Tops' ? variantValue.toUpperCase() : null,
          product_name: document.getElementById(getElementId('productName')).value,
          description: document.getElementById(getElementId('productDescription')).value,
          care_instructions: document.getElementById(getElementId('productCare')).value,
          delivery_returns: document.getElementById(getElementId('productDelivery')).value,
          size_material_composition: document.getElementById(getElementId('productMaterial')).value
        };

        const res = await authFetch(`/api/styles/${styleNumber}/product-info`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const result = await res.json();

        if (res.ok) {
          showToast('✓ Style saved!');
          toggleEdit('product-info');
          const variantForLoad = selectedProductType === 'Tops' ? variantValue.toUpperCase() : null;
          await loadStyle(styleNumber, variantForLoad);

          if (currentActiveTab === 'product') {
            await loadAllProducts();
            document.getElementById('searchQuery-product').value = '';
          } else {
            await loadRecentStyles();
            const searchQuery = document.getElementById(getElementId('searchQuery'))?.value?.trim();
            if (searchQuery) {
              handleSearch({ preventDefault: () => {} });
            }
          }
        } else {
          showToast('Error: ' + result.error);
        }
      } catch (err) {
        showToast('Error: ' + err.message);
      }
    }

