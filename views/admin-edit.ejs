<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DPP Hub</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
  <div class="max-w-7xl mx-auto py-12 px-4">
    <h1 class="text-4xl font-bold text-gray-900 mb-8">🌐 DPP Hub</h1>

    <!-- TOAST NOTIFICATION -->
    <div id="toastNotification" class="hidden fixed top-4 right-4 bg-green-600 text-white px-6 py-3 rounded-lg shadow-lg flex items-center gap-2 z-50">
      <span>✓</span>
      <span id="toastMessage">Saved!</span>
    </div>

    <!-- TAB NAVIGATION -->
    <div class="flex gap-4 mb-8 border-b border-gray-300">
      <button onclick="switchTab('edit')" id="tabEdit" class="active px-6 py-4 font-semibold text-gray-900 border-b-2 border-blue-600">
        🔍 Lookup & Edit
      </button>
      <button onclick="switchTab('new')" id="tabNew" class="px-6 py-4 font-semibold text-gray-700">
        ➕ New Data
      </button>
    </div>

    <!-- EDIT TAB -->
    <div id="editTab">
    <!-- SEARCH SECTION -->
    <div class="bg-white rounded-lg shadow-md p-8 mb-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Search</h2>
      <form id="searchForm" class="flex gap-4">
        <input type="text" id="searchQuery" placeholder="Style, Serial, Batch, SGTIN..." class="flex-1 border border-gray-300 rounded px-4 py-3" required>
        <button type="submit" class="bg-blue-600 text-white px-8 py-3 rounded font-semibold hover:bg-blue-700">
          Search
        </button>
      </form>
      <div id="searchStatus" class="mt-4 text-sm text-gray-600"></div>
    </div>

    <!-- SEARCH RESULTS LIST -->
    <div id="resultsListContainer" class="hidden bg-white rounded-lg shadow-md p-8 mb-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Search Results</h2>
      <div id="resultsList" class="space-y-2 max-h-64 overflow-y-auto"></div>
    </div>

    <!-- RESULT CONTAINER -->
    <div id="resultContainer" class="hidden space-y-6">

      <!-- STYLE VIEW -->
      <div id="styleSection" class="hidden bg-white rounded-lg shadow-md p-8">
        <h2 class="text-3xl font-bold text-gray-900 mb-6">📦 STYLE: <span id="styleTitle"></span></h2>

        <!-- Images Section -->
        <div class="bg-gray-50 p-6 rounded mb-6">
          <h3 class="text-lg font-bold text-gray-900 mb-4">📸 Style Images</h3>
          <div id="styleImages" class="flex gap-4 mb-4 flex-wrap"></div>
          <input type="file" id="styleImageUpload" accept="image/*" class="border border-gray-300 rounded px-3 py-2 w-full">
          <button onclick="uploadStyleImage()" class="mt-2 bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700">
            Upload Image
          </button>
        </div>

        <!-- Style Data Tabs -->
        <div class="space-y-6">
          <div class="border-t pt-6">
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-xl font-bold text-gray-900">Product Information</h3>
              <button onclick="toggleEdit('product-info')" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
                ✏️ Edit
              </button>
            </div>
            <div id="productInfoView" class="bg-gray-50 p-4 rounded space-y-2"></div>
            <div id="productInfoEdit" class="hidden space-y-4 mt-4">
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Product Name</label>
                <input type="text" id="productName" class="w-full border border-gray-300 rounded px-3 py-2">
              </div>
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Description</label>
                <textarea id="productDescription" rows="3" class="w-full border border-gray-300 rounded px-3 py-2"></textarea>
              </div>
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Care Instructions</label>
                <textarea id="productCare" rows="2" class="w-full border border-gray-300 rounded px-3 py-2"></textarea>
              </div>
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Delivery & Returns</label>
                <textarea id="productDelivery" rows="2" class="w-full border border-gray-300 rounded px-3 py-2"></textarea>
              </div>
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Size, Material & Composition</label>
                <textarea id="productMaterial" rows="2" class="w-full border border-gray-300 rounded px-3 py-2"></textarea>
              </div>
              <button onclick="saveProductInfo()" class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700">
                ✓ Save
              </button>
            </div>
          </div>

          <div class="border-t pt-6">
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-xl font-bold text-gray-900">Transparency Data</h3>
              <button onclick="toggleEdit('transparency')" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
                ✏️ Edit
              </button>
            </div>
            <div id="transparencyView" class="bg-gray-50 p-4 rounded text-sm overflow-auto max-h-48"></div>
            <div id="transparencyEdit" class="hidden space-y-4 mt-4">
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Suppliers Chain (JSON)</label>
                <textarea id="transparencySuppliers" rows="3" class="w-full border border-gray-300 rounded px-3 py-2 font-mono text-xs"></textarea>
              </div>
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Certifications (JSON)</label>
                <textarea id="transparencyCerts" rows="3" class="w-full border border-gray-300 rounded px-3 py-2 font-mono text-xs"></textarea>
              </div>
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Environmental Data (JSON)</label>
                <textarea id="transparencyEnv" rows="3" class="w-full border border-gray-300 rounded px-3 py-2 font-mono text-xs"></textarea>
              </div>
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Social Data (JSON)</label>
                <textarea id="transparencySocial" rows="3" class="w-full border border-gray-300 rounded px-3 py-2 font-mono text-xs"></textarea>
              </div>
              <button onclick="saveTransparency()" class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700">
                ✓ Save
              </button>
            </div>
          </div>

          <div class="border-t pt-6">
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-xl font-bold text-gray-900">Nudie Values</h3>
              <button onclick="toggleEdit('nudie-values')" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
                ✏️ Edit
              </button>
            </div>
            <div id="nudieValuesView" class="bg-gray-50 p-4 rounded space-y-2"></div>
            <div id="nudieValuesEdit" class="hidden space-y-4 mt-4">
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Repair Info</label>
                <textarea id="nudieRepair" rows="3" class="w-full border border-gray-300 rounded px-3 py-2"></textarea>
              </div>
              <button onclick="saveNudieValues()" class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700">
                ✓ Save
              </button>
            </div>
          </div>

          <div class="border-t pt-6">
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-xl font-bold text-gray-900">Storytelling</h3>
              <button onclick="toggleEdit('storytelling')" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
                ✏️ Edit
              </button>
            </div>
            <div id="storytellingView" class="bg-gray-50 p-4 rounded space-y-2"></div>
            <div id="storytellingEdit" class="hidden space-y-4 mt-4">
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Summary</label>
                <textarea id="storytellinSummary" rows="2" class="w-full border border-gray-300 rounded px-3 py-2"></textarea>
              </div>
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Content</label>
                <textarea id="storytellingContent" rows="4" class="w-full border border-gray-300 rounded px-3 py-2"></textarea>
              </div>
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Links (JSON)</label>
                <textarea id="storytellingLinks" rows="3" class="w-full border border-gray-300 rounded px-3 py-2 font-mono text-xs"></textarea>
              </div>
              <button onclick="saveStorytelling()" class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700">
                ✓ Save
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- BATCH VIEW -->
      <div id="batchSection" class="hidden bg-white rounded-lg shadow-md p-8">
        <h2 class="text-3xl font-bold text-gray-900 mb-6">📦 BATCH: <span id="batchTitle"></span></h2>

        <!-- Batch Images -->
        <div class="bg-gray-50 p-6 rounded mb-6">
          <h3 class="text-lg font-bold text-gray-900 mb-4">📸 Batch Images</h3>
          <div id="batchImages" class="flex gap-4 mb-4 flex-wrap"></div>
          <input type="file" id="batchImageUpload" accept="image/*" class="border border-gray-300 rounded px-3 py-2 w-full">
          <button onclick="uploadBatchImage()" class="mt-2 bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700">
            Upload Image
          </button>
        </div>

        <div id="batchInfo" class="bg-gray-50 p-4 rounded space-y-2"></div>

        <!-- Serials Table -->
        <div class="border-t pt-6 mt-6">
          <div class="flex justify-between items-center mb-4">
            <h3 class="text-xl font-bold text-gray-900">🏷️ Serials (<span id="serialsCount">0</span>)</h3>
            <input type="text" id="serialsSearchInput" placeholder="Search serials..." class="border border-gray-300 rounded px-4 py-2 w-64" oninput="filterSerials()">
          </div>

          <div class="overflow-x-auto">
            <table class="w-full border-collapse text-sm">
              <thead>
                <tr class="bg-gray-100 border-b border-gray-300">
                  <th class="px-4 py-2 text-left font-bold cursor-pointer hover:bg-gray-200" onclick="sortSerials('serial_number')">Serial Number ↕️</th>
                  <th class="px-4 py-2 text-left font-bold cursor-pointer hover:bg-gray-200" onclick="sortSerials('condition')">Condition ↕️</th>
                  <th class="px-4 py-2 text-left font-bold cursor-pointer hover:bg-gray-200" onclick="sortSerials('size')">Size ↕️</th>
                  <th class="px-4 py-2 text-left font-bold">Owner</th>
                </tr>
              </thead>
              <tbody id="serialsTableBody">
              </tbody>
            </table>
          </div>

          <!-- Pagination -->
          <div id="serialsPagination" class="flex gap-2 justify-center mt-4"></div>
        </div>
      </div>

      <!-- SERIAL VIEW -->
      <div id="serialSection" class="hidden bg-white rounded-lg shadow-md p-8">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-3xl font-bold text-gray-900">🏷️ SERIAL: <span id="serialTitle"></span></h2>
          <div class="flex gap-2">
            <button onclick="previewPublicPassport()" class="bg-purple-600 text-white px-4 py-2 rounded hover:bg-purple-700">
              👁️ Preview Passport
            </button>
            <button onclick="copyPublicLink()" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
              🔗 Copy Public Link
            </button>
          </div>
        </div>

        <div class="grid grid-cols-3 gap-6 mb-6">
          <div class="bg-gray-50 p-4 rounded">
            <h3 class="font-bold text-gray-900 mb-2">Serial Info</h3>
            <div id="serialInfo" class="text-sm space-y-1"></div>
          </div>
          <div class="bg-gray-50 p-4 rounded">
            <h3 class="font-bold text-gray-900 mb-2">Batch Info</h3>
            <div id="serialBatchInfo" class="text-sm space-y-1"></div>
          </div>
          <div class="bg-gray-50 p-4 rounded">
            <h3 class="font-bold text-gray-900 mb-2">Style Info</h3>
            <div id="serialStyleInfo" class="text-sm space-y-1"></div>
          </div>
        </div>

        <!-- Serial Metadata -->
        <div class="border-t pt-6">
          <div class="flex justify-between items-center mb-4">
            <h3 class="text-xl font-bold text-gray-900">Serial Metadata</h3>
            <button onclick="toggleEdit('serial-metadata')" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
              ✏️ Edit
            </button>
          </div>
          <div id="serialMetadataView" class="bg-gray-50 p-4 rounded grid grid-cols-2 gap-4"></div>
          <div id="serialMetadataEdit" class="hidden space-y-4 mt-4 bg-gray-50 p-4 rounded">
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-1">SGTIN (Numeric) - Read only</label>
              <input type="text" id="serialSGTINNumeric" placeholder="301414170001200ABC" class="w-full border border-gray-300 rounded px-3 py-2 font-mono text-sm bg-gray-100" readonly>
            </div>
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-1">Public URL (QR Code Link)</label>
              <input type="text" id="serialSGTINUri" placeholder="https://id.gs1.org/01/.../21/..." class="w-full border border-gray-300 rounded px-3 py-2 font-mono text-sm">
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Size</label>
                <select id="serialSize" class="w-full border border-gray-300 rounded px-3 py-2">
                  <option value="">-- Not specified --</option>
                  <option value="XS">XS</option>
                  <option value="S">S</option>
                  <option value="M">M</option>
                  <option value="L">L</option>
                  <option value="XL">XL</option>
                  <option value="XXL">XXL</option>
                </select>
              </div>
              <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Condition (Lifecycle)</label>
                <select id="serialCondition" class="w-full border border-gray-300 rounded px-3 py-2">
                  <option value="">-- Not specified --</option>
                  <option value="new">🆕 New</option>
                  <option value="repaired">🔧 Repaired</option>
                  <option value="reused">♻️ Reused</option>
                  <option value="recycled">🗑️ Recycled</option>
                </select>
              </div>
            </div>
            <input type="text" id="serialLocation" placeholder="Location" class="w-full border border-gray-300 rounded px-3 py-2">
            <input type="text" id="serialOwner" placeholder="Owner/Customer ID" class="w-full border border-gray-300 rounded px-3 py-2">
            <textarea id="serialNotes" placeholder="Notes" rows="3" class="w-full border border-gray-300 rounded px-3 py-2"></textarea>
            <button onclick="saveSerialMetadata()" class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700">
              ✓ Save
            </button>
          </div>
        </div>

        <!-- Events Timeline -->
        <div class="border-t pt-6">
          <h3 class="text-xl font-bold text-gray-900 mb-4">📅 Events & History</h3>
          <div id="eventsTimeline" class="space-y-3 mb-6"></div>

          <div class="bg-gray-50 p-4 rounded">
            <h4 class="font-bold text-gray-900 mb-4">➕ Add New Event</h4>
            <div class="space-y-4">
              <select id="eventType" class="w-full border border-gray-300 rounded px-3 py-2">
                <option value="">-- Select Event Type --</option>
                <option value="service">Service</option>
                <option value="repair">Repair</option>
                <option value="reuse">Reuse (Trade-in)</option>
                <option value="recycling">Recycling</option>
                <option value="scanned">Scanned</option>
              </select>
              <textarea id="eventData" placeholder='Event details (JSON)' rows="4" class="w-full border border-gray-300 rounded px-3 py-2 font-mono text-xs"></textarea>
              <button onclick="addEvent()" class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700">
                ✓ Add Event
              </button>
            </div>
          </div>
        </div>
      </div>

    </div>
    </div>

    <!-- NEW TAB -->
    <div id="newTab" class="hidden space-y-6">

      <!-- QUICK BATCH CREATOR WIZARD -->
      <div class="bg-white rounded-lg shadow-md p-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">🚀 Quick Batch Creator</h2>

        <!-- Progress Steps -->
        <div class="flex gap-4 mb-8 overflow-x-auto">
          <div class="step-indicator" data-step="1">
            <div class="bg-blue-600 text-white rounded-full w-10 h-10 flex items-center justify-center font-bold">1</div>
            <div class="text-sm font-bold text-gray-700 mt-1">Style</div>
          </div>
          <div class="step-indicator" data-step="2">
            <div class="bg-gray-300 text-white rounded-full w-10 h-10 flex items-center justify-center font-bold">2</div>
            <div class="text-sm font-bold text-gray-700 mt-1">Details</div>
          </div>
          <div class="step-indicator" data-step="3">
            <div class="bg-gray-300 text-white rounded-full w-10 h-10 flex items-center justify-center font-bold">3</div>
            <div class="text-sm font-bold text-gray-700 mt-1">Batch</div>
          </div>
          <div class="step-indicator" data-step="4">
            <div class="bg-gray-300 text-white rounded-full w-10 h-10 flex items-center justify-center font-bold">4</div>
            <div class="text-sm font-bold text-gray-700 mt-1">Serials</div>
          </div>
          <div class="step-indicator" data-step="5">
            <div class="bg-gray-300 text-white rounded-full w-10 h-10 flex items-center justify-center font-bold">5</div>
            <div class="text-sm font-bold text-gray-700 mt-1">SGTIN</div>
          </div>
          <div class="step-indicator" data-step="6">
            <div class="bg-gray-300 text-white rounded-full w-10 h-10 flex items-center justify-center font-bold">6</div>
            <div class="text-sm font-bold text-gray-700 mt-1">Review</div>
          </div>
        </div>

        <!-- Step 1: Style -->
        <div id="wizardStep1" class="wizard-step space-y-4">
          <h3 class="text-xl font-bold text-gray-900 mb-4">Step 1: Select or Create Style</h3>
          <div class="space-y-4">
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-1">Style Number</label>
              <input type="text" id="wizardStyleNumber" placeholder="114519" class="w-full border border-gray-300 rounded px-3 py-2">
            </div>
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-1">Product Name</label>
              <input type="text" id="wizardProductName" placeholder="Lofty Lo" class="w-full border border-gray-300 rounded px-3 py-2">
            </div>
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-1">Material & Composition</label>
              <textarea id="wizardMaterial" rows="2" placeholder="95% Cotton, 5% Elastane" class="w-full border border-gray-300 rounded px-3 py-2"></textarea>
            </div>
            <button onclick="wizardNextStep(1)" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700">
              Next →
            </button>
          </div>
        </div>

        <!-- Step 2: Style Details -->
        <div id="wizardStep2" class="wizard-step hidden space-y-4">
          <h3 class="text-xl font-bold text-gray-900 mb-4">Step 2: Style Details (Optional)</h3>
          <p class="text-sm text-gray-600 mb-4">Add transparency, nudie values, and storytelling info. You can skip this and add later.</p>
          <div class="bg-blue-50 p-4 rounded mb-4">
            <p class="text-sm"><strong>Style:</strong> <span id="wizardShowStyleDetails"></span></p>
          </div>
          <div class="space-y-4">
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-1">Transparency Data (JSON)</label>
              <textarea id="wizardTransparency" rows="3" placeholder='{"suppliers": "..."}' class="w-full border border-gray-300 rounded px-3 py-2 font-mono text-xs"></textarea>
            </div>
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-1">Nudie Values - Repair Info</label>
              <textarea id="wizardRepair" rows="2" placeholder="Free repairs for 2 years..." class="w-full border border-gray-300 rounded px-3 py-2"></textarea>
            </div>
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-1">Storytelling Summary</label>
              <textarea id="wizardStory" rows="2" placeholder="The story of this collection..." class="w-full border border-gray-300 rounded px-3 py-2"></textarea>
            </div>
            <div class="flex gap-4">
              <button onclick="wizardPrevStep(2)" class="bg-gray-400 text-white px-6 py-2 rounded hover:bg-gray-500">
                ← Back
              </button>
              <button onclick="wizardNextStep(2)" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700">
                Next →
              </button>
            </div>
          </div>
        </div>

        <!-- Step 3: Batch -->
        <div id="wizardStep3" class="wizard-step hidden space-y-4">
          <h3 class="text-xl font-bold text-gray-900 mb-4">Step 3: Batch Details</h3>
          <div class="bg-blue-50 p-4 rounded mb-4">
            <p class="text-sm"><strong>Style:</strong> <span id="wizardShowStyle"></span></p>
          </div>
          <div class="space-y-4">
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-1">Batch ID</label>
              <input type="text" id="wizardBatchId" placeholder="114519-BATCH001" class="w-full border border-gray-300 rounded px-3 py-2">
            </div>
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-1">Total Units</label>
              <input type="number" id="wizardBatchUnits" placeholder="100" class="w-full border border-gray-300 rounded px-3 py-2">
            </div>
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-1">Production Date</label>
              <input type="date" id="wizardProductionDate" class="w-full border border-gray-300 rounded px-3 py-2">
            </div>
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-1">Manufacturing Details</label>
              <textarea id="wizardManufacturing" rows="3" placeholder="Factory: XYZ&#10;QC Status: Passed" class="w-full border border-gray-300 rounded px-3 py-2"></textarea>
            </div>
            <div class="flex gap-4">
              <button onclick="wizardPrevStep(2)" class="bg-gray-400 text-white px-6 py-2 rounded hover:bg-gray-500">
                ← Back
              </button>
              <button onclick="wizardNextStep(2)" class="bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700">
                Next →
              </button>
            </div>
          </div>
        </div>

        <!-- Step 4: Serials -->
        <div id="wizardStep4" class="wizard-step hidden space-y-4">
          <h3 class="text-xl font-bold text-gray-900 mb-4">Step 4: Serial Numbers</h3>
          <div class="bg-blue-50 p-4 rounded mb-4">
            <p class="text-sm"><strong>Batch:</strong> <span id="wizardShowBatch"></span></p>
          </div>
          <div class="space-y-4">
            <div>
              <label class="block text-sm font-bold text-gray-700 mb-1">Serial Numbers (paste comma-separated)</label>
              <textarea id="wizardSerials" rows="6" placeholder="114519-001-AA,114519-001-AB,114519-001-AC" class="w-full border border-gray-300 rounded px-3 py-2" required></textarea>
            </div>
