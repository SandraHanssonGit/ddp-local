    async function addEvent() {
      try {
        if (!currentData.serial) {
          showToast('No serial selected');
          return;
        }

        const serialNumber = currentData.serial.serial.serial_number;
        const eventType = document.getElementById('eventType').value;
        const eventDataStr = (document.getElementById('eventData').value || '').trim();
        const addBtn = document.getElementById('addEventBtn');
        const isEditing = addBtn.dataset.editingEventId;

        console.log('Adding event:', { serialNumber, eventType, eventDataStr, isEditing });

        if (!eventType) {
          showToast('Please select event type');
          return;
        }

        let eventData = {};
        if (eventDataStr) {
          // If something is entered, it MUST be valid JSON
          if (!eventDataStr.startsWith('{') && !eventDataStr.startsWith('[')) {
            showToast('Event details must be valid JSON or left empty. Example: {"location": "Stockholm"}');
            return;
          }
          try {
            eventData = JSON.parse(eventDataStr);
          } catch (e) {
            showToast('Invalid JSON: ' + e.message);
            return;
          }
        }

        console.log('Sending event data:', { event_type: eventType, event_data: eventData });

        const endpoint = isEditing
          ? `/api/serials/${serialNumber}/event/${isEditing}`
          : `/api/serials/${serialNumber}/event`;
        const method = isEditing ? 'PUT' : 'POST';

        const res = await authFetch(endpoint, {
          method: method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            event_type: eventType,
            event_data: eventData
          })
        });

        const result = await res.json();
        console.log('Event response:', result);

        if (res.status === 401) {
          showToast('Session expired - please login again');
          window.location.href = '/login';
          return;
        }

        if (res.ok) {
          showToast(isEditing ? 'Event updated!' : 'Event added!');
          const eventTypeEl = document.getElementById('eventType');
          const eventDataEl = document.getElementById('eventData');
          if (eventTypeEl) {
            eventTypeEl.value = '';
            eventTypeEl.disabled = false;
          }
          if (eventDataEl) eventDataEl.value = '';
          if (addBtn) {
            addBtn.textContent = '✓ Add Event';
            delete addBtn.dataset.editingEventId;
          }
          await loadSerial(serialNumber);
        } else {
          showToast('Error: ' + (result.error || 'Unknown error'));
        }
      } catch (err) {
        console.error('Add event error:', err);
        showToast('Error: ' + err.message);
      }
    }

    async function uploadStyleImage() {
      const file = document.getElementById('styleImageUpload').files[0];
      if (!file) {
        showToast('Please select an image');
        return;
      }

      const styleNumber = currentData.style.style.style_number;
      const reader = new FileReader();
      reader.onload = async (e) => {
        try {
          // Compress image
          const img = new Image();
          img.onload = async () => {
            const canvas = document.createElement('canvas');
            let width = img.width;
            let height = img.height;

            // Scale down to max 800px width while maintaining aspect ratio
            if (width > 800) {
              height = (height * 800) / width;
              width = 800;
            }

            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, width, height);

            // Convert to JPEG with 80% quality
            const compressedBase64 = canvas.toDataURL('image/jpeg', 0.8).split(',')[1];

            const res = await authFetch(`/api/styles/${styleNumber}/image`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                image_data: compressedBase64,
                image_name: file.name
              })
            });

            const result = await res.json();
            if (res.ok) {
              showToast('✓ Image uploaded!');
              document.getElementById('styleImageUpload').value = '';
              await loadStyleImages(styleNumber);
            } else {
              showToast('Error: ' + (result.error || 'Upload failed'));
            }
          };
          img.src = e.target.result;
        } catch (err) {
          showToast('Error: ' + err.message);
        }
      };
      reader.readAsDataURL(file);
    }

