      const batch = currentData.serial.batch.batch_id;
      const serial = currentData.serial.serial.serial_number;
      const publicLink = `${window.location.origin}/p/${style}/${batch}/${serial}`;
      navigator.clipboard.writeText(publicLink).then(() => {
        showToast('📋 Link copied!');
      });
    }

    function previewPublicPassport() {
      if (!currentData.serial) {
        showToast('Serial data not loaded');
