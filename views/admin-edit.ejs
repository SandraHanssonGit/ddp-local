    function closeDeleteEventModal() {
      document.getElementById('deleteEventModal').classList.add('hidden');
      pendingDeleteEventId = null;
    }

    async function confirmDeleteEvent() {
      if (!pendingDeleteEventId) return;

      const serialNumber = document.getElementById('serialTitle').textContent;
      const eventId = pendingDeleteEventId;

      try {
        const res = await authFetch(`/api/serials/${serialNumber}/event/${eventId}`, {
          method: 'DELETE'
        });

        if (res.ok) {
          showToast('Event deleted');
          closeDeleteEventModal();
          // Force reload the serial data to refresh events list
          await loadSerial(serialNumber);
        } else {
          showToast('Error deleting event');
        }
      } catch (err) {
        showToast('Error: ' + err.message);
      }
    }

    // Serials table globals
    let serialsTableData = [];
    let serialsFilteredData = [];
    let serialsCurrentSort = { column: 'serial_number', direction: 'asc' };
    let serialsCurrentPage = 1;
    let serialsSearchQuery = '';
    const SERIALS_PER_PAGE = 50;

    function showSerialsTable(serials, allSerialData) {
      // Map serial data to serials
      serialsTableData = serials.map(s => {
        const data = {};
        const serialDataForThis = allSerialData.filter(sd => sd.serial_id === s.id);
        serialDataForThis.forEach(sd => {
          data[sd.key] = sd.value;
        });
        return {
          ...s,
          condition: data.condition || '-',
          size: data.size || '-',
          owner_id: data.owner_id || '-'
        };
      });

      serialsFilteredData = [...serialsTableData];
      document.getElementById('serialsCount').textContent = serialsTableData.length;
      document.getElementById('serialsSearchInput').value = '';
      serialsCurrentPage = 1;
      renderSerialsTable();
    }

    function filterSerials() {
      serialsSearchQuery = document.getElementById('serialsSearchInput').value.toLowerCase();
      serialsFilteredData = serialsTableData.filter(s =>
        s.serial_number.toLowerCase().includes(serialsSearchQuery)
      );
      serialsCurrentPage = 1;
      renderSerialsTable();
    }

    function renderSerialsTable() {
      const sorted = [...serialsFilteredData].sort((a, b) => {
        const aVal = a[serialsCurrentSort.column];
        const bVal = b[serialsCurrentSort.column];
        const cmp = aVal > bVal ? 1 : aVal < bVal ? -1 : 0;
        return serialsCurrentSort.direction === 'asc' ? cmp : -cmp;
      });

      const start = (serialsCurrentPage - 1) * SERIALS_PER_PAGE;
      const end = start + SERIALS_PER_PAGE;
      const pageData = sorted.slice(start, end);

      // Group by style
      const serialsByStyle = {};
      pageData.forEach(s => {
        if (!serialsByStyle[s.style_number]) {
          serialsByStyle[s.style_number] = [];
        }
        serialsByStyle[s.style_number].push(s);
      });

      const tbody = document.getElementById('serialsTableBody');
      tbody.innerHTML = Object.keys(serialsByStyle)
        .sort()
        .map(styleNum => {
          const serialsForStyle = serialsByStyle[styleNum];
          return `
            <tr class="bg-gray-100 border-b-2 border-gray-300">
              <td colspan="4" class="px-4 py-2 font-semibold text-gray-900">Style: ${styleNum} (${serialsForStyle.length} serials)</td>
            </tr>
            ${serialsForStyle.map(s => `
              <tr class="border-b border-gray-200 hover:bg-gray-50 cursor-pointer" onclick="loadSerial('${s.serial_number}')">
                <td class="px-4 py-2">${s.serial_number}</td>
                <td class="px-4 py-2">${s.condition}</td>
                <td class="px-4 py-2">${s.size}</td>
                <td class="px-4 py-2 text-xs">${s.owner_id}</td>
              </tr>
            `).join('')}
          `;
        })
        .join('');

      // Render pagination
      const totalPages = Math.ceil(serialsFilteredData.length / SERIALS_PER_PAGE);
      const pagination = document.getElementById('serialsPagination');
      pagination.innerHTML = '';

      if (totalPages <= 1) return;

      for (let i = 1; i <= totalPages; i++) {
        const btn = document.createElement('button');
        btn.textContent = i;
        btn.className = i === serialsCurrentPage
          ? 'px-3 py-1 bg-gray-900 text-white rounded'
          : 'px-3 py-1 border border-gray-300 rounded hover:bg-gray-100';
        btn.onclick = () => {
          serialsCurrentPage = i;
          renderSerialsTable();
          document.querySelector('#batchSection').scrollIntoView({ behavior: 'smooth' });
        };
        pagination.appendChild(btn);
      }
    }

    function sortSerials(column) {
      if (serialsCurrentSort.column === column) {
        serialsCurrentSort.direction = serialsCurrentSort.direction === 'asc' ? 'desc' : 'asc';
      } else {
        serialsCurrentSort = { column, direction: 'asc' };
      }
      serialsCurrentPage = 1;
      renderSerialsTable();
    }


    // Load recent batches for Design tab
    async function loadRecentBatches() {
      try {
        const [batchesRes, serialsRes] = await Promise.all([
          fetch('/api/batches'),
          fetch('/api/serials')
        ]);

        const batches = await batchesRes.json();
        const serials = await serialsRes.json();

        // Sort batches by ID (newest first) and take top 10
        const recentBatches = batches
          .sort((a, b) => b.batch_id.localeCompare(a.batch_id))
          .slice(0, 10);

        // Group serials by batch and style
        const serialsByBatchAndStyle = {};
        serials.forEach(s => {
          if (!serialsByBatchAndStyle[s.batch_id]) {
            serialsByBatchAndStyle[s.batch_id] = {};
          }
          if (!serialsByBatchAndStyle[s.batch_id][s.style_number]) {
            serialsByBatchAndStyle[s.batch_id][s.style_number] = 0;
          }
          serialsByBatchAndStyle[s.batch_id][s.style_number]++;
        });

        // Render desktop table
        const tbody = document.getElementById('recentBatchesTable');
        tbody.innerHTML = recentBatches.map(b => {
          const stylesInBatch = serialsByBatchAndStyle[b.batch_id] || {};
          const stylesHtml = Object.entries(stylesInBatch)
            .map(([styleNum, count]) => `${styleNum} (${count})`)
            .join(' | ');
          const totalSerials = Object.values(stylesInBatch).reduce((sum, count) => sum + count, 0);

          return `
          <tr class="border-b border-gray-200 hover:bg-gray-50 cursor-pointer" data-batch-id="${b.batch_id}">
            <td class="py-2 px-3 font-semibold text-blue-600 hover:underline">${b.batch_id}</td>
            <td class="py-2 px-3 text-sm">${stylesHtml || '-'}</td>
            <td class="py-2 px-3">${totalSerials}</td>
            <td class="py-2 px-3">${b.partner_name || '-'}</td>
          </tr>
        `;
        }).join('');

        // Render mobile cards
        const cardsContainer = document.getElementById('recentBatchesCards');
        cardsContainer.innerHTML = recentBatches.map(b => {
          const stylesInBatch = serialsByBatchAndStyle[b.batch_id] || {};
          const stylesList = Object.entries(stylesInBatch)
            .map(([styleNum, count]) => `<div class="text-sm">• ${styleNum} (${count})</div>`)
            .join('');
          const totalSerials = Object.values(stylesInBatch).reduce((sum, count) => sum + count, 0);

          return `
          <div class="bg-gray-50 rounded-lg p-4 border border-gray-200 hover:bg-gray-100 cursor-pointer" data-batch-id="${b.batch_id}">
            <div class="font-semibold text-blue-600 mb-2">${b.batch_id}</div>
            <div class="space-y-1 text-sm text-gray-700">
              <div><span class="font-semibold">Styles:</span></div>
              <div>${stylesList || '<span class="text-gray-500">No serials</span>'}</div>
              <div><span class="font-semibold">Total Serials:</span> ${totalSerials}</div>
              <div><span class="font-semibold">Partner:</span> ${b.partner_name || '-'}</div>
            </div>
          </div>
        `;
        }).join('');

        // Add click handlers to both table rows and cards
        const attachClickHandlers = (selector) => {
          document.querySelectorAll(selector).forEach(element => {
            element.addEventListener('click', () => {
              const batchId = element.getAttribute('data-batch-id');
              document.getElementById('resultContainer').classList.remove('hidden');
              document.getElementById('recentBatchesContainer').classList.add('hidden');
              loadBatch(batchId);
            });
          });
        };

        attachClickHandlers('tbody tr[data-batch-id]');
        attachClickHandlers('#recentBatchesCards [data-batch-id]');
      } catch (err) {
        console.error('Error loading recent batches:', err);
        document.getElementById('recentBatchesTable').innerHTML = '<tr><td colspan="4" class="px-3 py-2 text-center text-red-500">Error loading batches</td></tr>';
      }
    }

    // Load Dashboard
    async function loadDashboard() {
      try {
        // Fetch all data
        const [stylesRes, batchesRes, serialsRes, eventsRes] = await Promise.all([
          fetch('/api/styles'),
          fetch('/api/batches'),
          fetch('/api/serials'),
          fetch('/api/events')
        ]);

        const styles = await stylesRes.json();
        const batches = await batchesRes.json();
        const serials = await serialsRes.json();
        const events = await eventsRes.json();

        // Update KPI cards
        document.getElementById('statsStyles').textContent = styles.length;
        document.getElementById('statsBatches').textContent = batches.length;
        document.getElementById('statsSerials').textContent = serials.length;
        document.getElementById('statsEvents').textContent = events.length;

        // Count conditions
        const conditions = { new: 0, repaired: 0, reused: 0, recycled: 0 };
        serials.forEach(s => {
          const cond = s.condition || 'new';
          if (conditions.hasOwnProperty(cond)) conditions[cond]++;
        });
        document.getElementById('conditionNew').textContent = conditions.new;
        document.getElementById('conditionRepaired').textContent = conditions.repaired;
        document.getElementById('conditionReused').textContent = conditions.reused;
        document.getElementById('conditionRecycled').textContent = conditions.recycled;

        // Top 5 styles
        const styleSerialCounts = {};
        serials.forEach(s => {
          const style = s.style_number;
          styleSerialCounts[style] = (styleSerialCounts[style] || 0) + 1;
        });
        const topStyles = Object.entries(styleSerialCounts)
          .sort((a, b) => b[1] - a[1])
          .slice(0, 5);
        const topStylesEl = document.getElementById('topStyles');
        topStylesEl.innerHTML = topStyles.map(([style, count], idx) => `
          <div class="flex justify-between p-2 bg-gray-50 rounded hover:bg-gray-100 cursor-pointer" data-style-index="${idx}">
            <span class="font-semibold text-blue-600 hover:underline">${style}</span>
            <span class="text-gray-600">${count} serials</span>
          </div>
        `).join('');

        // Add click handlers to top styles
        topStylesEl.querySelectorAll('[data-style-index]').forEach((el, idx) => {
          el.addEventListener('click', () => {
            goToLookup('style', topStyles[idx][0]);
          });
        });

        // Data quality issues - check Style, Batch, and Serial data
        const issues = [];

        // Check Styles
        styles.forEach(s => {
          if (!s.product_name || s.product_name.trim() === '') issues.push({ type: 'style', target: s.style_number, text: `Style ${s.style_number}: missing product name` });
          if (!s.description || s.description.trim() === '') issues.push({ type: 'style', target: s.style_number, text: `Style ${s.style_number}: missing description` });
          if (!s.care_instructions || s.care_instructions.trim() === '') issues.push({ type: 'style', target: s.style_number, text: `Style ${s.style_number}: missing care instructions` });
          if (!s.size_material_composition || s.size_material_composition.trim() === '') issues.push({ type: 'style', target: s.style_number, text: `Style ${s.style_number}: missing material composition` });
        });

        // Check Batches (partner_name)
        batches.forEach(b => {
          if (!b.partner_name || b.partner_name.trim() === '') issues.push({ type: 'batch', target: b.batch_id, text: `Batch ${b.batch_id}: missing partner/manufacturer` });
          // Check serials in this batch
          const batchSerials = serials.filter(s => s.batch_id === b.batch_id);
          batchSerials.forEach(s => {
            if (!s.condition || s.condition === '-') issues.push({ type: 'serial', target: s.serial_number, text: `Serial ${s.serial_number}: missing condition` });
          });
        });

        const issuesEl = document.getElementById('dataQualityIssues');
        if (issues.length > 0) {
          issuesEl.innerHTML = issues.slice(0, 5).map((i, idx) => `
            <div class="text-gray-700">
              • <a href="javascript:void(0)" class="text-blue-600 hover:underline cursor-pointer" data-issue-index="${idx}">${i.text}</a>
            </div>
          `).join('');

          // Add click handlers to issue links
          issuesEl.querySelectorAll('[data-issue-index]').forEach((link, idx) => {
            link.addEventListener('click', (e) => {
              e.preventDefault();
              goToLookup(issues[idx].type, issues[idx].target);
            });
          });
        } else {
          issuesEl.innerHTML = '<div class="text-gray-600">All data is complete</div>';
        }

        // Activity timeline - show events with detailed context (exclude scanned events)
        const recentEvents = events.filter(e => e.event_type !== 'scanned').slice(0, 20);
        const timelineHTML = recentEvents.map(e => {
          const serial = serials.find(s => s.serial_number === e.serial_number);
          const styleNumber = serial ? serial.style_number : 'N/A';

          let itemInfo = '';
          let locationInfo = '';

          // Get location from event_data if available
          if (e.event_data) {
            try {
              const data = typeof e.event_data === 'string' ? JSON.parse(e.event_data) : e.event_data;
              if (data.location) {
                locationInfo = `Location: ${data.location}`;
              }
            } catch (err) {}
          }

          if (e.serial_number) {
            itemInfo = `${e.serial_number} (Style: ${styleNumber})`;
          } else if (e.batch_id) {
            itemInfo = `Batch: ${e.batch_id} (Style: ${styleNumber})`;
          }

          return `
            <div class="border-l-4 border-blue-500 pl-4 py-3 pb-3 border-b border-gray-100">
              <div class="flex justify-between items-start mb-2">
                <div class="font-semibold text-gray-900 capitalize">${e.event_type}</div>
                <div class="text-xs text-gray-500">${new Date(e.created_at).toLocaleDateString('sv-SE')} ${new Date(e.created_at).toLocaleTimeString('sv-SE', {hour: '2-digit', minute:'2-digit'})}</div>
              </div>
              ${itemInfo ? `<div class="text-sm text-blue-600 hover:underline cursor-pointer font-mono" onclick="loadData('${e.serial_number ? 'serial' : 'batch'}', '${styleNumber}', '${e.batch_id || ''}', '${e.serial_number || ''}')">${itemInfo}</div>` : ''}
              ${locationInfo ? `<div class="text-sm text-gray-600">${locationInfo}</div>` : ''}
            </div>
          `;
        }).join('') || '<div class="text-gray-500 text-sm p-2">No events yet</div>';

        document.getElementById('activityTimeline').innerHTML = timelineHTML;

        // Load most viewed serials
        const mostViewedTable = document.getElementById('mostViewedTable');
        const mostViewed = serials
          .filter(s => s.view_count > 0)
          .sort((a, b) => (b.view_count || 0) - (a.view_count || 0))
          .slice(0, 10);

        if (mostViewed.length > 0) {
          mostViewedTable.innerHTML = mostViewed.map(s => `
            <tr class="border-b border-gray-200 hover:bg-gray-50">
              <td class="px-4 py-3 font-mono text-gray-900">${s.serial_number}</td>
              <td class="px-4 py-3 text-gray-700">${s.batch_id ? batches.find(b => b.batch_id === s.batch_id)?.style_number || 'N/A' : 'N/A'}</td>
              <td class="px-4 py-3 text-right">
                <span class="inline-block bg-blue-100 text-blue-800 px-3 py-1 rounded-full font-bold">${s.view_count || 0}</span>
              </td>
            </tr>
          `).join('');
        } else {
          mostViewedTable.innerHTML = '<tr><td colspan="3" class="px-4 py-3 text-center text-gray-500">No views yet</td></tr>';
        }

      } catch (err) {
        console.error('Dashboard load error:', err);
      }
    }

    // Tab switching
    function switchTab(tab) {
      // Hide/show tabs
      document.getElementById('dashboardTab').classList.toggle('hidden', tab !== 'dashboard');
      document.getElementById('scanTab').classList.toggle('hidden', tab !== 'scan');
      document.getElementById('editTab').classList.toggle('hidden', tab !== 'edit');
      document.getElementById('adminTab').classList.toggle('hidden', tab !== 'admin');

      // Update button styles
      ['dashboard', 'scan', 'edit', 'admin'].forEach(t => {
        const btn = document.getElementById(`tab${t.charAt(0).toUpperCase() + t.slice(1)}`);
        if (btn) {
          btn.classList.toggle('border-b-2', tab === t);
          btn.classList.toggle('border-gray-900', tab === t);
          btn.classList.toggle('text-gray-900', tab === t);
          btn.classList.toggle('text-gray-700', tab !== t);
        }
      });

      // Load admin data when admin tab is opened
      if (tab === 'admin') {
        loadAdminUsers();
      }

      // Load dashboard data when dashboard tab is opened
      if (tab === 'dashboard') {
        loadDashboard();
      }

      // Load recent batches when design tab is opened
      if (tab === 'edit') {
        loadRecentBatches();
      }

      // Clear scan result when tab is opened
      if (tab === 'scan') {
        document.getElementById('scanResult').classList.add('hidden');
        document.getElementById('scanSerial').focus();
      }
    }

    // NEW STYLE form
    const newStyleForm = document.getElementById('newStyleForm');
    if (newStyleForm) {
    newStyleForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const styleNumber = document.getElementById('newStyleNumber').value;
      const productType = document.getElementById('newProductType')?.value?.trim().toLowerCase() || '';
      const variantValue = document.getElementById('newProductVariant')?.value?.trim() || '';

      if (!productType) {
        alert('Please select if this style is jeans or topp');
        return;
      }

      if (productType === 'topp' && !variantValue) {
        alert('Variant is required when creating a topp');
        return;
      }

      if (productType === 'topp' && !/^[A-Za-z0-9-]+$/.test(variantValue)) {
        alert('Variant must only contain letters, numbers or dashes');
        return;
      }

      const res = await authFetch(`/api/styles/${styleNumber}/product-info`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          product_type: productType,
          variant: productType === 'topp' ? variantValue.toUpperCase() : null,
          product_name: document.getElementById('newProductName').value,
          description: document.getElementById('newDescription').value,
          care_instructions: document.getElementById('newCare').value,
          delivery_returns: document.getElementById('newDelivery').value,
          size_material_composition: document.getElementById('newMaterial').value
        })
      });
      const result = await res.json();
      const resultDiv = document.getElementById('newStyleResult');
      resultDiv.className = res.ok ? 'mt-4 p-4 rounded bg-green-50 border border-green-200 text-green-900' : 'mt-4 p-4 rounded bg-red-50 border border-red-200 text-red-900';
      resultDiv.innerHTML = `<p>${res.ok ? '✓ Style created! Now add transparency/nudie/storytelling data.' : '✗ Error: ' + result.error}</p>`;
      resultDiv.classList.remove('hidden');
      if (res.ok) document.getElementById('newStyleForm').reset();
    });
    }

    // NEW BATCH form
    const newBatchForm = document.getElementById('newBatchForm');
    if (newBatchForm) {
    newBatchForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const serials = document.getElementById('newSerials').value.split(',').map(s => s.trim());
