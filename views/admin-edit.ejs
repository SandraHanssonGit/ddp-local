    function showVariantDialog(title, errorMsg = '') {
      return new Promise(resolve => {
        const dialog = document.createElement('div');
        dialog.className = 'fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50';
        dialog.innerHTML = `
          <div class="bg-white rounded-lg shadow-xl p-6 max-w-md w-full mx-4">
            <h2 class="text-lg font-semibold text-gray-900 mb-2">${title}</h2>
            ${errorMsg ? `<div class="bg-red-50 border border-red-200 text-red-700 px-3 py-2 rounded text-sm mb-4">${errorMsg}</div>` : ''}
            <input type="text" id="variantInput" class="w-full border border-gray-300 rounded px-3 py-2 mb-4 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="e.g., B20, B21" />
            <div class="flex gap-2 justify-end">
              <button type="button" class="px-4 py-2 text-gray-700 bg-gray-200 rounded hover:bg-gray-300" id="cancelBtn">Cancel</button>
              <button type="button" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700" id="okBtn">OK</button>
            </div>
          </div>
        `;
        document.body.appendChild(dialog);

        const input = dialog.querySelector('#variantInput');
        const cancelBtn = dialog.querySelector('#cancelBtn');
        const okBtn = dialog.querySelector('#okBtn');

        input.focus();

        cancelBtn.addEventListener('click', () => {
          dialog.remove();
          resolve(null);
        });

        okBtn.addEventListener('click', () => {
          dialog.remove();
          resolve(input.value);
        });

        input.addEventListener('keypress', (e) => {
          if (e.key === 'Enter') {
            dialog.remove();
            resolve(input.value);
          }
        });

        input.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            dialog.remove();
            resolve(null);
          }
        });
      });
    }

    async function addNewTopVariant(styleNumber) {
      try {
        // Fetch existing variants for this style
        const res = await fetch(`/api/styles/${styleNumber}/variants`);
        const data = await res.json();
        const existingVariants = new Set(data.variants || []);

        let validVariant = false;
        let chosenVariant = null;
        let errorMsg = '';

        while (!validVariant) {
          chosenVariant = await showVariantDialog(`Enter variant name for ${styleNumber}:`, errorMsg);

          if (chosenVariant === null) {
            // User clicked cancel
            return;
          }

          const trimmedVariant = chosenVariant.trim();
          errorMsg = '';

          if (trimmedVariant === '') {
            errorMsg = '❌ Variant name cannot be empty.';
            continue;
          }

          if (existingVariants.has(trimmedVariant)) {
            errorMsg = `❌ Variant "${trimmedVariant}" already exists. Please choose another name.`;
            continue;
          }

          validVariant = true;
          chosenVariant = trimmedVariant;
        }

        // Variant is valid, open form
        await showCreateStyleForm(styleNumber, chosenVariant, 'topp');
        document.getElementById('searchQuery').value = '';
      } catch (error) {
        console.error('Error in addNewTopVariant:', error);
        showToast('❌ Error checking variants. Please try again.');
      }
    }

    async function showCreateStyleForm(styleNumber, variant = null, productType = '') {
      // For topps without a variant, ask user which variant to add
      if (productType === 'topp' && !variant) {
        try {
          // Fetch existing variants for this style
          const res = await fetch(`/api/styles/${styleNumber}/variants`);
          const data = await res.json();
          const existingVariants = new Set(data.variants || []);

          let validVariant = false;
          let errorMsg = '';

          while (!validVariant) {
            const enteredVariant = await showVariantDialog(`Enter variant to add for ${styleNumber}:`, errorMsg);
            if (!enteredVariant) return; // User cancelled

            const trimmedVariant = enteredVariant.trim();
            errorMsg = '';

            if (trimmedVariant === '') {
              errorMsg = '❌ Variant name cannot be empty.';
              continue;
            }

            if (existingVariants.has(trimmedVariant)) {
              errorMsg = `❌ Variant "${trimmedVariant}" already exists. Please choose another name.`;
              continue;
            }

            validVariant = true;
            variant = trimmedVariant;
          }
        } catch (error) {
          console.error('Error checking variants:', error);
          showToast('❌ Error checking variants. Please try again.');
          return;
        }
      }

      document.getElementById('resultContainer').classList.remove('hidden');
      document.getElementById('styleSection').classList.remove('hidden');
      document.getElementById('batchSection').classList.add('hidden');
      document.getElementById('serialSection').classList.add('hidden');

      // Only show variant in title if it's a real value (not null, undefined, or "null")
      const hasVariant = variant && variant !== 'null' && variant !== 'undefined';
      const displayTitle = hasVariant ? `${styleNumber}-${variant}` : styleNumber;
      document.getElementById('styleTitle').textContent = displayTitle;
      document.getElementById('fetchNudieBtn').style.display = 'block';

      // Determine type: jeans if no variant, topp if variant provided
      const finalProductType = variant ? 'topp' : (productType || 'jeans');
      const typeLabel = finalProductType === 'topp' ? 'Topp' : 'Jeans';
      document.getElementById('productInfoView').innerHTML = `<p class="text-gray-500">New ${typeLabel} - fill in details below</p>`;

      // Show edit form with all fields
      document.getElementById('productType').value = finalProductType;
      document.getElementById('productType').disabled = true; // Lock type for new styles
      document.getElementById('productVariant').value = variant || '';
      document.getElementById('productVariant').disabled = !!variant; // Lock variant if provided
      updateVariantRequirements();
      document.getElementById('productName').value = '';
      document.getElementById('productDescription').value = '';
      document.getElementById('productCare').value = '';
      document.getElementById('productDelivery').value = '';
      document.getElementById('productMaterial').value = '';
      toggleEdit('product-info');

      // Set style number for saving
      document.getElementById('styleNumber').dataset.styleNumber = styleNumber;
      document.getElementById('styleNumber').dataset.variant = variant || '';
    }

