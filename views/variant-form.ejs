<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= variant ? 'Edit Variant' : 'Create Variant' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white">
  <nav class="border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-8 py-4">
      <div class="flex items-center">
        <a href="/" class="flex items-center">
          <img src="https://images.teamtailor-cdn.com/images/s3/teamtailor-production/logotype-v3/image_uploads/7118e754-48bc-483f-b8fa-42a84f2e08f2/original.png" alt="Nudie Jeans" class="h-8">
        </a>
      </div>
    </div>
  </nav>

  <main class="max-w-2xl mx-auto px-8 py-16">
    <a href="/variants/<%= variant.variant_id %>" class="text-gray-600 hover:text-gray-900 mb-8 inline-block">← Back</a>

    <div class="mb-12">
      <h1 class="text-4xl font-bold text-gray-900">Edit Variant</h1>
    </div>

    <form method="POST" action="/variants/<%= variant.variant_id %>" class="space-y-8">
      <!-- Variant Info -->
      <div class="border-b border-gray-200 pb-8">
        <h2 class="text-lg font-bold text-gray-900 mb-6">Variant Information</h2>
        <div class="space-y-6">
          <div>
            <label class="block text-sm font-semibold text-gray-900 mb-2">Variant Code *</label>
            <input type="text" name="variant_code" maxlength="3" required class="w-full border border-gray-300 px-4 py-2 text-sm focus:outline-none focus:border-gray-900 uppercase" placeholder="e.g., ANT" pattern="[A-Z0-9]{3}" value="<%= variant.variant_code %>">
            <p class="text-xs text-gray-500 mt-2">Exactly 3 characters (letters or numbers)</p>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-900 mb-2">Variant Name</label>
            <input type="text" name="variant_name" class="w-full border border-gray-300 px-4 py-2 text-sm focus:outline-none focus:border-gray-900" placeholder="e.g., Antracite" value="<%= variant.variant_name || '' %>">
            <p class="text-xs text-gray-500 mt-2">Optional human-readable name for this variant</p>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-900 mb-2">Image URL</label>
            <textarea name="image_url" class="w-full border border-gray-300 px-4 py-2 text-sm focus:outline-none focus:border-gray-900" rows="2" placeholder="https://example.com/image.jpg"><%= variant.image_url || '' %></textarea>
            <p class="text-xs text-gray-500 mt-2">Optional image URL for this variant</p>
          </div>
        </div>
      </div>

      <!-- Actions -->
      <div class="flex gap-4">
        <button type="submit" class="flex-1 bg-gray-900 text-white py-3 font-semibold hover:bg-gray-800">
          Update Variant
        </button>
        <a href="/variants/<%= variant.variant_id %>" class="flex-1 border border-gray-300 text-gray-900 py-3 font-semibold text-center hover:border-gray-900">
          Cancel
        </a>
      </div>
    </form>
  </main>
</body>
</html>
